<!DOCTYPE html>
{# The map of `media-hygiene places`: where the photos were taken, as circles sized by
   count, and the user's places. Leaflet is served by the tool itself; only the map tiles
   come from the tile server, fetched by the browser. Each place is saved at once into
   config.toml by the server. #}
{% set texts = {
  "photos": [ngettext("{n} photo", "{n} photos", 1), ngettext("{n} photo", "{n} photos", 2)],
  "videos": [ngettext("{n} video", "{n} videos", 1), ngettext("{n} video", "{n} videos", 2)],
  "inPlace": _("place: {place}"),
  "nameIt": _("Name this place"),
  "noCluster": _("Every cluster lies in a place of yours."),
  "noPlace": _("No place yet: click a circle or the map."),
  "noTown": _("No town of more than 1,000 inhabitants starts so."),
  "newPlace": _("New place"),
  "saving": _("Saving…"),
  "saved": _("Saved in config.toml."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The map is not running any more: start it again."),
  "needName": _("Give the place a name."),
  "confirmDelete": _("Delete the place {name}? The photos stay where they are."),
  "osmSearching": _("Searching OpenStreetMap…"),
  "osmNone": _("OpenStreetMap knows no area of that name."),
  "osmTooLarge": _("Larger areas not listed (regions, countries): {count}. A 'trip' rule names them."),
  "osmType": _("Type a name first."),
  "clusterTitle": _("Cluster — {files}"),
  "firstPhotos": [ngettext("The first photo out of {count}", "The first {n} photos out of {count}", 1),
                  ngettext("The first photo out of {count}", "The first {n} photos out of {count}", 2)],
  "firstVideos": [ngettext("The first video out of {count}", "The first {n} videos out of {count}", 1),
                  ngettext("The first video out of {count}", "The first {n} videos out of {count}", 2)],
  "photosMissing": _("Some photos are not reachable: moved since the audit, or their folder is not mounted (read-only is enough)."),
  "showPhotos": _("Show its photos"),
  "withoutGps": _("{files} without GPS"),
  "noFolder": _("No folder named after a town holds photos without GPS."),
  "folderMissing": _("Not found: renamed or moved? Rename it back, or forget its position."),
  "folderHint": _("Drag the pin where these photos were taken, then save: 'xmp' writes that position into their sidecars ([tags] xmp_folder_gps = true)."),
  "folderSaved": _("Position saved in config.toml."),
  "folderForgotten": _("Position taken out of config.toml."),
  "folderIgnored": _("Saved in config.toml: this name is no town."),
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("Your places") }} — media-hygiene</title>
<link rel="stylesheet" href="/leaflet.css">
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --ok: #1a7f37; --bad: #cf222e; --place: #1a7f37; --cluster: #0969da;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --ok: #3fb950; --bad: #f85149;
    }
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { display: flex; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  aside { width: 340px; max-width: 45vw; overflow-y: auto; padding: 12px 16px;
          background: var(--card); border-right: 1px solid var(--line); }
  #stage { flex: 1; position: relative; min-width: 0; }
  #map { position: absolute; inset: 0; }
  h1 { font-size: 1.1rem; margin: 0 0 8px; }
  h2 { font-size: .95rem; margin: 16px 0 6px; }
  .muted, .hint { color: var(--muted); font-size: .85rem; }
  input[type=text], input[type=search], input[type=number] {
    width: 100%; padding: 6px 8px; font: inherit; color: var(--text); background: var(--bg);
    border: 1px solid var(--line); border-radius: 6px; }
  input[type=range] { width: 100%; }
  ul { list-style: none; margin: 0; padding: 0; }
  li button.link { width: 100%; padding: 4px 6px; text-align: left; font: inherit;
                   color: var(--text); background: none; border: 0; border-radius: 6px;
                   cursor: pointer; }
  li button.link:hover { background: var(--bg); }
  #editor { margin-top: 12px; padding: 10px; border: 2px solid var(--accent); border-radius: 10px; }
  #editor label { display: block; margin: 8px 0 2px; font-weight: 600; }
  #editor label.check { font-weight: normal; }
  .buttons { display: flex; gap: 8px; margin-top: 10px; }
  .buttons button { padding: 6px 12px; font: inherit; border: 1px solid var(--line);
                    border-radius: 6px; background: var(--bg); color: var(--text); cursor: pointer; }
  .buttons button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .buttons button.danger { color: var(--bad); }
  #status.error { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  .pin { width: 18px !important; height: 18px !important; margin: -9px 0 0 -9px !important;
         background: var(--accent); border: 3px solid #fff; border-radius: 50%;
         box-shadow: 0 0 0 1px var(--accent); }
  .leaflet-tooltip.place-name { font-weight: 600; }
  #osm { margin-top: 8px; }
  #osm button { padding: 4px 10px; font: inherit; border: 1px solid var(--line); border-radius: 6px;
                background: var(--bg); color: var(--text); cursor: pointer; }
  #osm button:disabled { opacity: .6; cursor: progress; }
  #osm a { color: var(--accent); }
  details.fold { margin-top: 16px; }
  details.fold > summary { font-size: .95rem; font-weight: 600; color: var(--muted); cursor: pointer;
                           margin-bottom: 6px; }
  details.fold .count { font-weight: normal; }
  li.cluster { display: flex; gap: 4px; align-items: center; }
  li.cluster button.link { flex: 1; width: auto; }
  li.cluster button.count { padding: 2px 8px; font: inherit; font-size: .85rem; white-space: nowrap;
                            color: var(--accent); background: none; border: 1px solid var(--line);
                            border-radius: 6px; cursor: pointer; }
  li.cluster.shown button.count { background: var(--accent); border-color: var(--accent); color: #fff; }
  @keyframes flash { from { background: var(--accent); color: #fff; } to { background: none; } }
  li.flash button.link { animation: flash 1.6s ease-out; }
  li.shown > button.link { background: var(--bg); font-weight: 600; }
  li.missing button.link { color: var(--bad); }
  .folder-pin { width: 18px !important; height: 18px !important; margin: -9px 0 0 -9px !important;
                background: var(--ok); border: 3px solid #fff; border-radius: 50%;
                box-shadow: 0 0 0 1px var(--ok); }
  /* The drawer: over the right of the map, at a fixed place whatever the lists' length. */
  #drawer { position: absolute; top: 0; right: 0; bottom: 0; width: 40%; min-width: 320px; z-index: 1100;
            display: flex; flex-direction: column; background: var(--card); color: var(--text);
            border-left: 1px solid var(--line); box-shadow: -4px 0 16px rgba(0, 0, 0, .2); }
  #drawer[hidden], #viewer[hidden], #drawerBody[hidden] { display: none; }
  #drawer > header { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  #drawer .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  #drawer .top strong { overflow-wrap: anywhere; }
  #drawer .buttons { flex-wrap: wrap; margin-top: 8px; }
  #drawerClose { font: inherit; font-size: 1.1rem; color: var(--muted); background: none; border: 0; cursor: pointer; }
  #drawerBody { flex: 1; overflow-y: auto; padding: 0 14px 14px; }
  #drawerBody h3 { margin: 12px 0 4px; font-size: .85rem; font-weight: normal; color: var(--muted);
                   overflow-wrap: anywhere; }
  #drawerBody h3 b { color: var(--text); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 4px; }
  .grid img, .grid .gone, .grid .video { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px;
                                         background: var(--bg); }
  .grid img { cursor: zoom-in; }
  .grid .gone, .grid .video { display: flex; flex-direction: column; align-items: center; justify-content: center;
                              padding: 4px; overflow: hidden; text-align: center; color: var(--muted);
                              font-size: 1.4rem; border: 1px dashed var(--line); }
  .grid .video small { font-size: .7rem; overflow-wrap: anywhere; }
  #viewer { flex: 1; display: flex; flex-direction: column; min-height: 0; margin: 0; padding: 8px 14px 14px; }
  #viewer img { flex: 1; min-height: 0; width: 100%; object-fit: contain; }
  #viewer figcaption { margin-top: 6px; font-size: .85rem; overflow-wrap: anywhere; }
  @media (max-width: 700px) { #drawer { width: 100%; min-width: 0; } }
  .photo-pin { width: 12px !important; height: 12px !important; margin: -6px 0 0 -6px !important;
               background: var(--bad); border: 2px solid #fff; border-radius: 50%; }
</style>
</head>
<body>
<aside>
  <h1>📍 {{ _("Your places") }}</h1>
  <p class="hint">{{ _("The circles are your photos with a GPS position, larger where there are more. Click a circle or the map to name a place; drag its marker to move it. Each place is saved at once in config.toml.") }}</p>
  <input id="search" type="search" autocomplete="off"
         placeholder="{{ _('Find a town (offline)…') }}" aria-label="{{ _('Find a town') }}">
  <ul id="towns"></ul>
  {% if osm_path %}
  <div id="osm">
    <button type="button" id="osmButton">{{ _("Search OpenStreetMap") }}</button>
    <p class="hint">{{ _("For a village, a district or a park drawn as an area: click or press Enter. Only the text you typed is sent, to {host}; never a photo nor a position.").format(host=osm_host) }}
      {{ _("Results") }} © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">{{ _("OpenStreetMap contributors") }}</a>, ODbL ·
      <a href="https://operations.osmfoundation.org/policies/nominatim/" target="_blank" rel="noopener">{{ _("usage policy") }}</a></p>
    <ul id="areas"></ul>
  </div>
  {% endif %}
  <span id="status" role="status" aria-live="polite"></span>
  <form id="editor" hidden>
    <strong id="editorTitle"></strong>
    <label for="name">{{ _("Name (it becomes a folder name)") }}</label>
    <input id="name" type="text" maxlength="120" required>
    <div id="circleOnly">
    <label for="radius">{{ _("Radius, in metres") }}</label>
    <input id="radius" type="range" min="20" max="3000" step="10">
    <input id="radiusValue" type="number" min="1" max="50000" step="1" aria-label="{{ _('Radius, in metres') }}">
    </div>
    <p id="areaNote" class="hint" hidden>{{ _("An area from OpenStreetMap: the photos taken inside its outline belong to this place.") }}</p>
    <label class="check"><input id="home" type="checkbox"> {{ _("Home: trips are measured from it") }}</label>
    <div class="buttons">
      <button type="submit" class="primary">{{ _("Save") }}</button>
      <button type="button" id="cancel">{{ _("Cancel") }}</button>
      <button type="button" id="delete" class="danger">{{ _("Delete") }}</button>
    </div>
  </form>
  <details id="placesFold" class="fold" open>
    <summary>{{ _("Your places") }} <span id="placesCount" class="count"></span></summary>
    <ul id="places"></ul>
  </details>
  <details id="clustersFold" class="fold" open>
    <summary>{{ _("The largest clusters without a name") }} <span id="clustersCount" class="count"></span></summary>
    <ul id="clusters"></ul>
  </details>
  <details id="foldersFold" class="fold" open>
    <summary>{{ _("Folders named after a town") }} <span id="foldersCount" class="count"></span></summary>
    <ul id="folders"></ul>
  </details>
  <p class="hint">{{ _("Done? Ctrl+C in the terminal stops the map. Then add a 'place' rule (and a 'trip' rule) to [[classify.rules]] and run 'classify'.") }}</p>
</aside>
<main id="stage">
  <div id="map"></div>
  <section id="drawer" hidden aria-labelledby="drawerTitle">
    <header>
      <div class="top"><strong id="drawerTitle"></strong>
        <button type="button" id="drawerClose" aria-label="{{ _('Close') }}" title="{{ _('Close') }} (Esc)">✕</button></div>
      <div class="buttons">
        <button type="button" id="clusterName" class="primary">{{ _("Name this place") }}</button>
        <button type="button" id="folderSave" class="primary">{{ _("Save this position") }}</button>
        <button type="button" id="folderForget">{{ _("Forget its position") }}</button>
        <button type="button" id="folderIgnore">{{ _("Not a town") }}</button>
      </div>
      <p id="drawerNote" class="hint"></p>
      <p id="drawerNotes" class="hint" hidden aria-live="polite"></p>
    </header>
    <div id="drawerBody"></div>
    <figure id="viewer" hidden>
      <img id="viewerImg" alt="">
      <figcaption id="viewerPath"></figcaption>
      <div class="buttons">
        <button type="button" id="viewerPrev" aria-label="{{ _('Previous photo') }}">←</button>
        <button type="button" id="viewerBack">{{ _("Back to the photos") }} (Esc)</button>
        <button type="button" id="viewerNext" aria-label="{{ _('Next photo') }}">→</button>
        <span id="viewerCount" class="muted"></span>
      </div>
    </figure>
  </section>
</main>
<script src="/leaflet.js"></script>
<script>
(() => {
  const T = {{ texts | tojson }};
  const paths = { state: {{ state_path | tojson }}, save: {{ save_path | tojson }},
                  search: {{ search_path | tojson }}, osm: {{ osm_path | tojson }},
                  cluster: {{ cluster_path | tojson }}, folders: {{ folders_path | tojson }},
                  folderPhotos: {{ folder_photos | tojson }}, folder: {{ folder_path | tojson }} };
  const tiles = {{ tiles | tojson }};
  const attribution = {{ attribution | tojson }};
  const byId = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
  // Text as a node: Leaflet writes a string tooltip with innerHTML, a node as it is.
  const label = (text) => { const span = document.createElement("span"); span.textContent = text; return span; };
  const plain = (text) => label(text).innerHTML;
  const plural = new Intl.PluralRules(document.documentElement.lang);
  // A counted fragment: its singular and plural forms, the one the language uses for n.
  const counted = (forms, n) => fill(forms[plural.select(n) === "one" ? 0 : 1], { n: n });
  const photos = (count) => counted(T.photos, count);
  const colour = (name) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const SHOWN_CLUSTERS = 15, NAMED_ZOOM = 16, TOWN_ZOOM = 13, DEFAULT_RADIUS = 200;
  // From this many places on, "Your places" starts folded, unless the reader chose.
  const FOLDED_FROM = 8, FOLD_KEY = "places-folds";

  const map = L.map("map", { worldCopyJump: true }).setView([30, 0], 2);
  L.tileLayer(tiles, { maxZoom: 19, attribution: plain(attribution) }).addTo(map);
  const clusterLayer = L.layerGroup().addTo(map);
  const placeLayer = L.layerGroup().addTo(map);
  let state = { places: [], clusters: [] };
  let editing = null, editCircle = null, editMarker = null;

  const status = (text, kind) => { const node = byId("status"); node.textContent = text; node.className = kind || ""; };

  function item(list, text, action) {
    const li = document.createElement("li");
    const button = document.createElement("button");
    button.type = "button"; button.className = "link"; button.textContent = text;
    button.addEventListener("click", action);
    li.append(button); list.append(li);
    return li;
  }

  // The reader's folds, kept in this browser only; a private window keeps none.
  const folds = (() => { try { return JSON.parse(localStorage.getItem(FOLD_KEY)) || {}; } catch (error) { return {}; } })();
  // Only a click of the reader is remembered, not a list the page opens itself.
  for (const id of ["placesFold", "clustersFold", "foldersFold"]) {
    byId(id).querySelector("summary").addEventListener("click", () => {
      folds[id] = !byId(id).open;
      try { localStorage.setItem(FOLD_KEY, JSON.stringify(folds)); } catch (error) { /* private window */ }
    });
  }
  const unfold = (id) => { if (!byId(id).open) byId(id).open = true; };
  // The line of a place just saved flashes in its list, opened: the save shows where the eye is.
  const flash = (li) => { li.classList.add("flash"); li.scrollIntoView({ block: "nearest" }); };
  let flashName = null;

  // What a cluster or a folder holds: "3 photos, 1 video"; never "0 photos" beside videos.
  const videos = (count) => counted(T.videos, count);
  const holds = (pictures, filmed) =>
    [pictures || !filmed ? photos(pictures) : "", filmed ? videos(filmed) : ""].filter(Boolean).join(", ");
  const lastName = (folder) => folder.split(/[\\/]/).filter(Boolean).pop() || folder;

  // The drawer, over the right of the map: the photos of a cluster or of a folder, grouped
  // by folder, its actions on top; a click on a photo opens it larger (←/→, Esc back).
  let opened = null, photoPin = null, folderPin = null, viewing = [], viewed = -1;
  const unpin = () => { if (photoPin) { photoPin.remove(); photoPin = null; } };
  const pinAt = (file) => {
    unpin();
    if ("latitude" in file) photoPin = L.marker([file.latitude, file.longitude], { icon: L.divIcon({ className: "photo-pin" }) }).addTo(map);
  };
  // The width the drawer hides on the map's right; none when it covers the whole map.
  const hidden = () => {
    const drawer = byId("drawer"), width = drawer.hidden ? 0 : drawer.offsetWidth;
    return width < byId("map").offsetWidth ? width : 0;
  };
  // A point at the middle of what the drawer leaves visible.
  const focus = (at, zoom) => map.setView(map.unproject(map.project(at, zoom).add([hidden() / 2, 0]), zoom), zoom);
  // The clicked line stays highlighted in its list while the drawer shows it.
  function highlight() {
    const key = opened ? opened.key : null;
    for (const li of document.querySelectorAll("li[data-drawer]")) {
      const on = li.dataset.drawer === key;
      li.classList.toggle("shown", on);
      const count = li.querySelector("button.count");
      if (count) count.setAttribute("aria-pressed", String(on));
    }
  }
  function closeViewer() {
    viewed = -1; byId("viewer").hidden = true; byId("drawerBody").hidden = false;
    byId("viewerImg").removeAttribute("src"); unpin();
  }
  function closeDrawer() {
    if (folderPin) { folderPin.remove(); folderPin = null; }
    opened = null; viewing = []; closeViewer();
    byId("drawer").hidden = true; byId("drawerBody").replaceChildren();
    highlight();
  }
  function openViewer(index) {
    if (!viewing.length) return;
    viewed = (index + viewing.length) % viewing.length;
    const file = viewing[viewed], cut = /[\\/]$/.test(file.folder) ? "" : (file.folder.includes("\\") ? "\\" : "/");
    byId("viewerImg").src = file.large; byId("viewerImg").alt = file.name;
    byId("viewerPath").textContent = `${file.folder}${cut}${file.name}`;
    byId("viewerCount").textContent = `${viewed + 1} / ${viewing.length}`;
    byId("drawerBody").hidden = true; byId("viewer").hidden = false;
    pinAt(file);
  }
  function cell(file) {
    let node;
    if (file.video || !file.found) {
      node = document.createElement("span");
      node.className = file.video ? "video" : "gone";
      const name = document.createElement("small"); name.textContent = file.name;
      node.append(file.video ? "🎞" : "∅", name);
    } else {
      node = document.createElement("img");
      node.src = file.preview; node.alt = file.name; node.loading = "lazy";
      node.addEventListener("click", () => openViewer(viewing.indexOf(file)));
    }
    node.title = file.name;
    node.addEventListener("mouseenter", () => pinAt(file));
    node.addEventListener("mouseleave", unpin);
    return node;
  }
  // The files, one heading per folder (its host path, its own name in bold).
  function fillDrawer(files, source) {
    const body = byId("drawerBody"); body.replaceChildren();
    const pictures = files.filter((file) => !file.video).length, filmed = files.length - pictures;
    const notes = [];
    if (pictures < source.pictures) notes.push(fill(counted(T.firstPhotos, pictures), { count: source.pictures }));
    if (filmed < source.videos) notes.push(fill(counted(T.firstVideos, filmed), { count: source.videos }));
    if (files.some((file) => !file.found)) notes.push(T.photosMissing);
    byId("drawerNotes").textContent = notes.join(" · "); byId("drawerNotes").hidden = !notes.length;
    viewing = files.filter((file) => !file.video && file.found);
    let folder = null, grid = null;
    for (const file of files) {
      if (file.folder !== folder) {
        folder = file.folder;
        const heading = document.createElement("h3"), own = document.createElement("b"), name = lastName(folder);
        own.textContent = name;
        heading.append(folder.slice(0, folder.lastIndexOf(name)), own);
        heading.title = folder;
        grid = document.createElement("div"); grid.className = "grid";
        body.append(heading, grid);
      }
      grid.append(cell(file));
    }
  }
  async function openDrawer(source) {
    closeDrawer(); opened = source;
    byId("drawerTitle").textContent = source.title;
    byId("drawerNote").textContent = source.note; byId("drawerNote").hidden = !source.note;
    for (const [id, shown] of Object.entries(source.actions)) byId(id).hidden = !shown;
    byId("drawerNotes").hidden = true;
    byId("drawer").hidden = false;
    focus(source.at, Math.max(map.getZoom(), source.zoom));
    if (source.folder) {
      folderPin = L.marker(source.at, { draggable: true, icon: L.divIcon({ className: "folder-pin" }) }).addTo(map);
      folderPin.bindTooltip(label(source.folder.town || source.folder.folder));
    }
    highlight();
    const response = await fetch(source.url).catch(() => null);
    if (opened !== source) return;
    if (!response || !response.ok) { status(T.offline, "error"); return; }
    fillDrawer((await response.json()).photos, source);
  }
  function showCluster(rank) {
    const key = `cluster:${rank}`;
    if (opened && opened.key === key) { closeDrawer(); return; }
    const [lat, lon, pictures, filmed] = state.clusters[rank];
    const actions = { clusterName: true, folderSave: false, folderForget: false, folderIgnore: false };
    openDrawer({ key, url: paths.cluster + rank, at: [lat, lon], zoom: NAMED_ZOOM, pictures, videos: filmed,
                 title: fill(T.clusterTitle, { files: holds(pictures, filmed) }), note: "", actions, folder: null });
  }
  byId("drawerClose").addEventListener("click", closeDrawer);
  byId("viewerBack").addEventListener("click", closeViewer);
  byId("viewerPrev").addEventListener("click", () => openViewer(viewed - 1));
  byId("viewerNext").addEventListener("click", () => openViewer(viewed + 1));
  byId("clusterName").addEventListener("click", () => { if (opened) startNew(...opened.at); });
  document.addEventListener("keydown", (event) => {
    if (byId("drawer").hidden || event.target.closest?.("input, textarea, select")) return;
    if (event.key === "Escape") { if (viewed >= 0) closeViewer(); else closeDrawer(); }
    else if (viewed >= 0 && event.key === "ArrowLeft") openViewer(viewed - 1);
    else if (viewed >= 0 && event.key === "ArrowRight") openViewer(viewed + 1);
    else return;
    event.preventDefault();
  });

  // The folders named after a town, or placed: their photos without GPS, a pin to drag.
  let folders = [], folderFlash = null;
  const filesOf = (folder) => holds(folder.count - folder.videos, folder.videos);
  function drawFolders() {
    const list = byId("folders"); list.replaceChildren();
    byId("foldersCount").textContent = `(${folders.length})`;
    if (!folders.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noFolder; list.append(li); }
    for (const folder of folders) {
      const name = folder.town || lastName(folder.folder);
      const mark = !folder.found ? "⚠ " : folder.saved ? "📌 " : "📁 ";
      const li = item(list, `${mark}${name} — ${fill(T.withoutGps, { files: filesOf(folder) })}`, () => showFolder(folder.rank));
      li.title = folder.folder; li.dataset.drawer = `folder:${folder.folder}`;
      if (!folder.found) li.classList.add("missing");
      if (folder.folder === folderFlash) { unfold("foldersFold"); flash(li); }
    }
    folderFlash = null;
    highlight();
  }
  async function loadFolders() {
    const response = await fetch(paths.folders).catch(() => null);
    if (!response || !response.ok) return;
    folders = (await response.json()).folders; drawFolders();
  }
  function showFolder(rank) {
    const folder = folders[rank], key = `folder:${folder.folder}`;
    if (opened && opened.key === key) { closeDrawer(); return; }
    const name = folder.town || lastName(folder.folder);
    const actions = { clusterName: false, folderSave: folder.found, folderForget: folder.saved, folderIgnore: Boolean(folder.town) };
    openDrawer({ key, url: paths.folderPhotos + rank, at: [folder.latitude, folder.longitude], zoom: TOWN_ZOOM,
                 pictures: folder.count - folder.videos, videos: folder.videos, folder, actions,
                 title: `${name} — ${fill(T.withoutGps, { files: filesOf(folder) })}`,
                 note: folder.found ? T.folderHint : T.folderMissing });
  }
  async function actOnFolder(action, said) {
    const chosen = opened && opened.folder;
    if (!chosen) return;
    const where = folderPin ? folderPin.getLatLng() : { lat: chosen.latitude, lng: chosen.longitude };
    status(T.saving);
    let response;
    try {
      response = await fetch(paths.folder, { method: "POST", headers: { "Content-Type": "application/json" },
                                             body: JSON.stringify({ action, folder: chosen.folder,
                                                                    latitude: where.lat, longitude: where.lng }) });
    } catch (error) { status(T.offline, "error"); return; }
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) { status(answer.error || fill(T.failed, { status: response.status }), "error"); return; }
    folderFlash = action === "ignore" ? null : chosen.folder;
    folders = answer.folders; closeDrawer(); drawFolders(); status(said, "saved");
  }
  byId("folderSave").addEventListener("click", () => actOnFolder("save", T.folderSaved));
  byId("folderForget").addEventListener("click", () => actOnFolder("forget", T.folderForgotten));
  byId("folderIgnore").addEventListener("click", () => actOnFolder("ignore", T.folderIgnored));

  function draw() {
    clusterLayer.clearLayers(); placeLayer.clearLayers();
    for (const [lat, lon, pictures, filmed, place] of state.clusters) {
      const what = holds(pictures, filmed);
      const circle = L.circleMarker([lat, lon], {
        radius: 4 + 3 * Math.log2(pictures + filmed), weight: 1, fillOpacity: 0.45,
        color: place ? colour("--muted") : colour("--cluster"),
      });
      circle.bindTooltip(label(place ? `${what}, ${fill(T.inPlace, { place })}` : what));
      circle.on("click", (event) => { L.DomEvent.stopPropagation(event); startNew(lat, lon); });
      circle.addTo(clusterLayer);
    }
    for (const place of state.places) {
      const style = { radius: place.radius_m, color: colour("--place"), weight: 2 };
      const circle = place.area ? L.polygon(place.area, style) : L.circle([place.latitude, place.longitude], style);
      circle.bindTooltip(label(place.home ? `🏠 ${place.name}` : place.name), { permanent: true, className: "place-name" });
      circle.on("click", (event) => { L.DomEvent.stopPropagation(event); edit(place); });
      circle.addTo(placeLayer);
    }
    const places = byId("places"); places.replaceChildren();
    if (!state.places.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noPlace; places.append(li); }
    for (const place of state.places) {
      const li = item(places, (place.home ? "🏠 " : "📍 ") + place.name, () => edit(place));
      if (place.name === flashName) { unfold("placesFold"); flash(li); }
    }
    flashName = null;
    byId("placesCount").textContent = `(${state.places.length})`;
    const clusters = byId("clusters"); clusters.replaceChildren();
    const unnamed = state.clusters.map((cluster, rank) => [rank, ...cluster]).filter((cluster) => !cluster[5]);
    byId("clustersCount").textContent = `(${unnamed.length})`;
    if (!unnamed.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noCluster; clusters.append(li); }
    for (const [rank, lat, lon, pictures, filmed] of unnamed.slice(0, SHOWN_CLUSTERS)) {
      const li = item(clusters, `● ${T.nameIt}`, () => startNew(lat, lon));
      li.classList.add("cluster"); li.dataset.drawer = `cluster:${rank}`;
      const button = document.createElement("button");
      button.type = "button"; button.className = "count";
      button.textContent = `${pictures ? "🖼" : "🎞"} ${holds(pictures, filmed)}`;
      button.title = T.showPhotos;
      button.addEventListener("click", () => showCluster(rank));
      li.prepend(button);
    }
    highlight();
  }

  function showEditor() {
    if (editCircle) editCircle.remove();
    if (editMarker) editMarker.remove();
    if (!editing) { byId("editor").hidden = true; return; }
    const at = [editing.latitude, editing.longitude];
    const dashed = { radius: editing.radius_m, color: colour("--accent"), dashArray: "6 6" };
    editCircle = (editing.area ? L.polygon(editing.area, dashed) : L.circle(at, dashed)).addTo(map);
    byId("circleOnly").hidden = Boolean(editing.area);
    byId("areaNote").hidden = !editing.area;
    if (!editing.area) {
      editMarker = L.marker(at, { draggable: true, icon: L.divIcon({ className: "pin" }) }).addTo(map);
      editMarker.on("drag", (event) => {
        const where = event.target.getLatLng();
        editing.latitude = where.lat; editing.longitude = where.lng; editCircle.setLatLng(where);
      });
    } else { editMarker = null; }
    byId("editorTitle").textContent = editing.key === null ? T.newPlace : editing.name;
    byId("name").value = editing.name;
    byId("radius").value = editing.radius_m; byId("radiusValue").value = editing.radius_m;
    byId("home").checked = editing.home;
    byId("delete").hidden = editing.key === null;
    byId("editor").hidden = false;
    byId("name").focus();
  }

  function edit(place) {
    editing = { ...place };
    if (place.area) map.fitBounds(L.polygon(place.area).getBounds().pad(0.1), { paddingBottomRight: [hidden(), 0] });
    else focus([place.latitude, place.longitude], Math.max(map.getZoom(), NAMED_ZOOM));
    showEditor();
  }
  const blank = { key: null, name: "", radius_m: DEFAULT_RADIUS, home: false, osm: "", area: null };
  const startNew = (lat, lon) => edit({ ...blank, latitude: lat, longitude: lon });
  map.on("click", (event) => startNew(event.latlng.lat, event.latlng.lng));

  const setRadius = (value) => {
    const radius = Math.max(1, Math.min(50000, Number(value) || DEFAULT_RADIUS));
    editing.radius_m = radius; editCircle.setRadius(radius);
    byId("radius").value = radius; byId("radiusValue").value = radius;
  };
  byId("radius").addEventListener("input", (event) => setRadius(event.target.value));
  byId("radiusValue").addEventListener("change", (event) => setRadius(event.target.value));
  byId("cancel").addEventListener("click", () => { editing = null; showEditor(); });

  const row = (place) => ({ key: place.key, name: place.name, latitude: place.latitude,
                            longitude: place.longitude, radius_m: place.radius_m, home: place.home,
                            osm: place.osm || "", area: place.area || null });

  async function send(places) {
    status(T.saving);
    let response;
    try {
      response = await fetch(paths.save, { method: "POST", headers: { "Content-Type": "application/json" },
                                           body: JSON.stringify({ places: places.map(row) }) });
    } catch (error) { status(T.offline, "error"); return; }
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) { status(answer.error || fill(T.failed, { status: response.status }), "error"); return; }
    flashName = editing ? editing.name : null;
    state = answer; editing = null; closeDrawer(); showEditor(); draw(); status(T.saved, "saved");
  }

  byId("editor").addEventListener("submit", (event) => {
    event.preventDefault();
    editing.name = byId("name").value.trim();
    editing.home = byId("home").checked;
    if (!editing.name) { status(T.needName, "error"); return; }
    const others = state.places.filter((place) => place.key !== editing.key)
      .map((place) => (editing.home ? { ...place, home: false } : place));
    const ordered = editing.key === null ? [...others, editing]
      : state.places.map((place) => (place.key === editing.key ? editing : others.find((other) => other.key === place.key)));
    send(ordered);
  });
  byId("delete").addEventListener("click", () => {
    if (!window.confirm(fill(T.confirmDelete, { name: editing.name }))) return;
    send(state.places.filter((place) => place.key !== editing.key));
  });

  let searching = null;
  byId("search").addEventListener("input", (event) => {
    clearTimeout(searching);
    searching = setTimeout(async () => {
      const list = byId("towns"); list.replaceChildren();
      const text = event.target.value.trim();
      if (!text) return;
      const response = await fetch(paths.search, { method: "POST", headers: { "Content-Type": "application/json" },
                                                  body: JSON.stringify({ text }) }).catch(() => null);
      if (!response || !response.ok) { status(T.offline, "error"); return; }
      const towns = await response.json();
      if (!towns.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noTown; list.append(li); }
      for (const town of towns) {
        item(list, `${town.name} — ${[town.region, town.country].filter(Boolean).join(", ")}`,
             () => map.setView([town.latitude, town.longitude], TOWN_ZOOM));
      }
    }, 250);
  });

  async function searchOsm() {
    const text = byId("search").value.trim();
    const list = byId("areas"), button = byId("osmButton");
    list.replaceChildren();
    if (!text) { status(T.osmType, "error"); return; }
    button.disabled = true; status(T.osmSearching);
    try {
      const response = await fetch(paths.osm, { method: "POST", headers: { "Content-Type": "application/json" },
                                                body: JSON.stringify({ text }) }).catch(() => null);
      if (!response) { status(T.offline, "error"); return; }
      const answer = await response.json().catch(() => ({}));
      if (!response.ok) { status(answer.error || fill(T.failed, { status: response.status }), "error"); return; }
      status("");
      if (!answer.areas.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.osmNone; list.append(li); }
      for (const found of answer.areas) {
        item(list, `${found.name} (${found.kind}) — ${found.label}`,
             () => edit({ ...blank, name: found.name, latitude: found.latitude, longitude: found.longitude,
                          osm: found.osm, area: found.area }));
      }
      if (answer.too_large) { const li = document.createElement("li"); li.className = "muted"; li.textContent = fill(T.osmTooLarge, { count: answer.too_large }); list.append(li); }
    } finally { button.disabled = false; }
  }
  if (paths.osm) {
    byId("osmButton").addEventListener("click", searchOsm);
    byId("search").addEventListener("keydown", (event) => { if (event.key === "Enter") { event.preventDefault(); searchOsm(); } });
  }

  fetch(paths.state).then((response) => response.json()).then((answer) => {
    state = answer;
    // Open while there are few places; the reader's own choice wins.
    byId("placesFold").open = folds.placesFold ?? state.places.length < FOLDED_FROM;
    byId("clustersFold").open = folds.clustersFold ?? true;
    byId("foldersFold").open = folds.foldersFold ?? true;
    draw(); loadFolders();
    const points = [...state.clusters.map((c) => [c[0], c[1]]), ...state.places.map((p) => [p.latitude, p.longitude])];
    if (points.length) map.fitBounds(L.latLngBounds(points).pad(0.1), { maxZoom: NAMED_ZOOM });
  }).catch(() => status(T.offline, "error"));
})();
</script>
{% include "home_link.html.j2" %}
</body>
</html>

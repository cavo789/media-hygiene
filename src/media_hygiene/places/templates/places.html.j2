{% set page_name = _("Your places") %}
{% set keys_safe = _("Done? Ctrl+C in the terminal stops the map. Then add a 'place' rule (and a 'trip' rule) to [[classify.rules]] and run 'classify'.") %}
{% block head %}
<link rel="stylesheet" href="leaflet.css">
{% endblock %}
{% block style %}
{% include "places.css.j2" %}
{% endblock %}
{% block side %}
{% include "places_side.html.j2" %}
{% endblock %}
{% block keys %}
    <dt><kbd>Esc</kbd></dt><dd>{{ _("close the large photo, then the photos of the place") }}</dd>
    <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>{{ _("opened: the previous or next one") }}</dd>
{% if osm_path %}
    <dt><kbd>Enter</kbd></dt><dd>{{ _("in the search box: search OpenStreetMap") }}</dd>
{% endif %}
    <dt><kbd>N</kbd> <kbd>P</kbd></dt><dd>{{ _("a folder opened: the next or previous one of its list (← → too)") }}</dd>
    <dt><kbd>Enter</kbd></dt><dd>{{ _("a folder opened: save its position") }}</dd>
    <dt><kbd>Esc</kbd></dt><dd>{{ _("in a filter box: empty it") }}</dd>
{% endblock %}
{% block bar %}
  <span id="status" role="status" aria-live="polite"></span>
{% endblock %}
{% block content %}
<main id="stage">
{% include "places_stage.html.j2" %}
</main>
{% include "undo_toast.html.j2" %}
{% endblock %}
{% block after %}
<script nonce="{{ page_nonce }}" src="leaflet.js"></script>
<script nonce="{{ page_nonce }}">
{% include "places_map.js.j2" %}
{% include "places_list.js.j2" %}
{% include "places_edit.js.j2" %}
})();
</script>
{% endblock %}

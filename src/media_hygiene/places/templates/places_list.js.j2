  // The folders named after a town, or placed: their photos without GPS, a pin to drag.
  let folders = [], ignored = [], folderFlash = null;
  // The lines each list shows now (filter and order kept): "next" walks them (0340).
  let shownTodo = [], shownPlaced = [];
  // The folders of one town (0383): one line, one pin, one save; ▸ unfolds them.
  let groups = [];
  const groupsOpen = new Set();
  function townLines(seen) {
    const grouped = new Set(), lines = [];
    for (const group of groups) {
      const members = group.folders.map((rank) => folders[rank]);
      members.forEach((folder) => grouped.add(folder.rank));
      if (!members.some((folder) => seen.includes(folder))) continue;
      const first = members[0];
      lines.push({ folder: `town:${folded(first.town)}|${first.country}`, town: first.town, country: first.country,
                   latitude: group.latitude, longitude: group.longitude, found: true, members, group: group.rank,
                   saved: members.every((folder) => folder.saved), positions: group.positions,
                   count: members.reduce((sum, folder) => sum + folder.count, 0),
                   videos: members.reduce((sum, folder) => sum + folder.videos, 0) });
    }
    return [...lines, ...seen.filter((folder) => !grouped.has(folder.rank))];
  }
  const filesOf = (folder) => holds(folder.count - folder.videos, folder.videos);
  // The name a folder line shows: its town, else its last folder name.
  const folderName = (folder) => folder.town || lastName(folder.folder);
  const byFolderName = (first, second) =>
    collator.compare(folderName(first), folderName(second)) || first.folder.localeCompare(second.folder);
  // The folders typed for: the name shown and the host path, case and accents ignored.
  const folderMatches = (folder, typed) => !typed || folded(`${folderName(folder)}\n${folder.folder}`).includes(typed);
  const countOf = (shown, total) => (shown === total ? `(${total})` : `(${shown} / ${total})`);
  function drawFolders() {
    const typed = folded(byId("folderFilter").value.trim());
    // A copy is sorted: `folders` keeps the server's order, whose index is the rank the API names.
    const seen = townLines(folders.filter((folder) => folderMatches(folder, typed)));
    const placed = seen.filter((folder) => folder.saved).sort(byFolderName);
    // Saved but not found (renamed, moved): at the top of "Placed", where they are seen.
    const lines = [["foldersTodo", seen.filter((folder) => !folder.saved).sort(byFolderName), "todoFold"],
                   ["foldersPlaced", [...placed.filter((f) => !f.found), ...placed.filter((f) => f.found)], "placedFold"]];
    const every = townLines(folders);
    const total = [every.filter((folder) => !folder.saved).length, every.filter((folder) => folder.saved).length];
    byId("foldersCount").textContent = countOf(seen.length, every.length);
    shownTodo = lines[0][1]; shownPlaced = lines[1][1];
    lines.forEach(([id, rows, fold], index) => {
      const list = byId(id); list.replaceChildren();
      byId(fold.replace("Fold", "Count")).textContent = countOf(rows.length, total[index]);
      if (!rows.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = folders.length ? T.noMatch : T.noFolder; list.append(li); }
      for (const folder of rows) drawFolder(list, folder, fold);
    });
    folderFlash = null;
    highlight();
  }
  // The words after a line's name: its files, and for a town its folders and positions.
  function lineText(folder) {
    const words = [fill(T.withoutGps, { files: filesOf(folder) })];
    if (folder.members) words.push(counted(T.folderCount, folder.members.length));
    if (folder.positions > 1) words.push(counted(T.positionCount, folder.positions));
    return `${folderName(folder)} — ${words.join(" · ")}`;
  }
  function drawFolder(list, folder, fold) {
    const mark = !folder.found ? "⚠ " : folder.saved ? "📌 " : "📁 ";
    const li = item(list, `${mark}${lineText(folder)}`, () => showFolder(folder));
    li.title = folder.folder; li.dataset.drawer = `folder:${folder.folder}`; li.classList.add("folder");
    if (!folder.found) li.classList.add("missing");
    // A town guess only: a position saved (📌) is the user's, forgotten in the drawer.
    if (folder.town && !folder.saved) tail(li, "✕", T.notTown, () => ignoreName(folder.members ? folder.members[0] : folder));
    if (folder.folder === folderFlash) { unfold("foldersFold"); unfold(fold); flash(li); }
    if (folder.members) drawTown(list, li, folder);
  }
  // A town's line: ▸ before it, its folders below it when unfolded, each openable alone.
  function drawTown(list, li, town) {
    li.title = town.members.map((folder) => folder.folder).join("\n");
    const open = groupsOpen.has(town.folder), toggle = document.createElement("button");
    toggle.type = "button"; toggle.className = "toggle"; toggle.textContent = open ? "▾" : "▸";
    toggle.title = T.showFolders; toggle.setAttribute("aria-label", T.showFolders); toggle.setAttribute("aria-expanded", String(open));
    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      if (groupsOpen.has(town.folder)) groupsOpen.delete(town.folder); else groupsOpen.add(town.folder);
      drawFolders();
    });
    li.prepend(toggle);
    if (!open) return;
    const holder = document.createElement("li"), below = document.createElement("ul");
    holder.className = "town-folders"; holder.append(below); list.append(holder);
    for (const folder of town.members) {
      const line = item(below, `${folder.saved ? "📌 " : "📁 "}${folder.folder} — ${fill(T.withoutGps, { files: filesOf(folder) })}`, () => showFolder(folder));
      line.title = folder.folder; line.dataset.drawer = `folder:${folder.folder}`; line.classList.add("folder");
    }
  }
  byId("folderFilter").addEventListener("input", drawFolders);
  byId("folderFilter").addEventListener("keydown", (event) => {
    if (event.key === "Escape" && byId("folderFilter").value) { event.stopPropagation(); byId("folderFilter").value = ""; drawFolders(); }
  });
  // Every place the photos were taken on screen (0339): the clusters, the places, the folders
  // placed by hand, beside the drawer; a point at exactly 0, 0 (a camera writing an empty GPS
  // as zeros) is drawn but left out, or the world would show. ⤢ brings it back.
  const unknownSpot = ([lat, lon]) => Math.abs(lat) < 1e-9 && Math.abs(lon) < 1e-9;
  function frame() {
    const points = [
      ...state.clusters.map((c) => [c[0], c[1]]),
      ...state.places.map((p) => [p.latitude, p.longitude]),
      ...folders.filter((folder) => folder.saved).map((folder) => [folder.latitude, folder.longitude]),
    ].filter((point) => !unknownSpot(point));
    map.invalidateSize();
    if (points.length) map.fitBounds(L.latLngBounds(points).pad(0.1), { maxZoom: NAMED_ZOOM, paddingBottomRight: [hidden(), 0] });
  }
  const ShowAll = L.Control.extend({
    options: { position: "topleft" },
    onAdd() {
      const bar = L.DomUtil.create("div", "leaflet-bar");
      const button = L.DomUtil.create("button", "show-all", bar);
      button.type = "button"; button.textContent = "⤢"; button.title = T.showAll;
      button.setAttribute("aria-label", T.showAll);
      L.DomEvent.disableClickPropagation(bar);
      button.addEventListener("click", frame);
      return bar;
    },
  });
  new ShowAll().addTo(map);
  async function loadFolders() {
    const response = await fetch(paths.folders).catch(() => null);
    if (!response || !response.ok) return;
    const answer = await response.json();
    gotFolders(answer);
  }
  // Every list the folders' answer feeds: the town folders, the names set aside, the tree.
  function gotFolders(answer) {
    folders = answer.folders; groups = answer.groups || []; ignored = answer.ignored || []; tree = answer.tree || [];
    drawFolders(); drawAside(); drawTree();
  }
  // Léo is the cat (0235): the name goes into folder_town_ignore, its line leaves the list.
  async function ignoreName(folder) {
    const name = lastName(folder.folder);
    const answer = await post(paths.folder, { action: "ignore", folder: folder.folder });
    if (!answer) return;
    if (opened && opened.folder) closeDrawer();
    gotFolders(answer);
    const gone = !folders.some((other) => other.folder === folder.folder);
    status(gone ? fill(T.nameIgnored, { name }) : T.notSaved, gone ? "saved" : "error");
  }
  async function restoreName(name) {
    const answer = await post(paths.folder, { action: "restore", folder: name });
    if (!answer) return;
    gotFolders(answer);
    const still = ignored.includes(name);
    status(still ? T.notSaved : fill(T.nameRestored, { name }), still ? "error" : "saved");
  }
  // What was set aside: the clusters' circles (0234) and the names that are no town (0235).
  function drawAside() {
    const list = byId("aside"); list.replaceChildren();
    const spots = state.aside || [];
    byId("asideCount").textContent = `(${spots.length + ignored.length})`;
    if (!spots.length && !ignored.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noAside; list.append(li); }
    for (const spot of spots) {
      const files = spot.pictures + spot.videos ? holds(spot.pictures, spot.videos) : T.asideEmpty;
      const li = item(list, `✕ ${files}`, () => {
        if (spot.cluster >= 0) showCluster(spot.cluster); else focus([spot.latitude, spot.longitude], NAMED_ZOOM);
      });
      li.classList.add("aside");
      if (spot.cluster >= 0) li.dataset.drawer = `cluster:${spot.cluster}`;
      tail(li, T.restore, T.restore, () => restoreSpot(spot));
    }
    for (const name of ignored) {
      const li = document.createElement("li"), text = document.createElement("span");
      li.className = "aside"; text.textContent = fill(T.asideName, { name }); li.append(text); list.append(li);
      tail(li, T.restore, T.restore, () => restoreName(name));
    }
    highlight();
  }
  // A folder's line, or a town's (its folders' photos, one pin for all of them).
  function showFolder(folder) {
    const key = `folder:${folder.folder}`;
    if (opened && opened.key === key) { closeDrawer(); return; }
    const forget = folder.members ? folder.members.some((one) => one.saved) : folder.saved;
    const actions = { clusterName: false, clusterAside: false, giveTo: false,
                      folderSave: folder.found, folderForget: forget, folderIgnore: Boolean(folder.town) };
    const url = folder.members ? paths.groupPhotos + folder.group : paths.folderPhotos + folder.rank;
    openDrawer({ key, url, at: [folder.latitude, folder.longitude], zoom: TOWN_ZOOM,
                 pictures: folder.count - folder.videos, videos: folder.videos, folder, actions,
                 title: lineText(folder),
                 note: folder.found ? T.folderHint : T.folderMissing });
  }
  async function actOnFolder(action, said) {
    const chosen = opened && opened.folder;
    if (!chosen) return;
    const where = folderPin ? folderPin.getLatLng() : { lat: chosen.latitude, lng: chosen.longitude };
    status(T.saving);
    let response;
    try {
      response = await fetch(paths.folder, { method: "POST", headers: { "Content-Type": "application/json" },
                                             body: JSON.stringify({ action, folder: (chosen.members ? chosen.members[0] : chosen).folder,
                                                                    together: chosen.members ? chosen.members.map((one) => one.folder) : [],
                                                                    latitude: where.lat, longitude: where.lng }) });
    } catch (error) { status(T.offline, "error"); return; }
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) { status(answer.error || fill(T.failed, { status: response.status }), "error"); return; }
    // A save sends no eye to "Placed" (0340): the next folder to place opens instead.
    const before = shownTodo, at = before.findIndex((folder) => folder.folder === chosen.folder);
    folderFlash = action === "forget" ? chosen.folder : null;
    closeDrawer(); gotFolders(answer);
    if (action === "forget" || at < 0) { status(said, "saved"); return; }
    const left = new Set(shownTodo.map((folder) => folder.folder));
    const next = [...before.slice(at + 1), ...before.slice(0, at)].find((folder) => left.has(folder.folder));
    const fresh = next && shownTodo.find((folder) => folder.folder === next.folder);
    if (!fresh) { status(fill(T.nothingLeft, { said }), "saved"); return; }
    openFolderLine(fresh);
    status(fill(counted(T.savedNext, shownTodo.length), { said, name: folderName(fresh) }), "saved");
  }
  // Open a folder of a list and bring its line into view.
  function openFolderLine(folder) {
    showFolder(folder);
    const li = [...document.querySelectorAll("li[data-drawer]")].find((line) => line.dataset.drawer === `folder:${folder.folder}`);
    if (li) li.scrollIntoView({ block: "nearest" });
  }
  // N / → and P / ← walk the list of the folder opened; Enter saves it.
  function folderKey(event) {
    const chosen = opened.folder, key = event.key.toLowerCase();
    if (key === "enter") { if (event.target.closest?.("#drawer button")) return false; if (chosen.found) actOnFolder("save", T.folderSaved); return true; }
    const step = key === "n" || key === "arrowright" ? 1 : key === "p" || key === "arrowleft" ? -1 : 0;
    if (!step || event.ctrlKey || event.metaKey || event.altKey) return false;
    const list = chosen.saved ? shownPlaced : shownTodo, at = list.findIndex((folder) => folder.folder === chosen.folder);
    if (at < 0 || list.length < 2) return true;
    openFolderLine(list[(at + step + list.length) % list.length]);
    return true;
  }
  byId("folderSave").addEventListener("click", () => actOnFolder("save", T.folderSaved));
  byId("folderForget").addEventListener("click", () => actOnFolder("forget", T.folderForgotten));
  byId("folderIgnore").addEventListener("click", () => actOnFolder("ignore", T.folderIgnored));

  // Any folder of the index (0242), as `browse` shows them: the mounted folders open, the
  // rest closed; what the reader opens stays open when an answer draws the tree again.
  let tree = [];
  const treeOpen = new Set(), treeTops = new Set();  // the folders open; the tops seen once
  const listedAs = (node) => folders.find((folder) => folder.folder === node.folder);
  const treeFiles = (node) => (node.count ? fill(T.withoutGps, { files: holds(node.count - node.videos, node.videos) }) : T.allLocated);
  function treeNode(node, children, flat) {
    const li = document.createElement("li"), line = document.createElement("div");
    const toggle = document.createElement("button"), button = document.createElement("button");
    const below = flat ? [] : children.get(node.folder) || [];
    const known = listedAs(node), mark = known && known.saved ? (known.found ? "📌 " : "⚠ ") : "📁 ";
    line.className = "tree-line"; toggle.type = "button"; toggle.className = "toggle";
    button.type = "button"; button.className = "link"; button.title = node.folder;
    button.textContent = `${mark}${flat ? node.folder : node.name} — ${treeFiles(node)}`;
    if (node.count) button.addEventListener("click", () => showTreeFolder(node));
    else li.classList.add("none");
    li.dataset.drawer = `folder:${node.folder}`;
    line.append(toggle, button); li.append(line);
    if (below.length) {
      const list = document.createElement("ul");
      list.append(...below.map((child) => treeNode(child, children, false)));
      const shut = () => { list.hidden = !treeOpen.has(node.folder); toggle.textContent = list.hidden ? "▸" : "▾"; };
      toggle.addEventListener("click", () => { treeOpen.has(node.folder) ? treeOpen.delete(node.folder) : treeOpen.add(node.folder); shut(); });
      shut(); li.append(list);
    }
    return li;
  }
  function drawTree() {
    const typed = folded(byId("treeFilter").value.trim()), list = byId("tree");
    for (const node of tree) {
      if (node.parent === null && !treeTops.has(node.folder)) { treeTops.add(node.folder); treeOpen.add(node.folder); }
    }
    // Typed for: the folders whose name or path matches, flat, their path shown.
    const seen = typed ? tree.filter((node) => folded(`${node.name}\n${node.folder}`).includes(typed)) : tree;
    byId("treeCount").textContent = countOf(seen.length, tree.length);
    const children = new Map();
    for (const node of tree) { if (!children.has(node.parent)) children.set(node.parent, []); children.get(node.parent).push(node); }
    const tops = typed ? seen : children.get(null) || [];
    list.replaceChildren(...tops.map((node) => treeNode(node, children, Boolean(typed))));
    if (!tops.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = tree.length ? T.noMatch : T.noTree; list.append(li); }
    highlight();
  }
  // A folder of the town list opens as there; any other, its pin in the middle of the map.
  function showTreeFolder(node) {
    const known = listedAs(node);
    if (known) { showFolder(known); return; }
    const key = `folder:${node.folder}`;
    if (opened && opened.key === key) { closeDrawer(); return; }
    const centre = map.getCenter();
    const folder = { folder: node.folder, town: "", latitude: centre.lat, longitude: centre.lng, saved: false, found: true };
    const actions = { clusterName: false, clusterAside: false, giveTo: false,
                      folderSave: true, folderForget: false, folderIgnore: false };
    openDrawer({ key, url: paths.tree + node.rank, at: [centre.lat, centre.lng], zoom: map.getZoom(),
                 pictures: node.count - node.videos, videos: node.videos, folder, actions,
                 title: `${node.name} — ${treeFiles(node)}`, note: T.treeHint });
  }
  byId("treeFilter").addEventListener("input", drawTree);
  byId("treeFilter").addEventListener("keydown", (event) => {
    if (event.key === "Escape" && byId("treeFilter").value) { event.stopPropagation(); byId("treeFilter").value = ""; drawTree(); }
  });

  function draw() {
    clusterLayer.clearLayers(); placeLayer.clearLayers();
    for (const [lat, lon, pictures, filmed, place, aside] of state.clusters) {
      if (aside >= 0 || !(pictures + filmed)) continue;  // set aside, or every photo given a place
      const what = holds(pictures, filmed);
      const circle = L.circleMarker([lat, lon], {
        radius: 4 + 3 * Math.log2(pictures + filmed), weight: 1, fillOpacity: 0.45,
        color: place ? colour("--muted") : colour("--cluster"),
      });
      circle.bindTooltip(label(place ? `${what}, ${fill(T.inPlace, { place })}` : what));
      circle.on("click", (event) => { L.DomEvent.stopPropagation(event); startNew(lat, lon); });
      circle.addTo(clusterLayer);
    }
    for (const place of state.places) {
      const style = { radius: place.radius_m, color: colour("--place"), weight: 2 };
      const circle = place.area ? L.polygon(place.area, style) : L.circle([place.latitude, place.longitude], style);
      const hand = place.hand && place.hand.length ? ` ${counted(T.handCount, place.hand.length)}` : "";
      circle.bindTooltip(label(`${place.home ? "🏠 " : ""}${place.name}${hand}`), { permanent: true, className: "place-name" });
      circle.on("click", (event) => { L.DomEvent.stopPropagation(event); edit(place); });
      circle.addTo(placeLayer);
    }
    const places = byId("places"); places.replaceChildren();
    if (!state.places.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noPlace; places.append(li); }
    // Home first, then by name; `state.places` keeps the file's order (a place's key is its rank there).
    const sorted = [...state.places].sort((first, second) => Number(second.home) - Number(first.home) || collator.compare(first.name, second.name));
    for (const place of sorted) {
      const li = item(places, (place.home ? "🏠 " : "📍 ") + place.name, () => edit(place));
      if (place.town) {  // the same sentence as the editor's hint
        const mark = document.createElement("span");
        mark.textContent = " ⓘ"; mark.className = "muted"; mark.title = fill(T.townHint, { town: place.town });
        li.firstChild.append(mark);
      }
      if (place.name === flashName) { unfold("placesFold"); flash(li); }
    }
    flashName = null;
    byId("placesCount").textContent = `(${state.places.length})`;
    const clusters = byId("clusters"); clusters.replaceChildren();
    const unnamed = state.clusters.map((cluster, rank) => [rank, ...cluster])
      .filter((cluster) => !cluster[5] && cluster[6] < 0 && cluster[3] + cluster[4] > 0);
    byId("clustersCount").textContent = `(${unnamed.length})`;
    if (!unnamed.length) { const li = document.createElement("li"); li.className = "muted"; li.textContent = T.noCluster; clusters.append(li); }
    for (const [rank, lat, lon, pictures, filmed] of unnamed.slice(0, SHOWN_CLUSTERS)) {
      const li = item(clusters, `● ${T.nameIt}`, () => startNew(lat, lon));
      li.classList.add("cluster"); li.dataset.drawer = `cluster:${rank}`;
      const button = document.createElement("button");
      button.type = "button"; button.className = "count";
      button.textContent = `${pictures ? "🖼" : "🎞"} ${holds(pictures, filmed)}`;
      button.title = T.showPhotos;
      button.addEventListener("click", () => showCluster(rank));
      li.prepend(button);
      tail(li, "✕", T.setAside, () => setAside(lat, lon));
    }
    drawAside();
  }

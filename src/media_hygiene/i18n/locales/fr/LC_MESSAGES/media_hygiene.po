msgid "'{key}' in the variable {name}"
msgstr "« {key} » dans la variable {name}"

#, python-brace-format
msgid "'{key}' in {table} of config.toml"
msgstr "« {key} » dans {table} de config.toml"

#, python-brace-format
msgid "'{key}' on the command line"
msgstr "« {key} » sur la ligne de commande"


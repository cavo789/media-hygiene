msgstr "Code d'appairage"

msgid "Parties"
msgstr "Fêtes"

#, python-brace-format
msgid "Password of {share} (asked once, never shown)"
msgstr "Mot de passe de {share} (demandé une fois, jamais affiché)"

msgid "Past the safety stop."
msgstr "Passer outre l'arrêt de sécurité."

msgid ""
"Paste it in the terminal where you ran the audit (PowerShell or bash, as "

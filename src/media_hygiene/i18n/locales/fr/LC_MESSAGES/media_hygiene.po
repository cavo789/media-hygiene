msgstr ""
"Collez-la dans le terminal où vous avez lancé l'audit (PowerShell ou "
"bash, tel qu'écrit)."

msgid "Path"
msgstr "Chemin"

msgid "Path contains"
msgstr "Le chemin contient"

msgid "People"

msgstr "Ce qui a déjà été fait est dans le journal : 'undo' le remet en place."

msgid "What you can do"
msgstr "Ce que vous pouvez faire"

#, python-brace-format
msgid "What {file} holds for this group"
msgstr "Ce que {file} contient pour ce groupe"


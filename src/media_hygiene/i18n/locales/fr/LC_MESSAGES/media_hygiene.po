msgid "Not touched by this clean"
msgstr "Laissé par ce nettoyage"

msgid "Not touched by this clean (decide later, if you want)"
msgstr "Laissé par ce nettoyage (à décider plus tard, si vous voulez)"

#, python-brace-format

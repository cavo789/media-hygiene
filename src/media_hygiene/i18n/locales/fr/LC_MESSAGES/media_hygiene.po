msgstr ""
"Tapez le code affiché sur le PC : sur sa page (dans la barre latérale de "
"la page d'accueil, en haut de celle du diaporama) et dans la fenêtre de "
"Média Hygiène."

msgid "Type the event's name first."
msgstr "Tapez d'abord le nom de l'événement."

#, python-brace-format
msgid "Type {command}: your browser shows every report."
msgstr "Tapez {command} : votre navigateur montre tous les rapports."

msgid ""
"Unanswered: nothing is remembered. D: deleted on purpose, M: moved "
"elsewhere, G: the whole group deleted on purpose."
msgstr ""
"Sans réponse : rien n'est retenu. D : supprimé exprès, M : déplacé "
"ailleurs, G : tout le groupe supprimé exprès."

msgid "Undated"
msgstr "Sans date"

msgid "Undecided: 'clean' does as planned, the copies of the second folder go."
msgstr ""
"Non décidée : 'clean' fait comme prévu, les copies du second dossier "
"partent."

msgid ""
"Undecided: nothing moves. → sets aside the photos marked, Space keeps or "
"sets aside the photo under the cursor."
msgstr ""
"Non décidé : rien ne bouge. → met de côté les photos marquées, Espace "
"garde ou met de côté la photo sous le curseur."


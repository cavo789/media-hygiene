msgstr "Annulation de l'exécution {command} {run_id}"

#, python-brace-format
msgid "Undo the {count} run left of the sort"
msgid_plural "Undo the {count} runs of the sort"
msgstr[0] "Annulation du {count} passage restant du tri"
msgstr[1] "Annulation des {count} passages du tri"

#, python-brace-format
msgid "Undo this run and move {moved} files back?"
msgid_plural "Undo these {count} runs and move {moved} files back?"
msgstr[0] "Annuler ce passage et remettre {moved} fichiers en place ?"
msgstr[1] "Annuler ces {count} passages et remettre {moved} fichiers en place ?"


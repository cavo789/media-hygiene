#, python-brace-format
msgid ""
"Page ready, open {url} in your browser. Each choice is saved at once in "
"{place}. Nothing leaves the phone before you press Delete."
msgstr ""
"Page prête, ouvrez {url} dans votre navigateur. Chaque choix est "
"enregistré aussitôt dans {place}. Rien ne quitte le téléphone avant que "
"vous appuyiez sur Supprimer."

msgid "Page stopped; nothing was changed."
msgstr "Page arrêtée ; rien n'a été modifié."

#, python-brace-format
msgid "Page {page} of {pages}"
msgstr "Page {page} sur {pages}"

msgid "Pair the TV"
msgstr "Appairer la télé"


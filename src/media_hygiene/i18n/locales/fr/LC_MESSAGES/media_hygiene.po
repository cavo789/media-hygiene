msgstr "-v \"<un de vos dossiers>:/reports\" (rapports HTML)"

msgid "-v \"<a folder of yours>:/reports\" (the workbook to edit)"
msgstr "-v \"<un de vos dossiers>:/reports\" (le classeur à modifier)"

msgid "-v media-hygiene-cache:/cache (much faster next audits)"
msgstr "-v media-hygiene-cache:/cache (prochains audits bien plus rapides)"


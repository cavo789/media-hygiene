msgid "'{name}' is longer than {count} characters."
msgstr "« {name} » dépasse {count} caractères."

#, python-brace-format
msgid "'{name}' is not a folder name Windows accepts"
msgstr "« {name} » n'est pas un nom de dossier accepté par Windows"

#, python-brace-format
msgid "'{name}' is not a folder name Windows accepts."
msgstr "« {name} » n'est pas un nom de dossier que Windows accepte."


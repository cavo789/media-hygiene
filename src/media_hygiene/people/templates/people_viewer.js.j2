{# The large view of the people page: the shared one (`pick_viewer.html.j2`, its look and its
   `?` list) driven by this page's faces instead of a grid of files. A click on a face opens its
   photo; ← → Home End go through the faces of the same section, Delete sets the one photo
   shown aside (its faces not remembered as someone's) then shows the next face not set aside,
   at the end the previous one, none left closes the view (as the shared large view);
   Backspace takes it back and the view stays on it; F full screen, I the photo's path, ? every key, Esc,
   a click beside it or Back closes it (0666). A button under it does what Delete or Backspace
   does, for a mouse. #}
let viewing = null; // { list: [{ item, aside }], at }: the faces the view goes through
const viewerToggle = element("button", "stay");
viewerToggle.id = "viewerToggle";
viewerToggle.type = "button";
viewerToggle.hidden = true;
$("viewerSaid").before(viewerToggle);
const viewerNamer = element("div", "stay");
viewerNamer.id = "viewerNamer";
viewerToggle.after(viewerNamer);
$("personLink").remove(); // the people page is the place for a person; no `/person` here
$("movie").remove(); // a face is on a photo, never on a video

function viewerOpen() {
  return $("viewer").classList.contains("open");
}

function shownFace() {
  return viewing ? viewing.list[viewing.at] : null;
}

function drawViewer() {
  const face = shownFace();
  if (!face) return;
  $("large").src = PHOTO + face.item.key + ".jpg";
  $("large").alt = face.item.photo;
  $("viewerName").textContent = face.item.photo;
  $("originalLink").href = PHOTO + face.item.key + ".jpg";
  $("viewerInfo").textContent = face.item.photo;
  $("viewerAside").hidden = !face.aside;
  viewerToggle.hidden = !state.can_aside;
  viewerToggle.textContent = face.aside ? TEXTS.photoBack : TEXTS.photoAside;
  // "Not <name>, this face is… [combo]" (0712): saved, the view goes on with the next face.
  const named = state.writable && !face.aside && face.source !== undefined;
  viewerNamer.replaceChildren(...(named ? [faceNamer([face.item.key], face.source, () => viewerNamed(face))] : []));
}

// A face named from the large view leaves the faces it goes through.
function viewerNamed(face) {
  const at = viewing.list.indexOf(face);
  if (at >= 0) viewing.list.splice(at, 1);
  if (!viewing.list.length) { closeViewer(); return; }
  viewerAt(Math.min(at, viewing.list.length - 1));
}

// Opening pushes a step of the history: Back closes the view, as Esc (0666).
function openViewer(item, list) {
  const at = list.findIndex((one) => one.item.key === item.key);
  viewing = { list: at < 0 ? [{ item: item, aside: false }] : list, at: Math.max(at, 0) };
  $("viewerSaid").textContent = "";
  drawViewer();
  if (!viewerOpen()) window.mhView.set({}, { push: true, state: { mhViewer: true } });
  $("viewer").classList.add("open");
}

function closeViewer() {
  if (window.history.state && window.history.state.mhViewer) { window.history.back(); return; }
  closeShown();
}

function closeShown() {
  if (document.fullscreenElement) document.exitFullscreen().catch(() => undefined);
  $("viewer").classList.remove("open");
}
window.addEventListener("popstate", () => { if (viewerOpen()) closeShown(); });

function viewerAt(at) {
  if (!viewing || at < 0 || at >= viewing.list.length) return;
  viewing.at = at;
  $("viewerSaid").textContent = "";
  drawViewer();
}

// The nearest face from `from` not set aside, going `step` ways; -1 when there is none.
function viewerNotAside(from, step) {
  for (let at = from + step; at >= 0 && at < viewing.list.length; at += step) {
    if (!viewing.list[at].aside) return at;
  }
  return -1;
}

// One photo, its faces not someone's to remember: set aside, or taken back. Taken back, the
// view stays; set aside, it steps to the next face, else the previous one, else closes.
async function viewerChoice(action) {
  const face = shownFace();
  if (!face || !state.can_aside || face.aside === (action === "add")) return;
  const body = { action: action, faces: [face.item.key], remember: false };
  const result = await send(body, ASIDE_PATH);
  if (!result) return;
  face.aside = action === "add";
  if (action === "add") {
    const before = viewerNotAside(viewing.at, -1);  // as the shared large view (0517)
    const shown = before >= 0 ? before : viewerNotAside(viewing.at, 1);
    if (shown < 0) { closeViewer(); return; }
    viewerAt(shown);
  } else {
    drawViewer();
  }
  $("viewerSaid").textContent = result.aside.message;
}

function viewerFull() {
  if (document.fullscreenElement) document.exitFullscreen().catch(() => undefined);
  else $("viewer").requestFullscreen().catch(() => undefined);
}

const VIEWER_KEYS = {
  Escape: closeViewer,
  ArrowRight: () => viewerAt(viewing.at + 1),
  ArrowLeft: () => viewerAt(viewing.at - 1),
  Home: () => viewerAt(0),
  End: () => viewerAt(viewing.list.length - 1),
  Delete: () => viewerChoice("add"),
  Backspace: () => viewerChoice("remove"),
  f: viewerFull,
  i: () => { $("viewerInfo").hidden = !$("viewerInfo").hidden; },
  "?": () => { $("viewerHelp").hidden = !$("viewerHelp").hidden; },
};

function viewerKey(event) {
  if (event.ctrlKey || event.metaKey || event.altKey) return;
  const action = VIEWER_KEYS[event.key.length === 1 ? event.key.toLowerCase() : event.key] || VIEWER_KEYS[event.key];
  if (!action) return;
  event.preventDefault();
  action();
}

$("viewer").addEventListener("click", (event) => {
  if (!event.target.closest("a, .stay")) closeViewer(); // the lists under it stay open
});
viewerToggle.addEventListener("click", () => {
  const face = shownFace();
  viewerChoice(face && face.aside ? "remove" : "add");
});

{# The script of the people page (`people.html.j2`), first part: the state, the folding of
   the sections (remembered in this browser), what is asked of the server and saved, the
   naming, the faces and their × marks. `people_sections.js.j2` draws the sections and holds
   the keys; `people_viewer.js.j2` drives the shared large view (`pick_viewer.html.j2`). #}
const FOLDED_KEY = "mh-people-folded-2"; // -2: choosing a person had unfolded its ✓ sections for good
const STRIP = {{ strip | tojson }};
const CHANGE_PATH = {{ change_path | tojson }};
const ASIDE_PATH = {{ aside_path | tojson }};
const FACE = {{ face_prefix | tojson }};
const PHOTO = {{ photo_prefix | tojson }};
const $ = (id) => document.getElementById(id);
let state = { sections: [], people: [], writable: false };
let current = 0;
const picked = new Set();
const removed = new Set();
const whole = new Map(); // face number → every face of its group, once shown in full
const showing = new Set(); // sections whose hidden faces are drawn, by `sectionKey`
const outAlike = new Set(); // faces taken out of the look-alike sections by ×
let foldedSaved = {}; // `sectionKey` → folded, for the named sections (this browser only)
try { foldedSaved = JSON.parse(localStorage.getItem(FOLDED_KEY) || "{}") || {}; } catch (error) { foldedSaved = {}; }

// A section's key across changes: a person and a kind, or a group by one of its faces.
function sectionKey(item) {
  if (item.name) return item.name + (item.verified ? "|verified" : "|attributed");
  const first = item.shown[0] || item.hidden[0];
  return "#" + (first ? first.key : "");
}

function isFolded(item) {
  const key = sectionKey(item);
  return key in foldedSaved ? foldedSaved[key] : item.verified;
}

function fold(index) {
  const item = state.sections[index];
  foldedSaved[sectionKey(item)] = !isFolded(item);
  try { localStorage.setItem(FOLDED_KEY, JSON.stringify(foldedSaved)); } catch (error) { /* kept for this visit */ }
  if (!isFolded(item) && item.strip) return sample(index);
  redraw(index);
  return Promise.resolve();
}

// A folded section came as a strip: its sample is asked for when it opens.
async function sample(index) {
  const item = state.sections[index];
  if (!item.shown.length) { item.strip = false; redraw(index); return; }
  let answer;
  try {
    answer = await fetch(SAMPLE + item.shown[0].key);
  } catch (error) {
    say(TEXTS.offline, "error");
    return;
  }
  if (!answer.ok) {
    say(fill(TEXTS.failed, { status: answer.status }), "error");
    return;
  }
  if (state.sections[index] !== item) return; // a change came meanwhile
  item.shown = (await answer.json()).shown;
  item.strip = false;
  redraw(index);
}

// Draw one section again, keeping the name typed in it.
function redraw(index) {
  const before = $("groups").children[index];
  const after = group(state.sections[index], index);
  const typed = before && before.querySelector("input");
  const field = after.querySelector("input");
  if (typed && field) field.value = typed.value; // typed, not saved yet
  if (before) before.replaceWith(after);
}

function fill(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, name) => (name in values ? values[name] : all));
}

const PLURAL = new Intl.PluralRules(document.documentElement.lang);

// A counted fragment: its singular and plural forms, the one the language uses for n.
function counted(forms, n) {
  return fill(forms[PLURAL.select(n) === "one" ? 0 : 1], { n: n });
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

// The bar's line says what was saved, read back; a failure is also a toast that stays
// (`busy_say.html.j2`, the one stack of every page).
function say(text, kind) {
  $("status").className = kind || "";
  $("status").textContent = text;
  if (kind === "error" && window.mhSay) window.mhSay(text, "error");
}

// The faces a section shows: every one once asked for, else its sample.
function displayed(item) {
  const full = item.shown.map((face) => whole.get(face.key)).find(Boolean);
  return full || item.shown;
}

function complete(item) {
  return displayed(item).length >= item.faces;
}

function kept(index) {
  return displayed(state.sections[index]).map((item) => item.key).filter((key) => !removed.has(key));
}

async function expand(index) {
  const item = state.sections[index];
  let answer;
  try {
    answer = await fetch(SECTION + item.shown[0].key);
  } catch (error) {
    say(TEXTS.offline, "error");
    return;
  }
  if (!answer.ok) {
    say(fill(TEXTS.failed, { status: answer.status }), "error");
    return;
  }
  const faces = (await answer.json()).faces;
  for (const face of faces) whole.set(face.key, faces);
  render(true);
}

// After a change the groups are new: show again in full those that were.
function expandAgain() {
  const before = new Set(whole.keys());
  whole.clear();
  state.sections.forEach((item, index) => {
    if (item.faces > item.shown.length && item.shown.some((face) => before.has(face.key))) expand(index);
  });
}

function takeBack(keys) {
  if (keys.length) send({ action: "remove", faces: keys }, ASIDE_PATH);
}

async function setAside(index, action) {
  const item = state.sections[index];
  if (!complete(item)) await expand(index); // every photo of the group, not only the sample
  const label = item.name || fill(TEXTS.group, { number: index + 1 });
  const faces = kept(index);
  if (faces.length) send({ action, faces, label }, ASIDE_PATH);
}

async function send(body, path) {
  say(TEXTS.saving);
  let answer;
  try {
    answer = await fetch(path || CHANGE_PATH, {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
    });
  } catch (error) {
    say(TEXTS.offline, "error");
    return;
  }
  const result = await answer.json().catch(() => ({ error: fill(TEXTS.failed, { status: answer.status }) }));
  if (!answer.ok) {
    say(result.error, "error");
    return;
  }
  picked.clear();
  for (const key of [...(body.faces || []), ...(body.removed || [])]) { removed.delete(key); outAlike.delete(key); }
  show(result);
  const remembered = result.aside && result.aside.remembered ? " " + TEXTS.remembered : "";
  say((result.saved || result.aside.message) + remembered, "saved");
  return result;
}

function nameGroups(index, name) {
  const chosen = new Set([index, ...picked]);
  const faces = [...chosen].flatMap(kept);
  const out = [...chosen].flatMap((at) => displayed(state.sections[at]).map((item) => item.key))
    .filter((key) => removed.has(key));
  return faces.length ? send({ action: "name", name, faces, removed: out }) : Promise.resolve(undefined);
}

// × marks a face as someone else's, or puts it back: nothing is sent, nothing moves;
// the next button of the section saves the marks with what it does.
function takeOut(index, key) {
  if (removed.has(key)) removed.delete(key); else removed.add(key);
  redraw(index);
}

function marked(index) {
  return displayed(state.sections[index]).map((item) => item.key).filter((key) => removed.has(key));
}

// The faces of a section in the order drawn, for ← → in the large view: those shown, then
// those set aside when they are drawn (each with whether its photo is set aside).
function sectionFaces(index) {
  const item = state.sections[index];
  const shown = isFolded(item) ? item.shown.slice(0, STRIP) : displayed(item);
  const faces = shown.map((one) => ({ item: one, aside: false, source: item.name || "" }));
  if (!isFolded(item) && showing.has(sectionKey(item))) faces.push(...item.hidden.map((one) => ({ item: one, aside: true })));
  return faces;
}

// A face: `kind` is "strip" (a folded section: no ×), "hidden" (its photo set aside:
// dimmed, ↺ takes it back) or empty.
function face(item, index, verified, kind) {
  const box = element("div", "face" + (kind ? " " + kind : ""));
  const picture = element("img");
  picture.loading = "lazy";
  picture.src = FACE + item.key + ".jpg";
  picture.alt = item.photo;
  picture.title = item.photo;
  picture.addEventListener("click", (event) => {
    if (kind !== "strip" && kind !== "hidden" && pickFace(event, index, item.key, displayed(state.sections[index]).map((one) => one.key))) return;
    openViewer(item, sectionFaces(index));
  });
  if (kind === "strip") { box.append(picture); return box; }
  if (kind === "hidden") {
    const back = element("button", "", "↺");
    back.title = TEXTS.takeBackOne;
    back.setAttribute("aria-label", back.title);
    back.addEventListener("click", (event) => { event.stopPropagation(); takeBack([item.key]); });
    box.append(picture, back);
    return box;
  }
  const isOut = removed.has(item.key);
  box.classList.toggle("out", isOut);
  const out = element("button", "", isOut ? "↺" : "×");
  out.title = isOut ? TEXTS.putBack : TEXTS.remove;
  out.setAttribute("aria-label", out.title);
  out.addEventListener("click", (event) => { event.stopPropagation(); takeOut(index, item.key); });
  box.classList.toggle("chosen", facePicked(index, item.key));
  const one = element("button", "nameOne", "✎");
  one.title = TEXTS.nameOne;
  one.setAttribute("aria-label", one.title);
  one.disabled = !state.writable;
  one.addEventListener("click", (event) => { event.stopPropagation(); pickOneFace(index, item.key); });
  box.append(picture, out, one);
  if (verified) box.append(element("span", "check", "✓"));
  pathBadge(box, item, state.sections[index]); // people_path_names.js.j2
  return box;
}

<!DOCTYPE html>
{# The page of `media-hygiene people`: the people by name first, then the groups of
   faces alike, largest first, a few dozen faces each. Names are typed here and saved
   by the server into config.toml, read back and shown. Keyboard: arrows (or j/k) move
   between groups, Enter types a name, y confirms a suggestion, x picks a group to name
   with others, i ignores a group; a click on a face opens its photo, its × takes it
   out of the group. #}
{% set texts = {
  "group": _("Group {number}"),
  "size": _("{faces} in {photos}"),
  "faces": [ngettext("{n} face", "{n} faces", 1), ngettext("{n} face", "{n} faces", 2)],
  "photos": [ngettext("{n} photo", "{n} photos", 1), ngettext("{n} photo", "{n} photos", 2)],
  "more": [ngettext("and {n} more face", "and {n} more faces", 1), ngettext("and {n} more face", "and {n} more faces", 2)],
  "alone": [ngettext("{n} face looks like no other: it is not shown.", "{n} faces look like no other: they are not shown.", 1), ngettext("{n} face looks like no other: it is not shown.", "{n} faces look like no other: they are not shown.", 2)],
  "ignoredGroups": [ngettext("{n} ignored group is not shown.", "{n} ignored groups are not shown.", 1), ngettext("{n} ignored group is not shown.", "{n} ignored groups are not shown.", 2)],
  "none": _("No group yet: no two faces look alike enough."),
  "offline": _("The page is not running any more: start people again."),
  "failed": _("The groups could not be read (error {status})."),
  "suggest": _("{name}?"),
  "confirm": _("Yes, it is {name}"),
  "placeholder": _("Who is it? Type a name, then Enter"),
  "save": _("Name"),
  "ignore": _("Ignore this group"),
  "pick": _("Name with others"),
  "remove": _("Not this person: take this face out"),
  "picked": [ngettext("{n} group picked: the next name goes to it.", "{n} groups picked: the next name goes to all of them.", 1), ngettext("{n} group picked: the next name goes to it.", "{n} groups picked: the next name goes to all of them.", 2)],
  "saving": _("Saving…"),
  "readOnly": _("Names cannot be saved: mount a writable folder on /config."),
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("People") }} — media-hygiene</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --chip: #eef1f4; --bad: #cf222e; --good: #1a7f37;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --chip: #21262d; --bad: #f85149; --good: #3fb950;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header { position: sticky; top: 0; z-index: 1; padding: 12px 16px; background: var(--card);
           border-bottom: 1px solid var(--line); }
  h1 { font-size: 1.1rem; margin: 0 0 4px; }
  .hint, #status { color: var(--muted); font-size: .85rem; margin: 4px 0 0; }
  #status.error { color: var(--bad); font-weight: 600; }
  #status.saved { color: var(--good); font-weight: 600; }
  main { padding: 8px 16px 16px; }
  section { margin: 12px 0; padding: 10px 12px; background: var(--card);
            border: 1px solid var(--line); border-radius: 10px; }
  section.current { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  section.picked { background: var(--chip); }
  h2 { font-size: 1rem; margin: 0 0 8px; }
  h2 small { color: var(--muted); font-weight: normal; }
  .tools { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .tools input { flex: 1 1 14rem; min-width: 0; padding: 4px 8px; font: inherit;
                 border: 1px solid var(--line); border-radius: 6px; background: var(--bg);
                 color: var(--text); }
  .tools button { padding: 4px 10px; font: inherit; border: 1px solid var(--line);
                  border-radius: 6px; background: var(--chip); color: var(--text);
                  cursor: pointer; }
  .tools button.main { background: var(--accent); border-color: var(--accent); color: #fff; }
  .faces { display: flex; flex-wrap: wrap; gap: 6px; }
  .face { position: relative; }
  .face img { width: 96px; height: 96px; object-fit: cover; border-radius: 8px;
              background: var(--chip); cursor: pointer; display: block; }
  .face button { position: absolute; top: 2px; right: 2px; width: 22px; height: 22px;
                 padding: 0; border: 0; border-radius: 50%; background: rgba(0, 0, 0, .6);
                 color: #fff; cursor: pointer; line-height: 22px; }
  .more { align-self: center; color: var(--muted); font-size: .85rem; }
  #viewer { position: fixed; inset: 0; z-index: 2; display: none; flex-direction: column;
            align-items: center; justify-content: center; gap: 8px; padding: 16px;
            background: rgba(0, 0, 0, .88); color: #fff; }
  #viewer.open { display: flex; }
  #viewer img { max-width: 100%; max-height: calc(100vh - 90px); object-fit: contain; }
</style>
</head>
<body>
<header>
  <h1>🔒 {{ _("People") }}</h1>
  <p class="hint">{{ _("Each group holds faces that look alike: probably one person. Type a name to save it in config.toml; the photos are never changed and the faces stay on this computer.") }}</p>
  <p class="hint">{{ _("↑ ↓ move, Enter names, y confirms a suggestion, x names several groups at once, i ignores a group; × takes a face out of its group.") }}</p>
  <p id="status" role="status"></p>
</header>
<main id="groups"></main>
<datalist id="names"></datalist>
<div id="viewer" role="dialog" aria-modal="true">
  <img id="large" alt="">
  <div id="viewerName"></div>
</div>
<script>
"use strict";
const TEXTS = {{ texts | tojson }};
const GROUPS_PATH = {{ groups_path | tojson }};
const CHANGE_PATH = {{ change_path | tojson }};
const FACE = {{ face_prefix | tojson }};
const PHOTO = {{ photo_prefix | tojson }};
const $ = (id) => document.getElementById(id);
let state = { sections: [], people: [], writable: false };
let current = 0;
const picked = new Set();
const removed = new Set();

function fill(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, name) => (name in values ? values[name] : all));
}

const PLURAL = new Intl.PluralRules(document.documentElement.lang);

// A counted fragment: its singular and plural forms, the one the language uses for n.
function counted(forms, n) {
  return fill(forms[PLURAL.select(n) === "one" ? 0 : 1], { n: n });
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

function say(text, kind) {
  $("status").className = kind || "";
  $("status").textContent = text;
}

function kept(index) {
  return state.sections[index].shown.map((item) => item.key).filter((key) => !removed.has(key));
}

async function send(body) {
  say(TEXTS.saving);
  let answer;
  try {
    answer = await fetch(CHANGE_PATH, {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
    });
  } catch (error) {
    say(TEXTS.offline, "error");
    return;
  }
  const result = await answer.json().catch(() => ({ error: fill(TEXTS.failed, { status: answer.status }) }));
  if (!answer.ok) {
    say(result.error, "error");
    return;
  }
  picked.clear();
  show(result);
  say(result.saved, "saved");
}

function nameGroups(index, name) {
  const chosen = new Set([index, ...picked]);
  const faces = [...chosen].flatMap(kept);
  const out = [...chosen].flatMap((at) => state.sections[at].shown.map((item) => item.key))
    .filter((key) => removed.has(key));
  if (faces.length) send({ action: "name", name, faces, removed: out });
}

function takeOut(index, key) {
  const section = state.sections[index];
  const name = section.name || section.suggested;
  if (name && state.writable) {
    send({ action: "reject", name, faces: [key] });
    return;
  }
  removed.add(key);
  render();
}

function face(item, index) {
  const box = element("div", "face");
  const picture = element("img");
  picture.loading = "lazy";
  picture.src = FACE + item.key + ".jpg";
  picture.alt = item.photo;
  picture.title = item.photo;
  picture.addEventListener("click", () => {
    $("large").src = PHOTO + item.key + ".jpg";
    $("viewerName").textContent = item.photo;
    $("viewer").classList.add("open");
  });
  const out = element("button", "", "×");
  out.title = TEXTS.remove;
  out.setAttribute("aria-label", TEXTS.remove);
  out.addEventListener("click", () => takeOut(index, item.key));
  box.append(picture, out);
  return box;
}

function tools(item, index) {
  const bar = element("div", "tools");
  const input = element("input");
  input.setAttribute("list", "names");
  input.placeholder = TEXTS.placeholder;
  input.value = item.name;
  input.disabled = !state.writable;
  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && input.value.trim()) nameGroups(index, input.value.trim());
    if (event.key === "Escape") input.blur();
    event.stopPropagation();
  });
  const save = element("button", "main", TEXTS.save);
  save.addEventListener("click", () => input.value.trim() && nameGroups(index, input.value.trim()));
  bar.append(input, save);
  if (item.suggested) {
    const yes = element("button", "", fill(TEXTS.confirm, { name: item.suggested }));
    yes.addEventListener("click", () => nameGroups(index, item.suggested));
    bar.append(yes);
  }
  const pick = element("button", "", TEXTS.pick);
  pick.addEventListener("click", () => toggle(index));
  const ignore = element("button", "", TEXTS.ignore);
  ignore.addEventListener("click", () => ignoreGroup(index));
  bar.append(pick, ignore);
  for (const button of bar.querySelectorAll("button")) button.disabled = !state.writable;
  return bar;
}

function group(item, index) {
  const node = element("section");
  node.classList.toggle("current", index === current);
  node.classList.toggle("picked", picked.has(index));
  const heading = item.name || (item.suggested ? fill(TEXTS.suggest, { name: item.suggested }) : fill(TEXTS.group, { number: index + 1 }));
  const title = element("h2", "", heading + " ");
  title.append(element("small", "", fill(TEXTS.size, { faces: counted(TEXTS.faces, item.faces), photos: counted(TEXTS.photos, item.photos) })));
  const faces = element("div", "faces");
  faces.append(...item.shown.filter((shown) => !removed.has(shown.key)).map((shown) => face(shown, index)));
  if (item.faces > item.shown.length) {
    faces.append(element("span", "more", counted(TEXTS.more, item.faces - item.shown.length)));
  }
  node.append(title, tools(item, index), faces);
  node.addEventListener("click", () => { current = index; mark(); });
  return node;
}

function mark() {
  [...$("groups").children].forEach((node, index) => {
    node.classList.toggle("current", index === current);
    node.classList.toggle("picked", picked.has(index));
  });
}

function toggle(index) {
  if (picked.has(index)) picked.delete(index); else picked.add(index);
  mark();
  if (picked.size) say(counted(TEXTS.picked, picked.size));
}

function ignoreGroup(index) {
  const faces = kept(index);
  if (faces.length) send({ action: "ignore", faces });
}

function render() {
  $("groups").replaceChildren(...state.sections.map(group));
}

function show(next) {
  state = next;
  current = Math.min(current, Math.max(0, state.sections.length - 1));
  $("names").replaceChildren(...state.people.map((name) => { const option = element("option"); option.value = name; return option; }));
  render();
  const notes = [];
  if (!state.sections.length) notes.push(TEXTS.none);
  if (state.alone) notes.push(counted(TEXTS.alone, state.alone));
  if (state.ignored) notes.push(counted(TEXTS.ignoredGroups, state.ignored));
  if (!state.writable) notes.push(TEXTS.readOnly);
  say(notes.join(" "));
}

async function load() {
  let answer;
  try {
    answer = await fetch(GROUPS_PATH);
  } catch (error) {
    say(TEXTS.offline, "error");
    return;
  }
  if (!answer.ok) {
    say(fill(TEXTS.failed, { status: answer.status }), "error");
    return;
  }
  show(await answer.json());
}

function move(step) {
  if (!state.sections.length) return;
  current = Math.max(0, Math.min(state.sections.length - 1, current + step));
  mark();
  $("groups").children[current].scrollIntoView({ block: "nearest" });
}

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape") { $("viewer").classList.remove("open"); return; }
  if (!state.sections.length || event.ctrlKey || event.metaKey || event.altKey) return;
  const item = state.sections[current];
  if (event.key === "ArrowDown" || event.key === "j") move(1);
  else if (event.key === "ArrowUp" || event.key === "k") move(-1);
  else if (event.key === "Enter" || event.key === "n") $("groups").children[current].querySelector("input").focus();
  else if (event.key === "y" && item.suggested && state.writable) nameGroups(current, item.suggested);
  else if (event.key === "x" && state.writable) toggle(current);
  else if (event.key === "i" && state.writable) ignoreGroup(current);
  else return;
  event.preventDefault();
});
$("viewer").addEventListener("click", () => $("viewer").classList.remove("open"));
load();
</script>
</body>
</html>

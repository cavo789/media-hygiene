{% extends "page_frame.html.j2" %}
{# The page of `media-hygiene people`, on the frame of every page (0667): the people by name
   first, then the groups of faces alike, largest first, a few dozen faces each. Names are
   typed here and saved by the server into config.toml, read back and shown in the bar. Each
   person shows twice at most: the faces the user confirmed (verified ✓) and those the tool
   gives them (attributed). A click on a face opens its photo in the shared large view
   (`pick_viewer.html.j2`, `people_viewer.js.j2`); its × marks it as someone else's (greyed,
   kept in place: nothing moves) until the next button of its section saves the marks.
   *and N more faces* shows every face of a group: then, and only then, its photos can be set
   aside (in the decisions file, for `clean --decisions`; opened from the home page, *Apply
   now* in the bar runs it). The faces of photos set aside (any page) are not shown: a line
   says how many, *Show* draws them dimmed to take one back (0327). Each title folds or
   unfolds its section; verified ones come folded, as a strip, their sample asked for on
   opening (0323); what is folded is remembered in this browser. A group set aside is
   remembered (0328): the faces that look like it come first, to check and set aside too.
   The left column lists the people (0324); the bar says what is left, g goes to the next
   section to do (0325); a group nobody is given says who it looks like (0326):
   `people_guide.js.j2`. The person chosen is kept in the URL (`?who=`, `view_state`).
   Scripts: `people.js.j2`, `people_sections.js.j2`, `people_viewer.js.j2`. #}
{% set texts = {
  "group": _("Group {number}"),
  "size": _("{faces} in {photos}"),
  "faces": [ngettext("{n} face", "{n} faces", 1), ngettext("{n} face", "{n} faces", 2)],
  "photos": [ngettext("{n} photo", "{n} photos", 1), ngettext("{n} photo", "{n} photos", 2)],
  "more": [ngettext("and {n} more face", "and {n} more faces", 1), ngettext("and {n} more face", "and {n} more faces", 2)],
  "showAll": _("Show every face of the group, to take out those of someone else"),
  "aside": [ngettext("Set aside their {n} photo", "Set aside their {n} photos", 1), ngettext("Set aside their {n} photo", "Set aside their {n} photos", 2)],
  "asideHint": _("Every photo this person is on, with others or not. Nothing is deleted here: 'clean --decisions' moves them to the quarantine, 'undo' brings them back."),
  "allFirst": _("Show every face of the group first, to take out those of someone else."),
  "hiddenSome": [ngettext("{n} photo set aside, hidden", "{n} photos set aside, hidden", 1), ngettext("{n} photo set aside, hidden", "{n} photos set aside, hidden", 2)],
  "showHidden": _("Show"),
  "hideHidden": _("Hide"),
  "takeBack": _("Take out of the set aside"),
  "takeBackOne": _("Take this photo out of the set aside"),
  "fold": _("Fold this section (o)"),
  "unfold": _("Open this section (o)"),
  "alone": [ngettext("{n} face looks like no other: it is not shown.", "{n} faces look like no other: they are not shown.", 1), ngettext("{n} face looks like no other: it is not shown.", "{n} faces look like no other: they are not shown.", 2)],
  "ignoredGroups": [ngettext("{n} ignored group is not shown.", "{n} ignored groups are not shown.", 1), ngettext("{n} ignored group is not shown.", "{n} ignored groups are not shown.", 2)],
  "none": _("No group yet: no two faces look alike enough."),
  "offline": _("The page is not running any more: start people again."),
  "failed": _("The groups could not be read (error {status})."),
  "verified": _("verified"),
  "verifiedHint": _("The faces you confirmed as this person's."),
  "attributed": _("attributed"),
  "attributedHint": _("Faces given to this person because they look like those you confirmed: take out with × those of someone else, then confirm."),
  "confirm": [ngettext("Yes, this face is {name}", "Yes, these {n} faces are {name}", 1), ngettext("Yes, this face is {name}", "Yes, these {n} faces are {name}", 2)],
  "placeholder": _("Who is it? Type a name, then Enter"),
  "save": _("Set name"),
  "ignore": _("Ignore this group"),
  "pick": _("Name with others"),
  "remove": _("Not this person: mark this face; the next button of the group saves it"),
  "putBack": _("Put this face back"),
  "rejectMarked": [ngettext("Not {name}: take out this face", "Not {name}: take out these {n} faces", 1), ngettext("Not {name}: take out this face", "Not {name}: take out these {n} faces", 2)],
  "picked": [ngettext("{n} group picked: the next name goes to it.", "{n} groups picked: the next name goes to all of them.", 1), ngettext("{n} group picked: the next name goes to it.", "{n} groups picked: the next name goes to all of them.", 2)],
  "saving": _("Saving…"),
  "readOnly": _("Names cannot be saved: mount a writable folder on /config."),
  "alikeTitle": [ngettext("{n} other photo looks like the person you set aside on {date}", "{n} other photos look like the person you set aside on {date}", 1), ngettext("{n} other photo looks like the person you set aside on {date}", "{n} other photos look like the person you set aside on {date}", 2)],
  "alikeHint": _("Shown for you to check, never removed on their own. × : not this person, remembered. Removed means moved to the quarantine at the next clean; undo brings the photos back."),
  "alikeAside": [ngettext("Remove this photo too (quarantine, undo possible)", "Remove these {n} photos too (quarantine, undo possible)", 1), ngettext("Remove this photo too (quarantine, undo possible)", "Remove these {n} photos too (quarantine, undo possible)", 2)],
  "alikeNot": [ngettext("Not them: ignore this face", "Not them: ignore these {n} faces", 1), ngettext("Not them: ignore this face", "Not them: ignore these {n} faces", 2)],
  "alikeNotOne": _("Not this person: never shown for them again"),
  "alikeAgain": _("Show this face for this person again"),
  "alikeIgnored": [ngettext("{n} face ignored for the person set aside on {date}", "{n} faces ignored for the person set aside on {date}", 1), ngettext("{n} face ignored for the person set aside on {date}", "{n} faces ignored for the person set aside on {date}", 2)],
  "remembered": _("Their face is remembered: the photos that look like them will be shown at the top of this page, to check."),
  "photoAside": _("Set this photo aside (Delete)"),
  "photoBack": _("Take this photo back (Backspace)"),
  "toDo": _("To do:"),
  "allDone": _("Nothing left to do: every face shown is verified or ignored."),
  "leftAttributed": [ngettext("{n} attributed face ({people})", "{n} attributed faces ({people})", 1), ngettext("{n} attributed face ({people})", "{n} attributed faces ({people})", 2)],
  "persons": [ngettext("{n} person", "{n} people", 1), ngettext("{n} person", "{n} people", 2)],
  "leftUnnamed": [ngettext("{n} unnamed group ({faces})", "{n} unnamed groups ({faces})", 1), ngettext("{n} unnamed group ({faces})", "{n} unnamed groups ({faces})", 2)],
  "ignoredShort": [ngettext("{n} group ignored", "{n} groups ignored", 1), ngettext("{n} group ignored", "{n} groups ignored", 2)],
  "onlyLeft": _("Only what is left"),
  "everything": _("Everything"),
  "toConfirm": _("{n} to confirm"),
  "unnamedEntry": _("Unnamed groups ({n})"),
  "itIs": _("It is {name}? ({score})"),
  "pathHint": _("A person's name is in this photo's folder or file name: a hint only, nothing is named from it"),
  "pathPickOwn": [ngettext("📁 Show the face whose folder or file names {name}", "📁 Show the {n} faces whose folder or file names {name}", 1), ngettext("📁 Show the face whose folder or file names {name}", "📁 Show the {n} faces whose folder or file names {name}", 2)],
  "pathPickOwnHint": _("Shows only these faces, among those shown, picked: check them, then confirm them as this person"),
  "pathAll": _("✕ Show all the faces"),
  "pathPickOwnAll": _("📁 Show the faces of this group whose folder or file names {name}"),
  "pathPickAll": _("📁 Show the faces of this group whose folder or file names {name}: not {section}?"),
  "pathConfirm": [ngettext("✓ Yes, this face is {name}", "✓ Yes, these {n} faces are {name}", 1), ngettext("✓ Yes, this face is {name}", "✓ Yes, these {n} faces are {name}", 2)],
  "pathPick": [ngettext("📁 Show the face whose folder or file names {name}: not {section}?", "📁 Show the {n} faces whose folder or file names {name}: not {section}?", 1), ngettext("📁 Show the face whose folder or file names {name}: not {section}?", "📁 Show the {n} faces whose folder or file names {name}: not {section}?", 2)],
  "pathPickHint": _("Shows only these faces, among those shown, picked, and types the name: check them, then Enter to save"),
  "namerNot": [ngettext("Not {name}, this face is…", "Not {name}, these {n} faces are…", 1), ngettext("Not {name}, this face is…", "Not {name}, these {n} faces are…", 2)],
  "namerIs": [ngettext("This face is…", "These {n} faces are…", 1), ngettext("This face is…", "These {n} faces are…", 2)],
  "nameOne": _("Name this face only (Ctrl+click picks several, Shift+click a range)"),
  "suggestHint": _("This group looks like the faces you confirmed as this person's: a click names it so (y)."),
} %}
{% set page_name = _("People") %}
{% set tile_view_key = "mh-people-view" %}
{% set keys_safe = _("Names go to config.toml; the photos are never changed and the faces stay on this computer. Nothing is deleted here: 'clean --decisions' moves the photos set aside to the quarantine, 'undo' brings them back.") %}
{% set pick_album = false %}
{% block style %}
{% include "pick_viewer.css.j2" %}
{% include "people.css.j2" %}
{% endblock %}
{% block side %}
  <section id="toc" aria-label="{{ _('People') }}">
    <nav id="people" aria-label="{{ _('People') }}">
      <ul id="peopleList"></ul>
      <label><input id="onlyPerson" type="checkbox"> {{ _("Show only this person (Esc)") }}</label>
    </nav>
    {# Someone in no group, or in someone else's (0714): from one photo, its faces. #}
    <p><a id="personPage" href="/person" target="_blank" rel="noopener" title="{{ _("Paste the path of a photo: name each of its faces, then confirm that person's other photos") }}">👤 {{ _("Name someone from a photo") }}</a></p>
    <details>
      <summary>{{ _("How it works") }}</summary>
      <p class="muted">{{ _("Each group holds faces that look alike: probably one person. Type a name to save it in config.toml; the photos are never changed and the faces stay on this computer.") }}</p>
      <p class="muted">{{ _("Naming confirms the faces shown: they become verified ✓. The other faces that look like them are attributed to the person, in a section of their own, until you confirm them, a page at a time.") }}</p>
      <p class="muted">{{ _("People come in alphabetical order, then the unnamed groups, largest first: each name given there names the most faces. g goes to the next section to do, / to the people list.") }}</p>
    </details>
  </section>
{% endblock %}
{% block keys %}
      <dt><kbd>↑</kbd> <kbd>↓</kbd></dt><dd>{{ _("the previous or next section") }}</dd>
      <dt><kbd>g</kbd></dt><dd>{{ _("the next section to do") }}</dd>
      <dt><kbd>Enter</kbd></dt><dd>{{ _("type a name for the section") }}</dd>
      <dt><kbd>y</kbd></dt><dd>{{ _("confirm the attributed faces shown, or name the group as the person it looks like") }}</dd>
      <dt>×</dt><dd>{{ _("a face of someone else: the next button of the section saves it") }}</dd>
      <dt>{{ _("Ctrl+click") }}</dt><dd>{{ _("pick faces of the section to name them, Shift+click a range, drag a rectangle, Ctrl+A every face of the current section; ✎ this face only") }}</dd>
      <dt><kbd>Ctrl</kbd>+<kbd>I</kbd></dt><dd>{{ _("invert: the other faces of the current section instead") }}</dd>
      <dt>{{ _("click") }}</dt><dd>{{ _("its photo large; Delete sets it aside, Esc closes") }}</dd>
{% endblock %}
{% block more_keys %}
      <dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>{{ _("the next or previous section") }}</dd>
      <dt><kbd>n</kbd></dt><dd>{{ _("type a name for the section") }}</dd>
      <dt><kbd>o</kbd></dt><dd>{{ _("fold or open the section") }}</dd>
      <dt><kbd>x</kbd></dt><dd>{{ _("pick the group, to name several at once") }}</dd>
      <dt><kbd>i</kbd></dt><dd>{{ _("ignore the group") }}</dd>
      <dt><kbd>/</kbd></dt><dd>{{ _("go to a person") }}</dd>
      <dt><kbd>Esc</kbd></dt><dd>{{ _("every person again, after Show only this person") }}</dd>
{% endblock %}
{% block bar %}
  <p id="todo" aria-live="polite"></p>
  <button id="next" class="main" type="button">{{ _("Next to do (g)") }}</button>
  <button id="onlyLeft" type="button"></button>
  <button id="invertFaces" class="plain" type="button" title="{{ _('Pick the other faces of the current section: the ones picked are left (Ctrl+I)') }}">🔀 {{ _("Invert the picking") }}</button>
  <input id="who" type="search" placeholder="{{ _('Go to a person (/)') }}" aria-label="{{ _('Go to a person (/)') }}">
  {% include "apply_now.html.j2" %}
  <span id="status" role="status" aria-live="polite"></span>
  {% include "tile_view.html.j2" %}
  <p id="newPhotos" role="status" hidden><span id="newPhotosLine"></span> <button id="newPhotosStop" type="button" hidden>{{ _("Stop") }}</button> <button id="newPhotosShow" type="button" hidden>{{ _("Show the new groups") }}</button></p>
{% endblock %}
{% block content %}
<main>
  <div id="alike"></div>
  <div id="groups"></div>
</main>
{% endblock %}
{% block after %}
{% include "pick_viewer.html.j2" %}
<script nonce="{{ page_nonce }}">
"use strict";
const TEXTS = {{ texts | tojson }};
const GROUPS_PATH = {{ groups_path | tojson }};
const SECTION = {{ section_prefix | tojson }};
const SAMPLE = {{ sample_prefix | tojson }};
{% include "people.js.j2" %}
{% include "people_sections.js.j2" %}
{% include "people_name_face.js.j2" %}
{% include "people_face_band.js.j2" %}
{% include "people_viewer.js.j2" %}
{% include "people_guide.js.j2" %}
{% include "path_names.js.j2" %}
{% include "people_path_names.js.j2" %}
{% include "tile_view.js.j2" %}
{% if new_photos or turn_photos %}{% include "people_new_photos.js.j2" %}{% endif %}
load();
</script>
{% include "undo_toast.html.j2" %}
{% endblock %}

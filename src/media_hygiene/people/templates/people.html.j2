<!DOCTYPE html>
{# The page of `media-hygiene people`: the groups of faces alike, largest first, a few
   dozen faces each. Read-only: it only asks the server for the groups and for pictures.
   A click on a face opens its photo; Escape closes it. #}
{% set texts = {
  "group": _("Group {number}"),
  "size": _("{faces} faces in {photos} photos"),
  "more": _("and {count} more faces"),
  "alone": _("{count} faces look like no other: they are not shown."),
  "none": _("No group yet: no two faces look alike enough."),
  "offline": _("The page is not running any more: start people again."),
  "failed": _("The groups could not be read (error {status})."),
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("Faces alike") }} — media-hygiene</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --chip: #eef1f4; --bad: #cf222e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --chip: #21262d; --bad: #f85149;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header { padding: 12px 16px; background: var(--card); border-bottom: 1px solid var(--line); }
  h1 { font-size: 1.1rem; margin: 0 0 4px; }
  .hint, #status { color: var(--muted); font-size: .85rem; margin: 4px 0 0; }
  #status.error { color: var(--bad); font-weight: 600; }
  main { padding: 8px 16px 16px; }
  section { margin: 12px 0; padding: 10px 12px; background: var(--card);
            border: 1px solid var(--line); border-radius: 10px; }
  h2 { font-size: 1rem; margin: 0 0 8px; }
  h2 small { color: var(--muted); font-weight: normal; }
  .faces { display: flex; flex-wrap: wrap; gap: 6px; }
  .faces img { width: 96px; height: 96px; object-fit: cover; border-radius: 8px;
               background: var(--chip); cursor: pointer; }
  .more { align-self: center; color: var(--muted); font-size: .85rem; }
  #viewer { position: fixed; inset: 0; z-index: 2; display: none; flex-direction: column;
            align-items: center; justify-content: center; gap: 8px; padding: 16px;
            background: rgba(0, 0, 0, .88); color: #fff; }
  #viewer.open { display: flex; }
  #viewer img { max-width: 100%; max-height: calc(100vh - 90px); object-fit: contain; }
</style>
</head>
<body>
<header>
  <h1>🔒 {{ _("Faces alike") }}</h1>
  <p class="hint">{{ _("Each group holds faces that look alike: probably one person. Nothing is named nor changed here yet; the faces stay on this computer.") }}</p>
  <p id="status" role="status"></p>
</header>
<main id="groups"></main>
<div id="viewer" role="dialog" aria-modal="true">
  <img id="large" alt="">
  <div id="viewerName"></div>
</div>
<script>
"use strict";
const TEXTS = {{ texts | tojson }};
const GROUPS_PATH = {{ groups_path | tojson }};
const FACE = {{ face_prefix | tojson }};
const PHOTO = {{ photo_prefix | tojson }};
const $ = (id) => document.getElementById(id);

function fill(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, name) => (name in values ? values[name] : all));
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

function face(item) {
  const picture = element("img");
  picture.loading = "lazy";
  picture.src = FACE + item.key + ".jpg";
  picture.alt = item.photo;
  picture.title = item.photo;
  picture.addEventListener("click", () => {
    $("large").src = PHOTO + item.key + ".jpg";
    $("viewerName").textContent = item.photo;
    $("viewer").classList.add("open");
  });
  return picture;
}

function group(item, index) {
  const node = element("section");
  const title = element("h2", "", fill(TEXTS.group, { number: index + 1 }) + " ");
  title.append(element("small", "", fill(TEXTS.size, { faces: item.faces, photos: item.photos })));
  const faces = element("div", "faces");
  faces.append(...item.shown.map(face));
  if (item.faces > item.shown.length) {
    faces.append(element("span", "more", fill(TEXTS.more, { count: item.faces - item.shown.length })));
  }
  node.append(title, faces);
  return node;
}

async function load() {
  const status = $("status");
  let answer;
  try {
    answer = await fetch(GROUPS_PATH);
  } catch (error) {
    status.className = "error";
    status.textContent = TEXTS.offline;
    return;
  }
  if (!answer.ok) {
    status.className = "error";
    status.textContent = fill(TEXTS.failed, { status: answer.status });
    return;
  }
  const state = await answer.json();
  $("groups").replaceChildren(...state.groups.map(group));
  status.textContent = state.groups.length ? fill(TEXTS.alone, { count: state.alone }) : TEXTS.none;
}

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape") $("viewer").classList.remove("open");
});
$("viewer").addEventListener("click", () => $("viewer").classList.remove("open"));
load();
</script>
</body>
</html>

{# The script of home.html.j2, its core: the state asked once the page shows (GET state_path),
   the spaces, the theme, the keys. The page only draws: the next step, each action's state and reason
   come from Python (cli/home_state.py). home_draw.js.j2 draws, home_run.js.j2 runs the steps. #}
"use strict";
const T = {{ texts | tojson }};
const P = {{ paths | tojson }};
const RELAYS = {{ relays_steps | tojson }};
// A phone on the home network (mh --lan, 0269): reads only, never the audit (0427); Quit and the
// presence stay the PC's (its tab, not the phone's, keeps the page open).
const REMOTE = {{ remote | tojson }};
const PHONE_PAGES = {{ phone_pages | tojson }};  // a phone opens these steps as pages (0360)
const WINDOW = {{ window | tojson }};
const ALIVE_MS = {{ alive_ms | tojson }};
const THOUSANDS = {{ thousands | tojson }};
const POLL_MS = 1000;
// The next server may answer 0.5 s after this one ended (measured, 0354): asked often, and
// known by the run id each server sends (`RUN_HEADER` of review/respond.py).
const COMEBACK_MS = 250;
const ANSWER_MS = 2000; // a poll nobody answers in this time is asked again
const RUN_HEADER = "X-Media-Hygiene-Run";
const HINT_MS = 30000;
const TOAST_MS = 6500;
const LOADING_SLOW_MS = 5000;
const HOME = "home";
const FAMILY_STAGE = "find";  // the one stage a paired phone sees (0293)
const STORE_PREFIX = "mh-home-";
let S = null;

const esc = (text) => String(text).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
const icon = (name) => `<svg class="i" aria-hidden="true" focusable="false"><use href="#i-${esc(name)}"></use></svg>`;
const $ = (selector, root = document) => root.querySelector(selector);
const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
const norm = (text) => String(text).normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
const count = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, THOUSANDS);
const image = (name) => `${P.assets}images/${name}`;
const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

// Per-viewer conveniences only (the theme, an update banner closed): the page works without them.
const store = {
  get(key, fallback) {
    try { const value = localStorage.getItem(STORE_PREFIX + key); return value === null ? fallback : JSON.parse(value); } catch (error) { return fallback; }
  },
  set(key, value) {
    try { localStorage.setItem(STORE_PREFIX + key, JSON.stringify(value)); } catch (error) { /* storage refused: the choice lasts this visit */ }
  },
};

const RISK = {
  safe: { label: T.riskSafe, icon: "lock", cls: "pill-safe" },
  undo: { label: T.riskUndo, icon: "undo", cls: "pill-undo" },
  final: { label: T.riskFinal, icon: "alert", cls: "pill-final" },
};
// The meerkat of each stage, and of a few actions (assets/images/meerkat-*.webp).
const POSE = { import: "phone", clean: "broom", sort: "sorting", find: "magnifier", backup: "nas" };
const ACTION_POSE = { audit: "lookout", import: "nas", "nas-add": "nas", review: "magnifier", "review-near": "magnifier", "review-pairs": "magnifier", "review-junk": "magnifier", "review-gone": "magnifier" };
// The panels a tool's page shows above its commands.
const TOPS = { history: ["undo", "quarantine"], reports: ["reportsList"] };

const view = { id: HOME };
let SPACE = {};
let BY_ID = {};
let STAGES = [];
let SHARE = [];
let TOOLS = [];
function index() {
  SPACE = Object.fromEntries([[HOME, { id: HOME, title: T.home, long: T.home, icon: "home", groups: [] }], ...S.spaces.map((space) => [space.id, space])]);
  BY_ID = Object.fromEntries(S.actions.map((action) => [action.name, action]));
  STAGES = S.spaces.filter((space) => space.stage);
  SHARE = S.spaces.filter((space) => !space.stage && space.id === "share");
  TOOLS = S.spaces.filter((space) => !space.stage && space.id !== "share");
  // A paired phone (0293): the stages that change photos and the tools hidden, only Find.
  if (REMOTE) { STAGES = STAGES.filter((space) => space.id === FAMILY_STAGE); TOOLS = []; }
}
const statusOf = (action) => ({
  available: action.available && !action.planned,
  planned: action.planned,
  done: action.done,
  proposed: action.proposed,
  reason: action.planned ? T.plannedReason : action.reason || T.nothingYet,
});
const proposedAction = () => (S.proposed ? BY_ID[S.proposed.name] : null);
const stageOf = (name) => {
  const space = STAGES.find((stage) => stage.groups.some((group) => group.numbered && group.actions.includes(name)));
  return space ? space.id : null;
};

// ---- Theme ------------------------------------------------------------------------------
function applyTheme(choice, save) {
  const root = document.documentElement;
  if (choice === "auto") root.removeAttribute("data-theme");
  else root.setAttribute("data-theme", choice);
  if (save) store.set("theme", choice);
  $$("[data-theme-choice]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.themeChoice === choice)));
}

// ---- Drawer and navigation --------------------------------------------------------------
const narrow = window.matchMedia("(max-width: 959.98px)");
function setNav(open, focus = true) {
  $("#app").classList.toggle("nav-open", open);
  $("#menuBtn").setAttribute("aria-expanded", String(open));
  $("#scrim").hidden = !open;
  $("#sidebar").inert = narrow.matches && !open;
  if (open && focus) { const current = $('.nav-link[aria-current="page"]') || $(".nav-link"); current.focus(); }
}
function go(id, focusMain = true) {
  view.id = SPACE[id] ? id : HOME;
  try { history.replaceState(null, "", "#" + view.id); } catch (error) { /* a sandboxed frame may refuse it */ }
  setNav(false, false);
  render();
  window.scrollTo(0, 0);
  if (focusMain) $("#main").focus({ preventScroll: true });
}
function render() {
  renderNav();
  renderFolders();
  renderSignature();
  renderTop();
  renderMain();
}
// The state, read again from the tool folders (after the audit of the page, a step's end).
const reload = () => fetch(P.state, { cache: "no-store" })
  .then((response) => response.json())
  .then((state) => { S = state; index(); render(); })
  .catch(() => stopped());

// ---- Events -----------------------------------------------------------------------------
function wire() {
  narrow.addEventListener("change", () => setNav(false, false));
  $("#menuBtn").addEventListener("click", () => setNav(!$("#app").classList.contains("nav-open")));
  $("#scrim").addEventListener("click", () => { setNav(false, false); $("#menuBtn").focus(); });
  $("#copyClose").addEventListener("click", () => { $("#copyBox").hidden = true; });
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const closer = event.target.closest("[data-close]");
    if (closer) { closer.closest("dialog").close(); return; }
    const target = event.target.closest("[data-go],[data-run],[data-copy],[data-theme-choice],[data-act]");
    if (!target) return;
    if (target.dataset.go) { event.preventDefault(); go(target.dataset.go); }
    else if (target.dataset.run) { event.preventDefault(); onRun(target.dataset.run); }
    else if (target.dataset.copy) { event.preventDefault(); copyText(target.dataset.copy); }
    else if (target.dataset.themeChoice) applyTheme(target.dataset.themeChoice, true);
    else if (target.dataset.act && ACTS[target.dataset.act]) { event.preventDefault(); ACTS[target.dataset.act](); }
  });
  $$("dialog").forEach((dialog) => {
    dialog.addEventListener("close", () => {
      const back = dialog.opener;
      dialog.opener = null;
      if (back && back.isConnected) back.focus({ preventScroll: true });
    });
    dialog.addEventListener("click", (event) => { if (event.target === dialog && dialog.id !== "stoppedDlg" && dialog.id !== "runDlg") dialog.close(); });
  });
  // The sidebar is one stop of Tab: ↑ and ↓ move inside it (a roving tabindex).
  $("#sidebar").addEventListener("keydown", (event) => {
    const link = event.target.closest(".nav-link");
    if (!link) return;
    const links = $$(".nav-link");
    const at = links.indexOf(link);
    const to = { ArrowDown: (at + 1) % links.length, ArrowUp: (at - 1 + links.length) % links.length, Home: 0, End: links.length - 1 }[event.key];
    if (to === undefined) return;
    event.preventDefault();
    links.forEach((other) => { other.tabIndex = -1; });
    links[to].tabIndex = 0;
    links[to].focus();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (palette.dialog.open) palette.dialog.close();
      else if (!document.querySelector("dialog[open]")) openPalette();
      return;
    }
    if (document.querySelector("dialog[open]")) return;
    if (event.key === "Escape") {
      if ($("#app").classList.contains("nav-open")) { setNav(false, false); $("#menuBtn").focus(); return; }
      if (!$("#copyBox").hidden) $("#copyBox").hidden = true;
      return;
    }
    const typing = event.target.closest("input, textarea, select, [contenteditable='true']");
    if (typing || event.ctrlKey || event.metaKey || event.altKey) return;
    if (event.key === "/") { event.preventDefault(); openPalette(); }
    else if (event.key === "?") { event.preventDefault(); openKeys(); }
  });
  window.addEventListener("hashchange", () => {
    const wanted = decodeURIComponent(location.hash.slice(1));
    if (SPACE[wanted] && wanted !== view.id) go(wanted);
  });
  wirePalette();
}

// The page shows at once, its meerkat waiting for the state: reading the tool folders can be
// slow through Docker Desktop (0277). The tab says it is there from the start (0261).
function start() {
  wirePresence();  // a paired phone keeps the PC's server alive too (0416)
  if (!REMOTE) showLan();
  const slow = window.setTimeout(() => { $("#loadingSlow").hidden = false; }, LOADING_SLOW_MS);
  const shown = () => { window.clearTimeout(slow); $("#loading").hidden = true; };
  fetch(P.state, { cache: "no-store" })
    .then((response) => { if (!response.ok) throw new Error(String(response.status)); return response.json(); })
    .then((state) => { S = state; shown(); begin(); })
    .catch(() => { shown(); stopped(); });
}
// The PC's page under mh --lan: the address, the code and the QR code a phone needs (0269).
// GET P.lan answers the loopback only, and only under mh --lan (else 404: nothing shown).
function showLan() {
  fetch(P.lan, { cache: "no-store" })
    .then((response) => (response.ok ? response.json() : null))
    .then((lan) => {
      if (!lan) return;
      // No home network (0367): the card says why, without the pairing lines.
      $("#lanNone").hidden = lan.problem !== "none";
      $("#lanPublic").hidden = lan.problem !== "public";
      $("#lanPair").hidden = !lan.qr;
      $("#lanCard").hidden = false;
      if (!lan.qr) return;
      $("#lanQr").innerHTML = lan.qr;
      $("#lanUrl").textContent = lan.url;
      $("#lanCode").textContent = lan.code;
      // HTTPS (0430): a phone installs the PC's certificate first, once.
      $("#lanCaLine").hidden = !lan.ca;
      $("#lanCa").textContent = lan.ca || "";
      if (lan.caHelp) $("#lanCaHow").href = lan.caHelp;  // the steps per phone, in the docs
      // Phones paired for good (0431): listed, each forgotten on demand.
      if (lan.phones) fetch(lan.phones, { cache: "no-store" }).then((r) => (r.ok ? r.json() : null)).then((answer) => answer && showPhones(answer, lan.forget));
      $("#lanCard").hidden = false;
    })
    .catch(() => undefined);
}
// The list answered by the server, read back from its file after each forget (0431).
function showPhones(answer, forgetPath) {
  const list = $("#lanPhoneList");
  list.replaceChildren();
  for (const phone of answer.phones) {
    const item = document.createElement("li");
    const name = document.createElement("span");
    name.textContent = `${phone.name} · ${phone.paired}`;
    const forget = document.createElement("button");
    forget.type = "button";
    forget.textContent = list.dataset.forget;
    forget.addEventListener("click", () => {
      forget.disabled = true;
      post(forgetPath, { id: phone.id })
        .then((r) => (r.ok ? r.json() : null))
        .then((again) => { if (again) showPhones(again, forgetPath); else forget.disabled = false; })
        .catch(() => { forget.disabled = false; });
    });
    item.append(name, forget);
    list.append(item);
  }
  $("#lanPhones").hidden = answer.phones.length === 0;
}
// The phone's app (0432): the worker keeps the offline page; iOS never invites to install, a line says how.
function asApp() {
  if (!REMOTE) return;
  if (window.isSecureContext && "serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(() => undefined);
  const ios = /iPhone|iPad/.test(navigator.userAgent);
  const standalone = navigator.standalone || window.matchMedia("(display-mode: standalone)").matches;
  if (ios && !standalone) toast(T.addToHome);
}
function begin() {
  index();
  asApp();
  applyTheme(store.get("theme", "auto"), false);
  const wanted = decodeURIComponent((location.hash || "").slice(1));
  view.id = SPACE[wanted] ? wanted : HOME;
  wire();
  render();
  setNav(false, false);
  // Enter runs the next step, as in `mh menu`: its button has the focus.
  const first = $("#heroRun");
  if (view.id === HOME && first) first.focus({ preventScroll: true });
  pollAudit();
}

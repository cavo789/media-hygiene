{# The script of home.html.j2, its core: the state asked once the page shows (GET state_path),
   the spaces, the theme, the keys. The page only draws: the next step, each action's state and reason
   come from Python (cli/home_state.py). home_draw.js.j2 draws, home_run.js.j2 runs the steps. #}
"use strict";
const T = {{ texts | tojson }};
const P = {{ paths | tojson }};
const RELAYS = {{ relays_steps | tojson }};
// A phone on the home network (mh --lan, 0269): reads only, never the audit (0427); Quit and the
// presence stay the PC's (its tab, not the phone's, keeps the page open).
const REMOTE = {{ remote | tojson }};
const PHONE_PAGES = {{ phone_pages | tojson }};  // a phone opens these steps as pages (0360)
const WINDOW = {{ window | tojson }};
const ALIVE_MS = {{ alive_ms | tojson }};
const THOUSANDS = {{ thousands | tojson }};
const POLL_MS = 1000;
const IDLE_MS = 3000; // between runs, an audit asked from the console is looked for (0451)
// The next server may answer 0.5 s after this one ended (measured, 0354): asked often, and
// known by the run id each server sends (`RUN_HEADER` of review/respond.py).
const COMEBACK_MS = 250;
const ANSWER_MS = 2000; // a poll nobody answers in this time is asked again
const RUN_HEADER = "X-Media-Hygiene-Run";
const HINT_MS = 30000;
const LOADING_SLOW_MS = 5000;
const HOME = "home";
const FAMILY_STAGE = "find";  // the one stage a paired phone sees (0293)
const STORE_PREFIX = "mh-home-";
let S = null;
let wired = false;

const esc = (text) => String(text).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
const icon = (name) => `<svg class="i" aria-hidden="true" focusable="false"><use href="#i-${esc(name)}"></use></svg>`;
const $ = (selector, root = document) => root.querySelector(selector);
const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];
const norm = (text) => String(text).normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
const count = (n) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, THOUSANDS);
const image = (name) => `${P.assets}images/${name}`;
const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

// Per-viewer conveniences only (the theme, an update banner closed): the page works without them.
const store = {
  get(key, fallback) {
    try { const value = localStorage.getItem(STORE_PREFIX + key); return value === null ? fallback : JSON.parse(value); } catch (error) { return fallback; }
  },
  set(key, value) {
    try { localStorage.setItem(STORE_PREFIX + key, JSON.stringify(value)); } catch (error) { /* storage refused: the choice lasts this visit */ }
  },
};

const RISK = {
  safe: { label: T.riskSafe, icon: "lock", cls: "pill-safe" },
  undo: { label: T.riskUndo, icon: "undo", cls: "pill-undo" },
  final: { label: T.riskFinal, icon: "alert", cls: "pill-final" },
};
// The meerkat of each stage, and of a few actions (assets/images/meerkat-*.webp).
const POSE = { import: "phone", clean: "broom", sort: "sorting", find: "magnifier", backup: "nas" };
const ACTION_POSE = { audit: "lookout", import: "nas", "nas-add": "nas", review: "magnifier", "review-near": "magnifier", "review-pairs": "magnifier", "review-junk": "magnifier", "review-gone": "magnifier", "review-intruders": "magnifier" };
// The panels a tool's page shows above its commands.
const TOPS = { clean: ["auditHere"], history: ["undo", "quarantine"], reports: ["reportsList"] };

const view = { id: HOME };
let SPACE = {};
let BY_ID = {};
let STAGES = [];
let SHARE = [];
let TOOLS = [];
function index() {
  SPACE = Object.fromEntries([[HOME, { id: HOME, title: T.home, long: T.home, icon: "home", groups: [] }], ...S.spaces.map((space) => [space.id, space])]);
  BY_ID = Object.fromEntries(S.actions.map((action) => [action.name, action]));
  STAGES = S.spaces.filter((space) => space.stage);
  SHARE = S.spaces.filter((space) => !space.stage && space.id === "share");
  TOOLS = S.spaces.filter((space) => !space.stage && space.id !== "share");
  // A paired phone (0293): the stages that change photos and the tools hidden, only Find.
  if (REMOTE) { STAGES = STAGES.filter((space) => space.id === FAMILY_STAGE); TOOLS = []; }
}
const statusOf = (action) => ({
  available: action.available && !action.planned,
  planned: action.planned,
  done: action.done,
  proposed: action.proposed,
  reason: action.planned ? T.plannedReason : action.reason || T.nothingYet,
});
const proposedAction = () => (S.proposed ? BY_ID[S.proposed.name] : null);
const stageOf = (name) => {
  const space = STAGES.find((stage) => stage.groups.some((group) => group.numbered && group.actions.includes(name)));
  return space ? space.id : null;
};

// ---- Theme ------------------------------------------------------------------------------
function applyTheme(choice, save) {
  const root = document.documentElement;
  if (choice === "auto") root.removeAttribute("data-theme");
  else root.setAttribute("data-theme", choice);
  if (save) store.set("theme", choice);
  $$("[data-theme-choice]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.themeChoice === choice)));
}

// ---- Drawer and navigation --------------------------------------------------------------
const narrow = window.matchMedia("(max-width: 959.98px)");
function setNav(open, focus = true) {
  $("#app").classList.toggle("nav-open", open);
  $("#menuBtn").setAttribute("aria-expanded", String(open));
  $("#scrim").hidden = !open;
  $("#sidebar").inert = narrow.matches && !open;
  if (open && focus) { const current = $('.nav-link[aria-current="page"]') || $(".nav-link"); current.focus(); }
}
function go(id, focusMain = true) {
  view.id = SPACE[id] ? id : HOME;
  window.mhView.set({}, { state: null, hash: "#" + view.id }); // view_state.html.j2 (0666)
  setNav(false, false);
  render();
  window.scrollTo(0, 0);
  if (focusMain) $("#main").focus({ preventScroll: true });
}
function render() {
  renderNav();
  renderFolders();
  renderSignature();
  renderTop();
  renderMain();
}
// The state, read again from the tool folders (after the audit of the page, a step's end).
const reload = () => fetch(P.state, { cache: "no-store" })
  .then((response) => response.text())
  .then((text) => { S = JSON.parse(text); keepState(text); index(); render(); })
  .catch(() => stopped());
// The last state of this tab (0442): back on the page it is drawn at once, then refreshed
// behind. A per-tab convenience: without storage, the splash as before. Choosing a step reads
// the state again on the server, so what is drawn for this moment can never run a stale step.
const STATE_KEY = `mh-home-state-${document.documentElement.lang}`;
function keepState(text) {
  try { sessionStorage.setItem(STATE_KEY, text); } catch (error) { /* refused or full: the splash next time */ }
}
function keptState() {
  try { return sessionStorage.getItem(STATE_KEY); } catch (error) { return null; }
}
function forgetState() {
  try { sessionStorage.removeItem(STATE_KEY); } catch (error) { /* nothing kept */ }
}

// ---- Events -----------------------------------------------------------------------------
function wire() {
  narrow.addEventListener("change", () => setNav(false, false));
  $("#menuBtn").addEventListener("click", () => setNav(!$("#app").classList.contains("nav-open")));
  $("#scrim").addEventListener("click", () => { setNav(false, false); $("#menuBtn").focus(); });
  $("#copyClose").addEventListener("click", () => { $("#copyBox").hidden = true; });
  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const closer = event.target.closest("[data-close]");
    if (closer) { closer.closest("dialog").close(); return; }
    const target = event.target.closest("[data-go],[data-run],[data-copy],[data-theme-choice],[data-act]");
    if (!target) return;
    if (target.dataset.go) { event.preventDefault(); go(target.dataset.go); }
    else if (target.dataset.run) { event.preventDefault(); onRun(target.dataset.run); }
    else if (target.dataset.copy) { event.preventDefault(); copyText(target.dataset.copy); }
    else if (target.dataset.themeChoice) applyTheme(target.dataset.themeChoice, true);
    else if (target.dataset.act && ACTS[target.dataset.act]) { event.preventDefault(); ACTS[target.dataset.act](); }
  });
  $$("dialog").forEach((dialog) => {
    dialog.addEventListener("close", () => {
      const back = dialog.opener;
      dialog.opener = null;
      if (back && back.isConnected) back.focus({ preventScroll: true });
    });
    dialog.addEventListener("click", (event) => { if (event.target === dialog && dialog.id !== "stoppedDlg" && dialog.id !== "runDlg") dialog.close(); });
  });
  // The sidebar is one stop of Tab: ↑ and ↓ move inside it (a roving tabindex).
  $("#sidebar").addEventListener("keydown", (event) => {
    const link = event.target.closest(".nav-link");
    if (!link) return;
    const links = $$(".nav-link");
    const at = links.indexOf(link);
    const to = { ArrowDown: (at + 1) % links.length, ArrowUp: (at - 1 + links.length) % links.length, Home: 0, End: links.length - 1 }[event.key];
    if (to === undefined) return;
    event.preventDefault();
    links.forEach((other) => { other.tabIndex = -1; });
    links[to].tabIndex = 0;
    links[to].focus();
  });
  document.addEventListener("keydown", (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (palette.dialog.open) palette.dialog.close();
      else if (!document.querySelector("dialog[open]")) openPalette();
      return;
    }
    if (document.querySelector("dialog[open]")) return;
    if (event.key === "Escape") {
      if ($("#app").classList.contains("nav-open")) { setNav(false, false); $("#menuBtn").focus(); return; }
      if (!$("#copyBox").hidden) $("#copyBox").hidden = true;
      return;
    }
    const typing = event.target.closest("input, textarea, select, [contenteditable='true']");
    if (typing || event.ctrlKey || event.metaKey || event.altKey) return;
    if (event.key === "/") { event.preventDefault(); openPalette(); }
    else if (event.key === "?") { event.preventDefault(); openKeys(); }
  });
  window.addEventListener("hashchange", () => {
    const wanted = decodeURIComponent(location.hash.slice(1));
    if (SPACE[wanted] && wanted !== view.id) go(wanted);
  });
  wirePalette();
}

// The first load shows the meerkat waiting for the state: reading the tool folders can be slow
// through Docker Desktop (0277). Afterwards the last state is drawn at once, marked as updating,
// and drawn again only if the answer differs (0442). The tab says it is there from the start (0261).
function start() {
  wirePresence();  // a paired phone keeps the PC's server alive too (0416)
  if (!REMOTE) { showLan(); window.setInterval(showLan, LAN_EVERY_MS); }
  const kept = keptState();
  let drawn = false;
  if (kept) {
    try { S = JSON.parse(kept); begin(); drawn = true; } catch (error) { forgetState(); S = null; }
  }
  if (!drawn) $("#loading").hidden = false;
  $("#updating").hidden = !drawn;
  const slow = drawn ? 0 : window.setTimeout(() => { $("#loadingSlow").hidden = false; }, LOADING_SLOW_MS);
  const shown = () => { window.clearTimeout(slow); $("#loading").hidden = true; $("#updating").hidden = true; };
  fetch(P.state, { cache: "no-store" })
    .then((response) => { if (!response.ok) throw new Error(String(response.status)); return response.text(); })
    .then((text) => {
      keepState(text);
      if (drawn && text === kept) { shown(); askLate(); askSamples(); return; }
      const focused = document.activeElement && document.activeElement.id;
      S = JSON.parse(text);
      shown();
      if (drawn) { index(); render(); if (focused) { const again = document.getElementById(focused); if (again) again.focus({ preventScroll: true }); } } else begin();
      askLate();
      askSamples();
    })
    .catch(() => { forgetState(); shown(); stopped(); });
}
// The PC's page under mh --lan: the address, the code and the QR code a phone needs (0269).
// GET P.lan answers the loopback only, and only under mh --lan (else 404: nothing shown).
function showLan() {
  fetch(P.lan, { cache: "no-store" })
    .then((response) => (response.ok ? response.json() : null))
    .then((lan) => {
      if (!lan) return;
      // No home network (0367): the card says why, without the pairing lines.
      $("#lanNone").hidden = lan.problem !== "none";
      $("#lanPublic").hidden = lan.problem !== "public";
      $("#lanPair").hidden = !lan.qr;
      $("#lanCard").hidden = false;
      if (!lan.qr) return;
      $("#lanQr").innerHTML = lan.qr;
      $("#lanUrl").textContent = lan.url;
      $("#lanCode").textContent = lan.code;
      showPairing(lan);
      // HTTPS (0430): a phone installs the PC's certificate first, once.
      $("#lanCaLine").hidden = !lan.ca;
      $("#lanCa").textContent = lan.ca || "";
      if (lan.caHelp) $("#lanCaHow").href = lan.caHelp;  // the steps per phone, in the docs
      // Phones paired for good (0431): listed, each forgotten on demand.
      if (lan.phones) fetch(lan.phones, { cache: "no-store" }).then((r) => (r.ok ? r.json() : null)).then((answer) => answer && showPhones(answer, { forget: lan.forget, rename: lan.rename, forgetAll: lan.forgetAll }, false));
      $("#lanCard").hidden = false;
    })
    .catch(() => undefined);
}
// The pairing's report (0681): wrong codes per address, the devices paired this run (a toast for a new one).
const LAN_EVERY_MS = 15000;
const lanSeen = { paired: -1, wired: false };
const clock = (at) => new Date(at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
function showPairing(lan) {
  const attempts = lan.attempts || [];
  const list = $("#lanAttempts");
  const line = (text) => { const item = document.createElement("li"); item.textContent = text; return item; };
  const refused = lan.refused || [];  // connections beyond the doors' caps (0682)
  list.replaceChildren(...attempts.map((a) => line(fill(T.lanAttempt, { count: a.failures, address: a.address, time: clock(a.at) }))), ...refused.map((r) => line(fill(T.lanRefused, { count: r.count, address: r.address, time: clock(r.at) }))));
  $("#lanClosed").hidden = !lan.closed;
  $("#lanAlert").hidden = attempts.length === 0 && refused.length === 0 && !lan.closed;
  const paired = lan.paired || [];
  $("#lanNewList").replaceChildren(...paired.map((p) => { const item = document.createElement("li"); item.textContent = `${p.name} · ${clock(p.at)}`; return item; }));
  $("#lanNew").hidden = paired.length === 0;
  if (lanSeen.paired >= 0) for (const p of paired.slice(lanSeen.paired)) toast(fill(T.lanNewPaired, { name: p.name, time: clock(p.at) }), "ok");
  lanSeen.paired = paired.length;
  if (lanSeen.wired || !lan.reopen) return;
  lanSeen.wired = true;
  const ask = (path, said) => post(path, {}).then((r) => (r.ok ? r.json() : null)).then((again) => { if (!again) return; $("#lanQr").innerHTML = again.qr; $("#lanCode").textContent = again.code; showPairing(again); if (said) toast(said, "ok"); }).catch(() => undefined);
  $("#lanReopen").addEventListener("click", () => ask(lan.reopen, T.lanReopened));
  $("#lanSeen").addEventListener("click", () => ask(lan.seen, ""));
}
// The list answered by the server, read back from its file after each change (0431, 0683):
// each device's name (typed here), paired on, last seen, address, its 30 days of counts.
const lanDevices = { paths: null, count: 0, wired: false };
function devicePost(path, body, said) {
  return post(path, body).then((r) => (r.ok ? r.json() : null)).then((again) => { if (!again) return false; showPhones(again, lanDevices.paths, true); if (said) toast(said, "ok"); return true; }).catch(() => false);
}
function deviceLine(phone, list) {
  const paths = lanDevices.paths;
  const item = document.createElement("li");
  const name = document.createElement("input");
  name.value = phone.name;
  name.maxLength = 40;
  name.setAttribute("aria-label", T.lanRename);
  const rename = document.createElement("button");
  rename.type = "button";
  rename.textContent = T.lanRename;
  rename.addEventListener("click", () => { rename.disabled = true; devicePost(paths.rename, { id: phone.id, name: name.value }, T.lanRenamed).then((ok) => { rename.disabled = ok; }); });
  const forget = document.createElement("button");
  forget.type = "button";
  forget.textContent = list.dataset.forget;
  forget.addEventListener("click", () => { forget.disabled = true; devicePost(paths.forget, { id: phone.id }, "").then((ok) => { forget.disabled = ok; }); });
  const facts = document.createElement("small");
  const seen = phone.seen ? `${new Date(phone.seen).toLocaleDateString()} ${clock(phone.seen)}` : T.lanNeverSeen;
  facts.textContent = `${phone.tv ? T.lanTv + " · " : ""}${fill(T.lanDevice, { paired: phone.paired, seen, address: phone.address || "?" })}`;
  const did = document.createElement("small");
  const sum = (key) => phone.days.reduce((total, day) => total + (day[key] || 0), 0);
  did.textContent = phone.days.length ? fill(T.lanActivity, { pages: sum("pages"), pictures: sum("pictures"), day: phone.days[0].day }) : T.lanNoActivity;
  did.title = phone.days.map((d) => `${d.day}: ${d.pages || 0} / ${d.pictures || 0}`).join("\n");
  item.append(name, rename, forget, facts, did);
  return item;
}
function showPhones(answer, paths, force) {
  const list = $("#lanPhoneList");
  if (!force && list.contains(document.activeElement)) return;  // a name being typed: kept until the next poll
  lanDevices.paths = paths;
  lanDevices.count = answer.phones.length;
  list.replaceChildren(...answer.phones.map((phone) => deviceLine(phone, list)));
  const expired = answer.expired || [];
  $("#lanExpired").textContent = expired.length ? fill(T.lanExpired, { names: expired.join(", ") }) : "";
  $("#lanExpired").hidden = expired.length === 0;
  $("#lanForgetAll").hidden = answer.phones.length === 0;
  $("#lanPhones").hidden = answer.phones.length === 0 && expired.length === 0;
  if (lanDevices.wired) return;
  lanDevices.wired = true;
  // Forget every device (0683): the shared question (0663), then the list read back.
  $("#lanForgetAll").addEventListener("click", async () => {
    if (!await window.mhAsk({ lines: [fill(T.lanForgetSure, { count: lanDevices.count })], yes: T.lanForgetYes, danger: true })) return;
    devicePost(lanDevices.paths.forgetAll, {}, T.lanForgotAll);
  });
}
// The phone's app (0432): the worker keeps the offline page; iOS never invites to install, a line says how.
function asApp() {
  if (!REMOTE) return;
  if (window.isSecureContext && "serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(() => undefined);
  const ios = /iPhone|iPad/.test(navigator.userAgent);
  const standalone = navigator.standalone || window.matchMedia("(display-mode: standalone)").matches;
  if (ios && !standalone) toast(T.addToHome);
}
function begin() {
  index();
  asApp();
  applyTheme(store.get("theme", "auto"), false);
  const wanted = decodeURIComponent((location.hash || "").slice(1));
  view.id = SPACE[wanted] ? wanted : HOME;
  if (!wired) { wired = true; wire(); }
  render();
  setNav(false, false);
  // Enter runs the next step, as in `mh menu`: its button has the focus.
  const first = $("#heroRun");
  if (view.id === HOME && first) first.focus({ preventScroll: true });
  pollAudit();
}

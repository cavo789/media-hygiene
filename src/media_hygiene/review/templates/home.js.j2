{# The script of home.html.j2: draws the state, sends the step chosen, waits for mh to bring the page back. #}
(() => {
  const T = {{ texts | tojson }};
  const statePath = {{ state_path | tojson }};
  const stepPath = {{ step_path | tojson }};
  const auditPath = {{ audit_path | tojson }};
  const POLL_MS = 1000;
  const byId = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
  const element = (tag, text, css) => {
    const made = document.createElement(tag);
    if (text) made.textContent = text;
    if (css) made.className = css;
    return made;
  };
  const setStatus = (text, kind) => {
    byId("status").textContent = text;
    byId("status").className = kind || "";
  };

  // After a step is chosen the server ends; mh runs the step, then opens the page again on
  // the same port. The page reloads once the server was seen gone, then answering again.
  const waitForComeBack = () => {
    let seenGone = false;
    const poll = () => {
      fetch(statePath, { cache: "no-store" })
        .then((response) => {
          if (response.ok && seenGone) window.location.reload();
          else window.setTimeout(poll, POLL_MS);
        })
        .catch(() => {
          seenGone = true;
          window.setTimeout(poll, POLL_MS);
        });
    };
    window.setTimeout(poll, POLL_MS);
  };

  const choose = (number, command) => {
    for (const button of document.querySelectorAll("button")) button.disabled = true;
    fetch(stepPath, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ number: number, command: command }) })
      .then((response) => response.json().then((body) => ({ ok: response.ok, status: response.status, body: body })))
      .then((reply) => {
        if (!reply.ok) {
          setStatus(reply.body.error || fill(T.failed, { status: reply.status }), "error");
          load();
          return;
        }
        byId("runningCommand").textContent = fill(T.runningCommand, { command: reply.body.command });
        byId("running").hidden = false;
        waitForComeBack();
      })
      .catch(() => setStatus(T.offline, "error"));
  };

  const runButton = (step) => {
    const button = element("button", T.run);
    button.type = "button";
    button.title = T.runTitle;
    button.addEventListener("click", () => choose(step.number, step.command));
    return button;
  };

  const drawNext = (state) => {
    const next = state.proposed;
    const button = byId("nextButton");
    byId("why").textContent = next ? next.why : T.nothingLeft;
    button.hidden = !next;
    if (!next) return;
    button.textContent = next.command;
    button.title = T.runTitle;
    button.onclick = () => choose(next.number, next.command);
  };

  const drawWhere = (state) => {
    const lines = byId("lines");
    lines.replaceChildren(...state.lines.map((line) => element("li", line)));
    byId("undo").hidden = !state.undo;
    byId("undo").textContent = state.undo || "";
  };

  const drawFound = (state) => {
    byId("found").hidden = state.previews.length === 0;
    byId("previews").replaceChildren(...state.previews.map((url) => {
      const image = element("img");
      image.src = url;
      image.alt = "";
      image.loading = "lazy";
      return image;
    }));
  };

  const link = (text, url, detail) => {
    const item = element("li");
    const anchor = element("a", text);
    anchor.href = url;
    anchor.target = "_blank";
    item.append(anchor);
    if (detail) item.append(" — " + detail);
    return item;
  };

  const drawReports = (state) => {
    const items = state.reports.map((report) => link(report.label, report.url, report.when));
    if (state.index) items.push(link(T.everyReport, state.index, ""));
    if (items.length === 0) items.push(element("li", T.noReport, "muted"));
    byId("reports").replaceChildren(...items);
  };

  const stepRow = (step) => {
    const row = element("tr", "", step.done ? "done" : step.proposed ? "proposed" : "");
    row.append(element("td", step.proposed ? "👉" : step.done ? "✅" : "", "mark"));
    row.append(element("td", step.number ? String(step.number) : "", "number"));
    const command = element("td", "", "command");
    command.append(element("code", step.command));
    row.append(command);
    row.append(element("td", step.typed ? step.text + " " + T.typeIt : step.text));
    row.append(element("td", step.badges.join(" "), "badges"));
    const action = element("td");
    if (step.number) action.append(runButton(step));
    row.append(action);
    return row;
  };

  const drawGuides = (state) => {
    byId("guides").replaceChildren(...state.sections.map((section) => {
      const box = element("section");
      box.append(element("h2", section.title));
      const table = element("table");
      table.append(...section.steps.map(stepRow));
      box.append(table);
      return box;
    }));
  };

  const load = () => fetch(statePath, { cache: "no-store" })
    .then((response) => response.json())
    .then((state) => {
      drawNext(state);
      drawWhere(state);
      drawFound(state);
      drawReports(state);
      drawGuides(state);
      for (const button of document.querySelectorAll("button")) button.disabled = false;
    })
    .catch(() => setStatus(T.offline, "error"));

  // The audit run by the page: its steps polled while it runs, then its summary.
  const drawAudit = (audit) => {
    const running = audit.phase === "running";
    byId("auditStart").hidden = running;
    byId("auditStop").hidden = !running;
    byId("auditSteps").replaceChildren(...audit.steps.map((step) => {
      const counts = step.total === null ? step.done.toLocaleString() : step.done.toLocaleString() + " / " + step.total.toLocaleString();
      const item = element("li", (step.finished ? "✔ " : "⏳ ") + step.title + " — " + counts, step.finished ? "finished" : "");
      if (step.hint && !step.finished) item.title = step.hint;
      return item;
    }));
    byId("auditCurrent").textContent = running ? (audit.current || T.auditRunning) : "";
    const end = byId("auditEnd");
    end.replaceChildren(...audit.lines.map((line) => element("p", line)), ...audit.actions.map((line) => element("p", line)));
    if (audit.report) {
      const paragraph = element("p");
      const anchor = element("a", T.auditOpen);
      anchor.href = audit.report;
      anchor.target = "_blank";
      paragraph.append(anchor);
      end.append(paragraph);
    }
    if (audit.error) end.append(element("p", audit.error, "muted"));
    return running;
  };
  const pollAudit = () => fetch(auditPath, { cache: "no-store" })
    .then((response) => response.json())
    .then((audit) => {
      if (drawAudit(audit)) window.setTimeout(pollAudit, POLL_MS);
      else if (audit.phase !== "idle") load();
    })
    .catch(() => setStatus(T.offline, "error"));
  const askAudit = (action) => fetch(auditPath, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: action }) })
    .then((response) => response.json().then((body) => ({ ok: response.ok, body: body })))
    .then((reply) => {
      if (!reply.ok) setStatus(reply.body.error || T.auditBusy, "error");
      pollAudit();
    })
    .catch(() => setStatus(T.offline, "error"));
  byId("auditStart").addEventListener("click", () => askAudit("start"));
  byId("auditStop").addEventListener("click", () => askAudit("stop"));

  byId("legend").textContent = fill(T.legend, { safe: "🔒", undo: "↩️", final: "⚠️" });
  load();
  pollAudit();
})();

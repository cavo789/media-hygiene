{% extends "page_frame.html.j2" %}
{# The keyboard review of a classify proposal, served by `media-hygiene review-sort`.
   The page never touches a photo nor the workbook: each choice is sent to the server,
   which saves sort-decisions.json; `sort` lays it over the workbook's edits. #}
{% set texts = {
  "position": _("Event {number} of {total}"),
  "totals": _("Chosen here: {chosen} · still to decide: {open}"),
  "files": _("{files}, {undecided} to check or to sort"),
  "share": _("naming the events up to this one covers {share}%% of the work"),
  "from": _("From:"),
  "state": _("Status:"),
  "proposed": _("proposed by classify ({why}), not validated yet"),
  "dirty": _("changed, not saved yet: Enter saves it, Esc drops it"),
  "validated": _("validated here at {time}"),
  "validatedEarlier": _("validated here"),
  "inWorkbook": _("decided in the workbook: {value}"),
  "leave": _("The folder typed for this event is not saved. Save it before leaving? (Cancel: stay on this event)"),
  "already": _("{n} already there"),
  "nothing": _("nothing"),
  "stay": _("(stay where it is)"),
  "conflict": _("The workbook was edited otherwise since this choice: choose again here, or press Delete to let the workbook decide."),
  "left": "🔒 " ~ _("left as it is"),
  "noPreview": _("no preview"),
  "saving": _("Saving…"),
  "saved": _("Saved."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The review is not running any more: start it again."),
  "first": _("This is the first event."),
  "last": _("This is the last event: stop the review with Ctrl+C in the terminal."),
  "noOpen": _("No event left to decide after this one."),
  "sendTo": _("Send the photos ({count}) to the category:"),
  "sureMark": "✔ " ~ _("sure: V accepts it with the other sure proposals"),
  "sure": "✔ " ~ _("Accept {sure} ({files})"),
  "sureNone": _("No sure proposal left to accept."),
  "sureAsk": _("Events to decide with a sure proposal: {count}. Each one gets its proposed category, as Enter would give it, saved in one write: {moves} move, {kept} keep the folder you named. Events to decide left to look at: {left}. Accept them? The ↶ button takes the whole batch back."),
  "ownFolder": _("its own folder"),
  "sureDone": _("{done}, read back from the disk at {time}: the ↶ button takes the whole batch back."),
  "sureUndo": "↶ " ~ _("Take the batch back ({events})"),
  "sureUndone": _("{undone}, read back from the disk at {time}."),
  "nothingToUndo": _("Nothing to undo."),
  "nFiles": [ngettext("{n} file", "{n} files", 1), ngettext("{n} file", "{n} files", 2)],
  "nEvents": [ngettext("{n} event", "{n} events", 1), ngettext("{n} event", "{n} events", 2)],
  "nGo": [ngettext("{n} file goes to", "{n} files go to", 1), ngettext("{n} file goes to", "{n} files go to", 2)],
  "nStay": [ngettext("{n} file stays where it is", "{n} files stay where they are", 1), ngettext("{n} file stays where it is", "{n} files stay where they are", 2)],
  "nElsewhere": [ngettext("{n} file sent elsewhere, one by one", "{n} files sent elsewhere, one by one", 1), ngettext("{n} file sent elsewhere, one by one", "{n} files sent elsewhere, one by one", 2)],
  "nKept": [ngettext("{n} file keeps its own folder", "{n} files keep their own folder", 1), ngettext("{n} file keeps its own folder", "{n} files keep their own folder", 2)],
  "nSure": [ngettext("{n} sure proposal", "{n} sure proposals", 1), ngettext("{n} sure proposal", "{n} sure proposals", 2)],
  "nSureDone": [ngettext("{n} sure proposal accepted", "{n} sure proposals accepted", 1), ngettext("{n} sure proposal accepted", "{n} sure proposals accepted", 2)],
  "nUndone": [ngettext("{n} choice of the batch taken back", "{n} choices of the batch taken back", 1), ngettext("{n} choice of the batch taken back", "{n} choices of the batch taken back", 2)],
} %}
{% set page_name = _("Sort review") %}
{% set keys_safe = _("Every choice is saved at once in %(place)s; the workbook %(workbook)s is never changed. Done? Ctrl+C in the terminal stops the review; then 'sort' applies your choices on top of the workbook.", place=decisions, workbook=workbook) %}
{% block style %}
  main { padding: 12px 16px 24px; }
  h2 { margin: 0 0 4px; font-size: 1.2rem; overflow-wrap: anywhere; }
  .muted { color: var(--muted); } dl { margin: 6px 0; } dt { font-weight: 600; float: left; margin-right: 6px; }
  dd { margin: 0 0 2px; overflow-wrap: anywhere; }
  #status.error, .conflict { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  form { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: end; margin: 10px 0; }
  label { display: flex; flex-direction: column; font-size: .85rem; color: var(--muted); }
  input { min-width: 16rem; padding: 6px 8px; font: inherit; color: var(--text); background: var(--bg);
          border: 1px solid var(--line); border-radius: 6px; }
  input:focus { outline: 2px solid var(--accent); }
  #send[hidden] { display: none; }
  .photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .photo { position: relative; margin: 0; padding: 6px; background: var(--card);
           border: 2px solid var(--line); border-radius: 10px; }
  .photo img, .photo .none { display: block; width: 100%; height: 150px; object-fit: contain;
                             border-radius: 6px; background: var(--bg); }
  .photo .none { display: grid; place-items: center; color: var(--muted); }
  .photo.cursor { outline: 3px solid var(--accent); outline-offset: 1px; }
  .photo.selected { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--card)); }
  .photo.chosen { border-color: var(--ok); } .photo.conflicting { border-color: var(--bad); }
  figcaption { margin-top: 4px; font-size: .8rem; overflow-wrap: anywhere; }
  .badge { font-weight: 600; } .chosen .badge { color: var(--ok); }
  #zoom { position: fixed; inset: 0; z-index: 2; display: grid; place-items: center;
          background: rgb(0 0 0 / 85%); }
  #zoom[hidden] { display: none; } #zoom img { max-width: 96vw; max-height: 94vh; }
  .batch { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; margin-left: auto; }
  label.filter { flex-direction: row; gap: 4px; align-items: center; color: var(--text); }
  button { padding: 4px 10px; font: inherit; color: var(--text); background: var(--bg);
           border: 1px solid var(--line); border-radius: 6px; cursor: pointer; }
  button:disabled { color: var(--muted); cursor: default; } button[hidden] { display: none; }
  #sure:not(:disabled) { border-color: var(--ok); color: var(--ok); font-weight: 600; }
  /* The event in the left column; its folder and destination in the bar, on lines of their own,
     the same height whatever is chosen; its photos under them. */
  #bar > .break { flex-basis: 100%; height: 0; }
  #bar > form { margin: 0; }
  #bar form label { flex-direction: row; align-items: center; gap: 6px; }
  #bar form input { min-width: 10rem; }
  #bar label.folder { flex: 1 1 32rem; }
  #bar .path { display: flex; flex: 1; align-items: center; gap: 2px; }
  #bar .path input { flex: 1; min-width: 16rem; }
  #naming summary { cursor: pointer; color: var(--muted); font-size: .85rem; }
  #destination { flex-basis: 100%; overflow-wrap: anywhere; }
  #destination.error { color: var(--bad); }
  .dirty { color: var(--warn, var(--bad)); font-weight: 600; }
  .batch input[type=checkbox] { min-width: 0; }
{% endblock %}
{% block side %}
  <section id="toc" aria-label="{{ _('The event shown') }}">
    <h2 id="title"></h2>
    <div id="summary" class="muted"></div>
    <dl id="facts"></dl>
    <p id="conflict" class="conflict" hidden></p>
  </section>
{% endblock %}
{% block keys %}
    <dt><kbd>Enter</kbd></dt><dd>{{ _("save the folder, then the next event to decide") }}</dd>
    <dt><kbd>N</kbd> <kbd>P</kbd></dt><dd>{{ _("next or previous event") }}</dd>
    <dt><kbd>U</kbd></dt><dd>{{ _("next event to decide") }}</dd>
    <dt><kbd>F</kbd></dt><dd>{{ _("type the folder of the event") }}</dd>
    <dt><kbd>E</kbd></dt><dd>{{ _("change the name of the event (by default, the last folder)") }}</dd>
    <dt><kbd>␣</kbd></dt><dd>{{ _("select a photo") }}</dd>
    <dt><kbd>O</kbd></dt><dd>{{ _("send the selected photos to another category") }}</dd>
{% endblock %}
{% block more_keys %}
    <dt><kbd>V</kbd></dt><dd>{{ _("accept every sure proposal at once") }}</dd>
    <dt><kbd>Shift</kbd>+<kbd>Z</kbd></dt><dd>{{ _("take back the last batch of sure proposals") }}</dd>
    <dt><kbd>Shift</kbd>+<kbd>S</kbd></dt><dd>{{ _("leave the whole event where it is") }}</dd>
    <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>{{ _("move between photos") }}</dd>
    <dt><kbd>S</kbd></dt><dd>{{ _("leave the selected photos where they are") }}</dd>
    <dt><kbd>Delete</kbd></dt><dd>{{ _("take back the choice made here (of the selected photos, else of the event)") }}</dd>
    <dt><kbd>Z</kbd></dt><dd>{{ _("enlarge a photo") }}</dd>
    <dt><kbd>Esc</kbd></dt><dd>{{ _("leave a field; drop the folder typed and not saved") }}</dd>
{% endblock %}
{% block bar %}
  <strong id="position"></strong>
  <span id="totals" class="muted"></span>
  <span id="status" role="status" aria-live="polite"></span>
  <span class="batch">
    <label class="filter" title="{{ _('N, P and U skip the events already chosen and those whose proposal is sure') }}"><input type="checkbox" id="onlyDecide"> {{ _("Only the events to decide") }}</label>
    <button type="button" id="sure" title="{{ _('Accept at once every event still to decide whose proposal is sure (V)') }}"></button>
    <button type="button" id="sureUndo" title="{{ _('Take back the last batch of sure proposals (Shift+Z)') }}" hidden></button>
  </span>
  <span class="break"></span>
  <form id="choice" autocomplete="off">
    <label class="folder">{{ _("Folder") }} <kbd>F</kbd><span class="path"><span id="prefix" class="muted"></span><input id="folder" name="folder" list="categories"></span></label>
    <details id="naming"><summary>{{ _("Name of the event") }} <kbd>E</kbd></summary><input id="name" name="name"></details>
  </form>
  <span id="destination" class="muted" role="status" aria-live="polite"></span>
  <form id="send" autocomplete="off" hidden>
    <label><span id="send-label"></span><input id="send-category" list="categories"></label>
  </form>
  <datalist id="categories"></datalist>
{% endblock %}
{% block content %}
<main>
  <div id="photos" class="photos"></div>
  <div id="zoom" hidden><img alt=""></div>
</main>
{% endblock %}
{% block after %}
<script>
(() => {
  const T = {{ texts | tojson }};
  const P = {{ paths | tojson }};
  const positionKey = "media-hygiene:review-sort:" + {{ decisions | tojson }};
  const byId = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, key) => (key in values ? String(values[key]) : all));
  const plural = new Intl.PluralRules(document.documentElement.lang);
  // A counted fragment: its singular and plural forms, the one the language uses for n.
  const counted = (forms, n) => fill(forms[plural.select(n) === "one" ? 0 : 1], { n: n });
  let events = [];
  let current = 0;
  let photos = [];
  let cursor = 0;
  let selected = new Set();

  const setStatus = (text, kind) => {
    byId("status").textContent = text;
    byId("status").title = text; // the bar shows one line, the whole sentence on hover
    byId("status").className = kind || "";
  };
  const line = (tag, text, css) => {
    const element = document.createElement(tag);
    element.textContent = text;
    if (css) element.className = css;
    return element;
  };
  const isOpen = (card) => card.undecided > 0 && !card.page && !card.workbook.text;

  const showTotals = () => {
    const chosen = events.filter((card) => card.page).length;
    const open = events.filter(isOpen).length;
    byId("totals").textContent = fill(T.totals, { chosen: chosen, open: open });
    showSure();
  };

  const fact = (term, text) => [line("dt", term), line("dd", text || T.nothing)];
  // "3 files keep their own folder (Budva, Cetinje…)" (0385).
  const keptText = (count, folders) => {
    const names = folders.slice(0, 3).join(", ") + (folders.length > 3 ? "…" : "");
    return counted(T.nKept, count) + " (" + names + ")";
  };

  const showEvent = (card) => {
    byId("position").textContent = fill(T.position, { number: current + 1, total: events.length });
    byId("title").textContent = card.title;
    byId("summary").textContent = [card.span, fill(T.files, { files: counted(T.nFiles, card.files), undecided: card.undecided }), fill(T.share, { share: card.share })].join(" · ");
    byId("facts").replaceChildren(...fact(T.from, card.folders.join(" · ")), ...fact(T.state, ""));
    byId("conflict").hidden = !card.conflict;
    byId("conflict").textContent = T.conflict;
    fillChoice(card);
  };

  const figure = (photo, rank) => {
    const element = document.createElement("figure");
    const css = ["photo", rank === cursor ? "cursor" : "", selected.has(photo.row) ? "selected" : "", photo.page ? "chosen" : "", photo.conflict ? "conflicting" : ""];
    element.className = css.join(" ");
    const image = document.createElement("img");
    image.loading = "lazy";
    image.alt = photo.name;
    image.src = photo.thumb;
    image.addEventListener("error", () => image.replaceWith(line("div", "🎞️ " + T.noPreview, "none")));
    const badge = !photo.movable ? T.left : photo.page ? "✅ " + photo.page : photo.workbook ? "📒 " + photo.workbook : "";
    element.append(image, line("figcaption", photo.name), line("div", photo.date, "muted"));
    if (photo.proposed !== events[current].folder) element.append(line("div", "→ " + (photo.proposed || T.stay) + (photo.own ? " · " + T.ownFolder : ""), "muted"));
    if (badge) element.append(line("div", badge, "badge"));
    element.addEventListener("click", () => { cursor = rank; toggle(); });
    return element;
  };

  const showPhotos = () => {
    byId("photos").replaceChildren(...photos.map(figure));
    const shown = byId("photos").children[cursor];
    if (shown) shown.scrollIntoView({ block: "nearest" });
  };

  // While the user decides, the next event's thumbnails (the previous one's when going
  // back) and the zoom of the photos around the cursor are asked for: one event ahead.
  const ahead = async (index) => {
    if (index < 0 || index >= events.length) return;
    try {
      const response = await fetch(P.event + "/" + encodeURIComponent(events[index].id));
      if (!response.ok) return;
      for (const photo of (await response.json()).photos) new Image().src = photo.thumb;
    } catch (error) { /* ahead only: the event is asked for again when shown */ }
  };
  const zoomAhead = () => {
    for (const rank of [cursor, cursor + 1, cursor - 1]) if (photos[rank]) new Image().src = photos[rank].preview;
  };

  const load = async (index) => {
    const back = index < current;
    current = index;
    cursor = 0;
    selected = new Set();
    showEvent(events[current]);
    showTotals();
    byId("photos").replaceChildren();
    const response = await fetch(P.event + "/" + encodeURIComponent(events[current].id));
    if (!response.ok) { setStatus(T.offline, "error"); return; }
    const view = await response.json();
    photos = view.photos;
    showPhotos();
    zoomAhead();
    ahead(back ? index - 1 : index + 1);
    try { window.localStorage.setItem(positionKey, events[current].id); } catch (error) { /* private browsing */ }
  };

  const send = async (path, body, then) => {
    const index = current;
    setStatus(T.saving);
    let response;
    try {
      response = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    } catch (error) { setStatus(T.offline, "error"); return; }
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) { setStatus(answer.error || fill(T.failed, { status: response.status }), "error"); return; }
    events[index] = answer.card;
    if (index !== current) return;
    photos = answer.photos;
    selected = new Set();
    setStatus(T.saved, "saved");
    if (then) then(); else { showEvent(answer.card); showTotals(); showPhotos(); }
  };

{% include "sort_review_sure.js.j2" %}
{% include "sort_review_choice.js.j2" %}

  const go = (step) => {
    if (!mayLeave(() => go(step))) return;
    let next = current + step;
    while (next >= 0 && next < events.length && !visible(events[next])) next += step;
    if (next < 0 || next >= events.length) { setStatus(next < 0 ? T.first : T.last); return; }
    setStatus("");
    load(next);
    window.scrollTo(0, 0);
  };
  const goOpen = () => {
    if (!mayLeave(goOpen)) return;
    const next = events.findIndex((card, index) => index > current && isOpen(card) && visible(card));
    if (next < 0) { setStatus(T.noOpen); showEvent(events[current]); showTotals(); showPhotos(); return; }
    load(next);
    window.scrollTo(0, 0);
  };

  const id = () => events[current].id;
  const chosenRows = () => (selected.size ? [...selected] : photos[cursor] ? [photos[cursor].row] : []);
  const accept = () => { const body = choiceBody(); markSaved(); send(P.event, body, goOpen); };
  const stayEvent = () => send(P.event, { event: id(), stay: true }, goOpen);
  const toggle = () => {
    const photo = photos[cursor];
    if (!photo) return;
    if (selected.has(photo.row)) selected.delete(photo.row); else selected.add(photo.row);
    showPhotos();
  };
  const openSend = () => {
    if (!photos.length) return;
    byId("send").hidden = false;
    byId("send-label").textContent = fill(T.sendTo, { count: chosenRows().length });
    byId("send-category").value = "";
    byId("send-category").focus();
  };
  const closeSend = () => { byId("send").hidden = true; };

  // Two fields and no button: browsers do not submit on Enter, the page does.
  byId("choice").addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    event.preventDefault();
    event.stopPropagation();
    document.activeElement.blur();
    accept();
  });
  byId("send").addEventListener("submit", (event) => {
    event.preventDefault();
    const category = byId("send-category").value;
    closeSend();
    send(P.files, { event: id(), rows: chosenRows(), category: category });
  });
  document.addEventListener("keydown", (event) => {
    const zoom = byId("zoom");
    if (event.key === "Escape") {
      zoom.hidden = true;
      closeSend();
      if (choiceDirty()) dropChoice();
      document.activeElement.blur();
      return;
    }
    const typing = ["INPUT", "TEXTAREA"].includes(document.activeElement.tagName);
    if (typing || event.ctrlKey || event.metaKey || event.altKey || events.length === 0) return;
    const key = event.key;
    if (key === "Enter") accept();
    else if (key === "n" || key === "N" || key === "PageDown") go(1);
    else if (key === "p" || key === "P" || key === "PageUp") go(-1);
    else if (key === "u" || key === "U") goOpen();
    else if (key === "v" || key === "V") acceptSure();
    else if (key === "S") stayEvent();
    else if (key === "s") send(P.files, { event: id(), rows: chosenRows(), stay: true });
    else if (key === "o" || key === "O") openSend();
    else if (key === "Delete" || key === "Backspace") send(P.forget, { event: id(), rows: [...selected] });
    else if (key === "ArrowRight" || key === "ArrowLeft") {
      cursor = Math.max(0, Math.min(photos.length - 1, cursor + (key === "ArrowRight" ? 1 : -1)));
      showPhotos();
      zoomAhead();
    } else if (key === " ") toggle();
    else if (key === "e" || key === "E") { byId("naming").open = true; byId("name").focus(); }
    else if (key === "f" || key === "F" || key === "c" || key === "C") byId("folder").focus();
    else if (key === "Z" && event.shiftKey) undoSure();
    else if ((key === "z" || key === "Z") && photos[cursor]) {
      zoom.firstElementChild.src = photos[cursor].preview;
      zoom.hidden = !zoom.hidden;
    } else return;
    event.preventDefault();
  });
  byId("zoom").addEventListener("click", () => { byId("zoom").hidden = true; });
  byId("sure").addEventListener("click", acceptSure);
  byId("sureUndo").addEventListener("click", undoSure);
  const filterKey = positionKey + ":only-to-decide";
  try { byId("onlyDecide").checked = window.localStorage.getItem(filterKey) === "1"; } catch (error) { /* private browsing */ }
  byId("onlyDecide").addEventListener("change", (event) => {
    try { window.localStorage.setItem(filterKey, event.target.checked ? "1" : "0"); } catch (error) { /* private browsing */ }
    event.target.blur();  // the keys work again
  });

  fetch(P.state)
    .then((response) => response.json())
    .then((state) => {
      events = state.events;
      byId("categories").replaceChildren(...state.categories.map((name) => Object.assign(document.createElement("option"), { value: name })));
      let saved = "";
      try { saved = window.localStorage.getItem(positionKey) || ""; } catch (error) { saved = ""; }
      const resumed = events.findIndex((card) => card.id === saved);
      const first = events.findIndex(isOpen);
      showSure();
      if (events.length) load(resumed >= 0 ? resumed : Math.max(first, 0));
    })
    .catch(() => setStatus(T.offline, "error"));
})();
</script>
{% endblock %}

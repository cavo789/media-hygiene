{% extends "page_frame.html.j2" %}
{# The keyboard review of a classify proposal, served by `media-hygiene review-sort`.
   The page never touches a photo nor the workbook: each choice is sent to the server,
   which saves sort-decisions.json; `sort` lays it over the workbook's edits. The photos of
   the event shown are a page of photos to pick like `browse` (`pick_*` in review/templates,
   skill photo-picking-pages, 0389): the same gestures pick photos, the bar's buttons send
   them to another folder (O), take back the choice made here, or leave them where they
   are (S). No Delete to set aside: Delete takes back a choice made here. #}
{% set texts = {
  "position": _("Event {number} of {total}"),
  "totals": _("Chosen here: {chosen} · still to decide: {open}"),
  "files": _("{files}, {undecided} to check or to sort"),
  "share": _("naming the events up to this one covers {share}%% of the work"),
  "from": _("From:"),
  "state": _("Status:"),
  "proposed": _("proposed by classify ({why}), not validated yet"),
  "dirty": _("changed, not saved yet: Enter saves it, Esc drops it"),
  "validated": _("validated here at {time}"),
  "validatedEarlier": _("validated here"),
  "inWorkbook": _("decided in the workbook: {value}"),
  "leave": _("The folder typed for this event is not saved. Save it before leaving? (Cancel: stay on this event)"),
  "already": _("{n} already there"),
  "nothing": _("nothing"),
  "stay": _("(stay where it is)"),
  "conflict": _("The workbook was edited otherwise since this choice: choose again here, or press Delete to let the workbook decide."),
  "left": "🔒 " ~ _("left as it is"),
  "leftAll": _("These photos are left as they are: no choice applies to them."),
  "noPreview": _("no preview"),
  "saving": _("Saving…"),
  "saved": _("Saved."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The review is not running any more: start it again."),
  "first": _("This is the first event."),
  "last": _("This is the last event: stop the review with Ctrl+C in the terminal."),
  "noOpen": _("No event left to decide after this one."),
  "sendTo": _("Send the photos ({count}) to the folder, under the year:"),
  "sureMark": "✔ " ~ _("sure: V accepts it with the other sure proposals"),
  "sure": "✔ " ~ _("Accept {sure} ({files})"),
  "sureNone": _("No sure proposal left to accept."),
  "sureAsk": _("Events to decide with a sure proposal: {count}. Each one gets its proposed folder, as Enter would give it, saved in one write: {moves} move, {kept} keep the folder you named. Events to decide left to look at: {left}. Click an event to look at it first; the ↶ button takes the whole batch back."),
  "sureAccept": _("Accept them"),
  "sortAsk": _("Sort this event now? {destination}. Its files are moved at once, journaled: 'undo' puts them back. The other events are left for later."),
  "sorting": _("Sorting the files of this event…"),
  "sortedNow": _("{moved} moved, {verified} checked at their new place (run {run}, at {time}): 'undo {run}' puts them back."),
  "sortedNothing": _("Every file of this event is already in its folder: nothing to move."),
  "sortedNotIntact": _("The run {run} ended, but its manifest does not check out: look at it before going on."),
  "sortedState": _("sorted: its files are in their folders"),
  "ruleFact": _("Rule:"),
  "rulePreview": _("This rule would take {files}: {mine} of this event, {others} of other events or folders on the same days."),
  "ruleFolders": _("Elsewhere: {folders}."),
  "ruleOverlaps": _("It shares days with {rules}: the first listed in config.toml wins on those days."),
  "ruleTaken": _("A rule is already named so: choose another name."),
  "rulesRun": _("As decided by the classify run {run}: run classify again to see the rules you changed at work."),
  "nDead": [ngettext("{n} rule decided nothing.", "{n} rules decided nothing.", 1), ngettext("{n} rule decided nothing.", "{n} rules decided nothing.", 2)],
  "rulesNone": _("Every rule decided something."),
  "rulesRemoveAll": _("Remove the {count} rules that decided nothing"),
  "rulesRemoveAsk": _("Remove these rules from config.toml? {names}"),
  "rulesRemoved": _("Removed from config.toml, read back at {time}: {names}."),
  "rulesRemove": _("Remove"),
  "rulesConvert": _("Turn into dates"),
  "rulesBuiltIn": _("built in: its folder names the category"),
  "rulesLost": _("{n} files the old rule decided are not taken any more."),
  "ruleSaved": _("Rule '{name}' ({dates}) saved in config.toml, read back at {time}: the next classify applies it; this event's folder is chosen too."),
  "cancel": _("Cancel"),
  "ownFolder": _("its own folder"),
  "sureDone": _("{done}, read back from the disk at {time}: the ↶ button takes the whole batch back."),
  "sureUndo": "↶ " ~ _("Take the batch back ({events})"),
  "sureUndone": _("{undone}, read back from the disk at {time}."),
  "nothingToUndo": _("Nothing to undo."),
  "nFiles": [ngettext("{n} file", "{n} files", 1), ngettext("{n} file", "{n} files", 2)],
  "nEvents": [ngettext("{n} event", "{n} events", 1), ngettext("{n} event", "{n} events", 2)],
  "nGo": [ngettext("{n} file goes to", "{n} files go to", 1), ngettext("{n} file goes to", "{n} files go to", 2)],
  "nStay": [ngettext("{n} file stays where it is", "{n} files stay where they are", 1), ngettext("{n} file stays where it is", "{n} files stay where they are", 2)],
  "nElsewhere": [ngettext("{n} file sent elsewhere, one by one", "{n} files sent elsewhere, one by one", 1), ngettext("{n} file sent elsewhere, one by one", "{n} files sent elsewhere, one by one", 2)],
  "nKept": [ngettext("{n} file keeps its own folder", "{n} files keep their own folder", 1), ngettext("{n} file keeps its own folder", "{n} files keep their own folder", 2)],
  "nSure": [ngettext("{n} sure proposal", "{n} sure proposals", 1), ngettext("{n} sure proposal", "{n} sure proposals", 2)],
  "nSureDone": [ngettext("{n} sure proposal accepted", "{n} sure proposals accepted", 1), ngettext("{n} sure proposal accepted", "{n} sure proposals accepted", 2)],
  "nUndone": [ngettext("{n} choice of the batch taken back", "{n} choices of the batch taken back", 1), ngettext("{n} choice of the batch taken back", "{n} choices of the batch taken back", 2)],
} %}
{% set pick_texts = {
  "picked": [ngettext("{n} photo picked", "{n} photos picked", 1), ngettext("{n} photo picked", "{n} photos picked", 2)],
  "aside": "✅ " ~ _("chosen here"),
  "tick": _("Pick this photo"),
  "saving": _("Saving…"),
  "notSaved": _("Nothing was saved: {error}"),
  "offline": _("The review is not running any more: start it again."),
  "failed": _("Not saved (error {status})."),
} %}
{% set page_name = _("Sort review") %}
{% set pick_all = _("every photo of the event") %}
{% set pick_marks = false %}
{% set pick_album = false %}
{% set keys_safe = _("Every choice is saved at once in %(place)s; the workbook %(workbook)s is never changed. Done? Ctrl+C in the terminal stops the review; then 'sort' applies your choices on top of the workbook.", place=decisions, workbook=workbook) %}
{% block style %}
{% include "pick_grid.css.j2" %}
  h2 { margin: 0 0 4px; font-size: 1.2rem; overflow-wrap: anywhere; }
  .muted { color: var(--muted); } #facts { margin: 6px 0; } #facts dt { font-weight: 600; float: left; margin-right: 6px; }
  #facts dd { margin: 0 0 2px; overflow-wrap: anywhere; }
  .conflict { color: var(--bad); font-weight: 600; } #chosen.saved { color: var(--ok); }
  #bar form { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 0; }
  #bar form label { display: flex; flex-direction: row; align-items: center; gap: 6px; }
  #bar form input { min-width: 10rem; }
  input:focus { outline: 2px solid var(--accent); }
  .file .meta .proposed { color: var(--muted); overflow-wrap: anywhere; }
  .file.conflicting { border-color: var(--bad); }
  /* The event above, its keys below: the keys never take the whole column (they scroll). */
  #toc { min-height: 40%; }
  #keys { flex: 0 1 auto; min-height: 0; overflow: auto; }
  .file .badge { background: var(--ok); } /* chosen here: no file is set aside on this page */
  #eventNav { display: flex; gap: 6px; align-items: center; }
  #eventNav button { padding: 2px 10px; }
  .batch { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; margin-left: auto; }
  label.filter { display: flex; flex-direction: row; gap: 4px; align-items: center; color: var(--text); }
  button[hidden], #leavePicked[hidden] { display: none; }
  #sure:not(:disabled) { font-weight: 600; }
  /* The event in the left column; its folder and destination in the bar, on lines of their own,
     the same height whatever is chosen or picked: the grid never moves. */
  #bar > .break { flex-basis: 100%; height: 0; }
  #bar label.folder { flex: 1 1 32rem; }
  #bar .path { display: flex; flex: 1; align-items: center; gap: 2px; }
  #bar .path input { flex: 1; min-width: 16rem; }
  #naming summary { cursor: pointer; color: var(--muted); font-size: .85rem; }
  #destination { flex-basis: 100%; overflow-wrap: anywhere; font-size: .85rem; }
  #destination.error { color: var(--bad); }
  .dirty { color: var(--warn, var(--bad)); font-weight: 600; }
  #sortNow { margin-left: auto; }
  .batch input[type=checkbox] { min-width: 0; }
  dialog { max-width: min(56rem, 94vw); color: var(--text); background: var(--card);
           border: 1px solid var(--line); border-radius: 10px; }
  dialog::backdrop { background: rgb(0 0 0 / 50%); }
  #sureDlg ol { max-height: 55vh; overflow: auto; padding-left: 1.6rem; }
  #sureDlg li { margin: 2px 0; overflow-wrap: anywhere; }
  #sureDlg li button { border: 0; padding: 0; color: var(--accent); background: none; text-decoration: underline; }
  dialog menu { display: flex; gap: 8px; justify-content: end; padding: 0; }
  #sendDlg label, #ruleDlg label { display: flex; flex-direction: column; gap: 6px; margin: 6px 0; color: var(--text); }
  #ruleDlg label.filter { flex-direction: row; } #ruleDlg h2 { margin: 0 0 6px; }
  #rulePreview.error, #rulesSaid.error { color: var(--bad); } #rulesSaid.saved { color: var(--ok); }
  #rulesDlg { width: min(60rem, 94vw); } #rulesDlg table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  #rulesDlg tbody { display: block; max-height: 55vh; overflow: auto; } #rulesDlg thead, #rulesDlg tbody tr { display: table; width: 100%; table-layout: fixed; }
  #rulesDlg td, #rulesDlg th { padding: 3px 6px; text-align: left; border-bottom: 1px solid var(--line); overflow-wrap: anywhere; }
  #rulesDlg tr.dead td:nth-child(3) { color: var(--bad); font-weight: 600; }
  #sendDlg input { min-width: 24rem; }
{% endblock %}
{% block side %}
  <section id="toc" aria-label="{{ _('The event shown') }}">
    <h2 id="title"></h2>
    <div id="summary" class="muted"></div>
    <dl id="facts"></dl>
    <p id="conflict" class="conflict" hidden></p>
    <p><button type="button" id="rulesOpen" class="plain">📌 {{ _("Your rules") }}</button></p>
  </section>
{% endblock %}
{% block keys %}
    <dt><kbd>Enter</kbd></dt><dd>{{ _("save the folder, then the next event") }}</dd>
{% include "pick_keys.html.j2" %}
    <dt><kbd>O</kbd> <kbd>S</kbd></dt><dd>{{ _("the picked photos: to another folder, or left where they are") }}</dd>
{% endblock %}
{% block more_keys %}
    <dt><kbd>Enter</kbd></dt><dd>{{ _("no photo framed: save the folder, then the next event to decide") }}</dd>
    <dt><kbd>N</kbd> <kbd>P</kbd></dt><dd>{{ _("next or previous event (the ← → buttons of the bar)") }}</dd>
    <dt><kbd>U</kbd></dt><dd>{{ _("next event to decide") }}</dd>
    <dt><kbd>F</kbd></dt><dd>{{ _("type the folder of the event") }}</dd>
    <dt><kbd>E</kbd></dt><dd>{{ _("change the name of the event (by default, the last folder)") }}</dd>
    <dt><kbd>M</kbd></dt><dd>{{ _("sort this event now: move its files, the others left for later") }}</dd>
    <dt><kbd>R</kbd></dt><dd>{{ _("remember this event as a rule of config.toml") }}</dd>
    <dt><kbd>V</kbd></dt><dd>{{ _("accept every sure proposal at once") }}</dd>
    <dt><kbd>Shift</kbd>+<kbd>Z</kbd></dt><dd>{{ _("take back the last batch of sure proposals") }}</dd>
    <dt><kbd>Shift</kbd>+<kbd>S</kbd></dt><dd>{{ _("leave the whole event where it is") }}</dd>
    <dt><kbd>Delete</kbd></dt><dd>{{ _("take back the choice made here (of the picked photos, else of the event)") }}</dd>
{% include "pick_keys_more.html.j2" %}
    <dt><kbd>Esc</kbd></dt><dd>{{ _("leave a field; drop the folder typed and not saved") }}</dd>
{% endblock %}
{% block bar %}
  <span id="eventNav">
    <button type="button" id="prevEvent" class="plain" title="{{ _('Previous event (P)') }}" aria-label="{{ _('Previous event (P)') }}">←</button>
    <strong id="position"></strong>
    <button type="button" id="nextEvent" class="plain" title="{{ _('Next event (N)') }}" aria-label="{{ _('Next event (N)') }}">→</button>
  </span>
  {% set pick_add = _("Send to another folder (O)") %}
  {% set pick_remove = _("Take back the choice made here") %}
  {% include "pick_acting.html.j2" %}
  <button type="button" id="leavePicked" class="plain" hidden>{{ _("Leave where they are (S)") }}</button>
  <span class="batch">
    <label class="filter" title="{{ _('N, P and U skip the events already chosen and those whose proposal is sure') }}"><input type="checkbox" id="onlyDecide"> {{ _("Only the events to decide") }}</label>
    <label class="filter" title="{{ _('N and P walk only the events to decide whose proposal is sure, one by one, before accepting them') }}"><input type="checkbox" id="onlySure"> {{ _("Only the sure proposals") }}</label>
    <button type="button" id="sure" title="{{ _('Accept at once every event still to decide whose proposal is sure (V)') }}"></button>
    <button type="button" id="sureUndo" title="{{ _('Take back the last batch of sure proposals (Shift+Z)') }}" hidden></button>
  </span>
  <span class="break"></span>
  <form id="choice" autocomplete="off">
    <label class="folder">{{ _("Folder") }} <kbd>F</kbd><span class="path"><span id="prefix" class="muted"></span><input id="folder" name="folder" list="categories"></span></label>
    <details id="naming"><summary>{{ _("Name of the event") }} <kbd>E</kbd></summary><input id="name" name="name"></details>
  </form>
  <span id="destination" class="muted" role="status" aria-live="polite"></span>
  <button type="button" id="ruleOpen" class="plain" title="{{ _('Write this event down as a rule of config.toml: its days, its folder; the next classify runs apply it (R)') }}">📌 {{ _("Remember as a rule") }}</button>
  <button type="button" id="sortNow" title="{{ _('Save the folder, then move the files of this event only, journaled: undo puts them back (M)') }}">{{ _("Sort this event now") }}</button>
  <datalist id="categories"></datalist>
{% endblock %}
{% block content %}
  <main id="grid"></main>
{% endblock %}
{% block after %}
{% set pick_space = _("play or pause a video") %}
{% include "pick_viewer.html.j2" %}
<dialog id="sureDlg" aria-labelledby="sureAsk">
  <p id="sureAsk"></p>
  <ol id="sureList"></ol>
  <menu><button type="button" id="sureNo" class="plain"></button><button type="button" id="sureYes"></button></menu>
</dialog>
<dialog id="ruleDlg" aria-labelledby="ruleTitle">
  <form id="ruleForm" method="dialog" autocomplete="off">
    <h2 id="ruleTitle">📌 {{ _("Remember as a rule") }}</h2>
    <p class="muted">{{ _("Written into config.toml, above Existing folders: every classify run applies it, to the photos added later too.") }}</p>
    <label>{{ _("Name") }} <input id="ruleName" required></label>
    <label>{{ _("From") }} <input id="ruleFirst" type="date" required></label>
    <label>{{ _("To") }} <input id="ruleLast" type="date" required></label>
    <label>{{ _("Folder, under the year") }} <input id="ruleCategory" list="categories" required></label>
    <label class="filter"><input type="checkbox" id="ruleKeep" checked> {{ _("Keep my folders below it (keep_folders)") }}</label>
    <p id="rulePreview" class="muted" role="status"></p>
    <menu><button type="button" id="ruleNo" class="plain">{{ _("Cancel") }}</button><button type="submit" id="ruleYes">{{ _("Save the rule") }}</button></menu>
  </form>
</dialog>
<dialog id="rulesDlg" aria-labelledby="rulesTitle">
  <h2 id="rulesTitle">📌 {{ _("Your rules") }}</h2>
  <p id="rulesRun" class="muted"></p>
  <p id="rulesSaid" role="status"></p>
  <table id="rulesTable">
    <thead><tr><th>{{ _("Rule") }}</th><th>{{ _("Match") }}</th><th>{{ _("Files") }}</th><th>{{ _("Days") }}</th><th></th></tr></thead>
    <tbody></tbody>
  </table>
  <menu><button type="button" id="rulesRemoveAll" class="plain" hidden></button><button type="button" id="rulesClose">{{ _("Close") }}</button></menu>
</dialog>
<dialog id="sendDlg">
  <form id="send" method="dialog" autocomplete="off">
    <label><span id="send-label"></span><input id="send-category" list="categories"></label>
    <menu><button type="button" id="sendNo" class="plain">{{ _("Cancel") }}</button><button type="submit">{{ _("Send") }}</button></menu>
  </form>
</dialog>
<script>
{% include "pick_grid.js.j2" %}
{% include "pick_viewer.js.j2" %}
{% include "pick_band.js.j2" %}
// The hooks of the shared grid (pick_grid.js.j2), set by the page's script below.
const TEXTS = {{ pick_texts | tojson }};
const CHOSEN_PATH = ""; // unused: `saveChoice` saves the choices of this page
let card = null;        // (file, index) → its tile
let reopen = null;      // (again) → the photos of the event listed again
function scope() {
  return {};
}
deleteKeySets = false;  // Delete takes back a choice here, it sets nothing aside
for (const key of ["Delete", "Backspace", "a"]) delete VIEWER_KEYS[key];
(() => {
  const T = {{ texts | tojson }};
  const P = {{ paths | tojson }};
  const positionKey = "media-hygiene:review-sort:" + {{ decisions | tojson }};
  const byId = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, key) => (key in values ? String(values[key]) : all));
  const plural = new Intl.PluralRules(document.documentElement.lang);
  // A counted fragment: its singular and plural forms, the one the language uses for n.
  const counted = (forms, n) => fill(forms[plural.select(n) === "one" ? 0 : 1], { n: n });
  let events = [];
  let current = 0;       // the event shown (the grid's framed photo is `cards`' .current)
  let photoOf = {};      // the photos of the event shown, by row

  // Said in the line the bar always shows (`#chosen` of pick_acting.html.j2).
  const setStatus = (text, kind) => {
    byId("chosen").textContent = text;
    byId("chosen").title = text; // the bar shows one line, the whole sentence on hover
    byId("chosen").className = kind || "";
  };
  const line = (tag, text, css) => {
    const element = document.createElement(tag);
    element.textContent = text;
    if (css) element.className = css;
    return element;
  };
  const isOpen = (card) => card.undecided > 0 && !card.page && !card.workbook.text && !card.sorted;

  const showTotals = () => {
    const chosen = events.filter((card) => card.page).length;
    const open = events.filter(isOpen).length;
    byId("status").textContent = fill(T.totals, { chosen: chosen, open: open });
    showSure();
  };

  const fact = (term, text) => [line("dt", term), line("dd", text || T.nothing)];
  // "3 files keep their own folder (Budva, Cetinje…)" (0385).
  const keptText = (count, folders) => {
    const names = folders.slice(0, 3).join(", ") + (folders.length > 3 ? "…" : "");
    return counted(T.nKept, count) + " (" + names + ")";
  };

  const showEvent = (card) => {
    byId("position").textContent = fill(T.position, { number: current + 1, total: events.length });
    byId("title").textContent = card.title;
    byId("summary").textContent = [card.span, fill(T.files, { files: counted(T.nFiles, card.files), undecided: card.undecided }), fill(T.share, { share: card.share })].join(" · ");
    const rule = card.rule ? card.rule + (card.rule_days ? " (" + card.rule_days + ")" : "") : "";
    byId("facts").replaceChildren(...fact(T.from, card.folders.join(" · ")), ...(rule ? fact(T.ruleFact, rule) : []), ...fact(T.state, ""));
    byId("conflict").hidden = !card.conflict;
    byId("conflict").textContent = T.conflict;
    fillChoice(card);
  };

  // A photo as the shared grid lists it: `chosen` is a choice made here for it.
  const listing = (photos) => {
    photoOf = Object.fromEntries(photos.map((photo) => [photo.row, photo]));
    return photos.map((photo) => ({
      key: photo.row, name: photo.name, preview: photo.preview, original: photo.preview,
      chosen: Boolean(photo.page), date: photo.date, folder: photo.folder,
      facts: "→ " + (photo.page || photo.workbook || photo.proposed || T.stay),
    }));
  };
  const showPhotos = (photos, again) => showFiles(listing(photos), again);

  card = (file, index) => {
    const photo = photoOf[file.key];
    const node = element("article", photo.conflict ? "conflicting" : "");
    const image = element("img");
    image.loading = "lazy";
    image.draggable = false; // a drag draws a rectangle (pick_band.js.j2)
    image.alt = photo.name;
    image.src = photo.thumb;
    image.addEventListener("error", () => image.replaceWith(element("div", "empty", "🎞️ " + T.noPreview)));
    const meta = element("div", "meta");
    meta.append(element("div", "name", photo.name), element("div", "muted", photo.date));
    if (photo.proposed !== events[current].folder) meta.append(element("div", "proposed", "→ " + (photo.proposed || T.stay) + (photo.own ? " · " + T.ownFolder : "")));
    const note = !photo.movable ? T.left : photo.page ? "✅ " + photo.page : photo.workbook ? "📒 " + photo.workbook : "";
    if (note) meta.append(element("div", "muted", note));
    node.append(image, meta);
    return wireCard(node, index);
  };

  // While the user decides, the next event's thumbnails (the previous one's when going
  // back) are asked for: one event ahead.
  const ahead = async (index) => {
    if (index < 0 || index >= events.length) return;
    try {
      const response = await fetch(P.event + "/" + encodeURIComponent(events[index].id));
      if (!response.ok) return;
      for (const photo of (await response.json()).photos) new Image().src = photo.thumb;
    } catch (error) { /* ahead only: the event is asked for again when shown */ }
  };

  const load = async (index) => {
    const back = index < current;
    current = index;
    showEvent(events[current]);
    showTotals();
    showPhotos([], false);
    const response = await fetch(P.event + "/" + encodeURIComponent(events[current].id));
    if (!response.ok) { setStatus(T.offline, "error"); return; }
    if (index !== current) return; // another event was asked for meanwhile
    showPhotos((await response.json()).photos, false);
    ahead(back ? index - 1 : index + 1);
    try { window.localStorage.setItem(positionKey, events[current].id); } catch (error) { /* private browsing */ }
  };

  const send = async (path, body, then) => {
    const index = current;
    setStatus(T.saving);
    let response;
    try {
      response = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    } catch (error) { setStatus(T.offline, "error"); return false; }
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) { setStatus(answer.error || fill(T.failed, { status: response.status }), "error"); return false; }
    events[index] = answer.card;
    if (index !== current) return true;
    setStatus(T.saved, "saved");
    showPhotos(answer.photos, true);
    if (then) then(); else { showEvent(answer.card); showTotals(); }
    return true;
  };

{% include "sort_review_sure.js.j2" %}
{% include "sort_review_choice.js.j2" %}
{% include "sort_review_rule.js.j2" %}

  const go = (step) => {
    if (!mayLeave(() => go(step))) return;
    let next = current + step;
    while (next >= 0 && next < events.length && !visible(events[next])) next += step;
    if (next < 0 || next >= events.length) { setStatus(next < 0 ? T.first : T.last); return; }
    setStatus("");
    load(next);
    window.scrollTo(0, 0);
  };
  const goOpen = () => {
    if (!mayLeave(goOpen)) return;
    const next = events.findIndex((card, index) => index > current && isOpen(card) && visible(card));
    if (next < 0) { setStatus(T.noOpen); showEvent(events[current]); showTotals(); return; }
    load(next);
    window.scrollTo(0, 0);
  };

  const id = () => events[current].id;
  // The photos picked, else the one framed; those left as they are take no choice.
  const chosenRows = () => {
    const framed = cards.findIndex((node) => node.classList.contains("current"));
    const rows = picked.size ? [...picked] : framed >= 0 ? [files[framed].key] : [];
    return rows.filter((row) => photoOf[row] && photoOf[row].movable);
  };
  const accept = () => { const body = choiceBody(); markSaved(); send(P.event, body, goOpen); };
  const stayEvent = () => send(P.event, { event: id(), stay: true }, goOpen);
  let sending = [];  // the rows the send dialog is about
  const openSend = (rows) => {
    sending = rows || chosenRows();
    if (!sending.length) { setStatus(T.leftAll, "error"); return; }
    byId("send-label").textContent = fill(T.sendTo, { count: sending.length });
    byId("send-category").value = "";
    byId("sendDlg").showModal();
  };
  const leavePicked = () => {
    const rows = chosenRows();
    if (!rows.length) { setStatus(T.leftAll, "error"); return; }
    send(P.files, { event: id(), rows: rows, stay: true });
  };
  // The bar's buttons of the shared grid: *Send* opens the dialog, *Take back* forgets.
  saveChoice = async (action, keys) => {
    if (action === "add") { openSend(keys.filter((row) => photoOf[row] && photoOf[row].movable)); return false; }
    return send(P.forget, { event: id(), rows: keys });
  };
  reopen = async () => {
    const response = await fetch(P.event + "/" + encodeURIComponent(id()));
    if (response.ok) showPhotos((await response.json()).photos, true);
  };
  // Opened large: the photos on either side are asked for already, ← → shows them at once.
  const shownLarge = open;
  open = () => {
    shownLarge();
    const rank = cards.findIndex((node) => node.classList.contains("current"));
    for (const near of [rank + 1, rank - 1]) if (files[near]) new Image().src = files[near].preview;
  };
  const pickedShown = showPicked;
  showPicked = () => { pickedShown(); byId("leavePicked").hidden = byId("acting").hidden; };

  // Two fields and no button: browsers do not submit on Enter, the page does.
  byId("choice").addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    event.preventDefault();
    event.stopPropagation();
    document.activeElement.blur();
    accept();
  });
  byId("send").addEventListener("submit", (event) => {
    event.preventDefault();
    const category = byId("send-category").value;
    byId("sendDlg").close();
    send(P.files, { event: id(), rows: sending, category: category });
  });
  byId("sendNo").addEventListener("click", () => byId("sendDlg").close());
  // After the shared grid's keys (pick_grid.js.j2): what it took (arrows, Space, Enter on a
  // framed photo, Ctrl+A, I, the large view's keys) is not this page's.
  document.addEventListener("keydown", (event) => {
    if (["sureDlg", "sendDlg", "ruleDlg", "rulesDlg"].some((dialog) => byId(dialog).open)) return;  // the dialog's own keys
    if (event.defaultPrevented || byId("viewer").classList.contains("open")) return;
    if (event.key === "Escape") {
      if (choiceDirty()) dropChoice();
      document.activeElement.blur();
      return;
    }
    const typing = ["INPUT", "TEXTAREA"].includes(document.activeElement.tagName);
    if (typing || event.ctrlKey || event.metaKey || event.altKey || events.length === 0) return;
    const key = event.key;
    if (key === "Enter") accept();
    else if (key === "n" || key === "N" || key === "PageDown") go(1);
    else if (key === "p" || key === "P" || key === "PageUp") go(-1);
    else if (key === "u" || key === "U") goOpen();
    else if (key === "v" || key === "V") acceptSure();
    else if (key === "S") stayEvent();
    else if (key === "s") leavePicked();
    else if (key === "o" || key === "O") openSend();
    else if (key === "m" || key === "M") sortNow();
    else if (key === "r" || key === "R") openRule();
    else if (key === "Delete") send(P.forget, { event: id(), rows: [...picked] });
    else if (key === "e" || key === "E") { byId("naming").open = true; byId("name").focus(); }
    else if (key === "f" || key === "F" || key === "c" || key === "C") byId("folder").focus();
    else if (key === "Z" && event.shiftKey) undoSure();
    else return;
    event.preventDefault();
  });
  byId("prevEvent").addEventListener("click", () => go(-1));
  byId("nextEvent").addEventListener("click", () => go(1));
  byId("leavePicked").addEventListener("click", leavePicked);
  byId("sure").addEventListener("click", acceptSure);
  byId("sortNow").addEventListener("click", sortNow);
  byId("sureUndo").addEventListener("click", undoSure);
  // Two filters, one at a time: the events to decide, or the sure proposals (0388).
  const filters = { onlyDecide: positionKey + ":only-to-decide", onlySure: positionKey + ":only-sure" };
  for (const [box, key] of Object.entries(filters)) {
    try { byId(box).checked = window.localStorage.getItem(key) === "1"; } catch (error) { /* private browsing */ }
    byId(box).addEventListener("change", (event) => {
      for (const [other, otherKey] of Object.entries(filters)) {
        if (other !== box && event.target.checked) byId(other).checked = false;
        try { window.localStorage.setItem(otherKey, byId(other).checked ? "1" : "0"); } catch (error) { /* private browsing */ }
      }
      event.target.blur();  // the keys work again
    });
  }
  if (byId("onlyDecide").checked && byId("onlySure").checked) byId("onlySure").checked = false;

  fetch(P.state)
    .then((response) => response.json())
    .then((state) => {
      events = state.events;
      byId("categories").replaceChildren(...state.categories.map((name) => Object.assign(document.createElement("option"), { value: name })));
      let saved = "";
      try { saved = window.localStorage.getItem(positionKey) || ""; } catch (error) { saved = ""; }
      const resumed = events.findIndex((card) => card.id === saved);
      const first = events.findIndex(isOpen);
      showSure();
      if (events.length) load(resumed >= 0 ? resumed : Math.max(first, 0));
    })
    .catch(() => setStatus(T.offline, "error"));
})();
</script>

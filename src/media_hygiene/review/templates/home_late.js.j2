// *New photos during an event* (0558): asked once of the search's app the home server
// answers too; one line per event leads to its photos on the Events page. No index, no
// event: nothing shown.
const LATE_TEXTS = {{ {
  "line": _("{n} new photos during '{name}' — see them?"),
} | tojson }};
let lateEvents = [];
function lateLines() {
  return lateEvents.map((item) => `<p class="callout callout-info">${icon("folder")}<span><a href="${esc(item.page)}">${esc(fill(LATE_TEXTS.line, { n: item.total, name: item.label }))}</a></span></p>`).join("");
}
function askLate() {
  if (REMOTE) return;  // the phone is read-only: nothing to add or refuse there
  if (!P.late) return;
  fetch(P.late, { cache: "no-store" })
    .then((response) => (response.ok ? response.json() : { events: [] }))
    .then((view) => { lateEvents = view.events || []; const place = $("#lateEvents"); if (place) place.innerHTML = lateLines(); })
    .catch(() => {});
}
// "10 minutes of tidying" (0528): the session of this tab starts here; each review, biggest gain first.
const TIDY_MS = 600000;
document.addEventListener("click", (event) => {
  if (!event.target.closest("[data-tidy]")) return;
  try {
    const now = Date.now();
    sessionStorage.setItem("mh-tidy", JSON.stringify({ started: now, limit: now + TIDY_MS }));
    // The orders the user had, put back when the session ends (review 2026-11-05).
    if (localStorage.getItem("mh-tidy-before") === null) {
      localStorage.setItem("mh-tidy-before", JSON.stringify({
        "media-hygiene:review:order": localStorage.getItem("media-hygiene:review:order"),
        "near-order": localStorage.getItem("near-order"),
      }));
    }
    localStorage.setItem("media-hygiene:review:order", "space");
    localStorage.setItem("near-order", "gain");
  } catch (error) { /* no storage: the review alone, no session */ }
}, true);

{# "Back to the home page" of the page's bar (page_header.html.j2, shown when `mh` opened the page
   from the home page): `POST /api/stop` ends this page's server (code 0) and `mh` opens the home
   page again on the same port; the page reloads once another server answers (another run id,
   `RUN_HEADER` of review/respond.py, 0354: the next one may answer 0.5 s after this one ended,
   before any poll saw it gone), on the section it was left from (0280: the home page keeps it for this tab in
   sessionStorage). Included by each page, from any package.
   The page's presence, and its "Media Hygiene has stopped" overlay: presence.html.j2 (0341). #}
{% include "presence.html.j2" %}
<div id="homeClosed" hidden role="alertdialog" aria-live="assertive"
     style="position: fixed; inset: 0; z-index: 60; align-items: center; justify-content: center;
            padding: 16px; background: rgba(0, 0, 0, .55); font: 16px/1.5 var(--mk-font-text);">
  <p style="max-width: 520px; padding: 20px 24px; border-radius: 12px; background: var(--mk-surface); color: var(--mk-ink);">
    {{ _("This page is closed. The home page comes back here when mh opens it.") }}</p>
</div>
<script>
(() => {
  const POLL_MS = 250;
  // A poll answered by nobody (Docker Desktop's port proxy may hold a connection made in the
  // gap between two servers, forever): dropped, then asked again on a new connection.
  const ANSWER_MS = 2000;
  const RUN_HEADER = "X-Media-Hygiene-Run";
  const section = () => { try { return window.sessionStorage.getItem("mh-home-section") || ""; } catch { return ""; } };
  const closed = document.getElementById("homeClosed");
  const homeLink = document.getElementById("homeLink");
  // Another server answering (another run id than `run`, the one that ended, or seen gone
  // then answering again): the home page is back, this tab shows it.
  const awaitHome = (run) => {
    window.mhEnded();
    let seenGone = false;
    const poll = () => fetch("/", { cache: "no-store", signal: AbortSignal.timeout(ANSWER_MS) })
      .then((response) => {
        const now = response.headers.get(RUN_HEADER);
        if (response.ok && (seenGone || (run && now && now !== run))) window.location.replace("/" + section());
        else window.setTimeout(poll, POLL_MS);
      })
      .catch((error) => {
        if (error.name !== "TimeoutError") seenGone = true; // refused: the server is gone
        window.setTimeout(poll, POLL_MS);
      });
    window.setTimeout(poll, POLL_MS);
  };
  if (homeLink === null) return;
  // A page ending another way (the phone's Delete or Leave, 0332) follows the home page too.
  window.mhAwaitHome = awaitHome;
  // Served by the home server itself (0356): a plain link, back to the section left.
  if (homeLink.dataset.shared) { homeLink.href = "/" + section(); return; }
  homeLink.addEventListener("click", (event) => {
    event.preventDefault();
    fetch("/api/stop", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" })
      .then((response) => {
        closed.hidden = false;
        closed.style.display = "flex";
        awaitHome(response.headers.get(RUN_HEADER));
      })
      .catch(() => undefined);
  });
})();
</script>

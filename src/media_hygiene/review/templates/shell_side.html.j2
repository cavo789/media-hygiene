{# The sidebar of the frame (shell.html.j2): an entry opens that space of the home page. No home page to
   go back to (a page typed in the console, 0585): no entry at all, never items drawn as links that do
   nothing. On a paired phone (`data-phone`, read-only, 0435) only the spaces a phone opens stay. #}
{% set phone_spaces = ("home", "find", "share") %}
{% macro entry(link) -%}
<li{% if link.space not in phone_spaces %} class="pc-only"{% endif %}>
<a class="mh-shell-link" href="/#{{ link.space }}" data-space="{{ link.space }}"{% if link.current %} aria-current="page"{% endif %} title="{{ link.title }}">
<svg class="mh-i" aria-hidden="true"><use href="#i-{{ link.icon }}"></use></svg><span class="mh-shell-label">{{ link.title }}</span>
</a></li>
{%- endmacro %}
<aside class="mh-shell-side" id="mhShellSide" aria-label="{{ _('Menu of Media Hygiene') }}">
  <p class="mh-shell-brand"><img src="{{ header.assets }}images/avatar.webp" alt="" width="30" height="40"><span class="mh-shell-label">Media Hygiene</span></p>
  {% if header.shared or header.home %}
  <nav aria-label="{{ _('Spaces') }}">
    <ul class="mh-shell-list">{{ entry(shell.home) }}</ul>
    <p class="mh-shell-group mh-shell-label">{{ _("The cycle of your photos") }}</p>
    <ul class="mh-shell-list">{% for link in shell.stages %}{{ entry(link) }}{% endfor %}</ul>
    <p class="mh-shell-group mh-shell-label">{{ _("Share") }}</p>
    <ul class="mh-shell-list">{% for link in shell.share %}{{ entry(link) }}{% endfor %}</ul>
    <p class="mh-shell-group mh-shell-label">{{ _("Tools") }}</p>
    <ul class="mh-shell-list">{% for link in shell.tools %}{{ entry(link) }}{% endfor %}</ul>
  </nav>
  {% endif %}
  {% if header.folders %}{# Your folders (0579): the home page's list, its order, its badges; on a paired phone too, a read-only list (review 2026-11-05). #}
  <details class="mh-shell-folders mh-shell-label">
    <summary><svg class="mh-i" aria-hidden="true"><use href="#i-folder"></use></svg><span>{{ _("Your folders ({count})").format(count=header.folders.folders | length) }}</span>
    {%- if header.folders.warn %}<span class="mh-shell-folder-warn"><span class="mh-shell-hidden">{{ _("a folder not found") }}</span></span>{% endif -%}
    <svg class="mh-i mh-shell-chev" aria-hidden="true"><use href="#i-chevron"></use></svg></summary>
    <ul class="mh-shell-folder-list">{% for folder in header.folders.folders %}
      <li><span class="mh-shell-folder-path">{{ folder.path }}</span><span class="mh-shell-folder-role{% if not folder.ok %} is-warn{% endif %}">{{ folder.role }} · {{ folder.note }}</span></li>{% endfor %}
    </ul>
  </details>
  {% endif %}
  <div class="mh-shell-sign mh-shell-label">
    <p>Media Hygiene {{ shell.version }}</p>
    <div class="mh-shell-theme" role="group" aria-label="{{ _('Display') }}">
      <button type="button" data-theme-choice="auto" aria-pressed="true">{{ _("Auto") }}</button>
      <button type="button" data-theme-choice="light" aria-pressed="false">{{ _("Light") }}</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">{{ _("Dark") }}</button>
    </div>
  </div>
</aside>

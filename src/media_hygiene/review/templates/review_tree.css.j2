{# Included in the style of review.html.j2: the left column (table of contents above, the
   keyboard reminder below, always visible), and the panel showing what the decisions
   file holds for the series on screen. #}
  .layout { display: grid; grid-template-columns: minmax(240px, 340px) 1fr; align-items: start; }
  #side { position: sticky; top: 52px; display: flex; flex-direction: column; gap: 10px;
          height: calc(100vh - 110px); margin: 12px 0 12px 16px; }
  #toc, #keys { padding: 10px 12px; background: var(--card); border: 1px solid var(--line);
                border-radius: 10px; font-size: .85rem; }
  #toc { flex: 1; min-height: 0; overflow: auto; }
  #toc h2, #keys h2 { font-size: 1rem; margin: 0 0 6px; }
  #keys { flex: none; }
  #keys dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 10px; margin: 0; }
  #keys dt { white-space: nowrap; } #keys dd { margin: 0; }
  #tree summary .validate { flex: none; margin-left: auto; padding: 0 6px; font: inherit;
                            font-size: .8rem; color: var(--ok); background: none; cursor: pointer;
                            border: 1px solid var(--line); border-radius: 4px; visibility: hidden; }
  #tree summary:hover .validate, #tree summary:focus-within .validate { visibility: visible; }
  #tree details.done > summary .validate { display: none; }
  #tocBar { width: 100%; height: 10px; accent-color: var(--ok); }
  #toc .filter { display: flex; gap: 6px; align-items: center; margin: 6px 0 8px; cursor: pointer; }
  #toc select { flex: 1; min-width: 0; font: inherit; }
  #tree .row .where { color: var(--muted); font-weight: 400; }
  #tree details { margin-left: 2px; } #tree details details { margin-left: 12px; }
  #tree summary { display: flex; gap: 8px; justify-content: space-between; padding: 2px 4px;
                  cursor: pointer; border-radius: 4px; overflow-wrap: anywhere; }
  #tree summary:hover { background: var(--bg); }
  #tree summary .count { flex: none; color: var(--muted); font-variant-numeric: tabular-nums; }
  #tree details.done > summary .count { color: var(--ok); font-weight: 600; }
  #tree .rows { margin-left: 14px; }
  #tree .row { display: flex; gap: 8px; justify-content: space-between; width: 100%;
               padding: 2px 6px; font: inherit; text-align: left; color: var(--text);
               background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer; }
  #tree .row:hover { background: var(--bg); }
  #tree .row .what { color: var(--muted); } #tree .row.kept .what { color: var(--ok); }
  #tree .row.partial .what { color: var(--warn); } #tree .row.whole .what { color: var(--bad); }
  #tree .row.current { border-color: var(--accent); font-weight: 600; }
  #tree .row.flash { animation: flash 1.2s ease-out; }
  @keyframes flash { from { background: color-mix(in srgb, var(--ok) 35%, transparent); } }
  #tree.only-todo .row.done, #tree.only-todo details.done { display: none; }
  #disk { margin-top: 14px; padding: 8px 12px; background: var(--card);
          border: 1px solid var(--line); border-radius: 10px; font-size: .85rem; }
  #disk > summary { font-weight: 600; cursor: pointer; }
  #disk p.done { color: var(--ok); font-weight: 600; } #disk p.todo { color: var(--muted); }
  #disk .names { display: inline-block; vertical-align: top; min-width: 220px; margin: 0 24px 6px 0; }
  #disk .names.kept strong { color: var(--ok); } #disk .names.aside strong { color: var(--bad); }
  #disk ul { margin: 2px 0; padding-left: 18px; }
  #raw summary { cursor: pointer; color: var(--muted); }
  #rawJson { margin: 6px 0 0; padding: 8px; overflow: auto; background: var(--bg); border-radius: 6px; }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    #side { order: 2; position: static; height: auto; margin: 0 16px 16px; }
  }

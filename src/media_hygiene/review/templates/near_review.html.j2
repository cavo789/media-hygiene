{% extends "page_frame.html.j2" %}
{# The keyboard review of near duplicates, served by `media-hygiene review --near`. The page
   never touches a file: each choice is sent to the server, which saves the decisions file;
   `clean --tier near --decisions` then moves what was decided, journaled. The panel below
   the group shows the decisions file as read back from the disk after every choice. #}
{% set texts = {
  "position": _("Group {number} of {total}"),
  "totals": _("Decided: {decided} of {total} · to check, undecided: {left}"),
  "kept": "✅ " ~ _("kept"),
  "moved": "📦 " ~ _("to the quarantine"),
  "protected": "🔒 " ~ _("protected folder, kept"),
  "pending": "⏳ " ~ _("To check, undecided: nothing of this group moves with --tier near until you decide."),
  "pendingSure": "✔ " ~ _("Sure group: --tier near moves its copies as shown, unless you decide otherwise."),
  "planned": "✔ " ~ _("Decided: as planned, the copies go to the quarantine."),
  "swap": "🔁 " ~ _("Decided: the other version is kept, the version the audit kept goes to the quarantine."),
  "leave": "✋ " ~ _("Decided: left alone, nothing of this group moves."),
  "none": "🗑 " ~ _("Decided: none kept, every version of this group goes to the quarantine."),
  "noSwap": _("The kept version lies in a protected folder: it is never moved, W is not possible."),
  "noNone": _("The kept version lies in a protected folder: it is never moved, X is not possible."),
  "video": "🎞 " ~ _("video: open the original"),
  "noPlay": "🎞 " ~ _("This browser cannot play this video: open the original."),
  "original": "↗ " ~ _("original"),
  "originalTitle": _("Open the original in a new tab: the file as it lies on the disk"),
  "saving": _("Saving…"),
  "proofOk": "✔ " ~ _("Saved, then read back from the disk at {time}: {file} holds your choice.").replace("{file}", file),
  "loaded": "📄 " ~ _("{file} read from the disk at {time}.").replace("{file}", file),
  "diskTitle": _("What {file} holds for this group").replace("{file}", file),
  "diskNone": "⏳ " ~ _("No decision in the file: the tier decides."),
  "diskEntry": _("Decision in the file: {action}"),
  "pairs": _("{pair} — groups: {count}, undecided: {left}"),
  "pairButton": "✔ " ~ _("as planned"),
  "pairButtonTitle": _("Decide every undecided group of this folder pair as planned, in one write (G)"),
  "pairAsk": _("{pair} — undecided groups: {count}. As planned, their copies to the quarantine? Each group can still be decided again."),
  "pairNone": _("Every group of this folder pair is decided already."),
  "share": _("Up to this group, in this order: {size}, {share} %% of the space of every group."),
  "allDecided": _("Every group to check has been decided."),
  "first": _("This is the first group."),
  "last": _("This is the last group: stop the review with Ctrl+C in the terminal."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The review is not running any more: start it again."),
  "units": [_("B"), _("KB"), _("MB"), _("GB"), _("TB")],
} %}
{% set page_name = _("Near duplicates review") %}
{% set keys_safe = _("Every choice is saved at once in %(place)s. Done? Ctrl+C in the terminal stops the review; then run the same 'clean' command with --tier near %(option)s: the sure groups and the groups you decided go to the quarantine, and 'undo' brings them back.", place=place, option=clean_option) %}
{% block style %}
{% include "pick_viewer.css.j2" %}
  #toc label { display: flex; gap: 6px; align-items: center; }
  #toc select { flex: 1; min-width: 0; font: inherit; }
  #toc h3 { font-size: .9rem; margin: 12px 0 6px; }
  #status.error { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  #state { margin: 0 0 12px; padding: 8px 12px; font-weight: 600; background: var(--card);
           border: 2px dashed var(--warn); border-radius: 10px; color: var(--warn); }
  #state.decided { border-style: solid; border-color: var(--ok); color: var(--ok); }
  #state.sure { border-color: var(--ok); color: var(--ok); }
  #state.none { border-color: var(--bad); color: var(--bad); }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .shot { margin: 0; padding: 8px; background: var(--card); border: 3px solid var(--line); border-radius: 10px; }
  .shot.keep { border-color: var(--ok); }
  .shot.move { border: 3px dashed var(--bad); } .shot.move img, .shot.move video { opacity: .6; }
  .shot.lock { border-color: var(--warn); }
  .shot img, .shot video { display: block; width: 100%; height: auto; max-height: 58vh; object-fit: contain;
              border-radius: 6px; background: var(--bg); }
  .shot .clip { padding: 40px 8px; text-align: center; background: var(--bg); border-radius: 6px; }
  figcaption { margin-top: 6px; font-size: .85rem; overflow-wrap: anywhere; }
  figcaption .original { margin-left: 8px; color: var(--accent); }
  .tag { font-weight: 600; }
  .pair { margin: 0 0 8px; font-size: .85rem; overflow-wrap: anywhere; }
  .pair.current { font-weight: 600; }
  button { font: inherit; cursor: pointer; }
{% endblock %}
{% block side %}
  <section id="toc" aria-label="{{ _('Folder pairs') }}">
    <label>{{ _("Order") }}
      <select id="order">
        <option value="check">{{ _("to check first") }}</option>
        <option value="gain">{{ _("space freed, largest first") }}</option>
        <option value="pair">{{ _("by folder pair") }}</option>
      </select>
    </label>
    <p id="share" class="muted"></p>
    <h3>📁 {{ _("Folder pairs") }}</h3>
    <div id="pairs"></div>
  </section>
{% endblock %}
{% block keys %}
      <dt><kbd>→</kbd></dt><dd>{{ _("as planned, then next") }}</dd>
      <dt><kbd>W</kbd></dt><dd>{{ _("keep the other version, then next") }}</dd>
      <dt><kbd>L</kbd></dt><dd>{{ _("leave the group alone, then next") }}</dd>
      <dt><kbd>X</kbd></dt><dd>{{ _("none: the whole group aside, then next") }}</dd>
{% endblock %}
{% block more_keys %}
      <dt><kbd>←</kbd></dt><dd>{{ _("previous group") }}</dd>
      <dt><kbd>N</kbd></dt><dd>{{ _("next group to check, undecided") }}</dd>
      <dt><kbd>U</kbd></dt><dd>{{ _("back to undecided") }}</dd>
      <dt><kbd>G</kbd></dt><dd>{{ _("the whole folder pair as planned") }}</dd>
      <dt><kbd>␣</kbd> <kbd>←</kbd> <kbd>→</kbd></dt><dd>{{ _("on a video you clicked: play, seek; Esc gives the keys back") }}</dd>
{% include "pick_large_keys.html.j2" %}
{% endblock %}
{% block bar %}
  <strong id="position"></strong>
  <span id="totals" class="muted"></span>
  <span id="status" role="status" aria-live="polite"></span>
  {% include "apply_now.html.j2" %}
{% endblock %}
{% block content %}
<main>
  <p id="why" class="muted"></p>
  <p id="state" role="status"></p>
  <div id="shots" class="shots"></div>
  <details id="disk" open>
    <summary id="diskTitle"></summary>
    <div id="diskBody"></div>
  </details>
</main>
{% endblock %}
{% block after %}
{% include "pick_large.html.j2" %}
<script>
{% include "near_review.js.j2" %}
</script>
{% endblock %}

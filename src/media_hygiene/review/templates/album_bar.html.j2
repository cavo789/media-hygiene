{# The albums (0295), included by `search`, `browse` and the burst review, from any package;
   rendered only when the page's server answers them (`albums_path`). Apart from *Set aside*:
   another list (`albums.json`), never the decisions file. The page's own script says what is
   picked: `window.mhAlbumPick()` returns `{keys, all, search}` (`all`: every file a search
   finds), and it calls `window.mhAlbumPicked(count)` when the picking changes. Each change is
   saved at once and shown as read back from the disk, with the files missing from each album.
   *Share on the TV* gives the command that shows the album typed (`slideshow --album`),
   *Prepare for sending* the one that makes its copies to send (`share --album`, 0296):
   with files picked, they are added first to the album typed, or to one named after the
   day when none is (no album to make beforehand).
   `album_compact` (browse's one bar, 0305): the field says how to start, and the list of the
   albums is not said on opening (the field offers them), only what each change saved.
   `album_short` (the search's fixed bar, 0463): emoji and a short word, the whole label in the
   tooltip. The field starts empty on each page: a name kept from an earlier visit would send
   today's picking into yesterday's album; but `?album=` (0501: *Add photos* of the albums
   page) fills it once, with a way back to that album. #}
{% if albums_path %}
{% set album_quiet = album_compact | default(false) %}
<style>
  #albumBar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
  #albumBar input { width: 14em; }
  #albumSaid { font-size: .85rem; margin: 6px 0 0; }
  #albumSaid.error { color: var(--bad); font-weight: 600; }
  #albumTvLine { font-size: .85rem; margin: 6px 0 0; }
  #albumTvLine code { padding: 2px 6px; border-radius: 6px; background: var(--chip); }
  #albumMissing { font-size: .8rem; color: var(--muted); }
{% include "combo_list.css.j2" %}
</style>
<div id="albumBar">
  <label for="albumName">{{ _("Album") }}</label>
  <input id="albumName" maxlength="80" autocomplete="off"
         placeholder="{{ _('type a name, e.g. Crete 2023') if album_quiet else _('e.g. Crete 2023') }}">
{% if album_short | default(false) %}
  <button id="albumAdd" type="button" disabled title="{{ _('Add to the album') }}" aria-label="{{ _('Add to the album') }}">➕</button>
  <button id="albumRemove" class="plain" type="button" disabled title="{{ _('Take out of the album') }}" aria-label="{{ _('Take out of the album') }}">➖</button>
  <button id="albumTv" class="plain" type="button" disabled title="{{ _('Share on the TV') }}">📺 {{ _("Share") }}</button>
  <button id="albumSend" class="plain" type="button" disabled title="{{ _('Prepare for sending') }}">✉️ {{ _("Send") }}</button>
{% else %}
  <button id="albumAdd" type="button" disabled>➕ {{ _("Add to the album") }}</button>
  <button id="albumRemove" class="plain" type="button" disabled>{{ _("Take out of the album") }}</button>
  <button id="albumTv" class="plain" type="button" disabled>📺 {{ _("Share on the TV") }}</button>
  <button id="albumSend" class="plain" type="button" disabled>📨 {{ _("Prepare for sending") }}</button>
{% endif %}
  <a id="albumBack" href="#" hidden title="{{ _('Back to the album') }}"></a>
</div>
<p id="albumSaid" role="status"></p>
{% if album_root_path | default("") %}
{# Where the albums go (0534): `[album] root` read back from `config.toml`; empty, asked. #}
<p id="albumRoot"><span id="albumRootSaid"></span>
  <button id="albumRootChange" class="plain" type="button">📁 {{ _("Change") }}</button></p>
<form id="albumRootForm" hidden>
  <label for="albumRootField">{{ _("Where should your albums go?") }}</label>
  <input id="albumRootField" maxlength="4096" autocomplete="off" placeholder="{{ _('e.g. C:\\Photos\\Albums') }}">
  <button type="submit">{{ _("Save") }}</button>
</form>
<script>
(() => {
  const PATH = {{ album_root_path | tojson }};
  const TEXTS = {{ {
    "at": _("📁 Your albums go to {folder}."),
    "none": _("📁 Where should your albums go? Pick a folder on the disk of your photos."),
    "notSaved": _("Nothing was saved: {error}"),
  } | tojson }};
  const $ = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
  const show = (state, said) => {
    $("albumRootSaid").textContent = said || (state.used ? fill(TEXTS.at, { folder: state.used }) : TEXTS.none);
    $("albumRootField").value = state.root || state.used || "";
    $("albumRootForm").hidden = Boolean(said || state.used);
  };
  $("albumRootChange").addEventListener("click", () => { $("albumRootForm").hidden = !$("albumRootForm").hidden; });
  $("albumRootForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    const answer = await fetch(PATH, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ root: $("albumRootField").value }),
    }).catch(() => null);
    const state = answer ? await answer.json().catch(() => ({})) : {};
    if (answer && answer.ok) show(state, state.said);
    else $("albumRootSaid").textContent = fill(TEXTS.notSaved, { error: state.error || "" });
  });
  fetch(PATH).then((answer) => answer.json()).then((state) => show(state)).catch(() => { /* the bar says it */ });
})();
</script>
{% endif %}
<p id="albumTvLine" hidden></p>
<details id="albumMissing" hidden><summary></summary><ul></ul></details>
<script>
(() => {
{% include "combo_list.js.j2" %}
  const ALBUMS_PATH = {{ albums_path | tojson }};
  const TEXTS = {{ {
    "saving": _("Saving…"),
    "notSaved": _("Nothing was saved: {error}"),
    "offline": _("The page is not running any more: start it again."),
    "count": [ngettext("{n} file", "{n} files", 1), ngettext("{n} file", "{n} files", 2)],
    "missing": _("The files of {name} no longer found (moved without the index, or set aside then applied)"),
    "tv": _("To show {name} on the TV: close this page (Ctrl+C in the window where mh runs), then type (copied):"),
    "sendName": _("Sent {date}"),
    "send": _("To prepare {name} for sending (resized copies without the GPS position, a folder and a zip): close this page (Ctrl+C in the window where mh runs), then type (copied):"),
  } | tojson }};
  const QUIET = {{ album_quiet | tojson }};
  const $ = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
  const plural = new Intl.PluralRules(document.documentElement.lang);
  const counted = (forms, n) => fill(forms[plural.select(n) === "one" ? 0 : 1], { n: n });
  const same = (name) => name.trim().replace(/\s+/g, " ").toLowerCase();
  let albums = [];
  let pickedCount = 0;

  const named = () => albums.find((album) => same(album.name) === same($("albumName").value));
  const buttons = () => {
    const typed = $("albumName").value.trim() !== "";
    $("albumAdd").disabled = !(typed && pickedCount);
    $("albumRemove").disabled = !(named() && pickedCount);
    $("albumTv").disabled = !named();
    $("albumSend").disabled = !(named() || pickedCount);
  };

  const show = (answer, state, opening) => {
    const line = $("albumSaid");
    line.className = answer.ok ? "" : "error";
    if (!(opening && QUIET && answer.ok)) {
      line.textContent = answer.ok ? state.message : fill(TEXTS.notSaved, { error: state.error || answer.status });
    }
    if (!answer.ok) return;
    albums = state.albums || [];
    missingBox();
    buttons();
  };

  // The files missing from the album named only (another album's are said on the albums page),
  // hidden while a command is said: the bar has room for one of them.
  const missingBox = () => {
    const album = named();
    const missing = album && $("albumTvLine").hidden ? album.missing : [];
    const box = $("albumMissing");
    box.hidden = !missing.length;
    box.querySelector("summary").textContent = fill(TEXTS.missing, { name: album ? album.name : "" }) + " (" + missing.length + ")";
    box.querySelector("ul").replaceChildren(...missing.map((text) => {
      const item = document.createElement("li");
      item.textContent = text;
      return item;
    }));
  };

  const send = async (action, pick) => {
    const name = $("albumName").value.trim();
    if (!name || !(pick || window.mhAlbumPick)) return false;
    $("albumSaid").className = "";
    $("albumSaid").textContent = TEXTS.saving;
    const body = Object.assign({ action: action, album: name }, pick || window.mhAlbumPick());
    body.keys = (body.keys || []).map(String);
    let answer;
    try {
      answer = await fetch(ALBUMS_PATH, {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
      });
    } catch (error) {
      $("albumSaid").className = "error";
      $("albumSaid").textContent = TEXTS.offline;
      return true;
    }
    show(answer, await answer.json().catch(() => ({})));
    return true;
  };

  const say = (text, command) => {
    const album = named();
    if (!album) return;
    command = fill(command, { name: album.name });
    const line = $("albumTvLine");
    const code = document.createElement("code");
    code.textContent = command;
    line.replaceChildren(fill(text, { name: album.name }) + " ", code);
    line.hidden = false;
    missingBox();
    if (navigator.clipboard) navigator.clipboard.writeText(command).catch(() => { /* shown anyway */ });
  };

  // The command said belongs to the name and the picking it was given for: any change hides it.
  const forget = () => { $("albumTvLine").hidden = true; missingBox(); };
  window.mhAlbumPicked = (count) => { pickedCount = count; forget(); buttons(); };
  // One file into the album named, without picking it (browse's large view, key A);
  // false when no album is named.
  window.mhAlbumAdd = (pick) => send("add", pick);
  comboAttach($("albumName"), () => albums.map((album) => ({ label: album.name, value: album.name, count: counted(TEXTS.count, album.count) })));
  $("albumName").addEventListener("input", () => { forget(); buttons(); });
  $("albumAdd").addEventListener("click", () => send("add"));
  $("albumRemove").addEventListener("click", () => send("remove"));
  $("albumTv").addEventListener("click", () => say(TEXTS.tv, 'mh slideshow --album "{name}" --lan'));
  $("albumSend").addEventListener("click", async () => {
    if (pickedCount) {
      // The files picked are what to send: saved in an album first, `share` takes one.
      const day = new Date().toLocaleDateString("sv"); // YYYY-MM-DD, the local day
      // A plain folder in *Path contains* (search) names the album by its last part, after
      // the closest YYYY-MM (or YYYY) folder above it: 2026/2026-09/Hertogenbosch gives
      // 2026-09-Hertogenbosch. Wildcards or a regex do not name one: the day then.
      const typed = ($("folder")?.value ?? "").trim();
      const parts = /[*?]|^\/.*\/$/.test(typed) ? [] : typed.replace(/[\\/]+$/, "").split(/[\\/]/);
      const last = parts.pop() ?? "";
      const dated = parts.reverse().find((part) => /^\d{4}(-\d\d)?$/.test(part));
      const named = dated && !/^\d{4}/.test(last) ? `${dated}-${last}` : last;
      if (!$("albumName").value.trim()) $("albumName").value = named || fill(TEXTS.sendName, { date: day });
      await send("add");
    }
    say(TEXTS.send, 'mh share --album "{name}"');
  });
  // `?album=<name>` (0501): opened by the albums page's *Add photos*, the field filled once
  // (never remembered: the next page starts empty) and a way back to that album.
  const aimed = new URLSearchParams(window.location.search).get("album");
  if (aimed) {
    $("albumName").value = aimed;
    $("albumBack").href = "/albums/edit?album=" + encodeURIComponent(aimed); // share/album_page.py
    $("albumBack").textContent = "← " + aimed;
    $("albumBack").hidden = false;
  }
  fetch(ALBUMS_PATH).then(async (answer) => show(answer, await answer.json(), true)).catch(() => { /* the page says it */ });
})();
</script>
{% endif %}

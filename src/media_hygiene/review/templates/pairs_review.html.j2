<!DOCTYPE html>
{# The keyboard review of the folder pairs, served by `media-hygiene review --pairs`. The page
   never touches a file: each choice is sent to the server, which saves the `pairs` key of the
   decisions file; `clean --decisions` then applies it, journaled. The panel below the pair
   shows the decisions file as read back from the disk after every choice. #}
{% set texts = {
  "position": _("Pair {number} of {total}"),
  "totals": _("Decided: {decided} of {total}"),
  "files": [ngettext("{n} identical file, {size}", "{n} identical files, {size}", 1), ngettext("{n} identical file, {size}", "{n} identical files, {size}", 2)],
  "why": _("Why this folder keeps them: {reasons}"),
  "complete": "🧩 " ~ _("Entirely a copy: the second folder holds nothing else."),
  "pending": "⏳ " ~ _("Undecided: 'clean' does as planned, the copies of the second folder go."),
  "planned": "✔ " ~ _("Decided: as planned, the copies of the second folder go."),
  "swap": "🔁 " ~ _("Decided: swapped, the copies of the second folder stay and those of the first one go."),
  "skip": "✋ " ~ _("Decided: left alone, nothing of this pair moves."),
  "keep": "✅ " ~ _("keeps its copies"),
  "lose": "📦 " ~ _("loses its copies"),
  "noSwap": _("The first folder is protected, or both copies lie in one folder: W is not possible."),
  "original": "↗ " ~ _("original"),
  "originalTitle": _("Open the original in a new tab: the file as it lies on the disk"),
  "noSamples": _("No picture to preview in this pair (videos or other files): open the report's page of the pair."),
  "saving": _("Saving…"),
  "proofOk": "✔ " ~ _("Saved, then read back from the disk at {time}: {file} holds your choice.").replace("{file}", file),
  "loaded": "📄 " ~ _("{file} read from the disk at {time}.").replace("{file}", file),
  "diskTitle": _("What {file} holds for this pair").replace("{file}", file),
  "diskNone": "⏳ " ~ _("No decision in the file: as planned."),
  "diskEntry": _("Decision in the file: {action}"),
  "allDecided": _("Every pair has been decided."),
  "first": _("This is the first pair."),
  "last": _("This is the last pair: stop the review with Ctrl+C in the terminal."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The review is not running any more: start it again."),
  "units": [_("B"), _("KB"), _("MB"), _("GB"), _("TB")],
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("Folder pairs review") }} — media-hygiene</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header, footer { position: sticky; z-index: 1; padding: 8px 16px; background: var(--card); }
  header { top: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: baseline;
           border-bottom: 1px solid var(--line); }
  header h1 { font-size: 1.1rem; margin: 0; }
  footer { bottom: 0; border-top: 1px solid var(--line); font-size: .85rem; color: var(--muted); }
  .layout { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 16px; padding: 12px 16px 24px; }
  @media (max-width: 760px) { .layout { grid-template-columns: 1fr; } }
  aside section { margin-bottom: 16px; }
  aside h2 { font-size: .95rem; margin: 0 0 6px; }
  .muted { color: var(--muted); }
  #status.error { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  #state { margin: 0 0 12px; padding: 8px 12px; font-weight: 600; background: var(--card);
           border: 2px dashed var(--warn); border-radius: 10px; color: var(--warn); }
  #state.decided { border-style: solid; border-color: var(--ok); color: var(--ok); }
  .folders { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
  @media (max-width: 760px) { .folders { grid-template-columns: 1fr; } }
  .folder { padding: 8px 12px; background: var(--card); border: 3px solid var(--line); border-radius: 10px;
            overflow-wrap: anywhere; }
  .folder.keep { border-color: var(--ok); }
  .folder.lose { border: 3px dashed var(--bad); }
  .tag { font-weight: 600; }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .shot { margin: 0; padding: 8px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; }
  .shot img { display: block; width: 100%; height: auto; max-height: 40vh; object-fit: contain;
              border-radius: 6px; background: var(--bg); }
  figcaption { margin-top: 6px; font-size: .85rem; overflow-wrap: anywhere; }
  figcaption .original { margin-left: 8px; color: var(--accent); }
  kbd { display: inline-block; min-width: 1.6em; padding: 0 6px; font: inherit; text-align: center;
        background: var(--bg); border: 1px solid var(--line); border-radius: 4px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 8px; margin: 0; font-size: .9rem; }
  dd { margin: 0; }
</style>
</head>
<body>
<header>
  <h1>📁 {{ _("Folder pairs review") }}</h1>
  <strong id="position"></strong>
  <span id="totals" class="muted"></span>
  <span id="status" role="status" aria-live="polite"></span>
</header>
<div class="layout">
<aside>
  <section>
    <h2>⌨ {{ _("Keyboard") }}</h2>
    <dl>
      <dt><kbd>→</kbd></dt><dd>{{ _("as planned, then next") }}</dd>
      <dt><kbd>W</kbd></dt><dd>{{ _("swap the folders, then next") }}</dd>
      <dt><kbd>L</kbd></dt><dd>{{ _("leave the pair alone, then next") }}</dd>
      <dt><kbd>←</kbd></dt><dd>{{ _("previous pair") }}</dd>
      <dt><kbd>N</kbd></dt><dd>{{ _("next undecided pair") }}</dd>
      <dt><kbd>U</kbd></dt><dd>{{ _("back to undecided") }}</dd>
    </dl>
  </section>
  <section>
    <p class="muted">{{ _("The pairs come the most space freed first. Each copy in the second folder has an identical file in the first one.") }}</p>
  </section>
</aside>
<main>
  <p id="state" role="status"></p>
  <div class="folders">
    <div id="keptIn" class="folder"></div>
    <div id="removedFrom" class="folder"></div>
  </div>
  <p id="files"></p>
  <p id="why" class="muted"></p>
  <p id="complete"></p>
  <div id="shots" class="shots"></div>
  <details id="disk" open>
    <summary id="diskTitle"></summary>
    <div id="diskBody"></div>
  </details>
</main>
</div>
<footer>
  {{ _("Every choice is saved at once in %(place)s. Done? Ctrl+C in the terminal stops the review; then run the same 'clean' command with %(option)s: it audits again, applies your pairs, and 'undo' brings back what it removed.", place=place, option=clean_option) }}
</footer>
<script>
{% include "pairs_review.js.j2" %}
</script>
{% include "home_link.html.j2" %}
</body>
</html>

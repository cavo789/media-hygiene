{# The large view of a page of photos to pick (`pick_viewer.html.j2`): Enter or a double
   click opens the file framed; its keys (`VIEWER_KEYS`, read by `pick_grid.js.j2`) move,
   set aside, take back, add to the album, go full screen. Shares the state of
   `pick_grid.js.j2`, included just before. #}
let saving = false;    // Delete in the viewer: one save at a time (a key held repeats)
const SWIPE_PX = 50;   // a touch moved less than this is a tap (as the albums' page)
let pointer = null;    // where a touch began on the large view
let swiped = false;    // the click that ends a swipe does not close the view
{% include "pick_preload.js.j2" %}

// Opened large: the file shown alone is set aside (Delete) or taken back (Backspace), the
// save read back from the server (its label too). One save at a time: a key held repeats.
async function saveShown(action) {
  const file = files[current];
  if (!file || saving) return false;
  if ((action === "add") === Boolean(file.chosen)) return true; // so already
  saving = true;
  $("viewerSaid").className = "";
  $("viewerSaid").textContent = TEXTS.saving;
  if (saveChoice) {
    const saved = await saveChoice(action, [file.key]);
    saving = false;
    if (saved) await reopen(true);
    return saved;
  }
  const answer = await ask(CHOSEN_PATH, { action: action, keys: [file.key], search: scope() });
  saving = false;
  if (!answer) { failed(null); $("viewerSaid").textContent = TEXTS.offline; return false; }
  said(answer, await answer.json().catch(() => ({})));
  if (!answer.ok) return false;
  await reopen(true);
  return true;
}

// The nearest file not set aside from `from` (excluded), going by `step` (+1 or -1); -1 if none.
// The arrows step over the files set aside: none of them is ever shown on the way (0517).
function notAside(from, step) {
  for (let index = from + step; index >= 0 && index < files.length; index += step) {
    if (!files[index].chosen) return index;
  }
  return -1;
}

// Shows the file at `index` large; a file not found (-1) leaves the one shown.
function largeAt(index) {
  if (index < 0) return;
  focusOn(index);
  open();
}

// Delete: set aside, then the previous file not set aside shows, else the next; none left
// closes the view.
async function asideShown() {
  const index = current;
  if (!(await saveShown("add"))) return;
  const before = notAside(index, -1);
  const shown = before >= 0 ? before : notAside(index, 1);
  if (shown < 0) { focusOn(index); close(); } else largeAt(shown);
}

// Backspace: taken back out of the set aside; the file stays shown (a video keeps playing).
async function takeBackShown() {
  if (await saveShown("remove")) $("viewerAside").hidden = !files[current].chosen;
}

// A: the file shown goes into the album named in the bar (`album_bar.html.j2`).
async function albumShown() {
  const file = files[current];
  if (!file || !window.mhAlbumAdd) return;
  const sent = await window.mhAlbumAdd({ keys: [file.key], search: scope() });
  $("viewerSaid").className = $("albumSaid").className;
  $("viewerSaid").textContent = sent ? $("albumSaid").textContent : TEXTS.noAlbum;
}

function playPause() {
  const movie = $("movie");
  if (movie.hidden) return;
  if (movie.paused) movie.play().catch(() => undefined); else movie.pause();
}

// F: the large view on the whole screen; Esc (the browser's) leaves it first.
function fullScreen() {
  if (document.fullscreenElement) document.exitFullscreen().catch(() => undefined);
  else $("viewer").requestFullscreen().catch(() => undefined);
}

function toggle(id) {
  $(id).hidden = !$(id).hidden;
}

function open() {
  const file = files[current];
  if (!file) return;
  const movie = $("movie");
  const large = $("large");
  movie.hidden = !file.video;
  large.hidden = Boolean(file.video);
  if (file.video) { movie.src = file.video; } else { movie.removeAttribute("src"); large.src = file.preview; }
  large.alt = file.name;
  $("viewerName").textContent = file.name;
  $("viewerAside").hidden = !file.chosen;
  // A page may turn the day or the folder into a link (`infoLink`, the search page's).
  const facts = [["date", file.date], ["spot", file.spot], ["size", file.size], ["facts", file.facts], ["folder", file.where || file.folder || scope().folder]];
  $("viewerInfo").replaceChildren();
  for (const [at, [kind, text]] of facts.filter(([, text]) => text).entries()) {
    if (at) $("viewerInfo").append(" · ");
    $("viewerInfo").append(typeof infoLink === "function" ? infoLink(kind, text) : text);
  }
  for (const line of file.exif || []) $("viewerInfo").append(element("div", "", line)); // EXIF (0433)
  if (typeof infoExtra === "function") $("viewerInfo").append(...infoExtra(file)); // a page's own facts
  $("viewerSaid").textContent = "";
  $("originalLink").href = file.original;
  $("personLink").hidden = !file.path; // `/person`, served by every page (0351)
  if (file.path) $("personLink").href = "/person?path=" + encodeURIComponent(file.path);
  // Opening pushes a step of the history: Back closes the view, as Esc (0666); ← → replace nothing.
  if (!$("viewer").classList.contains("open")) window.mhView.set({}, { push: true, state: { mhViewer: true } });
  $("viewer").classList.add("open");
  preloadAround();
}

function close() {
  if (window.history.state && window.history.state.mhViewer) { window.history.back(); return; } // popstate closes it
  closeShown();
}

function closeShown() {
  preloadStop();
  preload.seen = -1;
  $("movie").pause();
  if (document.fullscreenElement) document.exitFullscreen().catch(() => undefined);
  $("viewer").classList.remove("open");
}
window.addEventListener("popstate", () => { if ($("viewer").classList.contains("open")) closeShown(); });

// The keys of the large view: listed under it with `?` (`pick_viewer.html.j2`, `viewerHelp`).
const VIEWER_KEYS = {
  Escape: close,
  ArrowRight: () => largeAt(notAside(current, 1)),
  ArrowLeft: () => largeAt(notAside(current, -1)),
  Home: () => largeAt(notAside(-1, 1)),
  End: () => largeAt(notAside(files.length, -1)),
  Delete: asideShown,
  Backspace: takeBackShown,
  " ": playPause,
  f: fullScreen,
  i: () => toggle("viewerInfo"),
  a: albumShown,
  "?": () => toggle("viewerHelp"),
};

$("viewer").addEventListener("click", (event) => {
  if (swiped) { swiped = false; return; }
  if (!event.target.closest("a, video, .stay")) close(); // the lists under it stay open
});
// A phone: a swipe to the left shows the next file, to the right the previous one.
$("viewer").addEventListener("pointerdown", (event) => { pointer = { x: event.clientX, y: event.clientY }; });
$("viewer").addEventListener("pointerup", (event) => {
  if (!pointer) return;
  const dx = event.clientX - pointer.x;
  const dy = event.clientY - pointer.y;
  pointer = null;
  if (Math.abs(dx) <= SWIPE_PX || Math.abs(dx) <= Math.abs(dy)) return;
  swiped = true;
  (dx < 0 ? VIEWER_KEYS.ArrowRight : VIEWER_KEYS.ArrowLeft)();
});

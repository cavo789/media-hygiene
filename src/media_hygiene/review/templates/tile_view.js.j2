{# The view of a page of tiles (`tile_view.html.j2`): the size of the tiles and the left panel
   hidden, kept per page and per viewer in this browser only (a convenience: the page works the
   same without it). `TILE_VIEW_KEY` names the page; `TEXTS.sideHide`/`sideShow` the button. #}
(() => {
  const read = () => { try { return JSON.parse(localStorage.getItem(TILE_VIEW_KEY) || "{}"); } catch (error) { return {}; } };
  const sizes = document.getElementById("sizes");
  const toggle = document.getElementById("sideToggle");
  const show = (view) => {
    document.body.dataset.tileSize = view.size || "m";
    for (const button of sizes.querySelectorAll("button")) {
      button.setAttribute("aria-pressed", String(button.dataset.size === document.body.dataset.tileSize));
    }
    const hidden = Boolean(view.sideHidden);
    document.querySelector(".layout").classList.toggle("sideHidden", hidden);
    toggle.textContent = hidden ? TEXTS.sideShow : TEXTS.sideHide;
    toggle.setAttribute("aria-pressed", String(hidden));
  };
  const change = (part) => {
    const view = { ...read(), ...part };
    try { localStorage.setItem(TILE_VIEW_KEY, JSON.stringify(view)); } catch (error) { /* not kept */ }
    show(view);
  };
  sizes.addEventListener("click", (event) => {
    const button = event.target.closest("button[data-size]");
    if (button) change({ size: button.dataset.size });
  });
  toggle.addEventListener("click", () => change({ sideHidden: !read().sideHidden }));
  show(read());
})();

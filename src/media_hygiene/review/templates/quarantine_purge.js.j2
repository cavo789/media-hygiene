{# *Purge* of the run shown (0616): only under the home server, reached from Disk space
   (`?run=…&purge=1`), once its files are on the page. The button states what goes, from the
   disk; the page asks once, `mh` runs the step, then Disk space says what the disk says. #}
const PURGE_TEXTS = {{ {
  "button": _("Erase these {count} files for good: frees {size}"),
  "unshown": _("Erase these {count} files and {others} other files not shown for good: frees {size}"),
  "sureYes": _("Erase for good"),
  "sure": _("Erase run {run} for good? This cannot be undone, not even by 'undo'."),
  "running": _("Erasing in the window of mh: {command}"),
  "only": _("{count} of these files exist nowhere else ({size}): near duplicates, burst shots, junk or unreadable, not exact copies."),
  "onlyMore": _("… and {count} more."),
  "onlySure": _("That includes the {count} files listed, which exist nowhere else."),
} | tojson }};
const DISK_STATE = "/disk-space/api/state";
const DISK_ONLY = "/disk-space/api/only"; // the run's only copies, listed first (0699)
let onlyCount = 0;
const PURGE_PATH = {{ purge_path | tojson }};
const ASKED = window.mhView.get({ back: ["history"], purge: ["1"] });
const LANDS_ON = ASKED.back === "history" ? "/history/" : "/disk-space/"; // 0631
const WANTS_PURGE = Boolean(ONLY_RUN) && ASKED.purge === "1";

drawPurge = async () => {
  if (!WANTS_PURGE) return;
  const answer = await fetch(DISK_STATE, { cache: "no-store" }).catch(() => null);
  const state = answer && answer.ok ? await answer.json() : null;
  const run = state && state.runs.find((each) => each.run_id === ONLY_RUN);
  $("purgeBar").hidden = !run || tiles.length === 0;
  if ($("purgeBar").hidden) return;
  const others = run.count - tiles.length;
  const values = { count: number(tiles.length), others: number(others), size: run.size };
  $("purge").textContent = fill(others > 0 ? PURGE_TEXTS.unshown : PURGE_TEXTS.button, values);
  await drawOnly();
};

const drawOnly = async () => {
  const answer = await fetch(`${DISK_ONLY}?run=${encodeURIComponent(ONLY_RUN)}`, { cache: "no-store" }).catch(() => null);
  const only = answer && answer.ok ? await answer.json() : null;
  if (!only) { $("purgeBar").hidden = true; return; } // never a purge without knowing them
  onlyCount = only.count;
  $("purgeOnly").hidden = only.count === 0;
  $("purgeOnlySaid").textContent = fill(PURGE_TEXTS.only, { count: number(only.count), size: only.size });
  const items = only.files.map((file) => { const item = document.createElement("li"); item.textContent = file; return item; });
  if (only.count > only.files.length) {
    const more = document.createElement("li");
    more.textContent = fill(PURGE_TEXTS.onlyMore, { count: number(only.count - only.files.length) });
    items.push(more);
  }
  $("purgeOnlyFiles").replaceChildren(...items);
};

// One poll for the page (step_chip.html.j2, 0661/0706): its end said here, not by the chip.
const followPurge = (step) => {
  window.mhStep.claim(step.id);
  const stop = window.mhStep.watch((now) => {
    if (!now || now.state !== "done" || now.id !== step.id) return; // no answer: the next poll
    stop();
    window.location.assign(`${LANDS_ON}?purged=${encodeURIComponent(ONLY_RUN)}`);
  });
};

$("purge").addEventListener("click", async () => {
  if (!await window.mhAsk({ lines: [fill(PURGE_TEXTS.sure, { run: ONLY_RUN }), ...(onlyCount > 0 ? [fill(PURGE_TEXTS.onlySure, { count: number(onlyCount) })] : [])], yes: PURGE_TEXTS.sureYes, danger: true })) return;
  $("purge").disabled = true;
  const answer = await ask(PURGE_PATH, { run_id: ONLY_RUN, files: tiles.length });
  const step = answer ? await answer.json().catch(() => ({})) : {};
  if (!answer || !answer.ok) {
    $("purge").disabled = false;
    say(step.error || TEXTS.offline, "error");
    return;
  }
  say(fill(PURGE_TEXTS.running, { command: step.command }), "");
  followPurge(step);
});

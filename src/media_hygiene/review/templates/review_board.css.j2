{# Included in the style of review.html.j2: the board (body.board), several series per
   screen; the single series view is hidden meanwhile, and the other way round. #}
  #board { display: none; }
  body.board #board { display: block; }
  body.board #single { display: none; }
  #view { padding: 2px 10px; font: inherit; color: var(--text); cursor: pointer;
          background: var(--bg); border: 1px solid var(--line); border-radius: 6px; }
  #board .boardBar { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; margin: 0 0 10px;
              padding: 8px 12px; font-weight: 600; color: var(--warn); background: var(--card);
              border: 2px dashed var(--warn); border-radius: 10px; }
  #board .boardNext { margin-left: auto; padding: 4px 12px; font: inherit; font-weight: 600; cursor: pointer;
               color: var(--card); background: var(--ok); border: 0; border-radius: 6px; }
  #board .series { margin: 0 0 10px; padding: 6px 8px; background: var(--card); cursor: pointer;
                   border: 2px solid var(--line); border-radius: 10px; }
  #board .series.current { border-color: var(--accent); }
  #board .head { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; font-size: .85rem; }
  #board .head .what { font-weight: 600; color: var(--muted); }
  #board .head .what.kept { color: var(--ok); } #board .head .what.partial { color: var(--warn); }
  #board .head .what.whole { color: var(--bad); }
  #board .head .act { padding: 0 8px; font: inherit; font-size: .8rem; color: var(--text); cursor: pointer;
                      background: var(--bg); border: 1px solid var(--line); border-radius: 4px; }
  #board .head .act:first-of-type { margin-left: auto; }
  #board .strip { display: flex; gap: 6px; margin-top: 6px; overflow-x: auto; }
  #board .thumb { flex: none; margin: 0; padding: 3px; cursor: pointer; text-align: center;
                  border: 3px solid var(--line); border-radius: 8px; }
  #board .thumb img { display: block; height: 130px; width: auto; max-width: 220px; object-fit: contain;
                      border-radius: 4px; background: var(--bg); }
  #board .thumb figcaption { margin: 0; font-size: .75rem; color: var(--muted); }
  #board .thumb.kept, #board .thumb.suggested { border-color: var(--ok); }
  #board .thumb.aside { border-color: var(--bad); } #board .thumb.aside img { opacity: .3; }
  #board .thumb.proposed { border-style: dashed; border-color: var(--bad); }
  #board .thumb.proposed img { opacity: .55; }
  #board .thumb.protected { border-color: var(--warn); cursor: not-allowed; }
  #zoom { position: fixed; top: 60px; bottom: 60px; z-index: 4; width: 48vw; padding: 6px;
          pointer-events: none; background: var(--card); border: 1px solid var(--line);
          border-radius: 10px; box-shadow: 0 8px 30px rgb(0 0 0 / 25%); }
  #zoom[hidden] { display: none; }
  #zoom.left { left: 16px; } #zoom.right { right: 16px; }
  #zoom.pinned { border: 2px solid var(--accent); }
  body:not(.board) #keys .board-only { display: none; }
  #zoom img { width: 100%; height: 100%; object-fit: contain; }

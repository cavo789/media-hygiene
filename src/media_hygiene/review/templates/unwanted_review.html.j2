<!DOCTYPE html>
{# The keyboard review of the photos most likely unwanted, served by `media-hygiene review --junk`.
   The page never touches a file: each choice is sent to the server, which saves the `unwanted`
   key of the decisions file; `clean --decisions` then moves the photos set aside to the
   quarantine, journaled. The panel below the group shows the file as read back from the disk. #}
{% set texts = {
  "position": _("Group {number} of {total}"),
  "totals": _("Set aside: {aside} · decided: {decided} of {total}"),
  "pending": "⏳ " ~ _("Undecided: nothing moves. → sets aside the photos marked, Space keeps or sets aside the photo under the cursor."),
  "decided": "✔ " ~ _("Decided: the photos marked 📦 go to the quarantine with 'clean --decisions', the others stay."),
  "aside": "📦 " ~ _("set aside"),
  "kept": "✅ " ~ _("kept"),
  "proposed": "⏳ " ~ _("proposed aside"),
  "original": "↗ " ~ _("original"),
  "originalTitle": _("Open the original in a new tab: the file as it lies on the disk"),
  "saving": _("Saving…"),
  "proofOk": "✔ " ~ _("Saved, then read back from the disk at {time}: {file} holds your choice.").replace("{file}", file),
  "loaded": "📄 " ~ _("{file} read from the disk at {time}.").replace("{file}", file),
  "diskTitle": _("What {file} holds for this group").replace("{file}", file),
  "diskCounts": _("In the file: {aside} set aside, {kept} kept, {none} undecided."),
  "allDecided": _("Every group has been decided."),
  "first": _("This is the first group."),
  "last": _("This is the last group: stop the review with Ctrl+C in the terminal."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The review is not running any more: start it again."),
} %}
{% set page_name = _("Unwanted photos review") %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_name }} — media-hygiene</title>
<link rel="icon" type="image/png" href="/assets/images/favicon.png">
<style>
{% include "theme.css.j2" %}
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 400 15px/1.5 var(--mk-font-text); }
  header, footer { position: sticky; z-index: 1; padding: 8px 16px; background: var(--card); }
  header { top: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: baseline;
           border-bottom: 1px solid var(--line); }
  footer { bottom: 0; border-top: 1px solid var(--line); font-size: .85rem; color: var(--muted); }
  .layout { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: 16px; padding: 12px 16px 24px; }
  @media (max-width: 760px) { .layout { grid-template-columns: 1fr; } }
  aside section { margin-bottom: 16px; }
  aside h2 { font-size: .95rem; margin: 0 0 6px; }
  main h2 { font-size: 1rem; margin: 0 0 8px; }
  .muted { color: var(--muted); }
  #status.error { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  #state { margin: 0 0 12px; padding: 8px 12px; font-weight: 600; background: var(--card);
           border: 2px dashed var(--warn); border-radius: 10px; color: var(--warn); }
  #state.decided { border-style: solid; border-color: var(--ok); color: var(--ok); }
  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .shot { margin: 0; padding: 6px; background: var(--card); border: 3px solid var(--line); border-radius: 10px; cursor: pointer; }
  .shot.kept { border-color: var(--ok); }
  .shot.aside, .shot.proposed { border: 3px dashed var(--bad); }
  .shot.aside img { opacity: .6; }
  .shot.cursor { outline: 3px solid var(--accent); outline-offset: 2px; }
  .shot img { display: block; width: 100%; height: 160px; object-fit: contain; border-radius: 6px; background: var(--bg); }
  figcaption { margin-top: 4px; font-size: .8rem; overflow-wrap: anywhere; }
  figcaption .original { margin-left: 6px; color: var(--accent); }
  .tag { font-weight: 600; }
  kbd { display: inline-block; min-width: 1.6em; padding: 0 6px; font: inherit; text-align: center;
        background: var(--bg); border: 1px solid var(--line); border-radius: 4px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 2px 8px; margin: 0; font-size: .9rem; }
  dd { margin: 0; }
</style>
</head>
<body>
{% include "page_header.html.j2" %}
<header>
  <strong id="position"></strong>
  <span id="totals" class="muted"></span>
  <span id="status" role="status" aria-live="polite"></span>
</header>
<div class="layout">
<aside>
  <section>
    <h2>⌨ {{ _("Keyboard") }}</h2>
    <dl>
      <dt><kbd>→</kbd></dt><dd>{{ _("the group as marked, then next") }}</dd>
      <dt><kbd>␣</kbd></dt><dd>{{ _("keep or set aside the photo under the cursor") }}</dd>
      <dt><kbd>↑</kbd> <kbd>↓</kbd></dt><dd>{{ _("move the cursor") }}</dd>
      <dt><kbd>←</kbd></dt><dd>{{ _("previous group") }}</dd>
      <dt><kbd>N</kbd></dt><dd>{{ _("next undecided group") }}</dd>
      <dt><kbd>U</kbd></dt><dd>{{ _("the group back to undecided") }}</dd>
    </dl>
    <p class="muted">{{ _("A click on a photo keeps it or sets it aside too.") }}</p>
  </section>
  <section>
    <p class="muted">{{ _("Never a photo of a protected folder, a burst shot, a near or exact duplicate. The thresholds are in [review.unwanted] of config.toml.") }}</p>
  </section>
</aside>
<main>
  <h2 id="title"></h2>
  <p id="state" role="status"></p>
  <div id="shots" class="shots"></div>
  <details id="disk" open>
    <summary id="diskTitle"></summary>
    <div id="diskBody"></div>
  </details>
</main>
</div>
<footer>
  {{ _("Every choice is saved at once in %(place)s. Done? Ctrl+C in the terminal stops the review; then run the same 'clean' command with %(option)s: the photos set aside go to the quarantine, and 'undo' brings them back.", place=place, option=clean_option) }}
</footer>
<script>
{% include "unwanted_review.js.j2" %}
</script>
{% include "home_link.html.j2" %}
</body>
</html>

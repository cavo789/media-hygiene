// The steps after `mh import --phone` (0481): `[imports] then` of config.toml, read from the
// disk, one box per step under the import's row; a box switched writes the file and draws
// what was read back (never what was sent).
const imports = { steps: null, busy: false };
const IMPORT_STEPS = ["audit", "copies", "bursts", "tags", "places"];
function importsHtml() {
  if (REMOTE || !P.importSteps || !imports.steps) return `<div id="importSteps"></div>`;
  const boxes = IMPORT_STEPS.map((step) => `<label><input type="checkbox" data-import-step="${step}"${imports.steps.includes(step) ? " checked" : ""}${imports.busy ? " disabled" : ""}> ${esc(T["imports_" + step])}</label>`).join(" ");
  return `<div id="importSteps"><p class="muted"><strong>${esc(T.importsThen)}</strong> ${boxes}${imports.steps.length ? "" : ` · ${esc(T.importsNone)}`}</p></div>`;
}
function redrawImports() { const box = $("#importSteps"); if (box) box.outerHTML = importsHtml(); }
function loadImports() {
  if (REMOTE || !P.importSteps) return;
  fetch(P.importSteps, { cache: "no-store" })
    .then((r) => (r.ok ? r.json() : null))
    .then((answer) => { if (answer) { imports.steps = answer.steps; redrawImports(); } })
    .catch(() => {});
}
document.addEventListener("change", (event) => {
  if (!event.target.matches("[data-import-step]") || imports.busy) return;
  const steps = $$("[data-import-step]").filter((box) => box.checked).map((box) => box.dataset.importStep);
  imports.busy = true;
  post(P.importSteps, { steps: steps })
    .then((reply) => {
      if (!reply.ok) { toast(reply.body.error || T.scopeFailed); return; }
      imports.steps = reply.body.steps; // what config.toml holds now, read back
      toast(T.scopeSaved);
    })
    .catch(() => stopped())
    .finally(() => { imports.busy = false; redrawImports(); });
});
loadImports();

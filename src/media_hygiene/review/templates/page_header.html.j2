{# The bar on top of every page served but the home page (0268, review/page_header.py): the name, the
   avatar and the page's name (`page_name`, set by the page); its chapter of the documentation in the
   page's language and in the other one; "Back to the home page" when `mh` opened it from the home
   page: its click is handled by home_link.html.j2, which ends this page as Quit does and waits for
   the home page to come back (0210), or a plain link when the home server serves the page (0356); a page may say more on its title (`home_title`). The theme the home page's switch chose is read first. #}
<script>
{% include "theme_choice.js.j2" %}
</script>
<nav class="mh-bar" aria-label="Media Hygiene">
  <span class="mh-brand"><img src="{{ header.assets }}images/avatar.webp" alt="" width="24" height="32">Media Hygiene</span>
  <span class="mh-page" aria-hidden="true">›</span>
  <h1 class="mh-page">{{ page_name }}</h1>
  <span class="mh-links">
    <a class="mh-doc" href="{{ header.doc }}" target="_blank" rel="noopener">{{ _("Documentation") }}</a>
    <a class="mh-doc" href="{{ header.twin }}" target="_blank" rel="noopener" hreflang="{{ header.twin_lang }}" lang="{{ header.twin_lang }}">{{ header.twin_label }}</a>
{% if header.shared %}
    <a class="mh-home" id="homeLink" href="/" data-shared="1">⌂ {{ _("Back to the home page") }}</a>
{% elif header.home %}
    <a class="mh-home" id="homeLink" href="#" title="{{ home_title | default(_('Close this page and go back to the home page: mh opens it again.')) }}">⌂ {{ _("Back to the home page") }}</a>
{% endif %}
  </span>
</nav>

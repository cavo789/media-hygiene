<!DOCTYPE html>
{# The keyboard review of burst series, served by `media-hygiene review`. The page never
   touches a photo: each choice is sent to the server, which saves the decisions file;
   `clean --decisions` then moves the shots set aside, journaled. The left panel shows the
   decisions file as read back from the disk after every choice: the proof it was saved. #}
{% set texts = {
  "position": _("Series {number} of {total}"),
  "totals": _("Series seen: {seen} · with shots set aside: {series} · shots set aside: {shots}"),
  "shots": _("{count} shots"),
  "nSeries": [ngettext("{n} series", "{n} series", 1), ngettext("{n} series", "{n} series", 2)],
  "nObvious": [ngettext("{n} obvious series", "{n} obvious series", 1), ngettext("{n} obvious series", "{n} obvious series", 2)],
  "nObviousDone": [ngettext("{n} obvious series validated", "{n} obvious series validated", 1), ngettext("{n} obvious series validated", "{n} obvious series validated", 2)],
  "nAside": [ngettext("{n} shot set aside", "{n} shots set aside", 1), ngettext("{n} shot set aside", "{n} shots set aside", 2)],
  "nProposed": [ngettext("{n} shot proposed aside", "{n} shots proposed aside", 1), ngettext("{n} shot proposed aside", "{n} shots proposed aside", 2)],
  "kept": "✅ " ~ _("kept"),
  "aside": "📦 " ~ _("set aside"),
  "protected": "🔒 " ~ _("protected folder, kept"),
  "sharpest": "⭐ " ~ _("sharpest"),
  "sharpestFaces": "⭐ " ~ _("faces sharpest"),
  "suggested": _("suggestion"),
  "undecided": "⏳ " ~ _("kept if you move on"),
  "proposed": "📦 " ~ _("proposed aside: sharpness {share} %% of the best"),
  "proposedFaces": "📦 " ~ _("proposed aside: faces less sharp, {share} %% of the best"),
  "identical": "📦 " ~ _("proposed aside: nearly identical to the sharper shot {number}"),
  "overexposed": "📦 " ~ _("proposed aside: overexposed next to the others"),
  "underexposed": "📦 " ~ _("proposed aside: underexposed next to the others"),
  "obvious": "✔ " ~ _("Validate {series} ({aside})"),
  "obviousNone": _("No obvious series left to validate."),
  "obviousAsk": _("{series}: only the sharpest shot (and those of protected folders) would stay, {aside}, saved in one write. Series to look at, still to see: {left}. Validate them? Z takes the whole batch back."),
  "obviousDone": _("{done}: Z takes the whole batch back."),
  "undoneMany": "↶ " ~ _("Choices on {count} series undone."),
  "welcome": "💡 " ~ _("The proposal is already made: → is enough when it suits you."),
  "pending": "⏳ " ~ _("No choice yet: moving on (→, ← or N) keeps every shot of this series. S keeps only the sharpest, X sets the whole series aside, 1…9 sets one shot aside."),
  "pendingProposed": "⏳ " ~ _("No choice yet: moving on (→, ← or N) accepts the proposal, the shots in red dashes set aside and the others kept. A keeps every shot; a digit takes a shot back."),
  "original": "↗ " ~ _("original"),
  "originalTitle": _("Open the original in a new tab: the file as it lies on the disk"),
  "saving": _("Saving…"),
  "proofOk": "✔ " ~ _("Saved, then read back from the disk at {time}: {file} holds your choice.").replace("{file}", file),
  "loaded": "📄 " ~ _("{file} read from the disk at {time}.").replace("{file}", file),
  "undone": "↶ " ~ _("Choice on series {number} undone."),
  "nothingToUndo": _("Nothing to undo."),
  "tocTitle": _("Table of contents"),
  "progress": _("Series seen: {seen} of {total}"),
  "rowName": _("Series {number}"),
  "rowTodo": "⏳ " ~ _("to see"),
  "rowKept": "✅ " ~ _("all {count} kept"),
  "rowAside": ["📦 " ~ ngettext("{n} of {count} set aside", "{n} of {count} set aside", 1), "📦 " ~ ngettext("{n} of {count} set aside", "{n} of {count} set aside", 2)],
  "rowWhole": "🗑 " ~ _("whole series set aside"),
  "rowGap": _("gap {gap} %%"),
  "compareTitle": "🔍 " ~ _("At 100 %%: move the mouse over a shot, the same area shows in every one. C or Escape closes."),
  "compareNone": _("Your browser cannot show this format: open the original."),
  "remaining": "⏱ " ~ _("about {time} left at your pace"),
  "viewBoard": "🗂 " ~ _("Board"),
  "viewSingle": "🖼 " ~ _("One series"),
  "boardKeep": "✅ " ~ _("keep all"),
  "boardSharpest": "⭐ " ~ _("only the sharpest"),
  "boardNone": "🗑 " ~ _("keep nothing"),
  "boardPage": _("Page {page} of {pages}"),
  "boardPending": _("→ validates the series still to see here as shown ({series}, {aside}), then opens the next page."),
  "boardDone": _("Every series of this page has been seen: → opens the next page."),
  "validate": "✔ " ~ _("validate"),
  "validateTitle": _("Validate the series still to see here, as moving on would"),
  "validateAsk": _("Series still to see in {folder}: {series}. Validate them as shown, {aside}, the others kept?"),
  "validateNone": _("Every series here has been seen already."),
  "diskTitle": _("What {file} holds for this series").replace("{file}", file),
  "diskTodo": "⏳ " ~ _("No choice yet: nothing will be moved."),
  "diskDone": "✔ " ~ _("Seen."),
  "diskKept": _("Kept"),
  "diskAside": _("Set aside"),
  "diskMissing": _("This series is not in the file yet."),
  "raw": _("Raw JSON"),
  "allSeen": _("Every series has been seen."),
  "failed": _("Not saved (error {status})."),
  "offline": _("The review is not running any more: start it again."),
  "protectedShot": _("This shot lies in a protected folder: it is never moved."),
  "keepOne": _("To set every shot aside, press X: the whole series goes to the quarantine."),
  "allProtected": _("Every shot of this series lies in a protected folder: none is ever moved."),
  "whole": "📦 " ~ _("Whole series set aside: its shots go to the quarantine at 'clean --decisions'. A or X keeps them all again."),
  "first": _("This is the first series."),
  "last": _("This is the last series: stop the review with Ctrl+C in the terminal."),
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("Burst series review") }} — media-hygiene</title>
<style>
{% include "review_side.css.j2" %}
{% include "review_tree.css.j2" %}
{% include "review_compare.css.j2" %}
{% include "review_board.css.j2" %}
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header, footer { position: sticky; z-index: 1; padding: 8px 16px; background: var(--card); }
  header { top: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: baseline;
           border-bottom: 1px solid var(--line); }
  header h1 { font-size: 1.1rem; margin: 0; }
  footer { bottom: 0; border-top: 1px solid var(--line); font-size: .85rem; color: var(--muted); }
  .muted { color: var(--muted); }
  #status.error { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  #status.pending { color: var(--warn); font-weight: 600; }
  #pending { margin: 0 0 12px; padding: 8px 12px; font-weight: 600; color: var(--warn);
             background: var(--card); border: 2px dashed var(--warn); border-radius: 10px; }
  #welcome { margin: 0 0 12px; padding: 8px 12px; font-weight: 600; color: var(--accent);
             background: var(--card); border: 2px solid var(--accent); border-radius: 10px; }
  #whole { margin: 0 0 12px; padding: 8px 12px; font-weight: 600; color: var(--bad);
           background: var(--card); border: 2px solid var(--bad); border-radius: 10px; }
  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
  .shot { position: relative; margin: 0; padding: 8px; background: var(--card); cursor: pointer;
          border: 3px solid var(--line); border-radius: 10px; }
  .shot.kept, .shot.suggested { border-color: var(--ok); }
  .shot img { display: block; width: 100%; height: auto; max-height: 62vh; object-fit: contain;
              border-radius: 6px; background: var(--bg); }
  .shot.aside { border-color: var(--bad); } .shot.aside img { opacity: .3; }
  .shot.proposed { border: 3px dashed var(--bad); } .shot.proposed img { opacity: .55; }
  .shot.protected { cursor: not-allowed; border-color: var(--warn); }
  .shot .key { position: absolute; top: 14px; left: 14px; min-width: 30px; padding: 2px 8px;
               text-align: center; font-weight: 650; background: var(--card);
               border: 1px solid var(--line); border-radius: 6px; }
  figcaption { margin-top: 6px; font-size: .85rem; overflow-wrap: anywhere; }
  figcaption .original { margin-left: 8px; font-weight: 400; color: var(--accent); }
  .state { font-weight: 600; color: var(--ok); } .aside .state, .proposed .state { color: var(--bad); }
  .undecided .state { color: var(--muted); }
  .protected .state { color: var(--warn); }
  kbd { display: inline-block; min-width: 1.6em; padding: 0 6px; font: inherit; text-align: center;
        color: var(--text); background: var(--bg); border: 1px solid var(--line); border-radius: 4px; }
</style>
</head>
<body>
<header>
  <h1>📸 {{ _("Burst series review") }}</h1>
  <button type="button" id="view" title="{{ _('Switch between the board and one series at a time (P)') }}"></button>
  <strong id="position"></strong>
  <span id="totals" class="muted"></span>
  <span id="eta" class="muted"></span>
  <span id="status" role="status" aria-live="polite"></span>
</header>
<div class="layout">
<aside id="side">
  <section id="toc" aria-label="{{ _('Table of contents') }}">
    <h2 id="tocTitle"></h2>
    <progress id="tocBar" value="0" max="1"></progress>
    <div id="tocProgress" class="muted"></div>
    <label class="filter">{{ _("Order") }}
      <select id="order">
        <option value="folder">{{ _("by folder") }}</option>
        <option value="time">{{ _("by date") }}</option>
        <option value="gap">{{ _("largest sharpness gap first") }}</option>
        <option value="space">{{ _("space freed, largest first") }}</option>
        <option value="todo">{{ _("still to see first") }}</option>
      </select>
    </label>
    <label class="filter"><input type="checkbox" id="onlyTodo"> <span>{{ _("Only the series still to see") }}</span></label>
    <label class="filter"><input type="checkbox" id="onlyLook"> <span>{{ _("Only the series to look at") }}</span></label>
    <button type="button" id="obvious" title="{{ _('Validate at once every series still to see whose proposal leaves nothing to judge (V)') }}"></button>
    <div id="tree"></div>
  </section>
  <section id="keys" aria-label="{{ _('Keyboard') }}">
    <h2>⌨ {{ _("Keyboard") }}</h2>
    <dl>
      <dt><kbd>→</kbd></dt><dd>{{ _("accept the proposal, next") }}</dd>
      <dt><kbd>S</kbd></dt><dd>{{ _("only the sharpest, then next") }}</dd>
      <dt><kbd>A</kbd></dt><dd>{{ _("keep every shot") }}</dd>
      <dt><kbd>X</kbd></dt><dd>{{ _("none: the whole series aside, then next") }}</dd>
    </dl>
    <details id="moreKeys">
    <summary>{{ _("More keys") }}</summary>
    <dl>
      <dt><kbd>1</kbd>…<kbd>9</kbd></dt><dd>{{ _("set a shot aside, or take it back") }}</dd>
      <dt><kbd>←</kbd></dt><dd>{{ _("previous series (no choice: as shown)") }}</dd>
      <dt><kbd>N</kbd></dt><dd>{{ _("next series still to see") }}</dd>
      <dt><kbd>V</kbd></dt><dd>{{ _("validate every obvious series at once") }}</dd>
      <dt><kbd>Z</kbd></dt><dd>{{ _("undo the last choice") }}</dd>
      <dt><kbd>C</kbd></dt><dd>{{ _("compare the shots at 100 %%") }}</dd>
      <dt><kbd>P</kbd></dt><dd>{{ _("board ⇄ one series") }}</dd>
      <dt class="board-only"><kbd>␣</kbd></dt><dd class="board-only">{{ _("board: pin the large preview of the shot under the mouse") }}</dd>
    </dl>
    </details>
  </section>
</aside>
<main>
  <div id="board">
    <div class="boardBar"><span class="boardInfo"></span><button type="button" class="boardNext">{{ _("Next page →") }}</button></div>
    <div id="boardRows"></div>
    <div class="boardBar"><span class="boardInfo"></span><button type="button" class="boardNext">{{ _("Next page →") }}</button></div>
  </div>
  <p id="welcome" role="status" hidden></p>
  <div id="single">
  <p id="series" class="muted"></p>
  <p id="pending" role="status" hidden></p>
  <p id="whole" role="status" hidden></p>
  <div id="shots" class="shots"></div>
  <details id="disk" open>
    <summary id="diskTitle"></summary>
    <div id="diskBody"></div>
    <details id="raw"><summary id="rawTitle"></summary><pre id="rawJson"></pre></details>
  </details>
  </div>
</main>
</div>
<div id="zoom" hidden></div>
<div id="compare" role="dialog" aria-label="{{ _('Compare at 100 %%') }}" hidden></div>
<footer>
  {{ _("Every choice is saved at once in %(place)s. Done? Ctrl+C in the terminal stops the review; then run the same 'clean' command with %(option)s: the shots set aside go to the quarantine, and 'undo' brings them back.", place=place, option=clean_option) }}
</footer>
<script>
(() => {
  const T = {{ texts | tojson }};
  const statePath = {{ state_path | tojson }};
  const decidePath = {{ decide_path | tojson }};
  const filePath = {{ file_path | tojson }};
  const byId = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
  const plural = new Intl.PluralRules(document.documentElement.lang);
  // A counted fragment: its singular and plural forms, the one the language uses for n.
  const counted = (forms, n, values) => fill(forms[plural.select(n) === "one" ? 0 : 1], Object.assign({ n: n }, values));
  let series = [];
  let current = 0;
  const disk = new Map();  // series rank -> its entry, as read back from the disk
  const clock = (iso) => new Date(iso).toLocaleTimeString(document.documentElement.lang);

  const setStatus = (text, kind) => {
    byId("status").textContent = text;
    byId("status").className = kind || "";
  };

  const showTotals = () => {
    const decided = series.filter((item) => item.discarded.length > 0);
    const shots = decided.reduce((count, item) => count + item.discarded.length, 0);
    const seen = series.filter((item) => item.reviewed).length;
    byId("totals").textContent = fill(T.totals, { seen: seen, series: decided.length, shots: shots });
    byId("eta").textContent = remaining(series.length - seen);
  };

  const line = (tag, text, css) => {
    const element = document.createElement(tag);
    element.textContent = text;
    if (css) element.className = css;
    return element;
  };

  // The sharpest shot first, then the others less and less sharp: the blurred ones last,
  // where they are set aside. Ranks stay those of the series.
  const shown = (item) => {
    const order = (rank) => [!item.shots[rank].best, -item.shots[rank].share];
    const before = (a, b) => (a[0] - b[0]) || (a[1] - b[1]);
    return item.shots.map((shot, rank) => rank).sort((a, b) => before(order(a), order(b)));
  };

  // What moving on would save for a series not seen yet: the shots proposed aside.
  const proposal = (item) => item.shots.map((shot, rank) => rank).filter((rank) => item.shots[rank].proposed);

{% include "review_pace.js.j2" %}

{% include "review_order.js.j2" %}

{% include "review_tree.js.j2" %}

{% include "review_disk.js.j2" %}

{% include "review_choices.js.j2" %}

{% include "review_obvious.js.j2" %}

{% include "review_compare.js.j2" %}

{% include "review_board.js.j2" %}

  const sharpestOf = (shot) => (shot.faces ? T.sharpestFaces : T.sharpest);

  const shotState = (item, shot, rank) => {
    if (shot.protected) return { css: "protected", text: T.protected };
    if (item.discarded.includes(rank)) return { css: "aside", text: T.aside };
    if (item.reviewed) return { css: "kept", text: T.kept };
    // No choice yet: the sharpest is only a suggestion, far less sharp shots a proposal.
    if (shot.proposed) return { css: "proposed", text: proposedText(item, shot) };
    return shot.best ? { css: "suggested", text: sharpestOf(shot) + " · " + T.suggested } : { css: "undecided", text: T.undecided };
  };

  const originalLink = (shot) => {
    const link = line("a", T.original, "original");
    link.href = shot.original;
    link.target = "_blank";
    link.rel = "noopener";
    link.title = T.originalTitle;
    link.addEventListener("click", (event) => event.stopPropagation());
    return link;
  };

  const card = (item, rank, position) => {
    const shot = item.shots[rank];
    const state = shotState(item, shot, rank);
    const figure = document.createElement("figure");
    figure.className = "shot " + state.css;
    const image = document.createElement("img");
    image.src = shot.preview;
    image.alt = shot.name;
    const text = shot.best && state.css !== "suggested" ? state.text + " · " + sharpestOf(shot) : state.text;
    const name = line("strong", shot.name);
    const caption = document.createElement("figcaption");
    caption.append(
      line("div", text, "state"),
      line("div", ""),
      line("div", shot.folder, "muted"),
      line("div", shot.details, "muted"),
    );
    caption.children[1].append(name, originalLink(shot));
    figure.append(line("span", position < 9 ? String(position + 1) : "·", "key"), image, caption);
    figure.addEventListener("click", () => toggle(position));
    return figure;
  };

  const prefetch = () => {
    for (const index of [current + 1, current + 2, current + 3]) {
      if (index < series.length) for (const shot of series[index].shots) new Image().src = shot.preview;
    }
  };

  const render = () => {
    showTotals();
    showObvious();
    markCurrent();
    showCompare();
    if (board) {
      byId("position").textContent = fill(T.position, { number: positions.get(current) + 1, total: series.length });
      renderBoard();
      return;
    }
    const item = series[current];
    byId("position").textContent = fill(T.position, { number: current + 1, total: series.length });
    byId("series").textContent = [item.camera, fill(T.shots, { count: item.shots.length })].filter(Boolean).join(" · ");
    byId("whole").hidden = item.discarded.length !== item.shots.length;
    byId("whole").textContent = T.whole;
    byId("pending").hidden = item.reviewed;
    byId("pending").textContent = proposal(item).length > 0 ? T.pendingProposed : T.pending;
    byId("shots").replaceChildren(...shown(item).map((rank, position) => card(item, rank, position)));
    showDisk();
    prefetch();
  };

  document.addEventListener("keydown", (event) => {
    if (event.ctrlKey || event.metaKey || event.altKey || series.length === 0) return;
    if (event.target instanceof HTMLSelectElement) return;  // the order list takes its keys
    // Digits by physical key: on an AZERTY keyboard the top row gives "&", "é"... without Shift.
    const digit = /^(?:Digit|Numpad)([1-9])$/.exec(event.code);
    const key = event.key.toLowerCase();
    if (digit) toggle(Number(digit[1]) - 1);
    else if (event.key === " " && board) pinZoom();
    else if (event.key === "ArrowRight" || event.key === " ") go(1);
    else if (event.key === "ArrowLeft") go(-1);
    else if (key === "s") keepSharpest();
    else if (key === "a") decide(current, []);
    else if (key === "x") setWholeAside();
    else if (key === "n") nextToSee();
    else if (key === "v") validateObvious();
    else if (key === "z" || event.key === "Backspace") undo();
    else if (key === "c") toggleCompare(!comparing);
    else if (key === "p") {
      setBoard(!board);
      render();
    }
    else if (event.key === "Escape" && comparing) toggleCompare(false);
    else return;
    event.preventDefault();
  });

  Promise.all([fetch(statePath).then((r) => r.json()), fetch(filePath).then((r) => r.json())])
    .then(([state, file]) => {
      series = state.series;
      if (file.error) setStatus(file.error, "error");
      else {
        for (const entry of file.entries) disk.set(entry.series, entry);
        setStatus(fill(T.loaded, { time: clock(file.modified) }), "saved");
      }
      byId("tocTitle").textContent = T.tocTitle;
      byId("diskTitle").textContent = T.diskTitle;
      byId("rawTitle").textContent = T.raw;
      byId("onlyTodo").addEventListener("change", (event) => byId("tree").classList.toggle("only-todo", event.target.checked));
      byId("onlyLook").addEventListener("change", (event) => byId("tree").classList.toggle("only-look", event.target.checked));
      byId("obvious").addEventListener("click", validateObvious);
      welcome();
      arrange(savedOrder());
      setBoard(savedBoard());
      buildTree();
      current = startAt();
      render();
    })
    .catch(() => setStatus(T.offline, "error"));
})();
</script>
{% include "home_link.html.j2" %}
</body>
</html>

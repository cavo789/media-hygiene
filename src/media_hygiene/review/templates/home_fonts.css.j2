{# The three families of the avonture.be design system, inside the image (`/assets/fonts/`, OFL licences next to them): the page never asks Google. #}
@font-face {
  font-family: "Bricolage Grotesque";
  font-style: normal;
  font-display: swap;
  font-weight: 200 800;
  src: url("{{ paths.assets }}fonts/bricolage-grotesque-latin-opsz-normal.woff2") format("woff2-variations");
}
@font-face {
  font-family: "Source Sans 3";
  font-style: normal;
  font-display: swap;
  font-weight: 200 900;
  src: url("{{ paths.assets }}fonts/source-sans-3-latin-wght-normal.woff2") format("woff2-variations");
}
@font-face {
  font-family: "Source Sans 3";
  font-style: italic;
  font-display: swap;
  font-weight: 200 900;
  src: url("{{ paths.assets }}fonts/source-sans-3-latin-wght-italic.woff2") format("woff2-variations");
}
@font-face {
  font-family: "JetBrains Mono";
  font-style: normal;
  font-display: swap;
  font-weight: 100 800;
  src: url("{{ paths.assets }}fonts/jetbrains-mono-latin-wght-normal.woff2") format("woff2-variations");
}

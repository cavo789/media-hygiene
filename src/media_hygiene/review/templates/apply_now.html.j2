{# *Apply now* (0243, 0288), included where the button goes by `browse` and the reviews, from
   any package; rendered only when `mh` opened the page from the home page (`apply_offered`).
   The page's own script calls `window.mhApplyNow(pending)` after each saved choice: the button
   shows while something is set aside. Its `POST /api/apply` ends the server with the code of
   the home step that applies the decisions; mh runs it in the terminal (its usual question),
   then opens the home page again on the same port: the page goes there once the server was
   seen gone, then answering again, on the section the home page was left from (0280, kept
   for this tab in sessionStorage by home_run.js.j2). Served by the home server that mh keeps
   up (0363), the answer is `kept`: the step runs in the window of mh, this page stays open,
   follows it on `follow` (`GET /api/step`), then loads again with its end said. The search's
   fixed bar (0463) sets `apply_short` (✅ Apply) and `apply_more` (the 🔒 line, in the tooltip). #}
{% if apply_offered %}
<span id="applyBar">
  <button id="applyNow" type="button" hidden title="{{ _('mh moves the files set aside to the quarantine in its window (it asks first).') }}{% if apply_more is defined %} {{ apply_more }}{% endif %}">{% if apply_short | default(false) %}✅ {{ _("Apply") }}{% else %}{{ _("Apply now") }}{% endif %}</button>
  <span id="applySaid" role="status"></span>
</span>
<script>
(() => {
  const APPLY_PATH = {{ apply_path | tojson }};
  // The next server may answer 0.5 s after this one ended (0354): asked often, and known by
  // its run id (`RUN_HEADER` of review/respond.py), not only by being seen gone.
  const APPLY_POLL_MS = 250;
  const ANSWER_MS = 2000; // a poll nobody answers (a connection held in the gap): asked again
  const RUN_HEADER = "X-Media-Hygiene-Run";
  const TEXTS = {{ {
    "applying": _("Running in the window where mh runs: {command}. The home page comes back here when it ends."),
    "failed": _("The page failed (error {status})."),
    "kept": _("Running in the window where mh runs: {command}. This page stays open."),
    "done": _("Done: {command}."),
    "stopped": _("Stopped (code {code}): {command}."),
  } | tojson }};
  const button = document.getElementById("applyNow");
  const said = document.getElementById("applySaid");
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));

  window.mhApplyNow = (pending) => { if (!button.disabled) button.hidden = !pending; };
  const ENDED_KEY = "mh-apply-ended";
  try {
    const ended = window.sessionStorage.getItem(ENDED_KEY);
    if (ended) { said.textContent = ended; window.sessionStorage.removeItem(ENDED_KEY); }
  } catch { /* private mode: nothing said */ }

  // The step's files, as mh writes them: its end said, then the page read again (the files
  // set aside are gone from the decisions). The server gone meanwhile: wait for the next one.
  const followStep = (state) => {
    const poll = () => fetch(state.follow, { cache: "no-store" })
      .then((response) => response.json())
      .then((step) => {
        if (step.state !== "done" || step.id !== state.id) { window.setTimeout(poll, APPLY_POLL_MS); return; }
        const text = fill(step.code === 0 ? TEXTS.done : TEXTS.stopped, { command: state.command, code: step.code });
        try { window.sessionStorage.setItem(ENDED_KEY, text); } catch { /* private mode */ }
        said.textContent = text;
        window.location.reload();
      })
      .catch(() => waitForHome(null));
    window.setTimeout(poll, APPLY_POLL_MS);
  };

  const waitForHome = (run) => {
    let seenGone = false;
    const poll = () => fetch("/", { cache: "no-store", signal: AbortSignal.timeout(ANSWER_MS) })
      .then((response) => {
        const now = response.headers.get(RUN_HEADER);
        const another = seenGone || Boolean(run && now && now !== run);
        if (!response.ok || !another) { window.setTimeout(poll, APPLY_POLL_MS); return; }
        let section = "";
        try { section = window.sessionStorage.getItem("mh-home-section") || ""; } catch { /* private mode */ }
        window.location.replace("/" + section);
      })
      .catch((error) => {
        if (error.name !== "TimeoutError") seenGone = true; // refused: the server is gone
        window.setTimeout(poll, APPLY_POLL_MS);
      });
    window.setTimeout(poll, APPLY_POLL_MS);
  };

  button.addEventListener("click", async () => {
    button.disabled = true;
    const answer = await fetch(APPLY_PATH, { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" })
      .catch(() => null);
    const state = answer ? await answer.json().catch(() => ({})) : {};
    if (!answer || !answer.ok) {
      button.disabled = false;
      said.className = "error";
      said.textContent = state.error || fill(TEXTS.failed, { status: answer ? answer.status : 0 });
      return;
    }
    said.className = "";
    button.hidden = true;
    if (state.kept) {
      said.textContent = fill(TEXTS.kept, { command: state.command });
      followStep(state);
      return;
    }
    said.textContent = fill(TEXTS.applying, { command: state.command });
    waitForHome(answer.headers.get(RUN_HEADER));
  });
})();
</script>
{% endif %}

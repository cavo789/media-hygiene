{% extends "page_frame.html.j2" %}
{# Disk space (0539): the previews and the quarantine, each limit next to its effect, saved
   into config.toml and read back from the disk before being shown. Nothing of the photos is
   touched here; *Purge* of a run opens its photos first (`/quarantine/?run=…&purge=1`, 0591, 0616),
   whose page asks, then comes back here (`?purged=`) to say what the disk says. Each run says
   how many of its files exist nowhere else (0775), counted from the index. #}
{% set page_name = _("Disk space") %}
{% set keys_safe = _("Your photos are not touched here. Previews are made again when shown.") %}
{% block style %}
  main section { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 14px; margin-bottom: 14px; }
  main label { display: block; margin: 8px 0; }
  main input { width: 7em; }
  main table { border-collapse: collapse; width: 100%; }
  main th, main td { padding: 4px 8px; border-bottom: 1px solid var(--line); text-align: left; }
  main .table-wrap { overflow-x: auto; }
{% endblock %}
{% block bar %}
  <strong>{{ page_name }}</strong>
  <span id="said" role="status"></span>
{% endblock %}
{% block content %}
<main>
  <section aria-labelledby="previewsTitle">
    <h2 id="previewsTitle">{{ _("Previews") }}: <span id="previewsSize"></span></h2>
    <label>{{ _("Keep at most (GB)") }} <input id="maxGb" type="number" min="0.1" step="0.1"></label>
    <button id="saveGb" type="button">{{ _("Save") }}</button>
    <button id="empty" class="plain" type="button"></button>
  </section>
  <section aria-labelledby="quarantineTitle">
    <h2 id="quarantineTitle">{{ _("Quarantine") }}: <span id="quarantineSize"></span></h2>
    <p id="quarantineOnly" hidden></p>
    <label>{{ _("Suggest purging after (days)") }} <input id="days" type="number" min="1" step="1"></label>
    <button id="saveDays" type="button">{{ _("Save") }}</button>
    <div class="table-wrap"><table>
      <thead><tr><th>{{ _("Run") }}</th><th>{{ _("Files") }}</th><th title="{{ _("Near duplicates, burst shots, junk or unreadable: not exact copies, whose kept twin stays in your photos.") }}">{{ _("Nowhere else") }}</th><th>{{ _("Size") }}</th><th>{{ _("Since") }}</th><th></th><th></th><th></th></tr></thead>
      <tbody id="runs"></tbody>
    </table></div>
    <p><a href="/quarantine/">{{ _("See every photo of the quarantine, put some back") }}</a> · <a href="/#history">{{ _("History and undo") }}</a></p>
  </section>
</main>
{% endblock %}
{% block after %}
<script nonce="{{ page_nonce }}">
(() => {
  "use strict";
  const TEXTS = {{ {
    "empty": _("Empty the previews ({size})"),
    "nothing": _("No preview kept"),
    "saved": _("Read back from config.toml: {gb} GB, {days} days."),
    "emptied": _("Previews now: {size}."),
    "old": _("Worth purging"),
    "see": _("See the photos"),
    "purge": _("Purge"),
    "purgedYes": _("Read back from the disk: run {run} is gone, {freed} freed ({stated} stated)."),
    "purgedNo": _("Read back from the disk: run {run} is still in the quarantine. The window of mh says why."),
    "failed": _("The page failed (error {status})."),
    "only": _("{count} of these files exist nowhere else: near duplicates, burst shots, junk or unreadable, not exact copies. The backup does not hold them: look at them before a purge."),
  } | tojson }};
  const byId = (id) => document.getElementById(id);
  const fill = (text, values) => text.replace(/\{(\w+)\}/g, (all, name) => (name in values ? String(values[name]) : all));
  const draw = (state) => {
    byId("previewsSize").textContent = state.previews_size;
    byId("quarantineSize").textContent = state.quarantine_size;
    const only = byId("quarantineOnly");
    only.hidden = !state.quarantine_only || state.quarantine_only === "0";
    only.textContent = fill(TEXTS.only, { count: state.quarantine_only });
    byId("maxGb").value = state.limits.previews_max_gb;
    byId("days").value = state.limits.purge_hint_days;
    byId("empty").textContent = state.previews_empty ? TEXTS.nothing : fill(TEXTS.empty, { size: state.previews_size });
    byId("empty").disabled = state.previews_empty;
    byId("runs").replaceChildren(...state.runs.map((run) => {
      const row = document.createElement("tr");
      for (const value of [run.run_id, run.files, run.only || "?", run.size, run.since, run.old ? TEXTS.old : ""]) {
        const cell = document.createElement("td");
        cell.textContent = value;
        row.append(cell);
      }
      const see = document.createElement("td");
      const link = document.createElement("a");
      link.href = `/quarantine/?run=${encodeURIComponent(run.run_id)}`;
      link.textContent = TEXTS.see;
      see.append(link);
      row.append(see);
      const purge = document.createElement("td");
      const purgeLink = document.createElement("a");
      purgeLink.href = `/quarantine/?run=${encodeURIComponent(run.run_id)}&purge=1`;
      purgeLink.textContent = TEXTS.purge;
      purge.append(purgeLink);
      row.append(purge);
      return row;
    }));
    const asked = window.mhView.get({ purged: "text" }).purged;
    if (asked && state.purged && state.purged.run_id === asked) {
      const { gone, freed, stated } = state.purged;
      byId("said").textContent = fill(gone ? TEXTS.purgedYes : TEXTS.purgedNo, { run: asked, freed, stated });
    }
  };
  const post = async (path, body, done) => {
    const answer = await fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
    const value = await answer.json().catch(() => ({}));
    if (!answer.ok) { byId("said").textContent = value.error || fill(TEXTS.failed, { status: answer.status }); return; }
    draw(value);
    byId("said").textContent = done(value);
  };
  const saveLimits = () => post("api/limits", { previews_max_gb: Number(byId("maxGb").value), purge_hint_days: Number(byId("days").value) },
    (state) => fill(TEXTS.saved, { gb: state.limits.previews_max_gb, days: state.limits.purge_hint_days }));
  byId("saveGb").addEventListener("click", saveLimits);
  byId("saveDays").addEventListener("click", saveLimits);
  byId("empty").addEventListener("click", () => post("api/empty", {}, (state) => fill(TEXTS.emptied, { size: state.previews_size })));
  fetch("api/state", { cache: "no-store" }).then((answer) => answer.json()).then(draw);
})();
</script>
{% endblock %}

{# Who is on the photo opened large (0714), and naming them right there, in every large view
   (2026-11-12: the people page's view named the face shown, the others sent to /person): "👤
   ✓ Chloé · ≈ Paul · ? not named", each face with its picture, asked of `/person/api/photo`
   (the index) only when a photo is opened, one small request each, never shipped with the
   tiles. A click on a face opens under the line "This face is… [name] [Name]" ("Not Paul, this
   face is…"), saved by `/person/api/names` as /person and the people page save it (`move`):
   the line the server read back from config.toml is said, then the faces are asked again.
   "👤 Its other photos" opens /person on that face. Read-only (a phone, no config.toml): the
   names only. Included by `pick_viewer.js.j2` and `people_viewer.js.j2` (needs `$`, `element`,
   `fill`); `#viewerWho` (`pick_viewer.html.j2`) holds the words; a page that shows names
   listens to the `mh-named` event of `document`. Each face is outlined on the photo, its name
   under it (`pick_who_boxes.js.j2`, 0838). Back on the tab, the faces are asked again. #}
{% include "combo_list.js.j2" %}
{% include "pick_who_boxes.js.j2" %}
let whoAsked = 0;   // the latest photo asked: an answer for an earlier one is dropped
let whoFile = null; // the file whose faces are shown

// Back on this tab (a face named in the /person tab "Identify someone" opened): the names as
// they are now, asked again for the photo still open.
document.addEventListener("visibilitychange", () => {
  if (!document.hidden && whoFile && $("viewer").classList.contains("open")) showWho(whoFile);
});

async function whoAsk(url, body) {
  const options = { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) };
  const answer = await fetch(url, options).catch(() => null);
  if (!answer || !answer.ok) return null;
  return answer.json().catch(() => null);
}

async function showWho(file) {
  const who = $("viewerWho");
  const asked = ++whoAsked;
  whoFile = file;
  who.hidden = true;
  who.replaceChildren();
  $("viewerWhoName").replaceChildren();
  whoClear();
  if (!file.path || file.video) return;
  const result = await whoAsk("/person/api/photo", { path: file.path });
  const faces = result && asked === whoAsked ? result.faces || [] : [];
  if (!faces.length) return;
  const writable = Boolean(result.writable) && !document.documentElement.hasAttribute("data-phone");
  const name = writable ? (face, at) => whoNamer(face, at, result.people || []) : null;
  who.append("👤 ");
  faces.forEach((face, at) => {
    if (at) who.append(" · ");
    const chip = who.appendChild(whoFace(face, name ? () => name(face, at) : null));
    chip.addEventListener("mouseenter", () => whoLight(at, true));
    chip.addEventListener("mouseleave", () => whoLight(at, false));
  });
  const guessed = name ? faces.filter((face) => face.named && face.named.name && face.named.how !== "confirmed") : [];
  if (guessed.length) who.append(" ", whoConfirm(guessed));
  if (faces.some((face) => face.box)) who.append(" ", whoSwitch());
  whoDraw(faces, name);
  who.hidden = false;
}

// One face: its picture and its name (✓ confirmed, ≈ guessed, ? nobody); a button to name it.
function whoFace(face, name) {
  const who = $("viewerWho");
  const named = face.named && face.named.name ? face.named : null;
  const sure = Boolean(named) && named.how === "confirmed";
  const tag = element(name ? "button" : "span", "whoFace" + (named && !sure ? " guessed" : ""));
  if (face.face) {
    const crop = element("img");
    crop.src = face.face;
    crop.alt = "";
    tag.append(crop);
  }
  tag.append(named ? (sure ? "✓ " : "≈ ") + named.name : who.dataset.nobody);
  tag.title = named ? (sure ? who.dataset.confirmed : who.dataset.guessed) : who.dataset.hint;
  if (name) {
    tag.type = "button";
    tag.title += " " + who.dataset.click;
    tag.addEventListener("click", name);
  }
  return tag;
}

// "This face is… [name] [Name]" under the line; Enter or a name picked saves it.
function whoNamer(face, at, people) {
  const who = $("viewerWho");
  const file = whoFile;
  const source = face.named && face.named.name ? face.named.name : "";
  const said = source ? fill(who.dataset.not, { name: source }) : who.dataset.is;
  const input = element("input");
  input.placeholder = who.dataset.placeholder;
  input.setAttribute("aria-label", said);
  let busy = false; // Enter on a name offered: the list and the key both ask, once saved
  const go = (name) => {
    if (!name || busy) return null;
    busy = true;
    return whoSave(file, [{ name: name, keys: [Number(face.key)], source: source }]).finally(() => {
      busy = false;
    });
  };
  const box = comboAttach(input, () => people, (row) => go(row.value));
  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter") go(input.value.trim());
    if (event.key === "Escape") input.blur();
    event.stopPropagation(); // typed here, never a key of the large view
  });
  const button = element("button", "", who.dataset.save);
  button.type = "button";
  button.addEventListener("click", () => go(input.value.trim()));
  const others = element("a", "", who.dataset.others);
  others.href = "/person?path=" + encodeURIComponent(file.path) + "&face=" + at;
  others.target = "_blank";
  others.rel = "noopener";
  const parts = [element("span", "", said), box, button, others];
  if (source) { // "✗ It is not Chloé": the face left with no name, nothing typed
    const notThem = element("button", "", fill(who.dataset.unsure, { name: source }));
    notThem.type = "button";
    notThem.addEventListener("click", () => whoPost(file, { action: "unname", name: source, faces: [Number(face.key)], source: "" }));
    parts.unshift(notThem);
  }
  if (source && face.named.how !== "confirmed") { // ≈ guessed: "✓ It is Chloé", one click
    const sure = element("button", "", fill(who.dataset.sure, { name: source }));
    sure.type = "button";
    sure.addEventListener("click", () => whoSave(file, [{ name: source, keys: [Number(face.key)], source: "" }]));
    parts.unshift(sure);
  }
  $("viewerWhoName").replaceChildren(...parts);
  whoLit = at; // outlined on the photo while it is named
  whoLight(at, false);
  input.focus();
}

// Saves names ({name, keys, source} each, as /person does: `move`), says the line read back
// from config.toml, then the faces as the file says now.
function whoSave(file, changes) {
  // One request, one write, whatever the number of names (`also`: 4 s each before).
  const [first, ...more] = changes;
  const also = more.map((change) => ({ name: change.name, faces: change.keys }));
  return whoPost(file, { action: "move", name: first.name, faces: first.keys, source: first.source, also: also });
}

// Sends a naming (`move`) or *✗ It is not …* (`unname`: no name left guessed, as the cross
// of /person), says the line read back, then the faces as the file says now.
async function whoPost(file, body) {
  const who = $("viewerWho");
  const line = $("viewerSaid");
  line.className = "";
  line.textContent = who.dataset.saving;
  const saved = await whoAsk("/person/api/names", body);
  line.className = saved && !saved.error ? "" : "error";
  line.textContent = saved ? saved.error || saved.saved : who.dataset.offline; // read back
  if (!saved || saved.error) return;
  document.dispatchEvent(new CustomEvent("mh-named", { detail: { key: file.key } }));
  if (whoFile === file) showWho(file);
}

// "✓ Confirm the names guessed: N": every ≈ face of the photo, as the tool named it.
function whoConfirm(guessed) {
  const who = $("viewerWho");
  const file = whoFile;
  const words = guessed.length === 1 ? who.dataset.sureOne : who.dataset.sureMany;
  const button = element("button", "whoConfirm", fill(words, { n: guessed.length }));
  button.type = "button";
  button.addEventListener("click", () => {
    const byName = new Map();
    for (const face of guessed) byName.set(face.named.name, [...(byName.get(face.named.name) || []), Number(face.key)]);
    button.disabled = true; // one click: the names are saved in one write
    whoSave(file, [...byName].map(([name, keys]) => ({ name: name, keys: keys, source: "" }))).finally(() => {
      button.disabled = false;
    });
  });
  return button;
}

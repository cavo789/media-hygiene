  #strict { margin-top: 12px; font-size: .85rem; }
  #strict summary { cursor: pointer; font-weight: 600; }
  .strictRow { display: block; margin: 6px 0; }
  .strictRow input[type="range"] { width: 100%; }
  #strictSaid { overflow-wrap: anywhere; }
  #strictSaid.error { color: var(--bad); font-weight: 600; } #strictSaid.saved { color: var(--ok); }
  #strictActs { display: flex; flex-wrap: wrap; gap: 6px; }

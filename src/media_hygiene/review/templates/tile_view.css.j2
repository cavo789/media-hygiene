  /* The view of a page of tiles (`tile_view.html.j2`), part of the frame's look: its buttons,
     the left panel hidden, and the size every grid of tiles takes from `--tile-scale`
     (`minmax(min(100%, calc(<its width> * var(--tile-scale))), 1fr)`: never wider than a
     phone). S shows the photos only (a person's name line stays). */
  body { --tile-scale: 1; }
  body[data-tile-size="s"] { --tile-scale: .72; }
  body[data-tile-size="l"] { --tile-scale: 1.6; }
  body[data-tile-size="xl"] { --tile-scale: 2.6; }
  body[data-tile-size="s"] .file .meta > :not(.named), body[data-tile-size="s"] .file .meta:not(:has(.named)) { display: none; }
  #view { display: inline-flex; gap: 6px; align-items: center; margin-left: auto; }
  #sizes button { min-width: 2.2em; padding: 2px 6px; }
  #sizes button[aria-pressed="true"] { background: var(--accent); color: var(--bg); }
  .layout.sideHidden { grid-template-columns: 1fr; } .layout.sideHidden #side { display: none; }

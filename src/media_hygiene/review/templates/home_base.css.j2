{# The home page, its tokens and shell: the avonture.be design system (--mk-*), the meerkat (--mh-*). Included by home.html.j2. #}
/* Layout: an app shell. The meerkat's indigo outline frames avonture.be's warm paper workspace;
   apricot marks "you are here". The --mk-* tokens are the blog's own, the --mh-* ones the avatar's. */
:root {
  --mk-font-display: "Bricolage Grotesque", "Segoe UI Variable Display", "Segoe UI", system-ui, -apple-system, sans-serif;
  --mk-font-text: "Source Sans 3", "Segoe UI Variable Text", "Segoe UI", system-ui, -apple-system, sans-serif;
  --mk-font-mono: "JetBrains Mono", "Cascadia Mono", Consolas, ui-monospace, monospace;
  --mk-radius-sm: 6px;
  --mk-radius-md: 10px;
  --mk-radius-lg: 16px;
  --mk-n-0: #f7f0e2;
  --mk-n-50: #f0e8d8;
  --mk-n-100: #e8dec9;
  --mk-n-200: #d5c7a9;
  --mk-n-300: #c2b192;
  --mk-n-500: #9a8870;
  --mk-n-700: #55483a;
  --mk-n-900: #2b2118;
  --mk-bg: var(--mk-n-0);
  --mk-surface: #ffffff;
  --mk-sunken: var(--mk-n-50);
  --mk-ink: var(--mk-n-900);
  --mk-ink-soft: var(--mk-n-700);
  --mk-border: var(--mk-n-200);
  --mk-border-strong: var(--mk-n-300);
  --mk-primary: #9b5a31;
  --mk-primary-strong: #864e2a;
  --mk-on-primary: #fffdf7;
  --mk-info-bg: #e6f4f7;
  --mk-info-line: #27798a;
  --mk-info-fg: #123f49;
  --mk-tip-bg: #eef4e3;
  --mk-tip-line: #5b7b36;
  --mk-tip-fg: #2b3c18;
  --mk-note-bg: #f5efe4;
  --mk-note-line: #7d5f41;
  --mk-note-fg: #3d3124;
  --mk-warn-bg: #fbf0da;
  --mk-warn-line: #94640f;
  --mk-warn-fg: #4c3307;
  --mk-danger-bg: #fae9e2;
  --mk-danger-line: #af3a1d;
  --mk-danger-fg: #54180b;
  --mk-on-danger: #fffdf7;
  --mk-key-bg: #f8ecd5;
  --mk-key-edge: #dbad74;
  --mk-key-fg: #4a2e18;
  --mk-code-bg: #2b2118;
  --mk-code-fg: #e7ddcb;
  --mk-code-line: #ffffff26;
  --mk-term-bg: #241d16;
  --mk-term-head: #322a20;
  --mk-term-border: #3f352a;
  --mk-term-title: #cbbfa9;
  --mk-term-prompt: #93b764;
  --mk-term-comment: #8a9e6b;
  --mk-dot-red: #c4614a;
  --mk-dot-amber: #d69a3c;
  --mk-dot-green: #7c9e51;
  --mk-shadow-1: 0 1px 2px #3b2c1e12;
  --mk-shadow-2: 0 6px 16px #3b2c1e1a;
  --mk-shadow-3: 0 14px 32px #3b2c1e24;
  --mh-apricot: #fdb057;
  --mh-apricot-soft: #fdebcf;
  --mh-on-apricot: #2b2118;
  --mh-brown: #a25341;
  --mh-cream: #faf0cb;
  --mh-on-cream: #2b2118;
  --mh-frame: #1a0737;
  --mh-frame-raise: #29124f;
  --mh-frame-line: #3a2366;
  --mh-frame-ink: #faf0cb;
  --mh-frame-soft: #cbbfe0;
  --mh-ai-bg: #efe9f8;
  --mh-ai-fg: #3a2366;
  --mh-focus: #1f6f80;
  --mh-art-shadow: #3b2c1e40;
  --mh-glass: #f7f0e2eb;
  --mh-photo-badge: #000000a6;
  --mh-on-photo-badge: #ffffff;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --mk-n-0: #1a1510;
    --mk-n-50: #221c15;
    --mk-n-100: #2b241b;
    --mk-n-200: #372f25;
    --mk-n-300: #4b4134;
    --mk-n-500: #7d6f5d;
    --mk-n-700: #a79987;
    --mk-n-900: #f0e7d8;
    --mk-surface: #221c15;
    --mk-sunken: #2b241b;
    --mk-primary: #dd7f3c;
    --mk-primary-strong: #e8924f;
    --mk-on-primary: #1a1510;
    --mk-info-bg: #14282d;
    --mk-info-line: #5fc3d4;
    --mk-info-fg: #cbeaf1;
    --mk-tip-bg: #1d2617;
    --mk-tip-line: #93b764;
    --mk-tip-fg: #ddebc9;
    --mk-note-bg: #262019;
    --mk-note-line: #be9a70;
    --mk-note-fg: #eadcc6;
    --mk-warn-bg: #2e2411;
    --mk-warn-line: #e0a83c;
    --mk-warn-fg: #f7e3b8;
    --mk-danger-bg: #31170f;
    --mk-danger-line: #e2724f;
    --mk-danger-fg: #fbd8cb;
    --mk-on-danger: #1a1510;
    --mk-key-bg: #2c2013;
    --mk-key-edge: #8a6134;
    --mk-key-fg: #f5e3c8;
    --mk-code-bg: #12100c;
    --mk-term-bg: #151109;
    --mk-term-head: #221c13;
    --mk-term-border: #332b20;
    --mk-shadow-1: 0 1px 2px #00000059;
    --mk-shadow-2: 0 6px 16px #00000073;
    --mk-shadow-3: 0 14px 32px #0000008c;
    --mh-apricot-soft: #3a2a14;
    --mh-on-apricot: #1a1510;
    --mh-frame: #120a22;
    --mh-frame-raise: #20123b;
    --mh-frame-line: #2c1b4c;
    --mh-frame-ink: #f3e9d2;
    --mh-frame-soft: #b9acd2;
    --mh-ai-bg: #231a36;
    --mh-ai-fg: #d8ccf3;
    --mh-focus: #5fc3d4;
    --mh-art-shadow: #00000080;
    --mh-glass: #1a1510eb;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --mk-n-0: #1a1510;
  --mk-n-50: #221c15;
  --mk-n-100: #2b241b;
  --mk-n-200: #372f25;
  --mk-n-300: #4b4134;
  --mk-n-500: #7d6f5d;
  --mk-n-700: #a79987;
  --mk-n-900: #f0e7d8;
  --mk-surface: #221c15;
  --mk-sunken: #2b241b;
  --mk-primary: #dd7f3c;
  --mk-primary-strong: #e8924f;
  --mk-on-primary: #1a1510;
  --mk-info-bg: #14282d;
  --mk-info-line: #5fc3d4;

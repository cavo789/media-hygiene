  --mk-warn-bg: #2e2411;
  --mk-warn-line: #e0a83c;
  --mk-warn-fg: #f7e3b8;
  --mk-danger-bg: #31170f;
  --mk-danger-line: #e2724f;
  --mk-danger-fg: #fbd8cb;
  --mk-on-danger: #1a1510;
  --mk-key-bg: #2c2013;
  --mk-key-edge: #8a6134;
  --mk-key-fg: #f5e3c8;
  --mk-code-bg: #12100c;
  --mk-term-bg: #151109;
  --mk-term-head: #221c13;
  --mk-term-border: #332b20;
  --mk-shadow-1: 0 1px 2px #00000059;
  --mk-shadow-2: 0 6px 16px #00000073;
  --mk-shadow-3: 0 14px 32px #0000008c;
  --mh-apricot-soft: #3a2a14;
  --mh-on-apricot: #1a1510;

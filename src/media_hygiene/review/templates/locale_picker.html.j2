{# The language picker of the frame (0609): `[general] locale` on the disk, shown as read back.
   PC only (the phone is read-only: hidden off the loopback). Self-contained: a select, one line
   that says what the file holds and when it applies, and a script. Included by the top bars and
   the home page. The language names are written in their own language: never translated. #}
<span class="mh-locale" id="mhLocale" hidden>
  <label>{{ _("Language") }}
    <select id="mhLocaleSelect">
      <option value="en">English</option>
      <option value="fr">Français</option>
    </select></label>
  <span id="mhLocaleSaid" role="status" aria-live="polite"></span>
</span>
<script>
(() => {
  const box = document.getElementById("mhLocale");
  if (!["127.0.0.1", "localhost", "[::1]"].includes(location.hostname)) return;
  const select = document.getElementById("mhLocaleSelect");
  const said = document.getElementById("mhLocaleSaid");
  const PATH = "/api/setting-locale";
  const draw = (values) => { select.value = values.locale; box.hidden = false; };
  fetch(PATH, { cache: "no-store" })
    .then((response) => (response.ok ? response.json() : null))
    .then((answer) => { if (answer) draw(answer.values); })
    .catch(() => {});
  select.addEventListener("change", () => {
    select.disabled = true;
    fetch(PATH, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ locale: select.value }) })
      .then((response) => response.json().then((body) => ({ ok: response.ok, body })))
      .then((reply) => {
        if (!reply.ok) { said.textContent = reply.body.error || {{ _("The settings could not be saved in config.toml.") | tojson }}; return; }
        draw(reply.body.values);  // what config.toml holds now, read back
        said.textContent = {{ _("Saved in config.toml, read back from the disk.") | tojson }} + " " + reply.body.later;
      })
      .catch(() => { said.textContent = {{ _("The settings could not be saved in config.toml.") | tojson }}; })
      .finally(() => { select.disabled = false; });
  });
})();
</script>

{# The one bar of every page of tiles, in two lines that keep their height whatever is picked,
   so the grid never moves and a button never changes place from a page to another.
   Line 1, what you look at: where you are, the set aside, 📺, then the page's view controls.
   Line 2, what you do with the picking, greyed while nothing is picked: ✕, the count, the page's
   actions, its panels (`.barPanel`), then at the right end, on every page, *Set aside* and
   *Apply*. `#acting` lays its buttons directly in the bar's lines (`display: contents`). #}
  #bar { row-gap: 4px; }
  #bar::before { content: ""; order: 2; flex-basis: 100%; height: 0; }
  #bar > * { order: 1; }
  #bar > #lead { flex: 1 1 0; min-width: 0; }
  #bar > #lead[hidden] { display: flex; }
  #bar > #acting, #bar > #acting[hidden] { display: contents; }
  #acting > * { order: 3; }
  #bar #takeBack[hidden], #bar #pickAll[hidden] { display: none; }
  #picked { display: inline-block; min-width: 9ch; white-space: nowrap; }
  #bar > #moveBar { order: 4; }
  #bar > #albumBar, #bar > #albumQuick { order: 5; }
  #acting > #setAside { order: 6; margin-left: auto; }
  #bar > #applyBar { order: 7; position: relative; }
  #bar #applyNow[hidden] { display: inline-block; opacity: .45; pointer-events: none; }
  #bar #applySaid { position: absolute; top: 100%; right: 0; width: max-content; max-width: 60vw;
                    padding: 2px 8px; background: var(--card); }
  #bar #applySaid:empty { display: none; }
  #bar > p { order: 8; }
  #bar button { padding: 4px 8px; white-space: nowrap; }
  #bar > #chosen { flex: 0 1 34ch; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  /* A small panel gathers what is not needed all the time; it floats: the grid stays put. */
  #bar > .barPanel { position: relative; flex-basis: auto; margin: 0; }
  .barPanel > summary { list-style: none; padding: 4px 8px; color: var(--accent); white-space: nowrap;
                        cursor: pointer; border: 1px solid var(--accent); border-radius: 6px; }
  .barPanel > summary::-webkit-details-marker { display: none; }
  .barPanel > .panelBody { position: absolute; top: calc(100% + 4px); left: 0; z-index: 6;
                           display: flex; flex-direction: column; align-items: stretch; gap: 8px;
                           width: max-content; max-width: min(34em, 90vw); padding: 12px;
                           background: var(--card); border: 1px solid var(--line); border-radius: 8px;
                           box-shadow: 0 2px 8px rgba(0, 0, 0, .25); }
  .panelBody p, .panelBody form { margin: 0; }
  .panelBody .panelRow { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .panelBody .panelHead { justify-content: space-between; }
  .panelBody input { width: 100%; box-sizing: border-box; }
  /* What a save says on the album floats under the bar. */
  #bar > #albumSaid, #bar > #albumTvLine, #bar > #albumMissing {
    position: absolute; top: 100%; left: 0; right: 0; margin: 0; padding: 2px 16px;
    background: var(--card); box-shadow: 0 2px 6px rgba(0, 0, 0, .2); }
  #bar > #albumSaid:empty { display: none; }
  #bar > #albumSaid { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

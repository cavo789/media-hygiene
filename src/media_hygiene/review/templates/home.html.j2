<!DOCTYPE html>
{# The home page, served by `media-hygiene home` (0266, from the mockup approved on 2026-10-20): an
   indigo sidebar (the five stages of the cycle, the tools, your folders, the version), the next step
   whose button has the focus (Enter runs it, as in `mh menu`), the cycle, the tiles, what the last audit
   found, one page per space, every action a click or Ctrl+K away. The page never acts: a step's button
   ends the server and `mh` runs that step in its window, when `mh` said it does (relays_steps); else
   the button copies the command. It is served at once, a waiting meerkat (#loading) in front until
   GET state_path answers: reading the tool folders can be slow through Docker Desktop (0277); the fonts and images come from /assets/: nothing from a CDN. #}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Media Hygiene — {{ texts.home }}</title>
<link rel="icon" type="image/png" href="/assets/images/favicon.png">
<script>
{% include "theme_choice.js.j2" %}
</script>
<style>
{% include "theme.css.j2" %}
{% include "home_base.css.j2" %}
{% include "home_parts.css.j2" %}
</style>
</head>
<body>
{% include "home_icons.svg.j2" %}
<div class="loading" id="loading" role="status">
  <img src="{{ paths.assets }}images/meerkat-lookout.webp" alt="" width="400" height="387">
  <p>{{ texts.loading }}</p>
  <p class="muted" id="loadingSlow" hidden>{{ texts.loadingSlow }}</p>
</div>
<a class="skip" href="#main">{{ texts.skip }}</a>
<div class="app" id="app">
  <aside class="sidebar" id="sidebar" aria-label="{{ texts.sidebar }}">
    <a class="brand" href="#home" data-go="home">
      <svg class="brand-logo" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
        <g stroke="#0B2239" stroke-linejoin="round" stroke-linecap="round">
          <rect x="84" y="20" width="152" height="150" rx="18" fill="#3D85C6" stroke-width="12"/>
          <rect x="20" y="58" width="168" height="170" rx="18" fill="#FFFFFF" stroke-width="12"/>
          <clipPath id="mhLogoPhoto"><rect x="42" y="80" width="124" height="100" rx="6"/></clipPath>
          <g clip-path="url(#mhLogoPhoto)">
            <rect x="42" y="80" width="124" height="100" fill="#FFFFFF" stroke="none"/>
            <path d="M30 186 L84 128 L120 164 L140 146 L178 186 Z" fill="#34A853" stroke-width="8"/>
            <circle cx="136" cy="110" r="14" fill="#FBC02D" stroke="none"/>
          </g>
          <rect x="42" y="80" width="124" height="100" rx="6" fill="none" stroke-width="8"/>
          <g transform="translate(194 194) rotate(32) scale(0.9)">
            <rect x="-13" y="-124" width="26" height="96" rx="13" fill="#FBC02D" stroke-width="10"/>
            <rect x="-30" y="-36" width="60" height="22" rx="6" fill="#FBC02D" stroke-width="10"/>
            <path d="M-28 -14 H28 Q40 22 34 50 Q0 64 -34 50 Q-40 22 -28 -14 Z" fill="#FBC02D" stroke-width="10"/>
            <path d="M-12 0 L-16 40 M8 0 L10 44" fill="none" stroke-width="7"/>
          </g>
        </g>
      </svg>
      <span><span class="brand-name">Media Hygiene</span><span class="brand-tag">{{ texts.tagline }}</span></span>
    </a>
    <nav class="nav" aria-label="{{ texts.spaces }}">
      <ul class="nav-list" id="navHome"></ul>
      <div>
        <p class="nav-label" id="navCycleLabel">{{ texts.cycle }}</p>
        <ul class="nav-list" id="navStages" aria-labelledby="navCycleLabel"></ul>
      </div>
      <div>
        <p class="nav-label" id="navToolsLabel">{{ texts.tools }}</p>
        <ul class="nav-list" id="navTools" aria-labelledby="navToolsLabel"></ul>
      </div>
    </nav>
    <details class="folders" id="folders">
      <summary id="foldersSummary"></summary>
      <ul class="folder-list" id="folderList"></ul>
      <button class="folder-add" type="button" data-run="folders-add"><svg class="i" aria-hidden="true"><use href="#i-folder-plus"></use></svg> {{ texts.addFolder }}</button>
    </details>
    <div class="signature">
      <img src="{{ paths.assets }}images/avatar.webp" alt="{{ texts.avatarAlt }}" width="236" height="320">
      <p class="sig-version" id="sigVersion"></p>
      <p class="sig-by">{{ texts.by }} <a href="https://www.avonture.be" target="_blank" rel="noopener">Christophe Avonture</a></p>
      <div class="theme-switch" role="group" aria-label="{{ texts.display }}">
        <button type="button" data-theme-choice="auto" aria-pressed="true"><svg class="i" aria-hidden="true"><use href="#i-auto"></use></svg>{{ texts.themeAuto }}</button>
        <button type="button" data-theme-choice="light" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-sun"></use></svg>{{ texts.themeLight }}</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false"><svg class="i" aria-hidden="true"><use href="#i-moon"></use></svg>{{ texts.themeDark }}</button>
      </div>
      <button class="quit" type="button" data-act="quit" title="{{ texts.quitTitle }}"><svg class="i" aria-hidden="true"><use href="#i-power"></use></svg> {{ texts.quit }}</button>
    </div>
  </aside>
  <div class="scrim" id="scrim" hidden></div>
  <div class="main-col">
    <header class="topbar">
      <button class="btn btn-ghost icon-btn menu-btn" id="menuBtn" type="button" aria-label="{{ texts.openMenu }}" aria-controls="sidebar" aria-expanded="false"><svg class="i" aria-hidden="true"><use href="#i-menu"></use></svg></button>
      <p class="crumb"><span class="hide-sm">Media Hygiene</span><span class="sep hide-sm" aria-hidden="true">›</span><strong id="crumbHere">{{ texts.home }}</strong></p>
      <button class="search-trigger" id="openPalette" type="button" data-act="open-palette" aria-haspopup="dialog" aria-keyshortcuts="Control+K /" aria-label="{{ texts.whatToDo }} (Ctrl+K)">
        <svg class="i" aria-hidden="true"><use href="#i-search"></use></svg>
        <span class="label">{{ texts.whatToDo }}</span>
        <span class="keys" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
      </button>
      <div class="top-links" id="topLinks"></div>
    </header>
    <main id="main" tabindex="-1"></main>
  </div>
</div>

<dialog id="paletteDlg" class="palette-dlg" aria-label="{{ texts.whatToDo }}">
  <div class="palette-box">
    <div class="palette-input">
      <svg class="i" aria-hidden="true"><use href="#i-search"></use></svg>
      <input id="paletteInput" type="text" role="combobox" aria-expanded="true" aria-controls="paletteList" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="{{ texts.palettePlaceholder }}" aria-label="{{ texts.whatToDo }}">
      <kbd>{{ texts.escKey }}</kbd>
    </div>
    <ul class="palette-list" id="paletteList" role="listbox" aria-label="{{ texts.actions }}"></ul>
    <div class="palette-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> {{ texts.choose }}</span>
      <span><kbd>{{ texts.enterKey }}</kbd> {{ texts.launch }}</span>
      <span><kbd>{{ texts.escKey }}</kbd> {{ texts.close }}</span>
    </div>
  </div>
</dialog>
<dialog id="formDlg" aria-labelledby="formTitle"></dialog>
<dialog id="confirmDlg" aria-labelledby="confirmTitle"></dialog>
<dialog id="runDlg" aria-labelledby="runTitle"></dialog>
<dialog id="keysDlg" aria-labelledby="keysTitle"></dialog>
<dialog id="stoppedDlg" class="stopped-dlg" aria-labelledby="stoppedTitle">
  <div class="dlg">
    <img src="{{ paths.assets }}images/meerkat-asleep.webp" alt="" width="400" height="387">
    <h2 id="stoppedTitle">{{ texts.stoppedTitle }}</h2>
    <p class="dlg-text">{{ texts.stoppedText }}</p>
    <div class="dlg-foot"><button class="btn btn-primary" type="button" data-close autofocus>{{ texts.close }}</button></div>
  </div>
</dialog>

<section class="copybox" id="copyBox" hidden aria-labelledby="copyTitle">
  <p class="copybox-title"><strong id="copyTitle">{{ texts.copied }}</strong></p>
  <code class="copybox-cmd" id="copyCmd"></code>
  <p class="muted">{{ texts.copyHow }}</p>
  <div class="copybox-foot"><button class="btn" type="button" id="copyClose">{{ texts.close }}</button></div>
</section>
<div class="toasts" id="toasts" aria-live="polite"></div>

<script>
(() => {
{% include "home.js.j2" %}
{% include "home_draw.js.j2" %}
{% include "home_run.js.j2" %}
  start();
})();
</script>
</body>
</html>

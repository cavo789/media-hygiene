<!DOCTYPE html>
{# The home page, served by `media-hygiene home`: where you are, the next step as a big button,
   every step of the guides as `mh menu` numbers them, the reports and a few previews. The page
   never acts: a step's button ends the server, and `mh` runs that step in the terminal. #}
{% set texts = {
  "nothingLeft": _("Nothing left to do: everything is applied."),
  "run": _("Run"),
  "runTitle": _("Ends this page: mh runs the step in the PowerShell window, then opens this page again."),
  "typeIt": _("(type it yourself)"),
  "runningCommand": _("Step chosen: {command}"),
  "failed": _("Not sent (error {status})."),
  "offline": _("The home page is not running any more: start it again (mh)."),
  "noReport": _("No report yet: the audit writes one."),
  "everyReport": _("Every report"),
  "auditOpen": _("Open the report"),
  "auditRunning": _("Auditing…"),
  "auditBusy": _("An audit already runs: wait for its end, or stop it."),
  "legend": _("{safe} your photos are not touched · {undo} can be undone · {final} for good"),
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("Home page") }} — media-hygiene</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header { position: sticky; top: 0; z-index: 1; display: flex; flex-wrap: wrap; gap: 4px 20px;
           align-items: baseline; padding: 8px 16px; background: var(--card);
           border-bottom: 1px solid var(--line); }
  header h1 { font-size: 1.1rem; margin: 0; }
  main { max-width: 1100px; margin: 0 auto; padding: 12px 16px 32px; }
  section { margin-bottom: 20px; padding: 12px 16px; background: var(--card);
            border: 1px solid var(--line); border-radius: 10px; }
  h2 { font-size: 1rem; margin: 0 0 8px; }
  .muted { color: var(--muted); }
  #status.error { color: var(--bad); font-weight: 600; }
  #auditSteps li.finished { color: var(--muted); }
  #auditCurrent { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  #where ul { margin: 0; padding-left: 20px; }
  #next { border: 2px solid var(--accent); }
  #next p { margin: 0 0 10px; font-weight: 600; }
  button { font: inherit; cursor: pointer; border-radius: 8px; border: 1px solid var(--line);
           background: var(--bg); color: var(--text); padding: 4px 12px; }
  button.big { padding: 12px 20px; font-size: 1.1rem; font-weight: 600; color: #fff;
               background: var(--accent); border-color: var(--accent); }
  button:disabled { opacity: .5; cursor: default; }
  code { font: .9em ui-monospace, SFMono-Regular, Consolas, monospace; overflow-wrap: anywhere; }
  .previews { display: flex; flex-wrap: wrap; gap: 8px; }
  .previews img { width: 96px; height: 96px; object-fit: cover; border-radius: 6px;
                  border: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; }
  td { padding: 6px 6px; border-top: 1px solid var(--line); vertical-align: top; }
  td.mark { width: 2em; text-align: center; }
  td.number { width: 2.5em; text-align: right; color: var(--muted); }
  td.badges { white-space: nowrap; }
  tr.done td { color: var(--muted); }
  tr.proposed td { font-weight: 600; }
  @media (max-width: 760px) { td.command { display: none; } }
  #running { position: fixed; inset: 0; z-index: 2; display: flex; align-items: center;
             justify-content: center; padding: 16px; background: rgba(0, 0, 0, .55); }
  #running[hidden] { display: none; }
  #running div { max-width: 560px; padding: 20px 24px; background: var(--card);
                 border-radius: 12px; font-size: 1.05rem; }
</style>
</head>
<body>
<header>
  <h1>⌂ {{ _("media-hygiene — where you are") }}</h1>
  <span id="status" role="status" aria-live="polite"></span>
</header>
<main>
  <section id="next" aria-labelledby="nextTitle">
    <h2 id="nextTitle">👉 {{ _("Next step") }}</h2>
    <p id="why"></p>
    <button id="nextButton" class="big" type="button" hidden></button>
  </section>
  <section id="audit" aria-labelledby="auditTitle">
    <h2 id="auditTitle">🔒 {{ _("Audit in this page") }}</h2>
    <p class="muted">{{ _("Reads your folders as 'mh audit' does, its progress shown here: your photos are not touched.") }}</p>
    <button id="auditStart" type="button">{{ _("Audit now") }}</button>
    <button id="auditStop" type="button" hidden>{{ _("Stop the audit") }}</button>
    <ol id="auditSteps"></ol>
    <p id="auditCurrent" class="muted"></p>
    <div id="auditEnd"></div>
  </section>
  <section id="where" aria-labelledby="whereTitle">
    <h2 id="whereTitle">{{ _("Where you are") }}</h2>
    <ul id="lines"></ul>
    <p id="undo" class="muted" hidden></p>
  </section>
  <section id="found" hidden aria-labelledby="foundTitle">
    <h2 id="foundTitle">{{ _("What the last audit found") }}</h2>
    <div id="previews" class="previews"></div>
  </section>
  <section aria-labelledby="reportsTitle">
    <h2 id="reportsTitle">{{ _("Reports") }}</h2>
    <ul id="reports"></ul>
  </section>
  <div id="guides"></div>
  <p class="muted" id="legend"></p>
</main>
<div id="running" hidden role="alertdialog" aria-live="assertive">
  <div><p id="runningCommand"></p><p>{{ _("Running in the PowerShell window: this page comes back when it ends.") }}</p>
  <p class="muted">{{ _("Not opened by mh? Type the command yourself; this page is closed.") }}</p></div>
</div>
<script>
{% include "home.js.j2" %}
</script>
</body>
</html>

<!DOCTYPE html>
{# The page freeing a phone, served by `media-hygiene phone-review` for `mh phone` (0248).
   The page never touches a file: each tick is sent to the server, which saves
   phone-decisions.json and reads it back; "Delete from the phone" ends the page, then `mh`
   copies each file ticked again, proves it by its content, and only then removes it. #}
{% set texts = {
  "totals": _("Ticked: {ticked} of {total} files ({size})"),
  "group": _("{ticked} of {count} ticked · {size}"),
  "delete": "🗑️ " ~ _("Delete {ticked} files ({size}) from the phone"),
  "confirm": _("Delete {ticked} files ({size}) from the phone? Each one is first copied again and compared with the PC's copy: one that differs stays on the phone. Deleted over USB, a file is gone for good from the phone: it has no trash."),
  "confirmAside": _("This photo is not in your library: {warning} Tick it anyway?"),
  "saving": _("Saving…"),
  "proofOk": "✔ " ~ _("Saved, then read back from the disk at {time}: {ticked} files ticked in {file}.").replace("{file}", place),
  "loaded": "📄 " ~ _("{file} read from the disk at {time}: {ticked} files ticked.").replace("{file}", place),
  "failed": _("Not saved (error {status})."),
  "offline": _("The page is not running any more: type mh phone again."),
  "freed": _("Back to the console: mh copies each file ticked again, proves it, then deletes it from the phone."),
  "left": _("Nothing was deleted from the phone. You can close this page."),
  "noPreview": _("no preview"),
  "pc": _("On the PC:"),
} %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ _("Free the phone") }} — media-hygiene</title>
<style>
  :root {
    --bg: #f7f7f5; --card: #ffffff; --text: #1f2328; --muted: #656d76; --line: #d8dee4;
    --accent: #0969da; --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1117; --card: #161b22; --text: #e6edf3; --muted: #8d96a0; --line: #30363d;
      --accent: #4493f8; --ok: #3fb950; --warn: #d29922; --bad: #f85149;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  header, footer { position: sticky; z-index: 1; padding: 8px 16px; background: var(--card); }
  header { top: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; align-items: baseline;
           border-bottom: 1px solid var(--line); }
  header h1 { font-size: 1.1rem; margin: 0; }
  footer { bottom: 0; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center;
           border-top: 1px solid var(--line); }
  main { padding: 12px 16px 24px; }
  .muted { color: var(--muted); }
  .notice { margin: 0 0 16px; padding: 8px 12px; background: var(--card); border: 2px solid var(--warn);
            border-radius: 10px; }
  #status.error { color: var(--bad); font-weight: 600; } #status.saved { color: var(--ok); }
  section { margin-bottom: 20px; }
  section h2 { font-size: 1rem; margin: 0; }
  .bar { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; margin-bottom: 8px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .tile { margin: 0; padding: 6px; background: var(--card); border: 3px solid var(--line); border-radius: 10px; }
  .tile.ticked { border: 3px dashed var(--bad); }
  .tile label { display: flex; gap: 6px; align-items: center; font-weight: 600; cursor: pointer; }
  .tile img, .tile .none { display: block; width: 100%; height: 140px; object-fit: contain; border-radius: 6px;
                           background: var(--bg); }
  .tile .none { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 2rem; }
  .tile p { margin: 4px 0 0; font-size: .8rem; overflow-wrap: anywhere; }
  .tile .warning { color: var(--warn); font-weight: 600; }
  button { font: inherit; padding: 4px 12px; border-radius: 8px; border: 1px solid var(--line);
           background: var(--card); color: var(--text); cursor: pointer; }
  button.danger { background: var(--bad); border-color: var(--bad); color: #fff; font-weight: 600; }
  button:disabled { opacity: .5; cursor: default; }
  #closed { position: fixed; inset: 0; z-index: 60; display: none; align-items: center; justify-content: center;
            padding: 16px; background: rgba(0, 0, 0, .55); }
  #closed p { max-width: 520px; padding: 20px 24px; border-radius: 12px; background: var(--card); }
</style>
</head>
<body>
<header>
  <h1>📱 {{ _("Free the phone") }} <span id="phone"></span></h1>
  <span id="totals" class="muted"></span>
  <span id="status" role="status" aria-live="polite"></span>
</header>
<main>
  <p class="notice">{{ _("Nothing leaves the phone before you press Delete. Each file ticked is then copied again from the phone and compared, byte for byte (SHA-256), with the PC's copy: a file that differs stays on the phone. Deleted over USB, a file is gone for good from the phone: it has no trash, and undo cannot put it back.") }}</p>
  <div id="groups"></div>
</main>
<footer>
  <button id="free" class="danger" type="button" disabled></button>
  <button id="leave" type="button">{{ _("Leave everything on the phone") }}</button>
  <span class="muted">{{ _("Every tick is saved at once in %(place)s.", place=place) }}</span>
</footer>
<div id="closed" role="alertdialog" aria-live="assertive"><p id="closedText"></p></div>
<script>
{% include "phone_review.js.j2" %}
</script>
</body>
</html>

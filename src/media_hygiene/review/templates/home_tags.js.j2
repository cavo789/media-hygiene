{# The read-only steps run by the page: `tags` (0343), the face scan of `people` (0424),
   search by meaning (0425, offered at the end of `tags` when `[tags] meaning` is on). One
   shape: figures and a question, then the progress (done / total, rate, time left) and
   Stop. Each path holds its run: reopening the page during a run shows it again. #}
const TAGS_HOUR = 60;
const RUN_KINDS = ["tags", "people", "meaning"].filter((kind) => P[kind]);
const fillIn = (text, values) => text.replace(/\{(\w+)\}/g, (all, key) => (key in values ? values[key] : all));
const said = (kind, key) => T[kind + key] || T["tags" + key];
function duration(seconds) {
  const minutes = Math.max(1, Math.round(seconds / 60));
  const hours = Math.floor(minutes / 60);
  return hours ? fillIn(T.tagsHours, { h: hours, min: minutes % 60 }) : fillIn(T.tagsMinutes, { min: minutes });
}
function askingParts(kind, figures) {
  if (!figures.model) return [`<p>${esc(T.tagsNoModel)}</p>`];
  if (!figures.to_describe) return [`<p>${esc(said(kind, "Nothing"))}</p>`];
  return [
    `<p>${esc(fillIn(said(kind, "Ask"), { count: count(figures.to_describe), model: figures.model, time: duration(figures.to_describe * figures.seconds_per_photo) }))}</p>`,
    `<div class="audit-controls"><button class="btn btn-primary" type="button" data-act="${kind}-all">${icon("play")} ${esc(said(kind, "Now"))}</button><button class="btn" type="button" data-act="${kind}-hour">${esc(said(kind, "Hour"))}</button><button class="btn btn-ghost" type="button" data-close>${esc(T.tagsNotNow)}</button></div>`,
  ];
}
function runBody(kind, state) {
  const steps = state.steps.map((step) => {
    const counts = step.total === null ? count(step.done) : `${count(step.done)} / ${count(step.total)}`;
    const pct = step.total ? Math.round((100 * step.done) / step.total) : 0;
    return `<li class="pstep${step.finished ? " is-done" : ""}">${icon(step.finished ? "check" : "history")}<span>${esc(step.title)}</span><span class="pstep-count">${esc(counts)}</span><span class="pbar" aria-hidden="true"><span style="width:${pct}%"></span></span></li>`;
  }).join("");
  const parts = [`<ol class="progress-steps"${steps ? "" : " hidden"}>${steps}</ol>`];
  if (state.phase === "preparing") parts.push(`<p class="pcurrent">${esc(said(kind, "Preparing"))}</p>`);
  if (state.phase === "asking" && state.figures) parts.push(...askingParts(kind, state.figures));
  if (state.phase === "running") {
    const step = state.steps.find((one) => one.total !== null && !one.finished);
    if (step && step.done && state.elapsed) {
      const rate = step.done / state.elapsed;
      parts.push(`<p class="pcurrent" aria-live="polite">${esc(fillIn(T.tagsRate, { rate: (rate * 60).toFixed(1), time: duration((step.total - step.done) / rate) }))}</p>`);
    } else parts.push(`<p class="pcurrent">${esc(said(kind, "Running"))}</p>`);
    if (state.current) parts.push(`<p class="pcurrent muted">${esc(state.current)}</p>`);
    parts.push(`<div class="audit-controls"><button class="btn btn-ghost" type="button" data-act="${kind}-stop">${esc(T.tagsStop)}</button></div>`);
  }
  if (state.phase === "stopped") parts.push(`<p>${esc(said(kind, "Stopped"))}</p>`);
  parts.push(...state.lines.map((line) => `<p>${esc(line)}</p>`));
  if (state.error) parts.push(`<p class="muted">${esc(state.error)}</p>`);
  const ended = ["done", "stopped"].includes(state.phase) || (state.phase === "asking" && state.figures && !state.figures.to_describe);
  if (kind === "tags" && P.meaning && ended) parts.push(`<div class="audit-controls"><button class="btn" type="button" data-act="meaning-here">${esc(T.meaningOpen)}</button></div>`);
  return parts.join("");
}
function drawRun(kind, state) {
  const dialog = $(`#${kind}Dlg`);
  dialog.innerHTML = `<div class="dlg">
    <div class="dlg-head"><div><p class="eyebrow">${icon("tag")} ${esc(T.tagsEyebrow)}</p><h2 id="${kind}Title">${esc(said(kind, "Title"))}</h2></div>${closeButton()}</div>
    <p class="muted">${esc(said(kind, "Text"))}</p>${runBody(kind, state)}</div>`;
  if (!dialog.open) showDialog(dialog);
  return state.phase === "preparing" || state.phase === "running";
}
const pollRun = (kind) => fetch(P[kind], { cache: "no-store" })
  .then((response) => response.json())
  .then((state) => { if (state.phase !== "idle" && drawRun(kind, state)) window.setTimeout(() => pollRun(kind), POLL_MS); })
  .catch(() => stopped());
function askRun(kind, body) {
  post(P[kind], body)
    .then((reply) => { if (!reply.ok) toast(reply.body.error || T.tagsBusy); pollRun(kind); })
    .catch(() => stopped());
}
RUN_KINDS.forEach((kind) => {
  ACTS[`${kind}-here`] = () => {
    if (kind === "meaning") $("#tagsDlg").close();
    askRun(kind, { action: "prepare" });
  };
  ACTS[`${kind}-all`] = () => askRun(kind, { action: "describe" });
  ACTS[`${kind}-hour`] = () => askRun(kind, { action: "describe", minutes: TAGS_HOUR });
  ACTS[`${kind}-stop`] = () => askRun(kind, { action: "stop" });
  fetch(P[kind], { cache: "no-store" })  // a run going on: show it again
    .then((response) => (response.ok ? response.json() : null))
    .then((state) => { if (state && (state.phase === "preparing" || state.phase === "running")) pollRun(kind); })
    .catch(() => {});
});

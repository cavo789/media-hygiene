{# The script of phone_review.html.j2, after the shared `pick_*` scripts: the files of the
   phone by folder (0312), picked as on `browse`; the bar's two buttons and Space in the
   large view tick or untick them (0314), the folder's box every file of the folder. Each
   choice is one `POST /api/phone`, the page shows what the file read back holds. A file
   set aside before is never ticked by a gesture on several files: only alone, after its
   warning. The red button only while the ticks shown are those read back from the disk; a
   server gone (no answer, or another page's server on the port: 404, 405) is said plainly
   (0331). #}
const TEXTS = {{ texts | tojson }};
const STATE_PATH = {{ state_path | tojson }};
const DECIDE_PATH = {{ decide_path | tojson }};
const FILE_PATH = {{ file_path | tojson }};
const FREE_PATH = {{ free_path | tojson }};
const STOP_PATH = {{ stop_path | tojson }};
const PHONE_MB_PER_SECOND = {{ phone_speed | tojson }}; // read twice: the proof's copy, then the move
const GONE = new Set([404, 405]); // a route this page's server always answers: another server's
const MB = 1024 * 1024;
const FOLDED_KEY = "mh-phone-folded";
const LANG = document.documentElement.lang;
const UNITS = ["B", "KB", "MB", "GB", "TB"];
let phone = "";
let tiles = [];   // every file of the phone the PC holds, by rank: `GET /api/state`
let groups = [];  // the phone's folders, in the order of their names
let badges = {};  // why the PC holds a file, by case: the legend's badges
let disk = new Set(); // the ranks ticked in the file, as read back from the disk
let synced = false;   // the ticks shown are those read back: the red button may delete

const number = (value) => value.toLocaleString(LANG);
const clock = (iso) => new Date(iso).toLocaleTimeString(LANG);
function size(bytes) {
  let value = bytes;
  let unit = 0;
  while (value >= 1024 && unit < UNITS.length - 1) {
    value /= 1024;
    unit += 1;
  }
  return value.toLocaleString(LANG, { maximumFractionDigits: unit < 2 ? 0 : 1 }) + " " + UNITS[unit];
}
const sum = (ranks) => ranks.reduce((total, rank) => total + tiles[rank].size, 0);
const aside = (rank) => tiles[rank].case === "set_aside";

function folded() {
  try { return new Set(JSON.parse(window.localStorage.getItem(FOLDED_KEY) || "[]")); } catch { return new Set(); }
}

function fold(folder, closed) {
  const kept = folded();
  if (closed) kept.add(folder); else kept.delete(folder);
  try { window.localStorage.setItem(FOLDED_KEY, JSON.stringify([...kept])); } catch { /* private mode */ }
}

// What the shared grid picks: the files in the folders' order (Shift ranges, arrows).
function listing() {
  return groups.flatMap((group) => group.files.map((rank) => {
    const tile = tiles[rank];
    return {
      key: String(rank), name: tile.name, preview: tile.preview, original: tile.original,
      chosen: tile.ticked, date: tile.taken.slice(0, 10), size: tile.size_text, folder: tile.folder || "DCIM",
    };
  }));
}

function card(file, index) {
  const tile = tiles[Number(file.key)];
  const node = element("article");
  let picture = element("div", "empty", "📷");
  if (tile.preview) {
    picture = element("img");
    picture.loading = "lazy";
    picture.draggable = false; // a drag draws a rectangle (`pick_band.js.j2`)
    picture.alt = tile.name;
    picture.src = tile.preview;
    picture.addEventListener("error", () => picture.replaceWith(element("div", "empty", "📷")));
  }
  const meta = element("div", "meta");
  meta.append(element("div", "name", tile.name), element("div", "muted", (badges[tile.case] || "") + " · " + tile.size_text));
  if (tile.held) meta.append(element("div", "muted", TEXTS.pc + " " + tile.held));
  if (tile.warning) meta.append(element("div", "warning", "⚠️ " + tile.warning));
  node.append(picture, meta);
  return wireCard(node, index);
}

// The cards in their folders: a line per folder (its box, its counts), then its grid.
function placeCards(made) {
  const closed = folded();
  let next = 0;
  $("grid").replaceChildren(...groups.map((group, rank) => {
    const section = element("section", "folder" + (closed.has(group.folder) ? " folded" : ""));
    section.id = "folder-" + rank;
    const bar = element("div", "folderBar");
    const toggle = element("button", "fold plain", "▾");
    toggle.type = "button";
    toggle.title = TEXTS.fold;
    toggle.addEventListener("click", () => fold(group.folder, section.classList.toggle("folded")));
    const box = element("input");
    box.type = "checkbox";
    box.title = TEXTS.folderBox;
    box.addEventListener("click", (event) => { event.preventDefault(); tickFolder(group); });
    bar.append(toggle, box, element("h2", "", "📁 " + (group.folder || "DCIM")), element("span", "muted count"));
    if (group.aside) bar.append(element("span", "warning", fill(TEXTS.asideKept, { n: number(group.aside) })));
    const grid = element("div", "tiles");
    grid.append(...made.slice(next, next + group.files.length));
    next += group.files.length;
    section.append(bar, grid);
    return section;
  }));
}

// The counts, the folders' boxes (☑ all, ☐ none, ▣ some) and the red button, after each save.
function paint() {
  const all = tiles.map((tile) => tile.rank);
  const ticked = all.filter((rank) => tiles[rank].ticked);
  $("phone").textContent = phone;
  $("status").textContent = fill(TEXTS.status, { phone: phone, ticked: number(ticked.length), total: number(all.length), size: size(sum(ticked)) });
  $("free").textContent = fill(TEXTS.delete, { ticked: number(disk.size), size: size(sum([...disk])) });
  $("free").disabled = disk.size === 0 || !synced;
  const sections = $("grid").querySelectorAll(".folder");
  $("folders").replaceChildren(...groups.map((group, rank) => {
    const on = group.files.filter((file) => tiles[file].ticked);
    const box = sections[rank].querySelector(".folderBar input");
    const full = tickable(group).every((file) => tiles[file].ticked) && on.length > 0;
    box.checked = full;
    box.indeterminate = on.length > 0 && !full;
    sections[rank].querySelector(".count").textContent = fill(TEXTS.group, { ticked: number(on.length), count: number(group.files.length), size: size(sum(on)) });
    const item = element("li");
    const link = element("a", "", "📁 " + (group.folder || "DCIM"));
    link.href = "#folder-" + rank;
    item.append(link, element("span", "muted", number(on.length) + " / " + number(group.files.length)));
    return item;
  }));
}

// What the files shown are: the whole page, always.
function scope() {
  return {};
}

function reopen(again) {
  showFiles(listing(), again);
  paint();
}

function say(text, kind) {
  for (const id of ["chosen", "viewerSaid"]) {
    $(id).className = kind || "";
    $(id).textContent = text;
  }
  $("chosen").title = text;
}

// Its server is gone (ended, or the home page back on the port): said, nothing more is sent.
function gone() {
  synced = false;
  $("free").disabled = true;
  $("leave").disabled = true;
  const home = Boolean(window.mhAwaitHome); // opened from the home page (home_link.html.j2)
  const text = home ? TEXTS.goneHome : TEXTS.offline;
  $("closedText").textContent = text;
  $("closedHome").hidden = !home;
  $("closed").style.display = "flex";
  say(text, "error");
}

// A save refused: the ticks shown again as the file on the disk holds them.
async function resync() {
  const answer = await ask(FILE_PATH);
  if (!answer || GONE.has(answer.status)) { gone(); return; }
  const read = await answer.json().catch(() => ({}));
  if (!answer.ok || read.error || !Array.isArray(read.ticked)) return;
  readBack(read);
  reopen(true);
}

// changes: [rank, ticked] pairs, sent in one POST; the page shows what the file read back holds.
async function decide(changes, left) {
  say(TEXTS.saving, "");
  synced = false;
  $("free").disabled = true;
  const body = { choices: changes.map(([rank, on]) => ({ file: rank, ticked: on })) };
  const answer = await ask(DECIDE_PATH, body);
  if (!answer || GONE.has(answer.status)) { gone(); return false; }
  const reply = await answer.json().catch(() => ({}));
  if (!answer.ok) {
    await resync();
    say(reply.error ? fill(TEXTS.notSaved, { error: reply.error }) : fill(TEXTS.failed, { status: answer.status }), "error");
    return false;
  }
  readBack(reply.file);
  const proof = fill(TEXTS.proofOk, { time: clock(reply.file.modified), ticked: number(disk.size) });
  say(left ? proof + " " + counted(TEXTS.asideLeft, left) : proof, "saved");
  return true;
}

function readBack(file) {
  disk = new Set(file.ticked);
  synced = true;
  for (const tile of tiles) tile.ticked = disk.has(tile.rank);
}

// The bar's buttons and Space in the large view: a set-aside file is ticked alone only, after its warning.
saveChoice = async (action, keys) => {
  const on = action === "add";
  let ranks = keys.map(Number);
  let left = 0;
  const warned = ranks.filter((rank) => aside(rank) && !tiles[rank].ticked);
  if (on && warned.length === 1 && ranks.length === 1) {
    if (!window.confirm(fill(TEXTS.confirmAside, { warning: tiles[warned[0]].warning }))) { say("", ""); return false; }
  } else if (on && warned.length) {
    ranks = ranks.filter((rank) => !warned.includes(rank));
    left = warned.length;
  }
  const changes = ranks.filter((rank) => tiles[rank].ticked !== on).map((rank) => [rank, on]);
  if (!changes.length) { say(left ? counted(TEXTS.asideLeft, left) : "", ""); return true; }
  return decide(changes, left);
};
deleteKeySets = false; // the only deletion is the red button

// Every file of a folder the box ticks: never one set aside before.
const tickable = (group) => group.files.filter((rank) => !aside(rank));

// The folder's box: every file of the folder unticked when all it ticks are, else those ticked.
async function tickFolder(group) {
  const ticking = !tickable(group).every((rank) => tiles[rank].ticked);
  const changes = group.files
    .filter((rank) => (ticking ? !aside(rank) && !tiles[rank].ticked : tiles[rank].ticked))
    .map((rank) => [rank, ticking]);
  const left = ticking ? group.files.filter((rank) => aside(rank) && !tiles[rank].ticked).length : 0;
  if (!changes.length) { say(left ? counted(TEXTS.asideLeft, left) : "", ""); return; }
  if (await decide(changes, left)) reopen(true);
}

// The large view: Space ticks or unticks the file shown (no Delete, no album here).
delete VIEWER_KEYS.Delete;
delete VIEWER_KEYS.Backspace;
delete VIEWER_KEYS.a;
VIEWER_KEYS[" "] = async () => {
  const file = files[current];
  if (file && (await saveShown(file.chosen ? "remove" : "add"))) $("viewerAside").hidden = !files[current].chosen;
};

// The page ends; opened from the home page, this tab shows it once mh opens it again (0332).
function end(path, text) {
  ask(path, {}).then(async (answer) => {
    if (!answer || GONE.has(answer.status)) { gone(); return; }
    const reply = await answer.json().catch(() => ({}));
    if (!answer.ok) { say(reply.error || fill(TEXTS.failed, { status: answer.status }), "error"); return; }
    $("closedText").textContent = text;
    $("closed").style.display = "flex";
    if (window.mhAwaitHome) window.mhAwaitHome();
  });
}

$("free").addEventListener("click", () => {
  const ranks = [...disk];
  if (!synced || !ranks.length) return; // the ticks shown are not those on the disk
  const minutes = Math.max(1, Math.ceil((2 * sum(ranks)) / MB / PHONE_MB_PER_SECOND / 60));
  if (window.confirm(fill(TEXTS.confirm, { ticked: number(ranks.length), size: size(sum(ranks)) }))) end(FREE_PATH, fill(TEXTS.freed, { minutes: number(minutes) }));
});
$("leave").addEventListener("click", () => end(STOP_PATH, TEXTS.left));

Promise.all([ask(STATE_PATH), ask(FILE_PATH)])
  .then(async ([state, file]) => {
    if (!state || !file || GONE.has(state.status) || GONE.has(file.status)) { gone(); return; }
    const listed = await state.json();
    const read = await file.json();
    tiles = listed.tiles;
    groups = listed.groups;
    phone = listed.phone;
    badges = Object.fromEntries(listed.reasons.map((reason) => [reason.case, reason.badge]));
    $("legend").replaceChildren(...listed.reasons.flatMap((reason) => [element("dt", "", reason.badge), element("dd", "", reason.help)]));
    if (read.error) say(read.error, "error");
    else {
      readBack(read);
      say(fill(TEXTS.loaded, { time: clock(read.modified), ticked: number(disk.size) }), "saved");
    }
    reopen(false);
  });

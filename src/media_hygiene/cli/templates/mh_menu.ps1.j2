{# `mh` alone (the home page, its steps run in the console) and `mh menu`: included by mh.ps1.j2. #}
# `{{ function }}` alone: the home page. A step chosen there ends it with {{ step_base }} + n; it runs
# here as `{{ function }} <step>`, its questions in this console, then the page comes back.
# A page a step opened may end the same way (browse's Apply now, 0243): that step runs next.
# A step with fields leaves its words in a one-shot file of the reports folder (0266).
# Quit, Ctrl+C or an error end the loop with the page's exit code (0210); a page whose tab
# was closed ends it too, the prompt back, never home opened again (0262). A signal's code
# (128 + n: Ctrl+C is 130) ends it whatever ran, never read as a step (0287).
# One tab (0280): the first page opens it; every later page of the loop shows in it, no new tab.
function global:_{{ function }}_home {
    $typed = @($args)
    $color = @(if ($Host.UI.SupportsVirtualTerminal) { '--color', 'always' } else { '--color', 'never' })
    $status = 0
    $after = $false
    $tab = $false
    while ($true) {
        if ($status -eq {{ page_closed }}) { $global:LASTEXITCODE = 0; return }
        if ($status -ge {{ signal_base }}) { $global:LASTEXITCODE = $status; return }
        if ($status -le {{ step_base }}) {
            $after = $false
            $global:MediaHygieneRelay = $true
            $global:MediaHygieneTab = $tab
            try { {{ function }} home @typed } finally { $global:MediaHygieneRelay = $null; $global:MediaHygieneTab = $null }
            $status = $LASTEXITCODE
            if ($status -le {{ step_base }} -or $status -ge {{ signal_base }}) { return }
            $tab = $true
        }
{% if host.step_file %}
        # A step with fields (0266), or any step since 0354 (no `{{ function }} menu` container to
        # read it): the page wrote its words, read once, then removed.
        $file = "{{ host.step_file }}"
        if ($status -eq {{ fields_code }} -and (Test-Path -LiteralPath $file)) {
            $words = @((Get-Content -LiteralPath $file -Raw -Encoding UTF8 | ConvertFrom-Json).words)
            Remove-Item -LiteralPath $file -Force -ErrorAction SilentlyContinue
            $chosen = @($words | ForEach-Object { if ("$_" -match '[\s\\]') { '"' + $_ + '"' } else { $_ } }) -join ' '
            Write-Host "{{ texts.direct }}"
            _{{ function }}_forward "$($words[0])"
            $after = $true
            $global:LASTEXITCODE = 0
            $global:MediaHygieneRelay = $true
            $global:MediaHygieneTab = $tab
            try { {{ function }} @words @typed } finally { $global:MediaHygieneRelay = $null; $global:MediaHygieneTab = $null }
            $status = $LASTEXITCODE
            continue
        }
{% endif %}
        $steps = @({{ function }} @color menu)
        $chosen = ''
        foreach ($step in $steps) {
            $number, $line = "$step" -split "`t", 2
            if ($number -eq "$($status - {{ step_base }})") { $chosen = $line; break }
        }
        if (-not $chosen -and $after) { $status = 0; continue }
        if (-not $chosen) { $global:LASTEXITCODE = $status; return }
        Write-Host "{{ texts.direct }}"
        $words = -split $chosen
        _{{ function }}_forward "$($words[0])"
        $after = $true
        $global:LASTEXITCODE = 0  # a step run by mh itself (open) leaves it as it was
        $global:MediaHygieneRelay = $true
        $global:MediaHygieneTab = $tab
        try { {{ function }} @words @typed } finally { $global:MediaHygieneRelay = $null; $global:MediaHygieneTab = $null }
        $status = $LASTEXITCODE
    }
}

# A console step chosen on the home page: the bell (BEL: Windows Terminal flashes its taskbar
# button when its bellStyle holds "taskbar") and Windows' sound, heard whatever the terminal;
# then this window brought forward when Windows allows it: the classic console only, measured
# (2026-10-21: nothing in Windows Terminal, whose window is not this process's) (0285).
# WScript.Shell, never Add-Type (0257). A page step shows in the browser's tab instead (0280).
function global:_{{ function }}_forward($command) {
    if ($command -in @({{ listed(script.commands.pages) }})) { return }
    Write-Host -NoNewline ([char]7)
    try { [Media.SystemSounds]::Exclamation.Play() } catch { }
    try {
        $shell = New-Object -ComObject WScript.Shell
        if (-not $shell.AppActivate($PID)) { $null = $shell.AppActivate($Host.UI.RawUI.WindowTitle) }
    } catch { }
}

# `{{ function }} menu`: the menu lists the steps, the number chosen runs as `{{ function }} <step>`.
# With --photos, the step chosen gets them too (0181).
function global:_{{ function }}_menu {
    $typed = @($args)
    if ($typed.Count -gt 0) {
        $shown = @(for ($i = 1; $i -lt $typed.Count; $i += 2) { $typed[$i] }) -join ', '
        Write-Host "{{ texts.folder }}"
    }
    $color = @(if ($Host.UI.SupportsVirtualTerminal) { '--color', 'always' } else { '--color', 'never' })
    Write-Host "{{ texts.reading }}"
    $steps = @({{ function }} @color menu)
    if ($LASTEXITCODE -ne 0 -or $steps.Count -eq 0) { return }
    $choice = "$(Read-Host "{{ texts.prompt }}")".Trim()
    if (-not $choice) { $choice = '0' }
    $chosen = ''
    foreach ($step in $steps) {
        $number, $line = "$step" -split "`t", 2
        if ($number -eq $choice) { $chosen = $line; break }
    }
    if (-not $chosen) {
        if ($choice -ne '0') { Write-Host "{{ texts.unknown }}" }
        return
    }
    Write-Host "{{ texts.direct }}"
    $words = -split $chosen
    {{ function }} @words @typed
}

{# The photo folders given and their drives in WSL (0254, 0259): included by mh.sh.j2; services/launcher_guards.py. #}
# --photos /mnt/e/Folder: one more photo folder, for this command only, its drive checked
# first in WSL (0259); the other words go to the caller's `rest`.
_{{ function }}_given() {
    local folder
    while [[ $# -gt 0 ]]; do
        if [[ "$1" != --photos || $# -lt 2 ]]; then rest+=("$1"); shift; continue; fi
        folder="$2"
        shift 2
        _{{ function }}_drive "$folder" || return 2
        if [[ ! -d "$folder" ]]; then printf '%s\n' "{{ texts.missing }}" >&2; return 2; fi
        folder="$(cd "$folder" && pwd -P)"
        typed+=(--photos "$folder")
        if [[ "$folder" =~ ^/mnt/([a-z])(/.*)?$ ]]; then
            given+=("$folder:/data/${BASH_REMATCH[1]}${BASH_REMATCH[2]}")
        else
            given+=("$folder:/data$folder")
        fi
    done
}

# WSL mounts the drives present when it starts (/mnt/c, /mnt/d), never a USB stick plugged
# in later: its /mnt/e is absent, the folder cannot be found, and Docker would mount an
# empty one in its place (0252). In WSL (cmd.exe reachable), the drive of a /mnt/<x>
# folder that Windows has but WSL has not mounted stops the command with the line to type:
# mh never runs sudo itself (0259). Native Linux, macOS, WSL with its Windows interop off:
# nothing changes.
_{{ function }}_drive() {
    local letter drive
    if [[ ! "$1" =~ ^/mnt/([a-z])(/|$) || "${BASH_REMATCH[1]}" == c ]]; then return 0; fi
    letter="${BASH_REMATCH[1]}"
    drive="$(printf '%s' "$letter" | tr '[:lower:]' '[:upper:]')"
    if mountpoint -q "/mnt/$letter" 2>/dev/null; then return 0; fi
    if ! command -v cmd.exe >/dev/null 2>&1; then return 0; fi  # native Linux, or interop off
    if ! cmd.exe /c vol "$drive:" >/dev/null 2>&1; then return 0; fi  # not a drive of Windows
    printf '%s\n    %s\n' "{{ guards.wsl.unmounted }}" \
        "sudo mkdir -p /mnt/$letter && sudo mount -t drvfs $drive: /mnt/$letter -o uid=$(id -u),gid=$(id -g)" >&2
    return 2
}

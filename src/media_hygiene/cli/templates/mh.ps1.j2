{# The `mh` launcher for PowerShell: see services/launcher.py. #}
{% macro listed(names) %}{% for name in names %}'{{ name }}'{{ ", " if not loop.last }}{% endfor %}{% endmacro %}
{% macro quoted(names) %}{% for name in names %}"{{ name }}"{{ ", " if not loop.last }}{% endfor %}{% endmacro %}
{% for line in header %}
# {{ line }}
{% endfor %}
function global:{{ function }} {
    # The title a long run left in the taskbar goes back at the next call (0185).
    if ($null -ne $global:MediaHygieneTitle) {
        $Host.UI.RawUI.WindowTitle = $global:MediaHygieneTitle
        $global:MediaHygieneTitle = $null
    }
    if ($args.Count -eq 1 -and $args[0] -eq '{{ host.flag }}') {
        # Explorer wrote the folder after the comment ending the command (0181).
        $line = [Environment]::CommandLine
        $folder = $line.Substring($line.LastIndexOf('#" "') + 4).TrimEnd().TrimEnd('"')
        {{ function }} --photos $folder
        return
    }
    _{{ function }}_stale  # this file written again since this window loaded it (0276)
    # --photos "E:\Folder": one more photo folder, for this command only.
    $given = @()
    $typed = @()
    $rest = @()
    for ($i = 0; $i -lt $args.Count; $i++) {
        if ($args[$i] -ne '--photos' -or $i + 1 -ge $args.Count) { $rest += $args[$i]; continue }
        $i++
        $folder = $args[$i]
        $found = Resolve-Path -LiteralPath $folder -ErrorAction SilentlyContinue
        if (-not $found -or $found.ProviderPath -notmatch '^[A-Za-z]:') { Write-Host "{{ texts.missing }}"; $global:LASTEXITCODE = 2; return }
        $typed += '--photos', $found.ProviderPath
        $full = $found.ProviderPath.TrimEnd('\')
        $given += "${full}:/data/" + $full.Substring(0, 1).ToLower() + ($full.Substring(2) -replace '\\', '/')
    }
    if ($rest.Count -eq 1 -and $rest[0] -eq '{{ lan.flag }}') {
        # `{{ function }} {{ lan.flag }}`: a phone of the home network may open the page (0269), whatever [review] lan.
        if (-not (_{{ function }}_desktop)) { return }
        _{{ function }}_lan @typed
        return
    }
    if ($rest.Count -gt 1 -and $rest[0] -in @({{ listed(lan.shows) }}) -and $rest -contains '{{ lan.flag }}') {
        # `{{ function }} slideshow {{ lan.flag }}`: the show opens to the TV and the phones of the home network (0291).
        if (-not (_{{ function }}_lan_open)) { return }
        $plain = @($rest | Where-Object { $_ -ne '{{ lan.flag }}' }) + $typed
        try { {{ function }} @plain } finally { $global:MediaHygieneLan = $null }
        return
    }
    if ($rest.Count -eq 0) {
        # Alone: the home page, the steps chosen there run here (0210); with --photos,
        # the step chosen gets them too (0181). Docker Desktop started first (0200).
        if (-not (_{{ function }}_desktop)) { return }
{% if script.commands.lan %}
        _{{ function }}_lan @typed  # open to the home network too: [review] lan (0367)
{% else %}
        _{{ function }}_home @typed  # [review] lan = false: this PC only (0367)
{% endif %}
        return
    }
    if ($rest.Count -eq 1 -and $rest[0] -eq 'menu') {
        # `{{ function }} menu`: the steps in this console, a number read (0172).
        if (-not (_{{ function }}_desktop)) { return }
        _{{ function }}_menu @typed
        return
    }
    # The commands of the host itself, without the container (0175, 0180, 0181).
    # Splatted: each word its own argument, as typed.
    $more = @($rest | Select-Object -Skip 1)
    if ($rest[0] -eq 'import' -and $more -contains '{{ host.phone }}') {
        # `{{ function }} import {{ host.phone }}`: a phone over USB, read by Windows itself, not Docker (0219, 0379).
        $words = @($more | Where-Object { $_ -ne '{{ host.phone }}' })
        _{{ function }}_phone @words
        return
    }
    switch ($rest[0]) {
{% for name in host.names %}
        '{{ name }}' { _{{ function }}_{{ name }} @more; return }
{% endfor %}
    }
    foreach ($folder in @({{ quoted(checked) }})) {
        if (-not (Test-Path -LiteralPath $folder)) { Write-Host "{{ texts.missing }}"; $global:LASTEXITCODE = 2; return }
    }
    $command = $rest | Where-Object { $_ -in @({{ listed(script.commands.names) }}) } | Select-Object -First 1
    # `{{ function }} import <folder>`: that folder only, read-only, for this run; never added (0378).
    $source = @()
    $at = if ($command -eq 'import') { [array]::IndexOf($rest, 'import') + 1 } else { 0 }
    if ($at -gt 0 -and $at -lt $rest.Count -and -not "$($rest[$at])".StartsWith('-')) {
        $folder = $rest[$at]
        $found = Resolve-Path -LiteralPath $folder -ErrorAction SilentlyContinue
        if (-not $found -or $found.ProviderPath -notmatch '^[A-Za-z]:') { Write-Host "{{ texts.missing }}"; $global:LASTEXITCODE = 2; return }
        $rest[$at] = $found.ProviderPath
        $full = $found.ProviderPath.TrimEnd('\')
        $source = @("${full}:/data/" + $full.Substring(0, 1).ToLower() + ($full.Substring(2) -replace '\\', '/'))
    }
    if ($command -in @({{ listed(cloud.readers) }})) {
        # Photos in OneDrive's cloud only: said, and asked, before anything reads them (0199).
        $read = @({{ quoted(checked) }}) + @(for ($i = 1; $i -lt $typed.Count; $i += 2) { $typed[$i] })
        if (-not (_{{ function }}_cloud $read)) { return }
    }
    $mode = if ($command -in @({{ listed(script.commands.writers) }})) { '' } else { ':ro' }
    # The port mh publishes is the one the page listens on, config.toml changed or not (0260).
    $page = if ($command -in @({{ listed(script.commands.pages) }})) { @('-p', '127.0.0.1:{{ script.commands.port }}:{{ script.commands.port }}', '-e', 'MEDIA_HYGIENE_REVIEW__PORT={{ script.commands.port }}') } else { @() }
    if ($page) {
        # A page left by a closed window holds the port: stopped when its console is gone (0250).
        if (-not (_{{ function }}_page_free)) { $global:LASTEXITCODE = 1; return }
        $page += '--label', "{{ guards.label }}=powershell-$PID-$(_{{ function }}_started $PID)"
        $page += @(_{{ function }}_lan_page $command)  # the home page of `{{ function }} {{ lan.flag }}` (0269)
    }
    # A removable drive is shared with Docker Desktop first, or the command stops; the
    # drives this run mounted are unmounted after it, in finally (0252).
    $hosts = @({{ quoted((script.data + script.backups + script.tools + script.drives) | map(attribute='host') | list) }}) + @(foreach ($volume in $given) { $volume }) + $source
    $shared = _{{ function }}_removable $hosts
    if ($null -eq $shared) { $global:LASTEXITCODE = 1; return }
    $marks = @($shared.labels)
    $nas = {% if script.nas %}_{{ function }}_nas_mount $command{% else %}@{ mounts = @(); backups = @(); volumes = @() }{% endif %}  # 0245
    $tty = @(if ($command -notin @({{ listed(script.commands.data) }})) { '-it' })
    # The home page in the background, its id in this file (`_{{ function }}_watch`, 0355).
    $detach = "$global:MediaHygieneDetach"
    if ($detach) { $tty = @('-d', '--cidfile', $detach) }
    $long = $command -in @({{ listed(script.commands.long) }})
    $photos = @(foreach ($volume in $given) { '-v'; "$volume$mode" })
    # The backups: mounted read-only below, whatever the command; given to those taking them (0205).
    $backups = @({% if script.backups %}if ($command -in @({{ listed(script.commands.backups) }}) -and -not $source) { {% for volume in script.backups %}'--backup', "{{ volume.host }}"{{ ", " if not loop.last }}{% endfor %} }{% endif %})
    # Only the loop of `{{ function }}` alone reads the step chosen on the home page (0210),
    # or on a page it opened (browse's Apply now, 0243).
    $relay = @(if ($global:MediaHygieneRelay -and $command -in @({{ listed(relayed) }})) { '-e', '{{ relay }}={{ relay_fields if host.step_file else 1 }}' })
    if ($detach) { $relay = @('-e', '{{ relay }}={{ watch.kept }}') }
    # The page names the folders given with --photos, a right-click's folder (0258).
    if ($relay -and $typed) { $relay += '-e', ('{{ photos }}=' + (@(for ($i = 1; $i -lt $typed.Count; $i += 2) { $typed[$i] }) -join '|')) }
{% if script.folders %}
    $null = New-Item -ItemType Directory -Force -Path {{ script.folders }}
{% endif %}
    # `{{ function }} {{ share.verb }}`: an album's copies to send go to one fixed folder, mounted for this command only (0296).
    $share = @()
    if ($command -eq '{{ share.verb }}') {
        $null = New-Item -ItemType Directory -Force -Path "{{ share.host }}"
        $share = @('-v', "{{ share.host }}:{{ share.point }}")
    }
    # `{{ function }} backup` / `restore`: the archives of the index, mounted for these commands only (0352).
    # A copy goes to, or comes from, --to/--from or the push target; refused while mh runs (0414, 0419).
    $keep = $null
    if ($command -in @({{ listed(keep.verbs) }})) {
        $keep = _{{ function }}_keep_before $command $rest
        if ($null -eq $keep) { return }  # said, its exit code set
        $rest = @($keep.rest)
        $share = @('-v', "{{ keep.host }}:{{ keep.point }}")
    }
    $status = 1
    $follow = $false
    $browser = $null
    $console = [Console]::OutputEncoding
    try {
        # The image writes UTF-8: accents and emojis readable in any console (0184).
        try { [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false) } catch { }
        $OutputEncoding = [Console]::OutputEncoding
        if ($long) {
            # The computer stays awake until the command ends; the screen may turn off (0179).
            if (-not ('MediaHygiene.Power' -as [type])) {
                Add-Type -Namespace MediaHygiene -Name Power -MemberDefinition '[DllImport("kernel32.dll")] public static extern uint SetThreadExecutionState(uint flags);'
            }
            # ES_CONTINUOUS (0x80000000) + ES_SYSTEM_REQUIRED (0x1), in decimal for PowerShell 5.1.
            $null = [MediaHygiene.Power]::SetThreadExecutionState([uint32]2147483649)
            $global:MediaHygieneTitle = $Host.UI.RawUI.WindowTitle
            $Host.UI.RawUI.WindowTitle = "{{ function }} $command..."
        }
        if ($page -and -not $global:MediaHygieneTab) {
            # The browser opens on the page as soon as it answers (0178); not from the loop of
            # `{{ function }}` alone once its tab is open: that tab follows each page (0280).
            $browser = Start-Job -ArgumentList 'http://127.0.0.1:{{ script.commands.port }}/', {{ script.commands.browse_wait }} -ScriptBlock {
                param($url, $wait)
                for ($i = 0; $i -lt $wait; $i++) {
                    try { $null = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 1 -ErrorAction Stop; break } catch { Start-Sleep -Seconds 1 }
                }
                if ($i -lt $wait) { Start-Process $url }
            }
        }
        docker run --rm @tty `
            -e "{{ variable }}={{ script.shell.value }}" `
            -e "{{ stamp.variable }}={{ stamp.value }}" `
            -e "{{ zone }}=$((Get-TimeZone).Id)" `
            -e "COLUMNS=$($Host.UI.RawUI.WindowSize.Width)" `
            @relay `
{% for option in script.environment %}
            {{ option }} `
{% endfor %}
{% for volume in script.data %}
            -v "{{ volume.host }}:{{ volume.point.as_posix() }}${mode}" `
{% endfor %}
            @photos `
{% for volume in script.backups %}
            -v "{{ volume.host }}:{{ volume.point.as_posix() }}:ro" `
{% endfor %}
            @($nas.mounts) `
            @(foreach ($volume in $source) { '-v'; "${volume}:ro" }) `
{% for volume in script.tools + script.drives %}
            -v "{{ volume.host }}:{{ volume.point.as_posix() }}" `
{% endfor %}
            @page `
            @share `
            @marks `
            {{ image }} @rest @backups @($nas.backups)
        $status = $LASTEXITCODE
        # The audit asked to review the files gone at once: a success, then that page.
        $follow = $command -eq 'audit' -and $status -eq {{ gone_review }}
        if ($follow) { $status = 0 }
    } finally {
        try { [Console]::OutputEncoding = $console } catch { }
        if ($detach) {
            # The server runs on: its tab, its stick and its NAS are released once it ended.
            $global:MediaHygieneHeld = @{ browser = $browser; shared = $shared; nas = $nas }
        } else {
            if ($browser) { Remove-Job -Job $browser -Force }
            if ($shared.mounted) { _{{ function }}_unmount $shared.mounted }
            if ($nas.volumes) { _{{ function }}_nas_release $nas.volumes }
        }
        if ($long) {
            # ES_CONTINUOUS alone: the computer may sleep again, Ctrl+C included.
            $null = [MediaHygiene.Power]::SetThreadExecutionState([uint32]2147483648)
            $Host.UI.RawUI.WindowTitle = if ($status -eq 0) { "{{ texts.done }}" } else { "{{ texts.failed }}" }
        }
    }
    if ($long) {
        if ($status -eq 0) { [Media.SystemSounds]::Asterisk.Play() } else { [Media.SystemSounds]::Hand.Play() }
    }
    if ($command -eq '{{ share.verb }}' -and $status -eq 0 -and -not ($rest | Where-Object { $_ -in @({{ listed(share.help_flags) }}) })) {
        # The album's folder and its zip, side by side in the Explorer (0296).
        Invoke-Item -LiteralPath "{{ share.host }}"
    }
    if ($keep -and $status -eq 0) { _{{ function }}_keep_after $keep }
    if ($status -ne 0) {
        # The container did not run or failed: Docker Desktop stopped is started, and the
        # command typed again by the user, never run twice by mh (a clean may have stopped
        # in the middle); the exit code stays the run's (0174, 0200).
        $ErrorActionPreference = 'Continue'
        $null = docker version 2>$null
        if ($LASTEXITCODE -ne 0 -and (_{{ function }}_desktop_start)) { Write-Host "{{ texts.ready }}" }
        $global:LASTEXITCODE = $status
    }
    if ($follow) { {{ function }} review --gone @typed }
}

# `{{ function }} open`: the catalogue of every report in the default browser (0175).
function global:_{{ function }}_open {
{% if host.index %}
    $index = "{{ host.index }}"
    if (-not (Test-Path -LiteralPath $index)) { Write-Host "{{ host.texts.no_report }}"; return }
    Invoke-Item -LiteralPath $index
{% else %}
    Write-Host "{{ host.texts.volume }}"
{% endif %}
}


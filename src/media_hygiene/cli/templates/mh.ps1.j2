{# The `mh` launcher for PowerShell: see services/launcher.py. #}
{% macro listed(names) %}{% for name in names %}'{{ name }}'{{ ", " if not loop.last }}{% endfor %}{% endmacro %}
{% macro quoted(names) %}{% for name in names %}"{{ name }}"{{ ", " if not loop.last }}{% endfor %}{% endmacro %}
{% for line in header %}
# {{ line }}
{% endfor %}
function global:{{ function }} {
    # The title a long run left in the taskbar goes back at the next call (0185).
    if ($null -ne $global:MediaHygieneTitle) {
        $Host.UI.RawUI.WindowTitle = $global:MediaHygieneTitle
        $global:MediaHygieneTitle = $null
    }
    if ($args.Count -eq 1 -and $args[0] -eq '{{ host.flag }}') {
        # Explorer wrote the folder after the comment ending the command (0181).
        $line = [Environment]::CommandLine
        $folder = $line.Substring($line.LastIndexOf('#" "') + 4).TrimEnd().TrimEnd('"')
        {{ function }} --photos $folder
        return
    }
    # --photos "E:\Folder": one more photo folder, for this command only.
    $given = @()
    $typed = @()
    $rest = @()
    for ($i = 0; $i -lt $args.Count; $i++) {
        if ($args[$i] -ne '--photos' -or $i + 1 -ge $args.Count) { $rest += $args[$i]; continue }
        $i++
        $folder = $args[$i]
        $found = Resolve-Path -LiteralPath $folder -ErrorAction SilentlyContinue
        if (-not $found -or $found.ProviderPath -notmatch '^[A-Za-z]:') { Write-Host "{{ texts.missing }}"; return }
        $typed += '--photos', $found.ProviderPath
        $full = $found.ProviderPath.TrimEnd('\')
        $given += "${full}:/data/" + $full.Substring(0, 1).ToLower() + ($full.Substring(2) -replace '\\', '/')
    }
    if ($rest.Count -eq 0) {
        # Alone: the menu lists the steps, the number chosen runs as `{{ function }} <step>`.
        # With --photos, the step chosen gets them too (0181).
        if ($typed.Count -gt 0) {
            $shown = @(for ($i = 1; $i -lt $typed.Count; $i += 2) { $typed[$i] }) -join ', '
            Write-Host "{{ texts.folder }}"
        }
        $color = @(if ($Host.UI.SupportsVirtualTerminal) { '--color', 'always' })
        Write-Host "{{ texts.reading }}"
        $steps = @({{ function }} @color menu)
        if ($LASTEXITCODE -ne 0 -or $steps.Count -eq 0) { return }
        $choice = "$(Read-Host "{{ texts.prompt }}")".Trim()
        if (-not $choice) { $choice = '0' }
        $chosen = ''
        foreach ($step in $steps) {
            $number, $line = "$step" -split "`t", 2
            if ($number -eq $choice) { $chosen = $line; break }
        }
        if (-not $chosen) {
            if ($choice -ne '0') { Write-Host "{{ texts.unknown }}" }
            return
        }
        Write-Host "{{ texts.direct }}"
        $words = -split $chosen
        {{ function }} @words @typed
        return
    }
    # The commands of the host itself, without the container (0175, 0180, 0181).
    # Splatted: each word its own argument, as typed.
    $more = @($rest | Select-Object -Skip 1)
    switch ($rest[0]) {
{% for name in host.names %}
        '{{ name }}' { _{{ function }}_{{ name }} @more; return }
{% endfor %}
    }
    foreach ($folder in @({{ quoted(checked) }})) {
        if (-not (Test-Path -LiteralPath $folder)) { Write-Host "{{ texts.missing }}"; return }
    }
    $command = $rest | Where-Object { $_ -in @({{ listed(script.commands.names) }}) } | Select-Object -First 1
    $mode = if ($command -in @({{ listed(script.commands.writers) }})) { '' } else { ':ro' }
    $page = if ($command -in @({{ listed(script.commands.pages) }})) { @('-p', '127.0.0.1:{{ script.commands.port }}:{{ script.commands.port }}') } else { @() }
    $tty = @(if ($command -notin @({{ listed(script.commands.data) }})) { '-it' })
    $long = $command -in @({{ listed(script.commands.long) }})
    $photos = @(foreach ($volume in $given) { '-v'; "$volume$mode" })
{% if script.folders %}
    $null = New-Item -ItemType Directory -Force -Path {{ script.folders }}
{% endif %}
    $status = 1
    $browser = $null
    $console = [Console]::OutputEncoding
    try {
        # The image writes UTF-8: accents and emojis readable in any console (0184).
        try { [Console]::OutputEncoding = [Text.UTF8Encoding]::new($false) } catch { }
        $OutputEncoding = [Console]::OutputEncoding
        if ($long) {
            # The computer stays awake until the command ends; the screen may turn off (0179).
            if (-not ('MediaHygiene.Power' -as [type])) {
                Add-Type -Namespace MediaHygiene -Name Power -MemberDefinition '[DllImport("kernel32.dll")] public static extern uint SetThreadExecutionState(uint flags);'
            }
            # ES_CONTINUOUS (0x80000000) + ES_SYSTEM_REQUIRED (0x1), in decimal for PowerShell 5.1.
            $null = [MediaHygiene.Power]::SetThreadExecutionState([uint32]2147483649)
            $global:MediaHygieneTitle = $Host.UI.RawUI.WindowTitle
            $Host.UI.RawUI.WindowTitle = "{{ function }} $command..."
        }
        if ($page) {
            # The browser opens on the page as soon as it answers (0178).
            $browser = Start-Job -ArgumentList 'http://127.0.0.1:{{ script.commands.port }}/', {{ script.commands.browse_wait }} -ScriptBlock {
                param($url, $wait)
                for ($i = 0; $i -lt $wait; $i++) {
                    try { $null = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 1 -ErrorAction Stop; break } catch { Start-Sleep -Seconds 1 }
                }
                if ($i -lt $wait) { Start-Process $url }
            }
        }
        docker run --rm @tty `
            -e "{{ variable }}={{ script.shell.value }}" `
            -e "{{ zone }}=$((Get-TimeZone).Id)" `
            -e "COLUMNS=$($Host.UI.RawUI.WindowSize.Width)" `
{% for option in script.environment %}
            {{ option }} `
{% endfor %}
{% for volume in script.data %}
            -v "{{ volume.host }}:{{ volume.point.as_posix() }}${mode}" `
{% endfor %}
            @photos `
{% for volume in script.tools + script.drives %}
            -v "{{ volume.host }}:{{ volume.point.as_posix() }}" `
{% endfor %}
            @page `
            {{ image }} @rest
        $status = $LASTEXITCODE
    } finally {
        try { [Console]::OutputEncoding = $console } catch { }
        if ($browser) { Remove-Job -Job $browser -Force }
        if ($long) {
            # ES_CONTINUOUS alone: the computer may sleep again, Ctrl+C included.
            $null = [MediaHygiene.Power]::SetThreadExecutionState([uint32]2147483648)
            $Host.UI.RawUI.WindowTitle = if ($status -eq 0) { "{{ texts.done }}" } else { "{{ texts.failed }}" }
        }
    }
    if ($long) {
        if ($status -eq 0) { [Media.SystemSounds]::Asterisk.Play() } else { [Media.SystemSounds]::Hand.Play() }
    }
    if ($status -ne 0) {
        # The container did not run or failed: Docker Desktop stopped says so in one line;
        # the exit code stays the run's (0174).
        $ErrorActionPreference = 'Continue'
        $null = docker version 2>$null
        if ($LASTEXITCODE -ne 0) { Write-Host "{{ texts.desktop }}" }
        $global:LASTEXITCODE = $status
    }
}

# `{{ function }} open`: the catalogue of every report in the default browser (0175).
function global:_{{ function }}_open {
{% if host.index %}
    $index = "{{ host.index }}"
    if (-not (Test-Path -LiteralPath $index)) { Write-Host "{{ host.texts.no_report }}"; return }
    Invoke-Item -LiteralPath $index
{% else %}
    Write-Host "{{ host.texts.volume }}"
{% endif %}
}

{% include 'mh_windows.ps1.j2' %}
{% include 'mh_folders.ps1.j2' %}

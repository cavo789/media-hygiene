{# The checks around docker run (0250, 0252): included by mh.ps1.j2; services/launcher_guards.py. #}
# A page left by a closed window keeps the port of the pages (0250): closing a console with
# its X ends the docker client, not the container. Each page carries the PID of its console
# and its start time (Windows gives a closed console's PID to another process); before a
# page, one whose console is gone (or is this one, idle) is stopped, said in one line; one
# whose console still runs is left alone, the user told to close it there.
# True once the port is free.
function global:_{{ function }}_page_free {
    $ErrorActionPreference = 'Continue'
    $port = {{ script.commands.port }}
    $held = @(docker ps --filter "publish={{ script.commands.port }}" --format '{% raw %}{{.ID}};{{.Labels}}{% endraw %}' 2>$null)
    $mark = '(^|,)' + [regex]::Escape('{{ guards.label }}') + '=powershell-(\d+)(-(\d*))?(,|$)'
    foreach ($line in $held) {
        $id, $labels = "$line" -split ';', 2
        if ("$id" -notmatch '^[0-9a-f]+$') { continue }  # a container id, nothing else
        $owner = 0
        $since = ''
        if ("$labels" -match $mark) { $owner = [int]$Matches[2]; $since = "$($Matches[4])" }
        if (-not $owner) { Write-Host "{{ guards.texts.held }}" -ForegroundColor Red; return $false }
        if ($owner -ne $PID -and (Get-Process -Id $owner -ErrorAction SilentlyContinue)) {
            # Live only when the start time matches; an unreadable one (or an older mh's
            # label without it) cannot prove the console gone: left alone.
            $started = _{{ function }}_started $owner
            if (-not $since -or -not $started -or $started -eq $since) { Write-Host "{{ guards.texts.open }}" -ForegroundColor Red; return $false }
        }
        $null = docker stop $id 2>$null
        Write-Host "{{ guards.texts.stopped }}"
    }
    # The port itself is not read here: Docker is tried first, the port diagnosed only
    # when it refuses to bind (0543, _{{ function }}_port_wait).
    return $true
}

# Docker refused to bind the port of the pages (0543): a program listening on it (another
# local server) is named, in red, never retried (0253); a socket being released (PID 0, a
# process gone: an mh page stopped a moment ago) says one line once, then `docker run` is
# tried again every second up to the limit (0503), then refused in red. $wait carries the
# state between tries ($null the first time); .again tells whether to try again.
function global:_{{ function }}_port_wait($wait) {
    $port = {{ script.commands.port }}
    if (-not $wait) { $wait = @{ until = (Get-Date).AddSeconds({{ guards.port.wait }}); said = $false; again = $true } }
    $holder = _{{ function }}_port_holder
    if ($holder -and $holder.name) {
        $name = $holder.name
        $process = $holder.process
        Write-Host "{{ guards.port.busy }}" -ForegroundColor Red
        $wait.again = $false
        return $wait
    }
    if ((Get-Date) -ge $wait.until) { Write-Host "{{ guards.port.released }}" -ForegroundColor Red; $wait.again = $false; return $wait }
    if (-not $wait.said) { Write-Host "{{ guards.port.releasing }}"; $wait.said = $true }
    Start-Sleep -Milliseconds {{ guards.port.poll }}
    return $wait
}

# What Docker said on standard error, shown again as typed, without PowerShell's own
# decoration of a native command's error lines (0543).
function global:_{{ function }}_replay([string[]]$said) {
    foreach ($line in $said) {
        if ($line -match '^(At line:|At .+:\d+ char:\d+|\s*\+ |\s*$)') { continue }
        [Console]::Error.WriteLine(($line -replace '^docker : ', ''))
    }
}

# Who listens on the port of the pages: $null when nobody but Docker; @{ name; process }
# for another program; @{ name = '' } for a socket being released. PID 0 is the System
# Idle Process: Windows names it for a socket whose owner has exited (0503); PID 4
# (System, http.sys) is a real holder.
function global:_{{ function }}_port_holder {
    $releasing = $false
    foreach ($socket in @(Get-NetTCPConnection -LocalPort {{ script.commands.port }} -State Listen -ErrorAction SilentlyContinue)) {
        $process = $socket.OwningProcess
        $found = if ($process) { Get-Process -Id $process -ErrorAction SilentlyContinue } else { $null }
        if (-not $found) { $releasing = $true; continue }
        $name = "$($found.ProcessName)"
        if ($name -and $name -notin @({% for name in guards.port.listeners %}'{{ name }}'{{ ", " if not loop.last }}{% endfor %})) { return @{ name = $name; process = $process } }
    }
    if ($releasing) { return @{ name = '' } }
    return $null
}

# The start time of a process, UTC, written the same in every language; '' when unreadable.
function global:_{{ function }}_started([int]$id) {
    try { return (Get-Process -Id $id -ErrorAction Stop).StartTime.ToUniversalTime().ToString('yyyyMMddHHmmss', [Globalization.CultureInfo]::InvariantCulture) } catch { return '' }
}

# A removable drive (a USB stick) is not shared by WSL: Docker Desktop would mount an empty
# folder of its own disk instead (0252). Mounted in its VM here (wsl.exe only), said in one
# line; a failure stops the command with the advice. C: is never removable: not asked.
# The drives it mounted itself (exit 0; 10: mounted already, by another window or by hand)
# and a label per removable drive for the container; $null when a drive cannot be seen.
function global:_{{ function }}_removable([string[]]$folders) {
    $ErrorActionPreference = 'Continue'
    $shared = @{ mounted = @(); labels = @() }
    $drives = @($folders | Where-Object { "$_" -match '^[A-Za-z]:' } | ForEach-Object { "$_".Substring(0, 1).ToUpper() } | Where-Object { $_ -ne 'C' } | Sort-Object -Unique)
    foreach ($drive in $drives) {
        $volume = Get-Volume -DriveLetter $drive -ErrorAction SilentlyContinue
        if (-not $volume -or "$($volume.DriveType)" -ne 'Removable') { continue }
        $letter = $drive.ToLower()
        $null = wsl.exe -d {{ guards.distro }} sh -c "mountpoint -q /mnt/host/$letter && exit 10; mkdir -p /mnt/host/$letter && mount -t drvfs ${drive}: /mnt/host/$letter" 2>$null
        if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne 10) {
            Write-Host "{{ guards.texts.unshared }}" -ForegroundColor Red
            _{{ function }}_unmount $shared.mounted
            return $null
        }
        if ($LASTEXITCODE -eq 0) { $shared.mounted += $letter }
        $shared.labels += '--label', "{{ guards.drive }}.$letter=1"
        Write-Host "{{ guards.texts.shared }}"
    }
    return $shared
}

# After the run, a drive mounted by this run is unmounted, so that Windows can eject the
# stick (0252); left while another mh container uses it (its label), or when Docker cannot
# tell. A failure says one line; the exit code stays the run's.
function global:_{{ function }}_unmount([string[]]$letters) {
    $ErrorActionPreference = 'Continue'
    $status = $global:LASTEXITCODE
    foreach ($letter in $letters) {
        $drive = $letter.ToUpper()
        $users = @(docker ps -q --filter "label={{ guards.drive }}.$letter" 2>$null)
        if ($LASTEXITCODE -ne 0) { continue }
        if ($users.Count -gt 0) { Write-Host "{{ guards.texts.kept }}"; continue }
        $null = wsl.exe -d {{ guards.distro }} umount /mnt/host/$letter 2>$null
        if ($LASTEXITCODE -ne 0) { Write-Host "{{ guards.texts.stuck }}" }
    }
    $global:LASTEXITCODE = $status
}

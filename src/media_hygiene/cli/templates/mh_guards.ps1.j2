{# The checks before docker run (0250, 0252): included by mh.ps1.j2; services/launcher_guards.py. #}
# A page left by a closed window keeps the port of the pages (0250): closing a console with
# its X ends the docker client, not the container. Each page carries the PID of its console;
# before a page, one whose console is gone (or is this one, idle) is stopped, said in one
# line; one whose console still runs is left alone, the user told to close it there.
# True once the port is free.
function global:_{{ function }}_page_free {
    $ErrorActionPreference = 'Continue'
    $held = @(docker ps --filter "publish={{ script.commands.port }}" --format '{% raw %}{{.ID}};{{.Labels}}{% endraw %}' 2>$null)
    $mark = '(^|,)' + [regex]::Escape('{{ guards.label }}') + '=powershell-(\d+)(,|$)'
    foreach ($line in $held) {
        $id, $labels = "$line" -split ';', 2
        if ("$id" -notmatch '^[0-9a-f]+$') { continue }  # a container id, nothing else
        $owner = if ("$labels" -match $mark) { [int]$Matches[2] } else { 0 }
        if (-not $owner) { Write-Host "{{ guards.texts.held }}"; return $false }
        if ($owner -ne $PID -and (Get-Process -Id $owner -ErrorAction SilentlyContinue)) { Write-Host "{{ guards.texts.open }}"; return $false }
        $null = docker stop $id 2>$null
        Write-Host "{{ guards.texts.stopped }}"
    }
    return $true
}

# A removable drive (a USB stick) is not shared by WSL: Docker Desktop would mount an empty
# folder of its own disk instead (0252). Mounted in its VM here (wsl.exe only), said in one
# line; a failure stops the command with the advice. C: is never removable: not asked.
# True when every drive given can be seen.
function global:_{{ function }}_removable([string[]]$folders) {
    $ErrorActionPreference = 'Continue'
    $drives = @($folders | Where-Object { "$_" -match '^[A-Za-z]:' } | ForEach-Object { "$_".Substring(0, 1).ToUpper() } | Where-Object { $_ -ne 'C' } | Sort-Object -Unique)
    foreach ($drive in $drives) {
        $volume = Get-Volume -DriveLetter $drive -ErrorAction SilentlyContinue
        if (-not $volume -or "$($volume.DriveType)" -ne 'Removable') { continue }
        $letter = $drive.ToLower()
        $null = wsl.exe -d {{ guards.distro }} sh -c "mountpoint -q /mnt/host/$letter || { mkdir -p /mnt/host/$letter && mount -t drvfs ${drive}: /mnt/host/$letter; }" 2>$null
        if ($LASTEXITCODE -ne 0) { Write-Host "{{ guards.texts.unshared }}"; return $false }
        Write-Host "{{ guards.texts.shared }}"
    }
    return $true
}

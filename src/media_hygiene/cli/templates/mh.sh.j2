{# The `mh` launcher for bash (WSL, Linux, macOS): see services/launcher.py. #}
{% for line in header %}
# {{ line }}
{% endfor %}
# One command of `{{ function }}`: the host's own, or the container's.
{{ function }}() {
    local command="" mode=":ro" arg folder zone="${TZ:-}" long="" browser="" status=0
    local tty=(-i) page=() given=() typed=() rest=() photos=() zoned=() awake=() relay=()
    local backups=()
    _{{ function }}_given "$@" || return  # --photos /mnt/e/Folder, for this command only
    set -- "${rest[@]}"
    if [[ $# -eq 0 ]]; then
        # Alone: the home page, the steps chosen there run here (0210); with --photos,
        # the step chosen gets them too (0181).
        _{{ function }}_home "${typed[@]}"
        return
    fi
    if [[ $# -eq 1 && "$1" == menu ]]; then
        # `{{ function }} menu`: the steps in this terminal, a number read (0172).
        _{{ function }}_menu "${typed[@]}"
        return
    fi
    # The commands of the host itself, without the container (0175, 0180, 0181).
    case "$1" in
{% for name in host.names %}
        {{ name }}) _{{ function }}_{{ name }} "${@:2}"; return ;;
{% endfor %}
    esac
{% if checked %}
    for folder in {% for folder in checked %}"{{ folder }}"{{ " " if not loop.last }}{% endfor %}; do
        _{{ function }}_drive "$folder" || return 2
        if [[ ! -d "$folder" ]]; then printf '%s\n' "{{ texts.missing }}" >&2; return 2; fi
    done
{% endif %}
    for arg in "$@"; do
        case " {{ script.commands.names | join(" ") }} " in
            *" $arg "*) command="$arg"; break ;;
        esac
    done
    case " {{ script.commands.writers | join(" ") }} " in
        *" $command "*) mode="" ;;
    esac
    case " {{ script.commands.pages | join(" ") }} " in
        # The port mh publishes is the one the page listens on, config.toml changed or not (0260).
        *" $command "*) page=(-p "127.0.0.1:{{ script.commands.port }}:{{ script.commands.port }}" -e "MEDIA_HYGIENE_REVIEW__PORT={{ script.commands.port }}") ;;
    esac
    if [[ -n "${page[*]}" ]]; then
        # A page left by a closed terminal holds the port: stopped when its shell is gone (0250).
        _{{ function }}_page_free || return 1
        page+=(--label "{{ guards.label }}=bash-$$-$(_{{ function }}_started $$)")
    fi
    case " {{ script.commands.data | join(" ") }} " in
        *" $command "*) tty=() ;;
        *) if [[ -t 0 && -t 1 ]]; then tty=(-it); fi ;;
    esac
    case " {{ script.commands.long | join(" ") }} " in
        *" $command "*) long=1 ;;
    esac
    for folder in "${given[@]}"; do photos+=(-v "$folder$mode"); done
{% if script.backups %}
    # The backups: mounted read-only below, whatever the command; given to those taking them (0205).
    case " {{ script.commands.backups | join(" ") }} " in
        *" $command "*) backups=({% for volume in script.backups %}--backup "{{ volume.point.as_posix() }}"{{ " " if not loop.last }}{% endfor %}) ;;
    esac
{% endif %}
    # Only the loop of `{{ function }}` alone reads the step chosen on the home page (0210),
    # or on a page it opened (browse's Apply now, 0243).
    if [[ -n "${_{{ function }}_relay:-}" && " {{ relayed | join(" ") }} " == *" $command "* ]]; then relay=(-e "{{ relay }}={{ relay_fields if host.step_file else 1 }}"); fi
    # The host's own zone, unless TZ says one: /etc/localtime links to it.
    if [[ -z "$zone" && -L /etc/localtime ]]; then
        zone="$(readlink /etc/localtime)"
        zone="${zone#*zoneinfo/}"
    fi
    if [[ -n "$zone" ]]; then zoned=(-e "TZ=$zone"); fi
    # The width of this terminal: the menu's output is read, not shown on a terminal.
    if [[ -n "${COLUMNS:-}" ]]; then zoned+=(-e "COLUMNS=$COLUMNS"); fi
{% if script.folders %}
    mkdir -p {{ script.folders }}
{% endif %}
    if [[ -n "$long" ]]; then
        read -r -a awake <<< "$(_{{ function }}_awake "$command")"
        _{{ function }}_title "{{ function }} $command..."
    fi
    if [[ -n "${page[*]}" ]]; then
        # The browser opens on the page as soon as it answers (0178).
        { _{{ function }}_browse {{ script.commands.port }} {{ script.commands.browse_wait }} & } 2>/dev/null
        browser=$!
        disown "$browser" 2>/dev/null
    fi
    "${awake[@]}" docker run --rm "${tty[@]}" --user "$(id -u):$(id -g)" \
        -e "{{ variable }}={{ script.shell.value }}" \
        "${zoned[@]}" "${relay[@]}" \
{% for option in script.environment %}
        {{ option }} \
{% endfor %}
{% for volume in script.data %}
        -v "{{ volume.host }}:{{ volume.point.as_posix() }}${mode}" \
{% endfor %}
        "${photos[@]}" \
{% for volume in script.backups %}
        -v "{{ volume.host }}:{{ volume.point.as_posix() }}:ro" \
{% endfor %}
{% for volume in script.tools + script.drives %}
        -v "{{ volume.host }}:{{ volume.point.as_posix() }}" \
{% endfor %}
        "${page[@]}" \
        {{ image }} "$@" "${backups[@]}" || status=$?
    if [[ -n "$browser" ]]; then kill "$browser" 2>/dev/null; fi
    if [[ -n "$long" ]]; then
        if [[ "$status" -eq 0 ]]; then
            _{{ function }}_title "{{ texts.done }}" $'\a'
        else
            _{{ function }}_title "{{ texts.failed }}" $'\a'
        fi
    fi
    # The container did not run or failed: a stopped Docker says so in one line (0174).
    if [[ "$status" -ne 0 ]] && ! docker version >/dev/null 2>&1; then
        printf '%s\n' "{{ texts.daemon }}" >&2
    fi
    return "$status"
}

{% include 'mh_host.sh.j2' %}

{% include 'mh_guards.sh.j2' %}

{% include 'mh_drives.sh.j2' %}
{% for name in host.windows %}

# `{{ function }} {{ name }}` writes a Windows shortcut or registry key, or reads a phone: mh.ps1
# only (0180, 0181, 0219).
_{{ function }}_{{ name }}() {
    set -- {{ name }}
    printf '%s\n' "{{ host.texts.windows }}" >&2
    return 2
}
{% endfor %}

# `{{ function }}` alone: the home page. A step chosen there ends it with {{ step_base }} + n; it runs
# here as `{{ function }} <step>`, its questions in this terminal, then the page comes back.
# A page a step opened may end the same way (browse's Apply now, 0243): that step runs next.
# Quit, Ctrl+C or an error end the loop with the page's exit code (0210).
_{{ function }}_home() {
    local _{{ function }}_relay=1 status=0 after=0 steps number line chosen words=() color=(--color never)
    if [[ -t 2 ]]; then color=(--color always); fi
    while true; do
        if [[ "$status" -eq {{ page_closed }} ]]; then return 0; fi  # its tab closed (0262)
        if [[ "$status" -le {{ step_base }} ]]; then
            status=0
            after=0
            {{ function }} home "$@" || status=$?
            if [[ "$status" -le {{ step_base }} ]]; then return "$status"; fi
        fi
{% if host.step_file %}
        # A step with fields (0266): the page wrote its words, one per line, read once.
        if [[ "$status" -eq {{ fields_code }} && -f "{{ host.step_file }}" ]]; then
            words=()
            while IFS= read -r line; do
                if [[ "$line" =~ ^\"(.*)\",?$ && "$line" != '"words":'* ]]; then
                    words+=("${BASH_REMATCH[1]//\\\\/\\}")
                fi
            done < "{{ host.step_file }}"
            rm -f -- "{{ host.step_file }}"
            chosen="${words[*]}"
            printf '%s\n' "{{ texts.direct }}" >&2
            status=0
            after=1
            {{ function }} "${words[@]}" "$@" || status=$?
            continue
        fi
{% endif %}
        steps="$({{ function }} "${color[@]}" menu)" || return
        chosen=""
        while IFS=$'\t' read -r number line; do
            if [[ "$number" == "$((status - {{ step_base }}))" ]]; then chosen="$line"; break; fi
        done <<< "$steps"
        if [[ -z "$chosen" && "$after" == 1 ]]; then status=0; continue; fi
        if [[ -z "$chosen" ]]; then return "$status"; fi
        printf '%s\n' "{{ texts.direct }}" >&2
        read -r -a words <<< "$chosen"
        status=0
        after=1
        {{ function }} "${words[@]}" "$@" || status=$?
    done
}

# `{{ function }} menu`: the menu lists the steps, the number chosen runs as
# `{{ function }} <step>`, with the --photos given to it, if any (0181).
_{{ function }}_menu() {
    local steps number line choice="" chosen="" color=(--color never) words=() shown="" index
    if [[ -t 2 ]]; then color=(--color always); fi
    for ((index = 2; index <= $#; index += 2)); do shown+="${shown:+, }${!index}"; done
    if [[ -n "$shown" ]]; then printf '%s\n' "{{ texts.folder }}" >&2; fi
    printf '%s\n' "{{ texts.reading }}" >&2
    steps="$({{ function }} "${color[@]}" menu)" || return
    read -r -p "{{ texts.prompt }}: " choice || return 0
    choice="${choice:-0}"
    while IFS=$'\t' read -r number line; do
        if [[ "$number" == "$choice" ]]; then chosen="$line"; break; fi
    done <<< "$steps"
    if [[ -z "$chosen" ]]; then
        if [[ "$choice" == 0 ]]; then return 0; fi
        printf '%s\n' "{{ texts.unknown }}" >&2
        return 2
    fi
    printf '%s\n' "{{ texts.direct }}" >&2
    read -r -a words <<< "$chosen"
    {{ function }} "${words[@]}" "$@"
}
{% include 'mh_folders.sh.j2' %}

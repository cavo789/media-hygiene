{# The `mh` launcher for bash (WSL, Linux, macOS): see services/launcher.py. #}
{% for line in header %}
# {{ line }}
{% endfor %}
{{ function }}() {
    local command="" mode=":ro" arg folder zone="${TZ:-}" long="" browser="" status=0
    local tty=(-i) page=() given=() typed=() rest=() photos=() zoned=() awake=()
    # --photos /mnt/e/Folder: one more photo folder, for this command only.
    while [[ $# -gt 0 ]]; do
        if [[ "$1" != --photos || $# -lt 2 ]]; then rest+=("$1"); shift; continue; fi
        folder="$2"
        shift 2
        if [[ ! -d "$folder" ]]; then printf '%s\n' "{{ texts.missing }}" >&2; return 2; fi
        folder="$(cd "$folder" && pwd -P)"
        typed+=(--photos "$folder")
        if [[ "$folder" =~ ^/mnt/([a-z])(/.*)?$ ]]; then
            given+=("$folder:/data/${BASH_REMATCH[1]}${BASH_REMATCH[2]}")
        else
            given+=("$folder:/data$folder")
        fi
    done
    set -- "${rest[@]}"
    if [[ $# -eq 0 ]]; then
        # Alone: the menu; with --photos, the step chosen gets them too (0181).
        _{{ function }}_menu "${typed[@]}"
        return
    fi
    # The commands of the host itself, without the container (0175, 0180, 0181).
    case "$1" in
{% for name in host.names %}
        {{ name }}) _{{ function }}_{{ name }} "${@:2}"; return ;;
{% endfor %}
    esac
{% if checked %}
    for folder in {% for folder in checked %}"{{ folder }}"{{ " " if not loop.last }}{% endfor %}; do
        if [[ ! -d "$folder" ]]; then printf '%s\n' "{{ texts.missing }}" >&2; return 2; fi
    done
{% endif %}
    for arg in "$@"; do
        case " {{ script.commands.names | join(" ") }} " in
            *" $arg "*) command="$arg"; break ;;
        esac
    done
    case " {{ script.commands.writers | join(" ") }} " in
        *" $command "*) mode="" ;;
    esac
    case " {{ script.commands.pages | join(" ") }} " in
        *" $command "*) page=(-p "127.0.0.1:{{ script.commands.port }}:{{ script.commands.port }}") ;;
    esac
    case " {{ script.commands.data | join(" ") }} " in
        *" $command "*) tty=() ;;
        *) if [[ -t 0 && -t 1 ]]; then tty=(-it); fi ;;
    esac
    case " {{ script.commands.long | join(" ") }} " in
        *" $command "*) long=1 ;;
    esac
    for folder in "${given[@]}"; do photos+=(-v "$folder$mode"); done
    # The host's own zone, unless TZ says one: /etc/localtime links to it.
    if [[ -z "$zone" && -L /etc/localtime ]]; then
        zone="$(readlink /etc/localtime)"
        zone="${zone#*zoneinfo/}"
    fi
    if [[ -n "$zone" ]]; then zoned=(-e "TZ=$zone"); fi
{% if script.folders %}
    mkdir -p {{ script.folders }}
{% endif %}
    if [[ -n "$long" ]]; then
        read -r -a awake <<< "$(_{{ function }}_awake "$command")"
        _{{ function }}_title "{{ function }} $command..."
    fi
    if [[ -n "${page[*]}" ]]; then
        # The browser opens on the page as soon as it answers (0178).
        { _{{ function }}_browse {{ script.commands.port }} {{ script.commands.browse_wait }} & } 2>/dev/null
        browser=$!
        disown "$browser" 2>/dev/null
    fi
    "${awake[@]}" docker run --rm "${tty[@]}" --user "$(id -u):$(id -g)" \
        -e "{{ variable }}={{ script.shell.value }}" \
        "${zoned[@]}" \
{% for option in script.environment %}
        {{ option }} \
{% endfor %}
{% for volume in script.data %}
        -v "{{ volume.host }}:{{ volume.point.as_posix() }}${mode}" \
{% endfor %}
        "${photos[@]}" \
{% for volume in script.tools + script.drives %}
        -v "{{ volume.host }}:{{ volume.point.as_posix() }}" \
{% endfor %}
        "${page[@]}" \
        {{ image }} "$@" || status=$?
    if [[ -n "$browser" ]]; then kill "$browser" 2>/dev/null; fi
    if [[ -n "$long" ]]; then
        if [[ "$status" -eq 0 ]]; then
            _{{ function }}_title "{{ texts.done }}" $'\a'
        else
            _{{ function }}_title "{{ texts.failed }}" $'\a'
        fi
    fi
    return "$status"
}

# A long run keeps the computer awake (0179): systemd-inhibit on Linux, caffeinate on
# macOS; nothing on WSL, where Windows decides. Prints the words to put before docker.
_{{ function }}_awake() {
    if [[ -z "${WSL_DISTRO_NAME:-}" ]] && command -v systemd-inhibit >/dev/null 2>&1 &&
        systemd-inhibit --list >/dev/null 2>&1; then
        printf '%s ' systemd-inhibit --what=sleep --who=media-hygiene "--why=$1" --
    elif command -v caffeinate >/dev/null 2>&1; then
        printf '%s ' caffeinate -i
    fi
}

# The window title says what runs, then how it ended, with a bell (0185).
_{{ function }}_title() {
    if [[ -t 2 ]]; then printf '\e]0;%s\a%s' "$1" "${2:-}" >&2; fi
}

# Wait until the page answers on the port, then open the browser on it (0178).
_{{ function }}_browse() {
    local port="$1" tries="$2" opener line
    opener="$(_{{ function }}_opener)"
    if [[ -z "$opener" ]]; then return 0; fi
    while [[ "$tries" -gt 0 ]]; do
        tries=$((tries - 1))
        line=""
        {
            printf 'GET / HTTP/1.1\r\nHost: 127.0.0.1:%s\r\nConnection: close\r\n\r\n' "$port" >&3
            IFS= read -r -t 2 line <&3
        } 2>/dev/null 3<>"/dev/tcp/127.0.0.1/$port"
        if [[ "$line" == HTTP/* ]]; then
            "$opener" "http://127.0.0.1:$port/" >/dev/null 2>&1
            return 0
        fi
        sleep 1
    done
}

# The program opening a page or a file: wslview or explorer.exe on WSL, xdg-open on
# Linux, open on macOS; nothing printed when none is there.
_{{ function }}_opener() {
    local opener
    for opener in wslview explorer.exe xdg-open; do
        if command -v "$opener" >/dev/null 2>&1; then
            printf '%s' "$opener"
            return 0
        fi
    done
    if [[ "$OSTYPE" == darwin* ]]; then printf '%s' open; fi
}

# `{{ function }} open`: the catalogue of every report in the browser (0175).
_{{ function }}_open() {
{% if host.index %}
    local index="{{ host.index }}" opener
    if [[ ! -f "$index" ]]; then printf '%s\n' "{{ host.texts.no_report }}" >&2; return 1; fi
    opener="$(_{{ function }}_opener)"
    if [[ -z "$opener" ]]; then printf '%s\n' "{{ host.texts.no_opener }}" >&2; return 1; fi
    if [[ "$opener" == explorer.exe ]]; then index="$(wslpath -w "$index")"; fi
    # explorer.exe says 1 even when it opened the page.
    "$opener" "$index" >/dev/null 2>&1 || true
{% else %}
    printf '%s\n' "{{ host.texts.volume }}" >&2
    return 1
{% endif %}
}
{% for name in host.windows %}

# `{{ function }} {{ name }}` writes a Windows shortcut or registry key: mh.ps1 only (0180, 0181).
_{{ function }}_{{ name }}() {
    set -- {{ name }}
    printf '%s\n' "{{ host.texts.windows }}" >&2
    return 2
}
{% endfor %}

# `{{ function }}` alone: the menu lists the steps, the number chosen runs as
# `{{ function }} <step>`, with the --photos given to it, if any (0181).
_{{ function }}_menu() {
    local steps number line choice="" chosen="" color=() words=() shown="" index
    if [[ -t 2 ]]; then color=(--color always); fi
    for ((index = 2; index <= $#; index += 2)); do shown+="${shown:+, }${!index}"; done
    if [[ -n "$shown" ]]; then printf '%s\n' "{{ texts.folder }}" >&2; fi
    steps="$({{ function }} "${color[@]}" menu)" || return
    read -r -p "{{ texts.prompt }}: " choice || return 0
    choice="${choice:-0}"
    while IFS=$'\t' read -r number line; do
        if [[ "$number" == "$choice" ]]; then chosen="$line"; break; fi
    done <<< "$steps"
    if [[ -z "$chosen" ]]; then
        if [[ "$choice" == 0 ]]; then return 0; fi
        printf '%s\n' "{{ texts.unknown }}" >&2
        return 2
    fi
    printf '%s\n' "{{ texts.direct }}" >&2
    read -r -a words <<< "$chosen"
    {{ function }} "${words[@]}" "$@"
}
{% include 'mh_folders.sh.j2' %}

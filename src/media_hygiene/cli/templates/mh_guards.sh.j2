{# The check before a page (0250): included by mh.sh.j2; services/launcher_guards.py. #}
# A page left by a closed terminal keeps the port of the pages (0250): closing a terminal
# ends the docker client, not the container. Each page carries the PID of its shell and
# its start time (a PID is given again once free); before a page, one whose shell is gone
# (or is this one, idle) is stopped, said in one line; one whose shell still runs is left
# alone, the user told to close it there.
_{{ function }}_page_free() {
    local port={{ script.commands.port }} line id labels owner since started pattern='(^|,){{ guards.label | replace(".", "[.]") }}=bash-([0-9]+)(-([0-9]*))?(,|$)'
    while IFS= read -r line; do
        id="${line%%;*}"
        labels="${line#*;}"
        if [[ ! "$id" =~ ^[0-9a-f]+$ ]]; then continue; fi  # a container id, nothing else
        if [[ ! "$labels" =~ $pattern ]]; then
            _{{ function }}_refuse "{{ guards.texts.held }}"
            return 1
        fi
        owner="${BASH_REMATCH[2]}"
        since="${BASH_REMATCH[4]}"
        # Live: another shell with this PID, started when the page was (an older mh's
        # label has no start time: the PID alone, as before).
        if [[ "$owner" != "$$" ]] && started="$(_{{ function }}_started "$owner")" \
            && [[ -z "$since" || "$started" == "$since" ]]; then
            _{{ function }}_refuse "{{ guards.texts.open }}"
            return 1
        fi
        docker stop "$id" >/dev/null 2>&1
        printf '%s\n' "{{ guards.texts.stopped }}" >&2
    done < <(docker ps --filter "publish={{ script.commands.port }}" --format '{% raw %}{{.ID}};{{.Labels}}{% endraw %}' 2>/dev/null)
    # The port itself is not read here: Docker is tried first (0543).
    return 0
}

# Docker refused to bind the port of the pages (0543): a program listening on it (another
# local server) is named, never Docker's raw "address already in use" (0253). ss tells the program of a
# socket of this user only; without ss, or for another user's, Docker says it. Linux
# closes a listening socket when its process exits: no "being released" wait as in
# mh.ps1 (0503); Docker's own docker-proxy, still there a moment, is not another program.
_{{ function }}_port_user() {
    local port={{ script.commands.port }} said name process pattern='users:\(\("([^"]+)",pid=([0-9]+)'
    if ! command -v ss >/dev/null 2>&1; then return 0; fi
    said="$(ss -ltnp "sport = :{{ script.commands.port }}" 2>/dev/null)"
    if [[ ! "$said" =~ $pattern ]]; then return 0; fi
    name="${BASH_REMATCH[1]}"
    process="${BASH_REMATCH[2]}"
    case " {{ guards.port.listeners | join(" ") }} " in
        *" $name "*) return 0 ;;
    esac
    _{{ function }}_refuse "{{ guards.port.busy }}"
    return 1
}

# The start time of a process, in clock ticks since boot (field 22 of /proc/<pid>/stat,
# read after the command name, which may hold spaces); fails when the process is gone.
# Without /proc (not Linux): empty, the PID alone tells.
_{{ function }}_started() {
    local stat fields
    if [[ ! -r /proc/self/stat ]]; then ps -p "$1" >/dev/null 2>&1; return; fi
    stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
    read -ra fields <<< "${stat##*) }"
    printf '%s' "${fields[19]}"
}

# A refusal: in red when standard error is a terminal (0503), the plain line otherwise.
_{{ function }}_refuse() {
    if [[ -t 2 ]] && command -v tput >/dev/null 2>&1; then
        printf '%s%s%s\n' "$(tput setaf 1 2>/dev/null)" "$1" "$(tput sgr0 2>/dev/null)" >&2
    else
        printf '%s\n' "$1" >&2
    fi
}

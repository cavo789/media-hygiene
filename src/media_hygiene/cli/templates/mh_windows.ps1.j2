{# `mh shortcut` and `mh explorer` in mh.ps1: see services/launcher_host.py. #}
# What the icon and the right-click entry start: Windows PowerShell loading this very
# file, then `{{ function }}` with the words given; the window stays open (0180, 0181).
# The user's own execution policy loads it (RemoteSigned, step 1 of the guides): an
# antivirus stopped a start that overrode it (0257). When it is refused, `{{ function }}`
# says the line to type instead of PowerShell's error. The words stay last: Explorer's
# folder follows them after a comment (`#`).
# Returns the program, then its arguments; nothing when this file is unknown.
function global:_{{ function }}_start($words) {
    $file = $MyInvocation.MyCommand.ScriptBlock.File
    if (-not $file -or -not (Test-Path -LiteralPath $file)) { Write-Host "{{ host.texts.no_file }}"; return }
    Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
    $load = "try { . '" + $file.Replace("'", "''") + "' } catch { function global:{{ function }} { Write-Host '{{ launch.policy }}' } }"
    '-NoExit -Command "' + $load + '; ' + $words + '"'
}

# A shortcut or a right-click entry made by an older mh starts this very file with another
# command (the policy overridden, before 0257), or a shortcut its window not minimised (0284):
# each one there is written again, read back and said in one line, when this file is loaded
# (mh update, mh folders, launcher).
# One naming another mh.ps1, or none, is left alone; nothing is created here.
function global:_{{ function }}_refresh {
    $file = $MyInvocation.MyCommand.ScriptBlock.File
    if ($env:OS -ne 'Windows_NT' -or -not $file) { return }
    $named = "'" + $file.Replace("'", "''") + "'"
    $powershell, $arguments = _{{ function }}_start '{{ function }}'
    $shell = New-Object -ComObject WScript.Shell
    foreach ($place in 'Desktop', 'Programs') {
        $path = Join-Path ([Environment]::GetFolderPath($place)) '{{ host.label }}.lnk'
        if (-not (Test-Path -LiteralPath $path)) { continue }
        $link = $shell.CreateShortcut($path)
        if (-not $link.Arguments.Contains($named) -or ($link.Arguments -eq $arguments -and $link.WindowStyle -eq {{ host.minimised }})) { continue }
        $link.TargetPath = $powershell
        $link.Arguments = $arguments
        $link.WindowStyle = {{ host.minimised }}
        $reason = ''
        $denied = $false
        try { $link.Save() } catch { $reason, $denied = _{{ function }}_why $_ }
        $back = $shell.CreateShortcut($path)
        _{{ function }}_said ($back.Arguments -eq $arguments -and $back.WindowStyle -eq {{ host.minimised }}) $reason $denied
    }
    $null, $arguments = _{{ function }}_start '{{ function }} {{ host.flag }} #" "%V'
    $command = '"' + $powershell + '" ' + $arguments
    foreach ($key in '{{ host.key }}', '{{ host.background }}') {
        $path = "$key\command"
        $item = Get-Item -LiteralPath $path -ErrorAction SilentlyContinue
        $read = if ($item) { "$($item.GetValue(''))" } else { '' }
        if (-not $read.Contains($named) -or $read -eq $command) { continue }
        $reason = ''
        $denied = $false
        try { $null = New-Item -Path $path -Value $command -Force -ErrorAction Stop } catch { $reason, $denied = _{{ function }}_why $_ }
        $back = Get-Item -LiteralPath $path -ErrorAction SilentlyContinue
        _{{ function }}_said ($back -and $back.GetValue('') -eq $command) $reason $denied
    }
}

# One line per shortcut or entry refreshed: written and read back, or why not ($path set).
function global:_{{ function }}_said($written, $reason, $denied) {
    if ($written) { Write-Host "{{ launch.refreshed }}"; return }
    Write-Host "{{ host.texts.not_saved }}"
    if ($reason) { Write-Host "    $reason" }
    if ($denied) { Write-Host "{{ host.texts.denied }}" }
}

# The icon of the shortcut and of the right-click entry, copied from the image next to
# this file by Docker itself, so that no script writes an image file (0194).
# Returns its path; PowerShell's own, said in one line, when it is not there.
function global:_{{ function }}_icon($powershell) {
    $file = $MyInvocation.MyCommand.ScriptBlock.File
    $icon = Join-Path (Split-Path -Parent $file) '{{ host.icon_name }}'
    $container = docker create {{ image }} 2>$null | Select-Object -Last 1
    if ($LASTEXITCODE -eq 0 -and $container) {
        $null = docker cp "${container}:{{ host.icon }}" $icon 2>$null
        $null = docker rm $container 2>$null
    }
    if (Test-Path -LiteralPath $icon) { return $icon }
    Write-Host "{{ host.texts.no_icon }}"
    $powershell
}

# Why a write failed, in one line (never the error record), then whether access was
# refused: an antivirus may lock a path it flagged until Windows restarts (0190).
function global:_{{ function }}_why($record) {
    $exception = $record.Exception
    while ($exception.InnerException) { $exception = $exception.InnerException }
    $exception.Message
    ($exception -is [UnauthorizedAccessException]) -or ($exception.HResult -eq -2147024891)
}

# `{{ function }} shortcut`: "{{ host.label }}" on the Desktop and in the Start menu, read back (0180).
# Each one is read back but said only when it failed: one line when all went well (0190).
# Its window starts minimised (0284): the home page is what one looks at; the window waits
# in the taskbar for the steps that ask there, and says it must stay open.
function global:_{{ function }}_shortcut {
    $powershell, $arguments = _{{ function }}_start '{{ function }}'
    if (-not $arguments) { return }
    $icon = _{{ function }}_icon $powershell
    $shell = New-Object -ComObject WScript.Shell
    $written = 0
    $denied = $false
    foreach ($place in 'Desktop', 'Programs') {
        $path = Join-Path ([Environment]::GetFolderPath($place)) '{{ host.label }}.lnk'
        $link = $shell.CreateShortcut($path)
        $link.TargetPath = $powershell
        $link.Arguments = $arguments
        $link.WorkingDirectory = $HOME
        $link.Description = '{{ host.label }}'
        $link.IconLocation = "$icon,0"
        $link.WindowStyle = {{ host.minimised }}
        $reason = ''
        try { $link.Save() } catch { $reason, $refused = _{{ function }}_why $_; $denied = $denied -or $refused }
        $back = $shell.CreateShortcut($path)
        if ((Test-Path -LiteralPath $path) -and $back.TargetPath -eq $powershell -and $back.Arguments -eq $arguments -and $back.WindowStyle -eq {{ host.minimised }}) {
            $written++
        } else {
            Write-Host "{{ host.texts.not_saved }}"
            if ($reason) { Write-Host "    $reason" }
        }
    }
    if ($denied) { Write-Host "{{ host.texts.denied }}" }
    if ($written -gt 0) { Write-Host "{{ host.texts.shortcut }}" }
}

# `{{ function }} explorer`: the right-click entry of every folder and of the empty space of
# an open folder (0188), in the user's own registry (no administrator), each read back and
# said only when it failed;
# `--remove` deletes both (0181). Explorer puts the folder (`%V`, the open one on the
# background) after `#`: a comment, so that no character of its name breaks the command.
function global:_{{ function }}_explorer {
    $keys = '{{ host.key }}', '{{ host.background }}'
    if ($args -contains '--remove') {
        foreach ($key in $keys) {
            $reason = ''
            $denied = $false
            if (Test-Path -LiteralPath $key) {
                try { Remove-Item -LiteralPath $key -Recurse -Force -ErrorAction Stop } catch { $reason, $denied = _{{ function }}_why $_ }
            }
            if (-not (Test-Path -LiteralPath $key)) { Write-Host "{{ host.texts.removed }}"; continue }
            Write-Host "{{ host.texts.not_removed }}"
            if ($reason) { Write-Host "    $reason" }
            if ($denied) { Write-Host "{{ host.texts.denied }}" }
        }
        return
    }
    $powershell, $arguments = _{{ function }}_start '{{ function }} {{ host.flag }} #" "%V'
    if (-not $arguments) { return }
    $icon = _{{ function }}_icon $powershell
    $command = '"' + $powershell + '" ' + $arguments
    $written = 0
    foreach ($key in $keys) {
        $reason = ''
        $denied = $false
        try {
            $null = New-Item -Path $key -Value '{{ host.label }}' -Force -ErrorAction Stop
            $null = New-ItemProperty -LiteralPath $key -Name Icon -Value $icon -Force -ErrorAction Stop
            $null = New-Item -Path "$key\command" -Value $command -Force -ErrorAction Stop
        } catch { $reason, $denied = _{{ function }}_why $_ }
        $back = Get-Item -LiteralPath "$key\command" -ErrorAction SilentlyContinue
        $read = if ($back) { $back.GetValue('') } else { $null }
        $path = $key
        if ($read -eq $command) {
            $written++
        } else {
            Write-Host "{{ host.texts.not_saved }}"
            if ($reason) { Write-Host "    $reason" }
            if ($denied) { Write-Host "{{ host.texts.denied }}" }
        }
    }
    if ($written -gt 0) { Write-Host "{{ host.texts.explorer }}" }
}

# Loaded: the shortcut and the right-click entry of this file start it as written above.
try { _{{ function }}_refresh } catch { }

{# The album's own buttons in the bar of `album_edit.html.j2` (0500), right after the count
   (`pick_first` of `pick_acting.html.j2`): another album, the cover, the copies to send. #}
  <button id="toOther" class="plain" type="button" title="{{ _('Add to another album') }}" aria-label="{{ _('Add to another album') }}">➕ {{ _("Album") }}</button>

{# The active filters as chips (0565), on line 1 of the bar right after the count: words,
   period, path, folder of the tree, sorted, kind, without, place, album (the folded ones
   of *More filters*, 0665, always shown here). ✕ removes that filter and searches again.
   The bar never grows: the chips that do not fit fold into `+N`, whose click lists them
   under the bar (a floating panel, the grid never moves). Drawn from the search sent
   (`asked`), so a chip is always what was searched. #}
const chipsLine = element("span", "", "");
chipsLine.id = "chips";
const chipsMore = element("button", "plain chipsMore", "");
chipsMore.type = "button";
chipsMore.title = TEXTS.chipsMore;
const chipsFolded = element("span", "", "");
chipsFolded.id = "chipsFolded";
chipsFolded.hidden = true;
$("lead").append(chipsLine, chipsMore);
$("bar").append(chipsFolded);

// The words typed, one chip each ("quoted words" stay one, `person:"Anne Marie"` too).
const chipWords = (text) => text.match(/(?:\w+:)?"[^"]*"|\S+/g) || [];
// A name searched among the people (a card's 👤 chip clicked): 👤 and the name, as there.
const chipLabel = (word) => {
  const name = word.match(/^person:\x22?([^\x22]*)\x22?$/i); // \x22: a quote the page checks cannot mistake for a string
  return name ? "👤 " + name[1] : word;
};
const pressedLabel = (id) => {
  const button = document.querySelector(`[data-for="${id}"][aria-pressed="true"]`);
  return button ? (button.title || button.textContent).trim() : "";
};

// Each active filter: its text and how to take it off the form.
function activeFilters(body) {
  const filters = chipWords(body.text).map((word, at) => ({
    text: chipLabel(word),
    off: () => { $("text").value = chipWords($("text").value).filter((_, i) => i !== at).join(" "); },
  }));
  if (body.day_from || body.day_to) {
    const days = body.day_from === body.day_to ? body.day_from : (body.day_from || "…") + " → " + (body.day_to || "…");
    filters.push({ text: "📅 " + days, off: () => { $("from").value = ""; $("to").value = ""; } });
  }
  if (body.folder) filters.push({ text: "📂 " + body.folder, off: () => { $("folder").value = ""; pathClearable(); } });
  if (body.within) filters.push({ text: "📁 " + $("withinName").textContent, off: () => { within = null; showWithin(); } });
  if (body.sorting !== "all") filters.push({ text: pressedLabel("sorting"), off: () => segmented("sorting", "all") });
  if (body.kind !== "all" && !body.aside) filters.push({ text: pressedLabel("kind"), off: () => { segmented("kind", "all"); remember("kind"); } });
  if (body.missing !== "all") filters.push({ text: pressedLabel("missing"), off: () => segmented("missing", "all") });
  if (body.near) filters.push({ text: "📍 " + $("placeDlg").dataset.nearChip, off: () => { window.mhNear = null; } });
  if (body.album && body.album.inside !== null) {
    const how = $("albumIn").selectedOptions[0];
    filters.push({ text: "📚 " + (how ? how.textContent.trim() : "") + " · " + body.album.name, off: () => { $("albumIn").value = ""; } });
  }
  if (body.place) filters.push({ text: "📍 " + body.place, off: () => { $("placeIn").value = ""; } });
  return filters;
}

function chipOf(filter) {
  const chip = element("span", "chip", filter.text + " ");
  chip.title = filter.text;
  const off = element("button", "plain", "✕");
  off.type = "button";
  off.title = TEXTS.chipRemove;
  off.setAttribute("aria-label", TEXTS.chipRemove + " — " + filter.text);
  off.addEventListener("click", (event) => {
    event.stopPropagation();
    chipsFolded.hidden = true;
    filter.off();
    search(null);
  });
  chip.append(off);
  return chip;
}

function showChips(body) {
  chipsLine.replaceChildren(...activeFilters(body).map(chipOf));
  chipsFolded.hidden = true;
  foldChips();
}

// Measured again each time the line changes width (the count, the set aside line, the window).
function foldChips() {
  chipsLine.append(...chipsFolded.children);
  chipsMore.hidden = true;
  const right = $("lead").getBoundingClientRect().right;
  const chips = [...chipsLine.children];
  const first = chips.findIndex((chip) => chip.getBoundingClientRect().right > right);
  if (first < 0) { chipsFolded.hidden = true; return; }
  const folded = chips.slice(Math.max(0, first - 1));  // room left for `+N`
  chipsFolded.append(...folded);
  chipsMore.textContent = "+" + folded.length;
  chipsMore.hidden = false;
}
new ResizeObserver(foldChips).observe($("lead"));
chipsMore.addEventListener("click", () => { chipsFolded.hidden = !chipsFolded.hidden; });

// *More filters* open or folded, kept in the URL (0666, 0665): Back and a reload keep it.
if (window.mhView) {
  $("moreFilters").open = window.mhView.get({ filters: ["more"] }).filters === "more";
  $("moreFilters").addEventListener("toggle", () => {
    window.mhView.set({ filters: $("moreFilters").open ? "more" : null });
  });
}

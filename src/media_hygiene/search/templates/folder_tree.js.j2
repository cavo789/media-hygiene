{# The tree of the library's folders, the same on the folder view and the search (0348):
   the mounted folders open, every folder below them closed, each with what it holds.
   `folderTree(folders, chosen)` builds it from `GET /api/folders`; `chosen(node)` is called
   when a folder is clicked (the folder view opens it, the search filters on it). `roles`
   (0532), optional: `{of: Map(host path → role), pick(node)}` adds each folder's badge
   and its *Role of this folder* button. #}
const ROLE_BADGES = { protected: "🛡️", preferred: "⭐", backups: "💾", excluded: "🚫" };
function folderBranch(node, children, chosen, roles) {
  const item = element("li");
  const line = element("div", "node");
  const below = children.get(node.path) || [];
  const toggle = element("button", "toggle", below.length ? "▸" : "");
  toggle.type = "button";
  const button = element("button", "folder", node.name);
  button.type = "button";
  button.dataset.path = node.path;
  button.append(element("small", "", fill(TEXTS.counts, node)));
  line.append(toggle, button);
  if (roles) {
    const role = roles.of.get(node.path);
    if (role) {
      const badge = element("span", "roleBadge", ROLE_BADGES[role]);
      badge.title = TEXTS.roleWhy[role];
      button.prepend(badge);
    }
    const menu = element("button", "plain roleOpen", "⋯");
    menu.type = "button";
    menu.title = TEXTS.roleOpen;
    menu.setAttribute("aria-label", TEXTS.roleOpen);
    menu.addEventListener("click", () => roles.pick(node));
    line.append(menu);
  }
  item.append(line);
  if (below.length) {
    const list = element("ul");
    list.append(...below.map((child) => folderBranch(child, children, chosen, roles)));
    list.hidden = node.parent !== null;
    toggle.textContent = list.hidden ? "▸" : "▾";
    toggle.addEventListener("click", () => {
      list.hidden = !list.hidden;
      toggle.textContent = list.hidden ? "▸" : "▾";
    });
    item.append(list);
  }
  button.addEventListener("click", () => chosen(node));
  return item;
}

function folderTree(folders, chosen, roles = null) {
  const children = new Map();
  for (const node of folders) {
    if (!children.has(node.parent)) children.set(node.parent, []);
    children.get(node.parent).push(node);
  }
  const list = element("ul");
  list.append(...(children.get(null) || []).map((node) => folderBranch(node, children, chosen, roles)));
  return list;
}

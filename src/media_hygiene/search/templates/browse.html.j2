<!DOCTYPE html>
{# The folder view of `media-hygiene browse` (the search's own server): the tree of the
   library's folders on the left, the photos and videos of the folder chosen on the
   right, or the heaviest files of the whole library (0302, *Heaviest files* above the
   folders). The photos are never changed: the files picked can be set aside, saved at
   once in the decisions file for `clean --decisions`. The keys are listed under the
   tree, always in sight, as on the review pages (`review_side.css.j2`), with the line
   saying that nothing is deleted here. Above the grid, one bar (0305): the folder shown,
   or, once files are picked, what to do with them (set aside, albums). The scripts
   are `browse.js.j2` and `browse_band.js.j2`. Opened from the home page, *Apply now*
   ends the page on the home step that applies the decisions (`apply_now.html.j2`). #}
{% set texts = {
  "files": [ngettext("{n} file", "{n} files", 1), ngettext("{n} file", "{n} files", 2)],
  "counts": _("{photos} photos · {videos} videos · {size}"),
  "empty": _("No photo or video directly in this folder: open a subfolder."),
  "noVideo": [ngettext("No video in this folder ({n} photo).", "No video in this folder ({n} photos).", 1), ngettext("No video in this folder ({n} photo).", "No video in this folder ({n} photos).", 2)],
  "heaviest": _("Heaviest files"),
  "heaviestHint": _("of every folder: where the space goes"),
  "noPhoto": [ngettext("No photo in this folder ({n} video).", "No photo in this folder ({n} videos).", 1), ngettext("No photo in this folder ({n} video).", "No photo in this folder ({n} videos).", 2)],
  "choose": _("Choose a folder on the left."),
  "offline": _("The page is not running any more: start it again."),
  "failed": _("The page failed (error {status})."),
  "noPreview": _("No preview"),
  "picked": [ngettext("{n} file picked", "{n} files picked", 1), ngettext("{n} file picked", "{n} files picked", 2)],
  "aside": _("marked to set aside"),
  "tick": _("Pick this file"),
  "saving": _("Saving…"),
  "notSaved": _("Nothing was saved: {error}"),
  "noAlbum": _("Type the album's name in the bar first: then A adds the file shown."),
} %}
{% set page_name = _("Your folders") %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_name }} — media-hygiene</title>
<link rel="icon" type="image/png" href="/assets/images/favicon.png">
<style>
{% include "theme.css.j2" %}
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 400 15px/1.5 var(--mk-font-text); }
  label { font-size: .85rem; color: var(--muted); }
  select { padding: 4px 6px; font: inherit; color: var(--text); background: var(--bg);
           border: 1px solid var(--line); border-radius: 6px; }
  button { padding: 6px 14px; font: inherit; color: var(--on-accent); background: var(--accent);
           border: 1px solid var(--accent); border-radius: 6px; cursor: pointer; }
  button.plain { color: var(--accent); background: transparent; }
  button:disabled { opacity: .45; cursor: default; }
  /* One bar above the grid (0305): where you are, or what to do with the files picked. */
  #content { min-width: 0; }
  #bar { position: sticky; top: 0; z-index: 1; display: flex; flex-wrap: wrap; gap: 6px 10px;
         align-items: center; padding: 8px 16px; background: var(--card);
         border-bottom: 1px solid var(--line); }
  #bar.acting { background: color-mix(in srgb, var(--accent) 14%, var(--card)); }
  #lead, #acting { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }
  #lead[hidden], #acting[hidden], #takeBack[hidden] { display: none; }
  #status { font-weight: 600; overflow-wrap: anywhere; }
  /* One line whatever it says, so the grid never moves when a save is said (the count and
     size come first; the whole sentence on hover). */
  #chosen { flex: 1 1 220px; min-width: 0; font-size: .85rem; white-space: nowrap;
            overflow: hidden; text-overflow: ellipsis; }
  #bar #albumBar { margin: 0; }
  #bar #albumBar input { width: 17em; }
  #bar > p, #bar > details { flex-basis: 100%; margin: 0; }
  #bar > p:empty { display: none; }
  #views { display: flex; gap: 6px; flex: none; }
  #views > * { flex: 1; padding: 6px; text-align: center; background: var(--card);
               border: 1px solid var(--line); border-radius: 8px; }
  #views [aria-current] { font-weight: 600; border-color: var(--accent); }
  #views a { color: var(--accent); text-decoration: none; }
  #keys .safe { margin: 8px 0 0; color: var(--muted); }
  #chosen.error, #status.error { color: var(--bad); font-weight: 600; }
{% include "review_side.css.j2" %}
  /* No header above the columns: the left one starts at the top of the window. */
  #side { top: 8px; height: calc(100vh - 16px); margin-top: 8px; }
  nav { overflow-wrap: anywhere; }
  nav ul { list-style: none; margin: 0; padding-left: 14px; }
  nav > ul { padding-left: 0; }
  .node { display: flex; gap: 4px; align-items: baseline; }
  .toggle { width: 1.2em; padding: 0; border: 0; color: var(--muted); background: none; }
  .folder { flex: 1; padding: 2px 6px; text-align: left; color: var(--text); background: none;
            border: 1px solid transparent; border-radius: 6px; }
  .folder.open { border-color: var(--accent); }
  .folder.heaviest { display: block; width: 100%; margin-bottom: 6px; font-weight: 600; }
  .where { overflow-wrap: anywhere; font-size: .75rem; }
  #moreLine { margin: 0 16px 16px; text-align: center; }
  .folder small { display: block; color: var(--muted); font-size: .75rem; }
  main { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
         gap: 10px; padding: 16px; align-content: start; }
  .file { position: relative; background: var(--card); border: 2px solid var(--line);
          border-radius: 10px; overflow: hidden; cursor: pointer; outline: none;
          user-select: none; }
  .tick { position: absolute; top: 6px; right: 6px; width: 22px; height: 22px; margin: 0;
          accent-color: var(--accent); cursor: pointer; }
  .band { position: absolute; z-index: 1; pointer-events: none; border: 1px solid var(--accent);
          background: color-mix(in srgb, var(--accent) 18%, transparent); }
  kbd { display: inline-block; min-width: 1.6em; padding: 0 6px; font: inherit; text-align: center;
        background: var(--bg); border: 1px solid var(--line); border-radius: 4px; }
  .file:focus, .file.current { border-color: var(--accent); }
  .file.picked { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent); }
  .file img, .file video, .file .empty { display: block; width: 100%; aspect-ratio: 4 / 3;
                                         object-fit: cover; background: var(--chip); }
  .file .empty { display: flex; align-items: center; justify-content: center;
                 color: var(--muted); font-size: .85rem; }
  .meta { padding: 4px 8px; font-size: .8rem; }
  .name { font-weight: 600; overflow-wrap: anywhere; }
  .muted { color: var(--muted); }
  .badge { position: absolute; top: 6px; left: 6px; padding: 0 8px; border-radius: 10px;
           color: #fff; background: var(--bad); font-size: .75rem; font-weight: 600; }
  #viewer { position: fixed; inset: 0; z-index: 2; display: none; flex-direction: column;
            align-items: center; justify-content: center; gap: 8px; padding: 16px;
            background: rgba(0, 0, 0, .88); color: #fff; }
  #viewer.open { display: flex; }
  #viewer img, #viewer video { max-width: 100%; max-height: calc(100vh - 90px); object-fit: contain; }
  #viewer a { color: #9cd0ff; }
  #viewer .asideMark { padding: 0 8px; border-radius: 10px; background: var(--bad); font-size: .8rem;
                       font-weight: 600; }
  #viewer .asideMark[hidden] { display: none; }
  #viewer .viewerKeys, #viewerInfo { color: #ccc; }
  #viewerSaid:empty, #viewerInfo[hidden], #viewerHelp[hidden] { display: none; }
  #viewerSaid.error { color: #ff9b9b; font-weight: 600; }
  #viewerHelp { display: grid; grid-template-columns: auto auto; gap: 4px 12px; margin: 0;
                padding: 10px 14px; background: rgba(40, 40, 40, .95); border-radius: 8px; }
  #viewerHelp dd { margin: 0; }
  #viewer kbd { color: #fff; background: #333; border-color: #666; }
</style>
</head>
<body>
{% include "page_header.html.j2" %}
<div class="layout">
  <aside id="side">
    <div id="views">
      <span aria-current="page">📁 {{ _("Folders") }}</span>
      <a href="{{ search_page }}" title="{{ _('Search by words') }}">🔎 {{ _("Words") }}</a>
    </div>
    <nav id="toc" aria-label="{{ _('Your folders') }}"><div id="tree"></div></nav>
    <section id="keys" aria-label="{{ _('Keyboard') }}">
      <h2>⌨ {{ _("Keyboard") }}</h2>
      <dl>
        <dt><kbd>Shift</kbd>+{{ _("click") }}</dt><dd>{{ _("every file from the last one clicked") }}</dd>
        <dt>☑ · <kbd>Ctrl</kbd>+{{ _("click") }}</dt><dd>{{ _("add or take out one file") }}</dd>
        <dt>{{ _("drag") }}</dt><dd>{{ _("a rectangle: the files it touches (Ctrl adds them)") }}</dd>
        <dt><kbd>Ctrl</kbd>+<kbd>A</kbd></dt><dd>{{ _("the whole folder") }}</dd>
        <dt><kbd>I</kbd></dt><dd>{{ _("invert: the others instead") }}</dd>
        <dt><kbd>Delete</kbd></dt><dd>{{ _("set the picked files aside") }}</dd>
      </dl>
      <details id="moreKeys">
      <summary>{{ _("More keys") }}</summary>
      <dl>
        <dt><kbd>←</kbd> <kbd>↑</kbd> <kbd>→</kbd> <kbd>↓</kbd></dt><dd>{{ _("move the frame") }}</dd>
        <dt><kbd>␣</kbd></dt><dd>{{ _("pick or unpick the framed file") }}</dd>
        <dt><kbd>Enter</kbd></dt><dd>{{ _("open it large (a double click too)") }}</dd>
        <dt><kbd>Home</kbd> <kbd>End</kbd></dt><dd>{{ _("the first or last file") }}</dd>
        <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>{{ _("opened: the previous or next one") }}</dd>
        <dt><kbd>Delete</kbd></dt><dd>{{ _("opened: set it aside, then the next one") }}</dd>
        <dt><kbd>⌫</kbd></dt><dd>{{ _("opened: take it back out") }}</dd>
        <dt><kbd>F</kbd></dt><dd>{{ _("opened: full screen") }}</dd>
        <dt><kbd>?</kbd></dt><dd>{{ _("opened: every key of the large view") }}</dd>
        <dt><kbd>Esc</kbd></dt><dd>{{ _("close it") }}</dd>
      </dl>
      </details>
      <p class="safe">🔒 {{ _("Nothing is deleted from this page: the files set aside go to the quarantine at the next 'clean --decisions', journaled; 'undo' brings them back, 'purge' frees the space.") }}</p>
    </section>
  </aside>
  <div id="content">
  <header id="bar">
    <span id="lead"><span id="status" role="status"></span></span>
    <span id="acting" hidden>
      <button id="unpick" class="plain" type="button" title="{{ _('Pick none') }}" aria-label="{{ _('Pick none') }}">✕</button>
      <strong id="picked"></strong>
      <button id="setAside" type="button">{{ _("Set aside the picked files") }}</button>
      <button id="takeBack" class="plain" type="button" hidden>{{ _("Take out of the set aside") }}</button>
      <button id="invert" class="plain" type="button" title="{{ _('Pick the others: the ones picked are left (I)') }}">{{ _("Invert the picking") }}</button>
    </span>
    <span id="chosen" role="status"></span>
    {% include "apply_now.html.j2" %}
    <label>{{ _("Sort by") }}
      <select id="order">
        <option value="name">{{ _("name") }}</option>
        <option value="date">{{ _("date") }}</option>
        <option value="size">{{ _("size, largest first") }}</option>
        <option value="rate" title="{{ _('The videos worst compressed for their length first: the best to lighten') }}">{{ _("bit rate (heaviest files)") }}</option>
      </select></label>
    <label>{{ _("Show") }}
      <select id="kind">
        <option value="all">{{ _("All") }}</option>
        <option value="photos">{{ _("Photos") }}</option>
        <option value="videos">{{ _("Videos") }}</option>
      </select></label>
    {% set album_compact = true %}
    {% include "album_bar.html.j2" %}
  </header>
  <main id="grid"></main>
  <p id="moreLine"><button id="more" class="plain" type="button" hidden>{{ _("Show more") }}</button></p>
  </div>
</div>
<div id="viewer" role="dialog" aria-modal="true">
  <img id="large" alt="">
  <video id="movie" controls hidden></video>
  <div><span id="viewerName"></span> <span id="viewerAside" class="asideMark" hidden>{{ _("marked to set aside") }}</span> — <a id="originalLink" target="_blank" rel="noopener">{{ _("Open the original") }}</a></div>
  <div id="viewerInfo" class="stay" hidden></div>
  <div id="viewerSaid" class="stay" role="status"></div>
  <small class="viewerKeys stay"><kbd>←</kbd> <kbd>→</kbd> {{ _("previous, next") }} · <kbd>Delete</kbd> {{ _("set it aside, then the next one") }} · <kbd>F</kbd> {{ _("full screen") }} · <kbd>?</kbd> {{ _("every key") }}</small>
  <dl id="viewerHelp" class="stay" hidden>
    <dt><kbd>←</kbd> <kbd>→</kbd></dt><dd>{{ _("the previous or next one") }}</dd>
    <dt><kbd>Home</kbd> <kbd>End</kbd></dt><dd>{{ _("the first or last one") }}</dd>
    <dt><kbd>Delete</kbd></dt><dd>{{ _("set it aside, then the next one") }}</dd>
    <dt><kbd>⌫</kbd></dt><dd>{{ _("take it back out of the set aside") }}</dd>
    <dt><kbd>␣</kbd></dt><dd>{{ _("play or pause a video") }}</dd>
    <dt><kbd>F</kbd></dt><dd>{{ _("full screen, or back") }}</dd>
    <dt><kbd>I</kbd></dt><dd>{{ _("its date, size, folder") }}</dd>
    <dt><kbd>A</kbd></dt><dd>{{ _("add it to the album named in the bar") }}</dd>
    <dt><kbd>?</kbd></dt><dd>{{ _("this list, or not") }}</dd>
    <dt><kbd>Esc</kbd></dt><dd>{{ _("close") }}</dd>
  </dl>
</div>
<script>
{% include "browse.js.j2" %}
{% include "browse_band.js.j2" %}
</script>
{% include "home_link.html.j2" %}
</body>
</html>

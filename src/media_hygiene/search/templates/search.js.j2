{# The script of the search page (`search.html.j2`): the search sent, the files found as
   cards with their folder, date and words. The picking, the bar and the saving are
   `pick_grid.js.j2`'s, the large view `pick_viewer.js.j2`'s, the albums
   `album_bar.html.j2`'s. The × of a `person` chip takes the name off the photo (the
   person's `rejected` list, read back, *Put back* in the line said): it never picks
   the card (0317). A click on any chip, a person's too, searches its word in every source,
   the filters emptied. W in the large view opens *Why this name?*: the face cut
   out, how it got the name, its reference and the score, then *Yes, it is …* or *Not …*
   for that face (0318); Esc closes it, the picking untouched. #}
const TEXTS = {{ texts | tojson }};
const DROPPABLE_SOURCES = ["vision", "folder", "name", "former"];  // index/tag_drop.py (0546)
const SOURCES = {{ sources | tojson }};
const SEARCH_PATH = {{ search_path | tojson }};
const CHOSEN_PATH = {{ chosen_path | tojson }};
const PEOPLE_REJECT_PATH = {{ people_reject_path | tojson }};
const PEOPLE_WHY_PATH = {{ people_why_path | tojson }};
let whyAsked = null; // the photo and the name the panel explains
let asked = {};        // the search shown
let within = null;     // the folder of the tree the search is narrowed to (0348)
const CHIPS_SHOWN = 6;  // the words on a card at sizes S and M; the rest behind +N
let more = 0;          // the files asked past the first ones (*Show more*, 0408)

let trialAgain = null;  // (again): the grid shows the photos of a trial (0640)
let trialShows = 0;     // how many times they were shown (0648)

function card(hit, index) {
  const node = element("article");
  const picture = element("img");
  picture.loading = "lazy";
  picture.draggable = false; // a drag draws a rectangle (`pick_band.js.j2`)
  picture.alt = hit.name;
  picture.src = hit.thumb;
  picture.addEventListener("error", () => picture.replaceWith(element("div", "empty", TEXTS.noPreview)));
  const meta = element("div", "meta");
  const folder = titled(element("div", "muted folderLine", ""));
  folder.append(linked(hit.folder, TEXTS.folderTip, () => searchFolder(hit.folder)));
  meta.append(titled(element("div", "name", hit.name)), folder);
  meta.append(takenLine(hit));  // which date it is (0433)
  if (hit.spot) meta.append(titled(element("div", "muted", "📍 " + hit.spot)));  // its landmark and town (0545)
  if (hit.facts) meta.append(element("div", "muted", hit.facts));  // a video (0408)
  if (hit.to !== undefined) { // a rule tried (0396): where the file would go
    const goes = hit.left ? TEXTS.leftHere : hit.taken ? fill(TEXTS.goesTo, { folder: hit.to || TEXTS.stays })
      : hit.otherDay ? fill(TEXTS.otherDay, { date: hit.date, rule: fill(TEXTS.leftTo, { rule: hit.by || "—" }) }) : fill(TEXTS.leftTo, { rule: hit.by || "—" });
    meta.append(element("div", "goes", goes));
    if (!hit.taken) node.classList.add("notTaken");
    if (hit.left) node.classList.add("leftHere");
  }
  if (hit.row !== undefined && eventTile) eventTile(hit, meta, node);  // an event's (0438)
  if (hit.likely && window.mhLate) window.mhLate.tile(hit, meta, node);  // a late photo's (0558)
  if (hit.inAlbum) { node.classList.add("inAlbum"); meta.append(element("div", "inAlbumMark", TEXTS.inAlbum)); }  // 0501
  if (hit.caption) meta.append(titled(element("div", "muted caption", hit.caption)));
  meta.append(chipsOf(hit));
  node.append(withLength(hit, picture), meta);
  return wireCard(node, index);
}

// One line on a card (0463): the whole text in the tooltip, and in the large view.
function titled(node) {
  node.title = node.textContent;
  return node;
}

// The day taken (EXIF, what the search finds by), its time and the file's modified
// day in the tooltip: a modified day Explorer shows is not the one searched (0433).
function takenLine(hit) {
  const line = element("div", "muted", hit.date ? "📷 " : [TEXTS.noTaken, hit.size].filter(Boolean).join(" · "));
  line.title = hit.date ? fill(TEXTS.takenTip, { taken: hit.taken || hit.date })
    + (hit.modified && hit.modified !== hit.date ? fill(TEXTS.modifiedTip, { day: hit.modified }) : "") : TEXTS.noTakenTip;
  // The day is a link: a click searches that day only (From = To = it).
  if (hit.date) line.append(linked(hit.date, line.title + TEXTS.dayTip, (event) => searchDay(hit.date, event)), hit.size ? " · " + hit.size : "");
  return line;
}

// A fact of a card or of the large view that searches by itself on a click: never a pick,
// a rectangle nor the large view.
function linked(text, title, act) {
  const link = element("span", "day", text);
  link.title = title;
  for (const kind of ["pointerdown", "mousedown", "dblclick"]) link.addEventListener(kind, (event) => event.stopPropagation());
  link.addEventListener("click", (event) => { event.stopPropagation(); act(event); });
  return link;
}

// The large view's day and folder (`pick_viewer.js.j2`): the same links as on the card.
function infoLink(kind, text) {
  if (kind === "date") return linked(text, TEXTS.dayTip.replace(/^ · /, ""), (event) => searchDay(text, event));
  if (kind === "folder") return linked(text, TEXTS.folderTip, () => searchFolder(text));
  return text;
}

{% include "search_words.js.j2" %}

{% include "search_why.js.j2" %}

// What the files shown are: the search, sent with each choice and each album change.
function scope() {
  return asked;
}

function reopen(again) {
  if (window.mhLate && window.mhLate.shown()) return window.mhLate.reopen(again);  // late photos (0558)
  if (trialAgain) return trialAgain(again);  // the photos of a trial, where they went (0640)
  return eventShown ? showEvent(eventShown, again) : search(null, again);  // an event (0437)
}

// What the index can be found by (0344, 0346): the line under the field when the photos are
// hardly described, the tip about sentences, "none yet" on each source without words.
const FEW = 10; // under one file in FEW described: the line shows
const hardlyDescribed = (seen) => Boolean(seen) && (seen.sources.vision || 0) * FEW < seen.files;
function covered(seen) {
  if (!seen) return;
  const line = $("coverage");
  line.hidden = !hardlyDescribed(seen);
  line.textContent = fill(TEXTS.notDescribed, { described: (seen.sources.vision || 0).toLocaleString(), files: seen.files.toLocaleString() });
  $("tipSentence").hidden = seen.meaning;
  $("tipMeaning").hidden = !seen.meaning;
  const none = (value) => !(seen.sources[value] || 0);
  for (const term of document.querySelectorAll("#sourceList [data-source]")) {
    term.querySelector(".none").hidden = !none(term.dataset.source);
  }
}

// The album named in the bar (0501): its files marked on their tiles, or kept, or left out.
function albumAimed() {
  const name = $("albumName") ? $("albumName").value.trim() : "";
  $("albumIn").disabled = !name;
  if (!name) return null;
  const wanted = $("albumIn").value;
  return { name: name, inside: wanted === "in" ? true : wanted === "out" ? false : null };
}

// What was found stays in the line; a failure is a toast that stays (0664).
function told(text, error) {
  $("status").className = "";
  $("status").textContent = error ? "" : text;
  if (error) { window.mhPlaceholders.clear($("grid")); window.mhSay(text, "error"); }
}

const PLACEHOLDER_TILES = 12;  // about two rows on a PC screen while the first answer comes
async function search(event, again) {
  if (event) event.preventDefault();
  if (!again) trialAgain = null;
  steppable();  // ◀ ▶ follow every way the dates change (cards, 📅, Back, a word)
  if (!again) more = 0;
  const near = window.mhNear;  // 0554: those photos alone, whatever the filters of the form
  const body = near ? { near: near.keys, order: "name", more: more, text: "", folder: "", sorting: "all", kind: "all", missing: "all", place: "", within: "", aside: false, album: null, day_from: null, day_to: null, source: null } : {
    text: $("text").value, day_from: $("from").value || null, day_to: $("to").value || null,
    folder: $("folder").value, source: null, sorting: $("sorting").value,
    order: $("missing").value !== "all" ? "name" : $("order").value, missing: $("missing").value, place: $("placeIn").value,
    kind: asideListed() ? "all" : $("kind").value, aside: asideListed(), within: within ? within.inside : "",
    more: more, album: albumAimed(),
  };
  const lateBefore = window.mhLate ? window.mhLate.opened : 0;
  const trialBefore = trialShows;
  if (!again && !cards.length) window.mhPlaceholders($("grid"), PLACEHOLDER_TILES);  // the grid never moves (0664)
  const answer = await ask(SEARCH_PATH, body);
  if (window.mhLate && window.mhLate.opened !== lateBefore) return;  // late photos shown meanwhile (0558)
  if (trialShows !== trialBefore) return;  // a trial found back meanwhile (0648)
  if (!answer) { told(TEXTS.offline, true); return; }
  if (!answer.ok) {
    const refused = answer.status === 400 ? await answer.json().catch(() => ({})) : {};  // a bad regex (0426)
    told(refused.error || fill(TEXTS.failed, { status: answer.status }), true);
    return;
  }
  const found = await answer.json();
  asked = body;
  showChips(body);  // the active filters, removable (0565)
  if (!again && !near) keepInHistory();
  offerRule();
  // The album filter and the place are sent with *Pick all N found* too (0602, 0642): the
  // server narrows its search the same way. The photos of `near` are not: not offered then.
  const narrowed = near;
  total = narrowed ? found.hits.length : found.total;
  showFiles(found.hits, again);
  $("grid").removeAttribute("aria-busy");
  $("more").hidden = found.total <= found.hits.length;
  covered(found.coverage);
  let text = counted(TEXTS.found, found.total);
  if (!found.total) text = TEXTS.none + (body.text.trim() && hardlyDescribed(found.coverage) ? " " + TEXTS.noneWhy : "");
  else if (found.total > found.hits.length) text = fill(TEXTS.shown, { total: found.total, shown: found.hits.length });
  told(found.note ? found.note + " " + text : text, false);
  offerAlbum(body, narrowed ? 0 : found.total);  // 0523
  // Sent from the field: the keys go to the grid (Ctrl+A, the arrows); "/" comes back.
  if (event && cards.length) document.activeElement.blur();
}

document.addEventListener("keydown", (event) => {
  if ($("viewer").classList.contains("open")) return;
  const typing = ["INPUT", "SELECT"].includes(document.activeElement.tagName);
  if (event.key === "/" && !typing) {
    event.preventDefault();
    if ($("toc").hidden) $("tabPhotos").click();
    $("text").focus();
  } else if (event.key === "ArrowDown" && document.activeElement === $("text") && cards.length) {
    event.preventDefault();
    focusOn(0);
  }
});
$("form").addEventListener("submit", search);
// From given: To follows when empty or before it (0453), the period still one day at least.
$("from").addEventListener("change", () => {
  const from = $("from").value;
  if (from && (!$("to").value || $("to").value < from)) $("to").value = from;
});
// One day only, from a card's day: the period shows it, then searched. Shift+click on a
// second day (0488): from the day clicked before to this one, put in order.
let dayClicked = "";
function searchDay(day, event) {
  const first = event && event.shiftKey && dayClicked ? dayClicked : day;
  [$("from").value, $("to").value] = first < day ? [first, day] : [day, first];
  dayClicked = day;
  if ($("viewer").classList.contains("open")) close();
  search(null);
}
// ◀ ▶ (0488): the period moves by its own length (whole months by months), then searched.
const asDay = (text) => { const [y, m, d] = text.split("-").map(Number); return new Date(y, m - 1, d); };
const lastOfMonth = (day) => new Date(day.getFullYear(), day.getMonth() + 1, 0).getDate();
function shifted(from, to, way) {
  if (from.getDate() === 1 && to.getDate() === lastOfMonth(to)) {
    const months = (to.getFullYear() - from.getFullYear()) * 12 + to.getMonth() - from.getMonth() + 1;
    const start = new Date(from.getFullYear(), from.getMonth() + way * months, 1);
    return [start, new Date(start.getFullYear(), start.getMonth() + months, 0)];
  }
  const days = Math.round((to - from) / 86400000) + 1;
  return [from, to].map((day) => new Date(day.getFullYear(), day.getMonth(), day.getDate() + way * days));
}
function stepPeriod(way) {
  const from = $("from").value || $("to").value;
  const to = $("to").value || from;
  if (!from) return;
  [$("from").value, $("to").value] = shifted(asDay(from), asDay(to), way).map(isoDay);
  search(null);
}
const steppable = () => { $("dayBefore").disabled = $("dayAfter").disabled = !$("from").value && !$("to").value; };
$("dayBefore").addEventListener("click", () => stepPeriod(-1));
$("dayAfter").addEventListener("click", () => stepPeriod(1));
for (const id of ["from", "to"]) for (const kind of ["input", "change"]) $(id).addEventListener(kind, steppable);
// A quick period: today, this month, this year (local days), or none; then searched.
const isoDay = (day) => [day.getFullYear(), String(day.getMonth() + 1).padStart(2, "0"), String(day.getDate()).padStart(2, "0")].join("-");
function period(span) {
  const now = new Date();
  const first = span === "year" ? new Date(now.getFullYear(), 0, 1) : span === "month" ? new Date(now.getFullYear(), now.getMonth(), 1) : now;
  const last = span === "year" ? new Date(now.getFullYear(), 11, 31) : span === "month" ? new Date(now.getFullYear(), now.getMonth() + 1, 0) : now;
  return span ? [isoDay(first), isoDay(last)] : ["", ""];
}
for (const button of document.querySelectorAll(".spans button")) {
  button.addEventListener("click", () => {
    [$("from").value, $("to").value] = period(button.dataset.span);
    button.closest("details").open = false;  // the 📅 menu (0463)
    search(null);
  });
}
// The segmented controls (0463): Show, Sorted, S/M/L; each sets its hidden field, then says
// it changed. Show and the size are kept for this viewer, as Sort by.
function segmented(id, value) {
  $(id).value = value;
  for (const button of document.querySelectorAll(`[data-for="${id}"]`)) {
    button.setAttribute("aria-pressed", String(button.dataset.value === value));
  }
}
function remembered(id) {
  try { return localStorage.getItem("mh-search-" + id); } catch (error) { return null; } // private window
}
function remember(id) {
  try { localStorage.setItem("mh-search-" + id, $(id).value); } catch (error) { /* not kept */ }
}
for (const button of document.querySelectorAll(".seg button[data-for]")) {
  button.addEventListener("click", () => {
    segmented(button.dataset.for, button.dataset.value);
    $(button.dataset.for).dispatchEvent(new Event("change"));
  });
}
const showSize = () => { $("grid").dataset.size = $("size").value; };
for (const id of ["kind", "size"]) {
  const kept = remembered(id);
  if (kept && kept !== "aside" && document.querySelector(`[data-for="${id}"][data-value="${kept}"]`)) segmented(id, kept);
}
showSize();
$("size").addEventListener("change", () => { remember("size"); showSize(); });  // no new search
for (const id of ["sorting", "missing", "placeIn"]) $(id).addEventListener("change", () => search(null));  // 0407, 0531, 0553
// 🗑 (0464): the files set aside only; the counter opens it, ✕ leaves it. Never kept.
const asideListed = () => $("kind").value === "aside";
$("kind").addEventListener("change", () => {
  if (!asideListed()) remember("kind");
  $("asideLeave").disabled = !asideListed();  // greyed, never hidden: nothing moves
  search(null);
});
function showAside(on) {
  segmented("kind", on ? "aside" : remembered("kind") || "all");
  $("kind").dispatchEvent(new Event("change"));
}
$("chosen").addEventListener("click", () => { if (!asideListed()) showAside(true); });
$("chosen").title = TEXTS.asideOpen;
$("asideLeave").addEventListener("click", () => showAside(false));
// **Sort by** (0347): the server sorts, so the first files shown are the right ones.
{
  const kept = remembered("order");
  if ([...$("order").options].some((option) => option.value === kept)) $("order").value = kept;
  $("order").addEventListener("change", () => { remember("order"); search(null); });
}
// The next files load when the end of the grid comes in sight (0463), as *Show more* did.
if (window.IntersectionObserver) {
  new IntersectionObserver((seen) => {
    if (seen.some((entry) => entry.isIntersecting) && !$("more").hidden) $("more").click();
  }, { rootMargin: "400px" }).observe($("moreLine"));
}
$("text").focus();
// `mh library --folder <folder>` (0405): the page opens on a folder left to sort.
// *Add photos* of the albums page (0501): the period around the album's dates. A reload or a
// bookmark gives the search back (0666): the words, the period, the folder, read as values.
const FOLDER_KEY = {{ folder_query | tojson }};
const VIEW_KEYS = { text: "text", from: "text", to: "text", [FOLDER_KEY]: "text" };
const opened = window.mhView.get(VIEW_KEYS);
for (const id of ["text", "from", "to"]) if (opened[id]) $(id).value = opened[id];
if (opened[FOLDER_KEY]) $("folder").value = opened[FOLDER_KEY];
$("albumIn").addEventListener("change", () => search(null));
if ($("albumName")) $("albumName").addEventListener("change", () => search(null));
search();
loadChosen();

// Back (Alt+←) gives the search before (a click on a day, a folder, a word replaces it):
// each search is a step of the browser's history, its fields restored from it.
let restoring = false;
function keepInHistory() {
  if (restoring) return;
  const state = shownSearch();
  if (history.state && JSON.stringify(history.state) === JSON.stringify(state)) return;
  const values = { text: state.text, from: state.from, to: state.to, [FOLDER_KEY]: state.folder };
  window.mhView.set(values, { push: Boolean(history.state), state });
}
function shownSearch() {
  return { text: $("text").value, from: $("from").value, to: $("to").value, folder: $("folder").value };
}
window.addEventListener("popstate", async (event) => {
  if (!event.state || !("folder" in event.state)) return;
  // Back from the large view lands on the search shown: the grid stays as it is (0666).
  if (JSON.stringify(event.state) === JSON.stringify(shownSearch())) return;
  window.mhNear = null;
  for (const id of ["text", "from", "to", "folder"]) $(id).value = event.state[id];
  pathClearable();
  restoring = true;
  try { await search(null); } finally { restoring = false; }
});

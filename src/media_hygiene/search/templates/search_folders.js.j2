{# The folders as a filter of the search (0348): the tree of the folder view, closed under
   *📁 My folders* (folded to one line, floating once opened: 0471); a folder clicked narrows the search to it and below, words or none (empty
   words list the whole folder); ✕ searches every folder again. Read once, when opened. #}
const FOLDERS_PATH = {{ folders_path | tojson }};
const ROLE_PATH = {{ role_path | tojson }};
const FIRST_SHOWN = {{ first_hits | tojson }};  // *Show more* asks as many again

function showWithin() {
  $("withinLine").hidden = !within;
  $("withinName").textContent = within ? within.path : "";
  for (const button of document.querySelectorAll("#tree .folder")) {
    button.classList.toggle("open", Boolean(within) && button.dataset.path === within.path);
  }
}

// Asked once, shared by the tree and the list of *Path contains* (0471): from the index.
let folderRows = null;
let folderRoles = [];  // `[folders]` of config.toml, as on the disk (0532)
async function folderList() {
  if (folderRows) return folderRows;
  const answer = await ask(FOLDERS_PATH);
  if (!answer || !answer.ok) return [];  // the search works without them
  const read = await answer.json();
  folderRows = read.folders;
  folderRoles = read.roles || [];
  return folderRows;
}

async function loadFolders() {
  const folders = await folderList();
  const roles = { of: new Map(folderRoles.map((r) => [r.path, r.role])), pick: openRole };
  $("tree").replaceChildren(folderTree(folders, (node) => {
    within = node; showWithin(); $("folders").open = false; search(null);
  }, roles));
  showMissing();
  showWithin();
}

// A folder with a role renamed or deleted in Explorer: its role points nowhere (0532).
function showMissing() {
  $("roleMissing").replaceChildren(...folderRoles.filter((r) => r.where === "missing").map((r) => {
    const line = element("li", "", fill(TEXTS.roleMissing, { folder: r.path, badge: ROLE_BADGES[r.role] }));
    const remove = element("button", "plain", TEXTS.roleRemove);
    remove.type = "button";
    remove.addEventListener("click", () => saveRole(r.path, "none"));
    // Its files are now in another folder (0580): one click moves the role there.
    const carry = (r.carry || []).map((to) => {
      const button = element("button", "plain", fill(TEXTS.roleCarry, { folder: to }));
      button.type = "button";
      button.addEventListener("click", () => saveRole(to, r.role, r.path));
      return button;
    });
    line.append(...carry, remove);
    return line;
  }));
}

let roleFolder = null;
function openRole(node) {
  roleFolder = node.path;
  $("roleFolder").textContent = node.path;
  const now = folderRoles.find((r) => r.path === node.path);
  for (const radio of document.querySelectorAll("#roleDlg input[name=role]")) {
    radio.checked = radio.value === (now ? now.role : "none");
  }
  $("roleSaid").textContent = ""; $("roleSaid").className = ""; $("roleStale").hidden = true;
  window.mhSortFolder.show(node.path);
  $("roleDlg").showModal();
}

// Saved, then shown as read back from the disk; a clash is said, nothing changed.
async function saveRole(folder, role, former = "") {
  $("roleSaid").textContent = TEXTS.roleSaving;
  const answer = await ask(ROLE_PATH, { folder, role, former });
  const read = answer ? await answer.json().catch(() => ({})) : {};
  if (!answer || !answer.ok) {
    $("roleSaid").textContent = read.error || TEXTS.offline;
    $("roleSaid").className = "error";
    return;
  }
  folderRoles = read.roles;
  $("roleSaid").textContent = read.said; $("roleSaid").className = "saved";
  $("roleStale").textContent = read.stale; $("roleStale").hidden = false;
  $("coverage").hidden = false; $("coverage").textContent = read.said + " " + read.stale;
  loadFolders();
}
$("roleSave").addEventListener("click", async () => {
  const picked = document.querySelector("#roleDlg input[name=role]:checked");
  if (!roleFolder || !picked) return;
  const refused = await window.mhSortFolder.save(roleFolder);  // leave, a person (0533)
  if (refused) { $("roleSaid").textContent = refused; $("roleSaid").className = "error"; return; }
  saveRole(roleFolder, picked.value);
});

$("folders").addEventListener("toggle", () => { if ($("folders").open && !$("tree").children.length) loadFolders(); });
// Folded (0471): the floating tree closes with Esc, like *More keys*.
document.addEventListener("keydown", (event) => {
  if (event.key === "Escape" && $("folders").open) { $("folders").open = false; event.stopImmediatePropagation(); }
}, true);
$("withinClear").addEventListener("click", () => { within = null; showWithin(); search(null); });

// *⚖ Heaviest files* (0408, as the folder view had it): every folder, no word, the videos
// first unless *Show* says otherwise, the largest first unless *bit rate* is chosen.
$("heaviest").addEventListener("click", () => {
  within = null;
  showWithin();
  $("text").value = "";
  if ($("kind").value === "all") segmented("kind", "videos");  // the 🎬 of Show (0463)
  if (!["size", "rate"].includes($("order").value)) $("order").value = "size";
  search(null);
});
$("more").addEventListener("click", () => { more += FIRST_SHOWN; search(null, true); });

// `mh browse` and old links to `/browse` (0408): the search, its folders open.
if (window.location.pathname === {{ browse_path | tojson }}) $("folders").open = true;

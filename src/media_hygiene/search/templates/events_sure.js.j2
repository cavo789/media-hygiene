{# Included in the Events view of the search (`search_events.js.j2`, 0438; review-sort's until 0439): the events whose proposal is sure
   (`sort_sure`) accepted at once, in one write read back from the disk, and taken back
   whole by one button; the filter that keeps only the events left to decide. Same
   mechanics as the obvious burst series (review_obvious.js.j2). #}
  let lastBatch = [];  // the events the last batch accepted: the undo button takes them back

  const onlyToDecide = () => byId("onlyDecide").checked;
  const onlySure = () => byId("onlySure").checked;
  const onlyUnsorted = () => byId("onlyUnsorted").checked;  // 0398
  const toDecide = (card) => isOpen(card) && !card.sure;
  const visible = (card) => (!onlyToDecide() || toDecide(card)) && (!onlySure() || (card.sure && isOpen(card))) && (!onlyUnsorted() || unsorted(card));
  const sureTodo = () => events.filter((card) => card.sure && isOpen(card));
  const filesIn = (cards) => cards.reduce((count, card) => count + card.files, 0);

  const showSure = () => {
    const todo = sureTodo();
    const button = byId("sure");
    button.disabled = todo.length === 0;
    button.textContent = todo.length === 0 ? T.sureNone : fill(T.sure, { sure: counted(T.nSure, todo.length), files: counted(T.nFiles, filesIn(todo)) });
    const undo = byId("sureUndo");
    undo.hidden = lastBatch.length === 0;
    undo.textContent = fill(T.sureUndo, { events: counted(T.nEvents, lastBatch.length) });
  };

  // One request, one write; the page then shows the events as the disk holds them.
  const sendBatch = async (ids, undo) => {
    setStatus(T.saving);
    let response;
    try {
      response = await fetch(P.sure, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ events: ids, undo: undo }) });
    } catch (error) { setStatus(T.offline, "error"); return null; }
    const answer = await response.json().catch(() => ({}));
    if (!response.ok) { setStatus(answer.error || fill(T.failed, { status: response.status }), "error"); return null; }
    const byEvent = new Map(answer.events.map((card) => [card.id, card]));
    events = events.map((card) => byEvent.get(card.id) || card);
    drawEvent(events[current]);
    showTotals();
    return answer;
  };

  // The confirmation lists the events, each one a link that shows it on the page (0388).
  const sureLine = (card) => {
    const item = document.createElement("li");
    const link = line("button", card.title);
    link.type = "button";
    link.addEventListener("click", () => {
      byId("sureDlg").close();
      const index = events.findIndex((other) => other.id === card.id);
      if (index >= 0) load(index);
    });
    const moves = counted(T.nFiles, card.moves);
    item.append(link, document.createTextNode(" · " + moves + " → " + (card.folder || T.stay)));
    return item;
  };
  const acceptSure = () => {
    const todo = sureTodo();
    if (todo.length === 0) { setStatus(T.sureNone); return; }
    const left = events.filter(isOpen).length - todo.length;
    const moves = todo.reduce((count, card) => count + card.moves, 0);
    const kept = todo.reduce((count, card) => count + card.kept, 0);
    byId("sureAsk").textContent = fill(T.sureAsk, { count: todo.length, moves: counted(T.nFiles, moves), kept: counted(T.nFiles, kept), left: left });
    byId("sureList").replaceChildren(...todo.map(sureLine));
    byId("sureDlg").showModal();
  };
  const sendSure = async () => {
    byId("sureDlg").close();
    const todo = sureTodo();
    if (todo.length === 0) return;
    const answer = await sendBatch(todo.map((card) => card.id), false);
    if (!answer) return;
    lastBatch = answer.events.map((card) => card.id);
    showSure();
    setStatus(fill(T.sureDone, { done: counted(T.nSureDone, answer.changed), time: new Date(answer.modified).toLocaleTimeString() }), "saved");
  };
  byId("sureNo").textContent = T.cancel;
  byId("sureYes").textContent = T.sureAccept;
  byId("sureNo").addEventListener("click", () => byId("sureDlg").close());
  byId("sureYes").addEventListener("click", sendSure);

  const undoSure = async () => {
    if (lastBatch.length === 0) { setStatus(T.nothingToUndo); return; }
    const answer = await sendBatch(lastBatch, true);
    if (!answer) return;
    lastBatch = [];
    showSure();
    setStatus(fill(T.sureUndone, { undone: counted(T.nUndone, answer.changed), time: new Date(answer.modified).toLocaleTimeString() }), "saved");
  };

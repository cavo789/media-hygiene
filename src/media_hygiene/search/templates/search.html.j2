{% extends "page_frame.html.j2" %}
{# The page of `media-hygiene search`: the field and its filters in the left column, above
   the keys, a grid of the files found with their folder, date and tags. The photos are
   never changed: files picked can be set aside, saved at once in the decisions file for
   `clean --decisions`. The left column, the one bar above the grid (0305), the picking,
   its keys and the large view are those of `browse` (`pick_*` in review/templates), so
   both pages work the same; this page's own script is `search.js.j2`. "/" goes back to
   the field. Opened from the home page, *Apply now* ends the page on the home step that
   applies the decisions (`apply_now.html.j2`). #}
{% set texts = {
  "found": [ngettext("{n} file found.", "{n} files found.", 1), ngettext("{n} file found.", "{n} files found.", 2)],
  "shown": _("{total} files found; the first {shown} are shown."),
  "none": _("Nothing found. Fewer words, or the start of a word (anniv*), find more."),
  "offline": _("The search is not running any more: start it again."),
  "failed": _("The search failed (error {status})."),
  "noPreview": _("No preview"),
  "picked": [ngettext("{n} file picked", "{n} files picked", 1), ngettext("{n} file picked", "{n} files picked", 2)],
  "allFound": _("Pick all {total} files found"),
  "allPicked": _("All {total} files found are picked"),
  "aside": _("marked to set aside"),
  "tick": _("Pick this file"),
  "noAlbum": _("Type the album's name in the bar first: then A adds the file shown."),
  "saving": _("Saving…"),
  "notSaved": _("Nothing was saved: {error}"),
  "unname": _("Not {name}: take this name off the photo (saved in config.toml)"),
  "putBack": _("Put back"),
  "why": _("Why {name}? Click to see the face that gave this name"),
  "whyTitle": _("Why {name}?"),
  "reference": _("The face of reference that gave the name:"),
  "yes": _("Yes, it is {name}"),
  "not": _("Not {name}"),
  "notDescribed": _("What the photos show is not known yet: {described} of {files} files described. The words found today come from folders, names, dates, places and people. 👉 Describe the photos: 🤖 mh tags (or its step on the home page)."),
  "noneWhy": _("This word may only come from what the photos show: not described yet."),
  "noneYet": _(" — none yet"),
} %}
{% set sources = {
  "vision": _("seen by the model"),
  "folder": _("folder"),
  "name": _("file name"),
  "former": _("name of a removed copy"),
  "date": _("date"),
  "place": _("place"),
  "person": _("person"),
  "takeout": _("Google Photos description"),
} %}
{# What each source of "Words of" holds, where it comes from (0346). #}
{% set explained = {
  "vision": _("the words the vision model gave to what the photo shows (🤖 tags)."),
  "caption": _("the model's whole sentence: for a phrase in quotes."),
  "folder": _("the meaningful words of the folders' names."),
  "name": _("the words of a name someone chose (none for IMG_1234)."),
  "former": _("the folders and name a duplicate had before clean removed it, kept on the copy that stayed."),
  "date": _("the year, month, season and holidays of the date taken."),
  "place": _("the town and your own places where the photo was taken."),
  "person": _("the names given to the faces on the people page."),
  "takeout": _("the description typed in Google Photos (a Takeout export)."),
} %}
{% set page_name = _("Search your photos") %}
{% set pick_all = _("every file shown") %}
{% set pick_search_key = true %}
{% set keys_safe = _("Nothing is deleted from this page: the files set aside go to the quarantine at the next 'clean --decisions', journaled; 'undo' brings them back, 'purge' frees the space.") %}
{% block style %}
{% include "pick_grid.css.j2" %}
  /* The field and its filters, one under the other, in the left column. */
  #toc { flex: none; }
  form { display: flex; flex-direction: column; gap: 6px; }
  form label { display: flex; flex-direction: column; }
  form input, form select { width: 100%; }
  #text { font-size: 1.05rem; }
  .years { display: flex; gap: 8px; }
  .years label { flex: 1; }
  #syntax { margin-top: 6px; color: var(--muted); }
  #syntax ul { margin: 4px 0; padding-left: 18px; }
  #syntax dt { margin-top: 4px; color: var(--text); }
  #syntax dd { margin: 0 0 0 12px; }
  #coverage { margin: 6px 0 0; color: var(--muted); }
  #syntax summary { cursor: pointer; }
  #syntax p { margin: 4px 0 0; }
  .folderLine, .caption { overflow-wrap: anywhere; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .chip { padding: 0 6px; border-radius: 10px; background: var(--chip); }
  .chip .unname { margin-left: 4px; padding: 0 4px; border: 0; border-radius: 50%; font: inherit;
                  line-height: 1.2; background: transparent; color: var(--muted); cursor: pointer; }
  .chip .unname:hover { background: var(--bad); color: #fff; }
  .putBack { margin-left: 6px; }
  #viewerInfo .chips { justify-content: center; }
  .chip.person { cursor: help; }
  #why { position: fixed; inset: 0; z-index: 5; display: flex; align-items: center;
         justify-content: center; padding: 16px; background: rgba(0, 0, 0, .5); }
  #why[hidden] { display: none; }
  #why .box { max-width: 40rem; max-height: calc(100vh - 32px); overflow: auto; padding: 12px 16px;
              border-radius: 10px; background: var(--card); color: var(--text); }
  #why h2 { margin: 0 0 8px; font-size: 1.05rem; }
  #why .face { display: flex; gap: 12px; align-items: flex-start; margin: 8px 0;
               padding: 8px 0; border-top: 1px solid var(--line); }
  #why img { width: 120px; height: 120px; object-fit: cover; border-radius: 8px;
             background: var(--chip); }
  #why .reference img { width: 72px; height: 72px; }
  #why .reference { display: flex; gap: 8px; align-items: center; overflow-wrap: anywhere; }
  #why .buttons { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
  #whySaid { color: var(--muted); }
{% endblock %}
{% block side %}
    {% set pick_view = "words" %}
    {% include "pick_views.html.j2" %}
    <section id="toc" aria-label="{{ _('Search your photos') }}">
    <form id="form">
      <label>{{ _("Words") }}
        <input id="text" type="search" autocomplete="off"
               placeholder="{{ _('e.g. Durbuy bear, birthday cake, snow 2008') }}"></label>
      <div class="years">
        <label>{{ _("From year") }}<input id="from" type="number" min="1800" max="2200"></label>
        <label>{{ _("To year") }}<input id="to" type="number" min="1800" max="2200"></label>
      </div>
      <label>{{ _("Path contains") }}<input id="folder" type="text"></label>
      <label>{{ _("Words of") }}
        <select id="source">
          <option value="">{{ _("every source") }}</option>
          {% for value, label in sources.items() %}
          <option value="{{ value }}">{{ label }}</option>
          {% endfor %}
          <option value="caption">{{ _("the model's sentence") }}</option>
        </select></label>
      <button type="submit">{{ _("Search") }}</button>
    </form>
    <p id="coverage" role="status" hidden></p>
    <details id="syntax">
      <summary>{{ _("How to write a search") }}</summary>
      <ul>
        <li>{{ _("Every word must be found: type one to three words (beach, cake candles), not a sentence.") }}</li>
        <li>{{ _("For the model, people are adult, child, baby or group: find someone by their name.") }}</li>
        <li id="tipSentence">{{ _("A sentence (an old man in a garden) needs search by meaning: 🤖 mh tags --meaning.") }}</li>
        <li id="tipMeaning" hidden>{{ _("Sentences work too: search by meaning is on.") }}</li>
      </ul>
      <p>{{ _('"bord de mer" finds the phrase, anniv* every word starting so, place:durbuy the word among the places only.') }}</p>
      <dl id="sourceList">
        <dt>{{ _("every source") }}</dt><dd>{{ _("any of them (the default).") }}</dd>
        {% for value, text in explained.items() %}
        <dt data-source="{{ value }}">{{ sources.get(value, _("the model's sentence")) }} <code>{{ value }}:</code><span class="none" hidden>{{ texts.noneYet }}</span></dt><dd>{{ text }}</dd>
        {% endfor %}
      </dl>
    </details>
    </section>
{% endblock %}
{% block keys %}{% include "pick_keys.html.j2" %}{% endblock %}
{% block more_keys %}{% include "pick_keys_more.html.j2" %}
    <dt><kbd>W</kbd></dt><dd>{{ _("opened: why this person's name (the face, its reference)") }}</dd>
{% endblock %}
{% block bar %}
    {% include "pick_acting.html.j2" %}
    {% set album_compact = true %}
    {% include "album_bar.html.j2" %}
{% endblock %}
{% block content %}
  <main id="grid"></main>
{% endblock %}
{% block after %}
{% include "pick_viewer.html.j2" %}
<div id="why" role="dialog" aria-modal="true" aria-labelledby="whyTitle" hidden>
  <div class="box">
    <h2 id="whyTitle"></h2>
    <div id="whyFaces"></div>
    <p id="whySaid" role="status"></p>
    <button id="whyClose" type="button">{{ _("Close") }} (Esc)</button>
  </div>
</div>
<script>
{% include "pick_grid.js.j2" %}
{% include "pick_viewer.js.j2" %}
{% include "pick_band.js.j2" %}
{% include "search.js.j2" %}
</script>
{% endblock %}

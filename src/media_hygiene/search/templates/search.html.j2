{% extends "page_frame.html.j2" %}
{# The page of `media-hygiene search`: the field and its filters in the left column, above
   the keys, a grid of the files found with their folder, date and tags. The photos are
   never changed: files picked can be set aside, saved at once in the decisions file for
   `clean --decisions`. The left column, the one bar above the grid (0305), the picking,
   its keys and the large view are those of `browse` (`pick_*` in review/templates), so
   both pages work the same; this page's own script is `search.js.j2`. "/" goes back to
   the field. Opened from the home page, *Apply now* ends the page on the home step that
   applies the decisions (`apply_now.html.j2`). #}
{% set texts = {
  "found": [ngettext("{n} file found.", "{n} files found.", 1), ngettext("{n} file found.", "{n} files found.", 2)],
  "shown": _("{total} files found; the first {shown} are shown."),
  "none": _("Nothing found. Fewer words, or the start of a word (anniv*), find more."),
  "offline": _("The search is not running any more: start it again."),
  "failed": _("The search failed (error {status})."),
  "noPreview": _("No preview"),
  "picked": [ngettext("{n} file picked", "{n} files picked", 1), ngettext("{n} file picked", "{n} files picked", 2)],
  "allFound": _("Pick all {total} files found"),
  "allPicked": _("All {total} files found are picked"),
  "aside": _("marked to set aside"),
  "tick": _("Pick this file"),
  "noAlbum": _("Type the album's name in the bar first: then A adds the file shown."),
  "saving": _("Saving…"),
  "notSaved": _("Nothing was saved: {error}"),
} %}
{% set sources = {
  "vision": _("seen by the model"),
  "folder": _("folder"),
  "name": _("file name"),
  "former": _("name of a removed copy"),
  "date": _("date"),
  "place": _("place"),
  "person": _("person"),
  "takeout": _("Google Photos description"),
} %}
{% set page_name = _("Search your photos") %}
{% set pick_all = _("every file shown") %}
{% set pick_search_key = true %}
{% set keys_safe = _("Nothing is deleted from this page: the files set aside go to the quarantine at the next 'clean --decisions', journaled; 'undo' brings them back, 'purge' frees the space.") %}
{% block style %}
{% include "pick_grid.css.j2" %}
  /* The field and its filters, one under the other, in the left column. */
  #toc { flex: none; }
  form { display: flex; flex-direction: column; gap: 6px; }
  form label { display: flex; flex-direction: column; }
  form input, form select { width: 100%; }
  #text { font-size: 1.05rem; }
  .years { display: flex; gap: 8px; }
  .years label { flex: 1; }
  #syntax { margin-top: 6px; color: var(--muted); }
  #syntax summary { cursor: pointer; }
  #syntax p { margin: 4px 0 0; }
  .folderLine, .caption { overflow-wrap: anywhere; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .chip { padding: 0 6px; border-radius: 10px; background: var(--chip); }
{% endblock %}
{% block side %}
    {% set pick_view = "words" %}
    {% include "pick_views.html.j2" %}
    <section id="toc" aria-label="{{ _('Search your photos') }}">
    <form id="form">
      <label>{{ _("Words") }}
        <input id="text" type="search" autocomplete="off"
               placeholder="{{ _('e.g. Durbuy bear, birthday cake, snow 2008') }}"></label>
      <div class="years">
        <label>{{ _("From year") }}<input id="from" type="number" min="1800" max="2200"></label>
        <label>{{ _("To year") }}<input id="to" type="number" min="1800" max="2200"></label>
      </div>
      <label>{{ _("Path contains") }}<input id="folder" type="text"></label>
      <label>{{ _("Words of") }}
        <select id="source">
          <option value="">{{ _("every source") }}</option>
          {% for value, label in sources.items() %}
          <option value="{{ value }}">{{ label }}</option>
          {% endfor %}
          <option value="caption">{{ _("the model's sentence") }}</option>
        </select></label>
      <button type="submit">{{ _("Search") }}</button>
    </form>
    <details id="syntax">
      <summary>{{ _("How to write a search") }}</summary>
      <p>{{ _('"bord de mer" finds the phrase, anniv* every word starting so, place:durbuy the word among the places only.') }}</p>
    </details>
    </section>
{% endblock %}
{% block keys %}{% include "pick_keys.html.j2" %}{% endblock %}
{% block more_keys %}{% include "pick_keys_more.html.j2" %}{% endblock %}
{% block bar %}
    {% include "pick_acting.html.j2" %}
    {% set album_compact = true %}
    {% include "album_bar.html.j2" %}
{% endblock %}
{% block content %}
  <main id="grid"></main>
{% endblock %}
{% block after %}
{% include "pick_viewer.html.j2" %}
<script>
{% include "pick_grid.js.j2" %}
{% include "pick_viewer.js.j2" %}
{% include "pick_band.js.j2" %}
{% include "search.js.j2" %}
</script>
{% endblock %}

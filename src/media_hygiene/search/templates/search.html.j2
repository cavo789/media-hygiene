  "chipsMore": _("The other active filters"),
  "counts": _("{photos} photos · {videos} videos · {size}"),
  "roleOpen": _("Role of this folder"),
  "roleWhy": {"protected": _("Protected: never changed; identical files elsewhere are set aside."), "preferred": _("Preferred: when copies differ only by folder, the copy here is kept."), "backups": _("Backup: only compared, never changed and never the reason a copy goes."), "excluded": _("Excluded: not read at all by the audit.")},
  "roleMissing": _("{folder} has the role {badge} but is gone (renamed or deleted?)"),
  "roleRemove": _("Remove"),
  "roleCarry": _("Carry the role to {folder}"),
  "roleSaving": _("Saving…"),
  "moveNamed": _("(your folder of another event, {name}: unticked)"),
  "moveNow": [ngettext("Move this file now", "Move these {n} files now", 1), ngettext("Move this file now", "Move these {n} files now", 2)],
  "moveReading": _("Reading where the photos picked lie…"),
  "moveUnticked": [ngettext("{n} source folder unticked: its files stay where they are.", "{n} source folders unticked: their files stay where they are.", 1), ngettext("{n} source folder unticked: its files stay where they are.", "{n} source folders unticked: their files stay where they are.", 2)],
  "ruleMove": _("You left {n} files aside: this is a move, not a rule. Sort them with the button below; the rule cannot say it."),

} %}
{% set sources = {
  "vision": _("seen by the model"),
  "folder": _("folder"),
  "name": _("file name"),
  "former": _("name of a removed copy"),
  "date": _("date"),
  "place": _("place"),
  "person": _("person"),
  "takeout": _("Google Photos description"),
  "hand": _("typed by hand"),
} %}
{# What each source of words holds, where it comes from (0346): written before a word
   (`folder:durbuy`), since the *Words of* list is gone (0463). #}
{% set explained = {
  "vision": _("the words the vision model gave to what the photo shows (🤖 tags)."),
  "caption": _("the model's whole sentence: for a phrase in quotes."),
  "folder": _("the meaningful words of the folders' names."),
  "name": _("the words of a name someone chose (none for IMG_1234)."),
  "former": _("the folders and name a duplicate had before clean removed it, kept on the copy that stayed."),
  "date": _("the year, month, season and holidays of the date taken."),
  "place": _("the town and your own places where the photo was taken."),
  "person": _("the names given to the faces on the people page."),
  "takeout": _("the description typed in Google Photos (a Takeout export)."),
  "hand": _("the words you gave the photos with 🏷 Tag…, kept in your settings."),
} %}
{% set page_name = _("Library") %}
{% set rule_title = _("Make it a rule") %}
{% set rule_update = true %}
{% set rule_go = true %}
{% set pick_all = _("every file shown") %}
{% set pick_search_key = true %}
{# No 🔒 line in the ⌨ panel (0463): it is the tooltip of ✅ Apply, and the help page's. #}
{% set apply_more = _("Nothing moves without your GO; every move is journaled: 'undo' puts it back. The files set aside go to the quarantine at the next 'clean --decisions'.") %}
{% set keys_safe = "" %}
{% set order_kind = false %}
{% block style %}
{% include "pick_grid.css.j2" %}
  .inAlbum .inAlbumMark { color: var(--good, var(--accent)); font-size: .8rem; font-weight: 600; }
  /* The field and its filters, one under the other, in the left column: as tall as they
     are, scrolled on their own once the open tree of folders is taller than the window. */
  #toc { flex: 0 1 auto; }
  /* The open tree scrolls on its own, the form above it staying in sight (0451). */
  #folders #tree { max-height: 45vh; overflow-y: auto; scrollbar-gutter: stable; }
  form { display: flex; flex-direction: column; gap: 6px; }
  form label { display: flex; flex-direction: column; }
  form input, form select { width: 100%; }
  #text { font-size: 1.05rem; }
  .years { display: flex; flex-wrap: wrap; gap: 8px; }
  .years label { flex: 1 1 8rem; }
  /* Today, this month, this year, any date: one click fills From and To, then searches. */
  .spans { display: flex; gap: 4px; }
  .spans button { flex: 1 1 auto; padding: 2px 4px; font-size: .8rem; white-space: nowrap; }
  #syntax { margin-top: 6px; color: var(--muted); }
  #syntax ul { margin: 4px 0; padding-left: 18px; }
  #syntax dt { margin-top: 4px; color: var(--text); }
  #syntax dd { margin: 0 0 0 12px; }
  #coverage { margin: 6px 0 0; color: var(--muted); }
  #syntax summary { cursor: pointer; }
  #syntax p { margin: 4px 0 0; }
{% include "search_cards.css.j2" %}
{% include "rule_dialog.css.j2" %}
{% include "folder_tree.css.j2" %}
{% include "search_events.css.j2" %}
  #folders summary { cursor: pointer; margin: 8px 0 4px; }
  /* Folded to one line (0471): opened, the tree floats over the page like *More keys*,
     the line keeps its place, nothing below it moves; Esc or a folder picked closes it. */
  #folders[open] > #tree { position: fixed; z-index: 4; left: calc(var(--mh-shell-left, 0px) + 16px);
                           width: min(28rem, calc(100vw - var(--mh-shell-left, 0px) - 32px));
                           /* below the shell's header (0595): its ⋯ reachable, never under it */
                           top: calc(var(--mh-shell-top-h, 0px) + 16px); max-height: calc(100vh - var(--mh-shell-top-h, 0px) - 32px); padding: 10px 12px; background: var(--card);
                           border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 4px 18px rgba(0, 0, 0, .3); }
{% include "combo_list.css.j2" %}
{% include "search_bar.css.j2" %}
{% endblock %}
{% block side %}
    {# Two tabs (0457): the search, or the events of the latest classify; kept per viewer. #}
    <div id="tabs" role="tablist" aria-label="{{ _('What the left column shows') }}">
      <button type="button" role="tab" id="tabPhotos" aria-controls="toc" aria-selected="true" title="{{ _('Search your photos') }}">🔎 {{ _("Photos") }}</button>
      <button type="button" role="tab" id="tabEvents" aria-controls="events" aria-selected="false" tabindex="-1" title="{{ _('The events of the latest classify, one by one') }}">🗂 {{ _("Events") }}</button>
    </div>
    <section id="toc" role="tabpanel" aria-labelledby="tabPhotos" aria-label="{{ _('Search your photos') }}">
    <form id="form">
      <label>{{ _("Words") }}
        <input id="text" type="search" autocomplete="off"
               placeholder="{{ _('e.g. Durbuy bear, birthday cake, snow 2008') }}"></label>
      <div class="years">
        <button type="button" id="dayBefore" class="plain step" disabled title="{{ _('The period before, as long (a day, a month)') }}" aria-label="{{ _('The period before') }}">◀</button>
        <label>{{ _("From") }}<input id="from" type="date" min="1800-01-01" max="2200-12-31"></label>
        <label>{{ _("To") }}<input id="to" type="date" min="1800-01-01" max="2200-12-31"></label>
        <button type="button" id="dayAfter" class="plain step" disabled title="{{ _('The period after, as long (a day, a month)') }}" aria-label="{{ _('The period after') }}">▶</button>
        <details class="dateMenu">
          <summary title="{{ _('Quick periods') }}" aria-label="{{ _('Quick periods') }}">📅 ▾</summary>
          <div class="spans" role="group" aria-label="{{ _('Quick periods') }}">
            <button type="button" class="plain" data-span="day" title="{{ _('Today') }}" aria-label="{{ _('Today') }}">📍 {{ _("Today") }}</button>
            <button type="button" class="plain" data-span="month" title="{{ _('This month') }}" aria-label="{{ _('This month') }}">🗓️ {{ _("Month") }}</button>
            <button type="button" class="plain" data-span="year" title="{{ _('This year') }}" aria-label="{{ _('This year') }}">📆 {{ _("Year") }}</button>
            <button type="button" class="plain" data-span="" title="{{ _('Any date') }}" aria-label="{{ _('Any date') }}">✕ {{ _("Clear") }}</button>
          </div>
        </details>
      </div>
      <label id="folderLabel" class="comboBox">{{ _("Path contains") }}<input id="folder" type="text" autocomplete="off"
               role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="folderList"
               title="{{ _('A part of the path. * is any characters, ? one character, /regex/ a regular expression: *.mov, /\\.(mov|mp4)$/') }}"
               placeholder="{{ _('e.g. 2019/Durbuy, *.mov, /\\.(mov|mp4)$/') }}">
        <button type="button" id="folderClear" class="plain comboClear" disabled title="{{ _('Empty the path, then the list of your folders again') }}" aria-label="{{ _('Empty the path') }}">✕</button>
        <ul id="folderList" class="comboList" role="listbox" aria-label="{{ _('Your folders, the latest first') }}" hidden></ul></label>
      {# The less used filters, folded (0665): an active one is a chip on line 1 of the bar
         (search_chips.js.j2), so nothing hidden narrows the results silently; open or folded
         is kept in the URL (`?filters=more`, view_state.html.j2). #}
      <details id="moreFilters">
        <summary title="{{ _('Album, kind, sorted, without a date or a place, place: an active one shows as a chip above the photos') }}">{{ _("More filters") }} ▾</summary>
        <label id="albumInLabel">{{ _("Album") }}
          <select id="albumIn" disabled title="{{ _('Name an album under 📚 Album: its files are marked, kept or left out') }}">
            <option value="">{{ _("In the album or not") }}</option>
            <option value="in">{{ _("In the album") }}</option>
            <option value="out">{{ _("Not in the album") }}</option>
          </select></label>
        <span class="segLabel">{{ _("Show") }}</span>
        <div class="seg" role="group" aria-label="{{ _('Show') }}">
          <input type="hidden" id="kind" value="all">
          <button type="button" data-for="kind" data-value="all" aria-pressed="true">{{ _("All") }}</button>
          <button type="button" data-for="kind" data-value="photos" aria-pressed="false" title="{{ _('Photos') }}">📷</button>
          <button type="button" data-for="kind" data-value="videos" aria-pressed="false" title="{{ _('Videos') }}">🎬</button>
          <button type="button" data-for="kind" data-value="aside" aria-pressed="false" title="{{ _('Only the files set aside, to see them or put some back before the quarantine') }}">🗑</button>
          <button type="button" id="asideLeave" class="plain" disabled title="{{ _('Leave the set aside: every file again') }}" aria-label="{{ _('Leave the set aside: every file again') }}">✕</button>
        </div>
        <span class="segLabel" title="{{ _('Sorted: in a year-month folder (2009/2009-11/…), as the sort convention puts them') }}">{{ _("Sorted") }}</span>
        <div class="seg" role="group" aria-label="{{ _('Sorted') }}">
          <input type="hidden" id="sorting" value="all">
          <button type="button" data-for="sorting" data-value="all" aria-pressed="true" title="{{ _('every photo') }}">{{ _("All") }}</button>
          <button type="button" data-for="sorting" data-value="sorted" aria-pressed="false" title="{{ _('sorted (year, then year-month)') }}">{{ _("sorted") }}</button>
          <button type="button" data-for="sorting" data-value="left" aria-pressed="false" title="{{ _('not sorted yet') }}">{{ _("not yet") }}</button>
        </div>
        <span class="segLabel" title="{{ _('The files the index knows no date or no position for: pick a group, then give it one') }}">{{ _("Without") }}</span>
        <div class="seg" role="group" aria-label="{{ _('Without') }}">
          <input type="hidden" id="missing" value="all">
          <button type="button" data-for="missing" data-value="all" aria-pressed="true" title="{{ _('every file') }}">{{ _("All") }}</button>
          <button type="button" data-for="missing" data-value="date" aria-pressed="false" title="{{ _('Without a date') }}">📅</button>
          <button type="button" data-for="missing" data-value="place" aria-pressed="false" title="{{ _('Without a place') }}">📍</button>
        </div>
        <label id="placeInLabel">{{ _("Place") }}
          <select id="placeIn" title="{{ _('The photos of one of your places: by their GPS, or given by hand') }}">
            <option value="">{{ _("Every place") }}</option>
          </select></label>
      </details>
      <p id="withinLine" hidden>📁 <span id="withinName"></span>
        <button type="button" id="withinClear" class="plain" title="{{ _('Search every folder again') }}">✕</button></p>
      <button type="submit" id="go" title="{{ _('Search (Enter; / comes back to Words)') }}">🔍 {{ _("Search") }}</button>
    </form>
    <button type="button" id="heaviest" class="plain" title="{{ _('The heaviest files of every folder: where the space goes') }}">⚖ {{ _("Heaviest files") }}</button>
    <details id="folders">
      <summary title="{{ _('Every folder as a tree; a click searches in it') }}">📁 {{ _("My folders") }} ▸</summary>
      <div id="tree" aria-label="{{ _('Your folders') }}"></div>
      <ul id="roleMissing" aria-label="{{ _('Folders with a role that are gone') }}"></ul>
    </details>
    <button type="button" id="ruleOpen" class="plain" hidden title="{{ _('Write this period down as a date rule of config.toml, after seeing the photos it would take and where each one would go') }}">📌 {{ _("Make it a rule") }}</button>
    <p id="coverage" role="status" hidden></p>
    <details id="syntax">
      <summary>{{ _("How to write a search") }}</summary>
      <ul>
        <li>{{ _("Every word must be found: type one to three words (beach, cake candles), not a sentence.") }}</li>
        <li>{{ _("For the model, people are adult, child, baby or group: find someone by their name.") }}</li>
        <li>{{ _("A sentence works too: Papy dans le jardin is read as Papy (a person named on the people page) and jardin; the little words go, as in the index.") }}</li>
        <li id="tipSentence">{{ _("A sentence (an old man in a garden) needs search by meaning: 🤖 mh tags --meaning.") }}</li>
        <li id="tipMeaning" hidden>{{ _("Sentences work too: search by meaning is on.") }}</li>
      </ul>
      <p>{{ _('"bord de mer" finds the phrase, anniv* every word starting so, place:durbuy the word among the places only.') }}</p>
      <p>{{ _("One source only: write its name and a colon before the word (folder:durbuy, name:anniv*):") }}</p>
      <dl id="sourceList">
        <dt>{{ _("every source") }}</dt><dd>{{ _("any of them (the default).") }}</dd>
        {% for value, text in explained.items() %}
        <dt data-source="{{ value }}">{{ sources.get(value, _("the model's sentence")) }} <code>{{ value }}:</code><span class="none" hidden>{{ texts.noneYet }}</span></dt><dd>{{ text }}</dd>
        {% endfor %}
      </dl>
    </details>
    {% include "tag_drop_list.html.j2" %}
    </section>
    {% include "search_events.html.j2" %}
    {% include "undo_toast.html.j2" %}
{% endblock %}
{% block keys %}{% include "pick_keys.html.j2" %}{% endblock %}
{% block more_keys %}{% include "pick_keys_more.html.j2" %}
{% include "search_events_keys.html.j2" %}
    <dt><kbd>W</kbd></dt><dd>{{ _("opened: why this person's name (the face, its reference)") }}</dd>
{% endblock %}
{% block bar %}
    {% set pick_first = "search_move_first.html.j2" %}
    {% include "pick_acting.html.j2" %}
    {% set order_best = true %}
    {% set order_rate = true %}
    {% set order_short = true %}
    {% include "pick_order.html.j2" %}
    <div class="seg" id="sizes" role="group" aria-label="{{ _('Thumbnail size') }}">
      <input type="hidden" id="size" value="m">
      <button type="button" data-for="size" data-value="s" aria-pressed="false" title="{{ _('Small: the photos only') }}">S</button>
      <button type="button" data-for="size" data-value="m" aria-pressed="true" title="{{ _('Medium') }}">M</button>
      <button type="button" data-for="size" data-value="l" aria-pressed="false" title="{{ _('Large: the whole caption and every word') }}">L</button>
    </div>
    {% set album_found = true %}
    {% include "album_bar.html.j2" %}
    <details id="moveBar" class="barPanel closesOnChoice">
      <summary class="plain" title="{{ _('Give the photos picked a tag, a day or a place') }}">🏷 {{ _("Describe") }} ▾</summary>
      <div class="panelBody" role="menu">
        <button type="button" id="tagOpen" class="plain" role="menuitem" data-key="T" disabled title="{{ _('Give the photos picked a word of yours, kept in your settings') }}">🏷 {{ _("Tag…") }}</button>
        <button type="button" id="dateOpen" class="plain" role="menuitem" data-key="D" disabled title="{{ _('Give the photos picked a day, in their .xmp sidecars') }}">📅 {{ _("Date…") }}</button>
        <button type="button" id="placeOpen" class="plain" role="menuitem" data-key="P" disabled title="{{ _('Put the photos picked in one of your places') }}">📍 {{ _("Place…") }}</button>
      </div>
    </details>
{% endblock %}
{% block content %}
  <main id="grid"></main>
  {# Reached by scrolling, the next files load by themselves (0463); the button stays for a keyboard. #}
  <p id="moreLine"><button id="more" class="plain" type="button" hidden>{{ _("Show more") }}</button></p>
{% endblock %}
{% block after %}

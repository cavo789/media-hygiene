<!DOCTYPE html>
{# The page of `media-hygiene search`: one field, a few filters, a grid of the files
   found with their folder, date and tags. The photos are never changed: files picked
   (a click or Space) can be set aside, saved at once in the decisions file for
   `clean --decisions`. Keyboard: "/" focuses the field, the arrows move in the grid,
   Space picks, Enter opens the picture, Escape closes it. #}
{% set texts = {
  "found": [ngettext("{n} file found.", "{n} files found.", 1), ngettext("{n} file found.", "{n} files found.", 2)],
  "shown": _("{total} files found; the first {shown} are shown."),
  "none": _("Nothing found. Fewer words, or the start of a word (anniv*), find more."),
  "offline": _("The search is not running any more: start it again."),
  "failed": _("The search failed (error {status})."),
  "original": _("Open the original"),
  "noPreview": _("No preview"),
  "picked": [ngettext("{n} file picked", "{n} files picked", 1), ngettext("{n} file picked", "{n} files picked", 2)],
  "allFound": _("Pick all {total} files found"),
  "allPicked": _("All {total} files found are picked"),
  "aside": _("marked to set aside"),
  "saving": _("Saving…"),
  "notSaved": _("Nothing was saved: {error}"),
} %}
{% set sources = {
  "vision": _("seen by the model"),
  "folder": _("folder"),
  "name": _("file name"),
  "former": _("name of a removed copy"),
  "date": _("date"),
  "place": _("place"),
  "person": _("person"),
  "takeout": _("Google Photos description"),
} %}
{% set page_name = _("Search your photos") %}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_name }} — media-hygiene</title>
<link rel="icon" type="image/png" href="/assets/images/favicon.png">
<style>
{% include "theme.css.j2" %}
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 400 15px/1.5 var(--mk-font-text); }
  header { position: sticky; top: 0; z-index: 1; padding: 12px 16px; background: var(--card);
           border-bottom: 1px solid var(--line); }
  .switch { font-size: 1.1rem; margin: 0 0 8px; display: flex; gap: 16px; align-items: baseline; }
  .switch a { font-size: .9rem; font-weight: 400; color: var(--accent); }
  form { display: flex; flex-wrap: wrap; gap: 8px; align-items: end; }
  label { display: flex; flex-direction: column; font-size: .8rem; color: var(--muted); }
  input, select { padding: 6px 8px; font: inherit; color: var(--text); background: var(--bg);
                  border: 1px solid var(--line); border-radius: 6px; }
  #text { width: min(520px, 100%); font-size: 1.05rem; }
  .year { width: 6.5em; }
  button { padding: 6px 14px; font: inherit; color: var(--on-accent); background: var(--accent);
           border: 1px solid var(--accent); border-radius: 6px; cursor: pointer; }
  .hint, #status { color: var(--muted); font-size: .85rem; margin: 6px 0 0; }
  #status.error { color: var(--bad); font-weight: 600; }
  main { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
         gap: 12px; padding: 16px; }
  .hit { background: var(--card); border: 2px solid var(--line); border-radius: 10px;
         overflow: hidden; cursor: pointer; outline: none; }
  .hit:focus, .hit.current { border-color: var(--accent); }
  .hit img, .hit .empty { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover;
                          background: var(--chip); }
  .hit .empty { display: flex; align-items: center; justify-content: center;
                color: var(--muted); font-size: .85rem; }
  .meta { padding: 6px 8px; font-size: .8rem; }
  .name { font-weight: 600; overflow-wrap: anywhere; }
  .folder, .caption { color: var(--muted); overflow-wrap: anywhere; }
  .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
  .chip { padding: 0 6px; border-radius: 10px; background: var(--chip); }
  #viewer { position: fixed; inset: 0; z-index: 2; display: none; flex-direction: column;
            align-items: center; justify-content: center; gap: 8px; padding: 16px;
            background: rgba(0, 0, 0, .88); color: #fff; }
  #viewer.open { display: flex; }
  #viewer img { max-width: 100%; max-height: calc(100vh - 90px); object-fit: contain; }
  #viewer a { color: #9cd0ff; }
  #actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
  #actions button.plain { color: var(--accent); background: transparent; }
  #actions button:disabled { opacity: .45; cursor: default; }
  #chosen { font-size: .85rem; margin: 6px 0 0; }
  #chosen.error { color: var(--bad); font-weight: 600; }
  .hit.picked { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent); }
  .hit { position: relative; }
  .badge { position: absolute; top: 6px; left: 6px; padding: 0 8px; border-radius: 10px;
           color: #fff; background: var(--bad); font-size: .75rem; font-weight: 600; }
</style>
</head>
<body>
{% include "page_header.html.j2" %}
<header>
  <p class="switch">🔒 <a href="{{ browse_path }}">{{ _("Your folders") }}</a></p>
  <form id="form">
    <label>{{ _("Words") }}
      <input id="text" type="search" autocomplete="off"
             placeholder="{{ _('e.g. Durbuy bear, birthday cake, snow 2008') }}"></label>
    <label>{{ _("From year") }}<input id="from" class="year" type="number" min="1800" max="2200"></label>
    <label>{{ _("To year") }}<input id="to" class="year" type="number" min="1800" max="2200"></label>
    <label>{{ _("Path contains") }}<input id="folder" type="text"></label>
    <label>{{ _("Words of") }}
      <select id="source">
        <option value="">{{ _("every source") }}</option>
        {% for value, label in sources.items() %}
        <option value="{{ value }}">{{ label }}</option>
        {% endfor %}
        <option value="caption">{{ _("the model's sentence") }}</option>
      </select></label>
    <button type="submit">{{ _("Search") }}</button>
  </form>
  <p class="hint">{{ _('"bord de mer" finds the phrase, anniv* every word starting so, place:durbuy the word among the places only. / types a search, the arrows move, a click or Space picks, Enter or a double click opens.') }}</p>
  <p id="status" role="status"></p>
  <div id="actions">
    <span id="picked"></span>
    <button id="pickAll" class="plain" type="button" hidden></button>
    <button id="setAside" type="button" disabled>{{ _("Set aside the picked files") }}</button>
    <button id="takeBack" class="plain" type="button" disabled>{{ _("Take out of the set aside") }}</button>
    <button id="unpick" class="plain" type="button" disabled>{{ _("Pick none") }}</button>
  </div>
  <p id="chosen" role="status"></p>
  {% include "album_bar.html.j2" %}
  <p class="hint">{{ _("Nothing is deleted from this page: the files set aside go to the quarantine at the next 'clean --decisions', journaled; 'undo' brings them back, 'purge' frees the space.") }}</p>
</header>
<main id="grid"></main>
<div id="viewer" role="dialog" aria-modal="true">
  <img id="large" alt="">
  <div><span id="viewerName"></span> — <a id="originalLink" target="_blank" rel="noopener">{{ texts.original }}</a></div>
</div>
<script>
"use strict";
const TEXTS = {{ texts | tojson }};
const SOURCES = {{ sources | tojson }};
const SEARCH_PATH = {{ search_path | tojson }};
const CHOSEN_PATH = {{ chosen_path | tojson }};
const $ = (id) => document.getElementById(id);
let cards = [];
let current = -1;
let asked = {};        // the search shown
let total = 0;         // how many files it finds
let everything = false; // every file found is picked, not only those shown
const picked = new Set(); // the keys of the files picked

function fill(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, name) => (name in values ? values[name] : all));
}

const PLURAL = new Intl.PluralRules(document.documentElement.lang);

// A counted fragment: its singular and plural forms, the one the language uses for n.
function counted(forms, n) {
  return fill(forms[PLURAL.select(n) === "one" ? 0 : 1], { n: n });
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

function card(hit, index) {
  const node = element("article", "hit");
  node.tabIndex = 0;
  const picture = element("img");
  picture.loading = "lazy";
  picture.alt = hit.name;
  picture.src = hit.thumb;
  picture.addEventListener("error", () => picture.replaceWith(element("div", "empty", TEXTS.noPreview)));
  const meta = element("div", "meta");
  meta.append(element("div", "name", hit.name), element("div", "folder", hit.folder));
  if (hit.date) meta.append(element("div", "folder", hit.date));
  if (hit.caption) meta.append(element("div", "caption", hit.caption));
  const chips = element("div", "chips");
  for (const [source, words] of Object.entries(hit.tags)) {
    for (const word of words) {
      const chip = element("span", "chip", word);
      chip.title = SOURCES[source] || source;
      chips.append(chip);
    }
  }
  meta.append(chips);
  node.append(picture, meta);
  if (hit.chosen) node.append(element("span", "badge", TEXTS.aside));
  node.addEventListener("click", () => { select(index); pick(index); });
  node.addEventListener("dblclick", () => { select(index); open(); });
  node.addEventListener("focus", () => select(index));
  node.dataset.key = hit.key;
  node.dataset.preview = hit.preview;
  node.dataset.original = hit.original;
  node.dataset.name = hit.name;
  return node;
}

function select(index) {
  if (index < 0 || index >= cards.length) return;
  if (current >= 0 && cards[current]) cards[current].classList.remove("current");
  current = index;
  cards[current].classList.add("current");
  if (document.activeElement !== cards[current]) cards[current].focus();
}

function open() {
  const node = cards[current];
  if (!node) return;
  $("large").src = node.dataset.preview;
  $("large").alt = node.dataset.name;
  $("viewerName").textContent = node.dataset.name;
  $("originalLink").href = node.dataset.original;
  $("viewer").classList.add("open");
}

function close() { $("viewer").classList.remove("open"); }

function pick(index) {
  const node = cards[index];
  if (!node) return;
  everything = false;
  const key = Number(node.dataset.key);
  if (picked.has(key)) picked.delete(key); else picked.add(key);
  showPicked();
}

function showPicked() {
  for (const node of cards) {
    node.classList.toggle("picked", everything || picked.has(Number(node.dataset.key)));
  }
  const count = everything ? total : picked.size;
  $("picked").textContent = count ? counted(TEXTS.picked, count) : "";
  for (const id of ["setAside", "takeBack", "unpick"]) $(id).disabled = !count;
  if (window.mhAlbumPicked) window.mhAlbumPicked(count); // album_bar.html.j2
  const button = $("pickAll");
  button.hidden = total <= cards.length && !everything;
  button.disabled = everything;
  button.textContent = fill(everything ? TEXTS.allPicked : TEXTS.allFound, { total: total });
}

// What *Add to the album* adds: the files picked, or every file the search finds.
window.mhAlbumPick = () => ({ keys: [...picked], all: everything, search: asked });

function said(answer, state) {
  const line = $("chosen");
  line.className = answer.ok ? "" : "error";
  line.textContent = answer.ok ? state.message : fill(TEXTS.notSaved, { error: state.error || answer.status });
}

async function choose(action) {
  const body = { action: action, keys: [...picked], all: everything, search: asked };
  $("chosen").className = "";
  $("chosen").textContent = TEXTS.saving;
  let answer;
  try {
    answer = await fetch(CHOSEN_PATH, {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
    });
  } catch (error) {
    $("chosen").className = "error";
    $("chosen").textContent = TEXTS.offline;
    return;
  }
  const state = await answer.json().catch(() => ({}));
  said(answer, state);
  if (!answer.ok) return;
  picked.clear();
  everything = false;
  await search();
}

async function loadChosen() {
  try {
    const answer = await fetch(CHOSEN_PATH);
    said(answer, await answer.json());
  } catch (error) { /* the search says when the server is gone */ }
}

function columns() {
  if (cards.length < 2) return 1;
  const top = cards[0].offsetTop;
  const count = cards.findIndex((node) => node.offsetTop !== top);
  return count < 0 ? cards.length : count;
}

async function search(event) {
  if (event) event.preventDefault();
  const year = (id) => ($(id).value ? Number($(id).value) : null);
  const body = {
    text: $("text").value, year_from: year("from"), year_to: year("to"),
    folder: $("folder").value, source: $("source").value || null,
  };
  if (event || JSON.stringify(body) !== JSON.stringify(asked)) { picked.clear(); everything = false; }
  asked = body;
  const status = $("status");
  status.className = "";
  let answer;
  try {
    answer = await fetch(SEARCH_PATH, {
      method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
    });
  } catch (error) {
    status.className = "error";
    status.textContent = TEXTS.offline;
    return;
  }
  if (!answer.ok) {
    status.className = "error";
    status.textContent = fill(TEXTS.failed, { status: answer.status });
    return;
  }
  const found = await answer.json();
  cards = found.hits.map(card);
  current = -1;
  total = found.total;
  $("grid").replaceChildren(...cards);
  showPicked();
  if (!found.total) status.textContent = TEXTS.none;
  else if (found.total > found.hits.length) {
    status.textContent = fill(TEXTS.shown, { total: found.total, shown: found.hits.length });
  } else status.textContent = counted(TEXTS.found, found.total);
  if (found.note) status.textContent = found.note + " " + status.textContent;
}

document.addEventListener("keydown", (event) => {
  const typing = ["INPUT", "SELECT"].includes(document.activeElement.tagName);
  if ($("viewer").classList.contains("open")) {
    if (event.key === "Escape") close();
    else if (event.key === "ArrowRight") { select(current + 1); open(); }
    else if (event.key === "ArrowLeft") { select(current - 1); open(); }
    else return;
    event.preventDefault();
    return;
  }
  if (event.key === "/" && !typing) { event.preventDefault(); $("text").focus(); return; }
  if (typing && event.key !== "ArrowDown") return;
  const moves = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: columns(), ArrowUp: -columns() };
  if (event.key in moves) {
    event.preventDefault();
    select(current < 0 ? 0 : current + moves[event.key]);
  } else if (event.key === "Enter" && current >= 0) {
    event.preventDefault();
    open();
  } else if (event.key === " " && current >= 0) {
    event.preventDefault();
    pick(current);
  }
});
$("pickAll").addEventListener("click", () => { everything = true; showPicked(); });
$("unpick").addEventListener("click", () => { picked.clear(); everything = false; showPicked(); });
$("setAside").addEventListener("click", () => choose("add"));
$("takeBack").addEventListener("click", () => choose("remove"));
$("viewer").addEventListener("click", (event) => { if (event.target.tagName !== "A") close(); });
$("form").addEventListener("submit", search);
$("text").focus();
search();
loadChosen();
</script>
{% include "home_link.html.j2" %}
</body>
</html>

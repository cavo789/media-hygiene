{# The script of the folder view (`browse.html.j2`): the tree, the files of a folder,
   the picking as in Explorer, the viewer, and the saving of what is set aside; the
   albums are `album_bar.html.j2`'s. #}
"use strict";
const TEXTS = {{ texts | tojson }};
const FOLDERS_PATH = {{ folders_path | tojson }};
const FOLDER_PATH = {{ folder_path | tojson }};
const CHOSEN_PATH = {{ chosen_path | tojson }};
const $ = (id) => document.getElementById(id);
const PLURAL = new Intl.PluralRules(document.documentElement.lang);
let folder = "";       // the folder shown (host path)
let files = [];        // its files, as the server listed them
let cards = [];
let current = -1;      // the card with the focus
let anchor = -1;       // where a Shift+click range starts
const picked = new Set(); // the keys of the files picked
let bandDrawn = false; // a rectangle just ended: the click that follows picks nothing

function fill(template, values) {
  return template.replace(/\{(\w+)\}/g, (all, name) => (name in values ? values[name] : all));
}

function counted(forms, n) {
  return fill(forms[PLURAL.select(n) === "one" ? 0 : 1], { n: n });
}

function element(tag, className, text) {
  const node = document.createElement(tag);
  if (className) node.className = className;
  if (text !== undefined) node.textContent = text;
  return node;
}

// Said in the line the bar always shows, whether files are picked or not.
function failed(answer) {
  $("chosen").className = "error";
  $("chosen").textContent = answer ? fill(TEXTS.failed, { status: answer.status }) : TEXTS.offline;
}

async function ask(path, body) {
  const options = body === undefined ? {} : {
    method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body),
  };
  try {
    return await fetch(path, options);
  } catch (error) {
    return null;
  }
}

// The tree: the mounted folders open, every folder below them closed.
function branch(node, children) {
  const item = element("li");
  const line = element("div", "node");
  const below = children.get(node.path) || [];
  const toggle = element("button", "toggle", below.length ? "▸" : "");
  toggle.type = "button";
  const button = element("button", "folder", node.name);
  button.type = "button";
  button.dataset.path = node.path;
  button.append(element("small", "", fill(TEXTS.counts, node)));
  line.append(toggle, button);
  item.append(line);
  if (below.length) {
    const list = element("ul");
    list.append(...below.map((child) => branch(child, children)));
    list.hidden = node.parent !== null;
    toggle.textContent = list.hidden ? "▸" : "▾";
    toggle.addEventListener("click", () => {
      list.hidden = !list.hidden;
      toggle.textContent = list.hidden ? "▸" : "▾";
    });
    item.append(list);
  }
  button.addEventListener("click", () => openFolder(node.path));
  return item;
}

async function loadTree() {
  const answer = await ask(FOLDERS_PATH);
  if (!answer || !answer.ok) { failed(answer); return; }
  const { folders } = await answer.json();
  const children = new Map();
  for (const node of folders) {
    if (!children.has(node.parent)) children.set(node.parent, []);
    children.get(node.parent).push(node);
  }
  const list = element("ul");
  list.append(...(children.get(null) || []).map((node) => branch(node, children)));
  $("tree").replaceChildren(list);
  $("status").textContent = TEXTS.choose;
}

function card(file, index) {
  const node = element("article", "file");
  node.tabIndex = 0;
  let picture;
  if (file.video) {
    picture = element("video");
    picture.preload = "metadata";
    picture.muted = true;
    picture.src = file.video + "#t=0.5";
  } else if (file.thumb) {
    picture = element("img");
    picture.loading = "lazy";
    picture.draggable = false; // a drag draws a rectangle (`browse_band.js.j2`)
    picture.alt = file.name;
    picture.src = file.thumb;
    picture.addEventListener("error", () => picture.replaceWith(element("div", "empty", TEXTS.noPreview)));
  } else picture = element("div", "empty", TEXTS.noPreview);
  const meta = element("div", "meta");
  meta.append(element("div", "name", file.name),
              element("div", "muted", [file.date, file.size].filter(Boolean).join(" · ")));
  // The box adds or takes out this file alone, without Ctrl (and on a touch screen).
  const tick = element("input", "tick");
  tick.type = "checkbox";
  tick.tabIndex = -1;
  tick.setAttribute("aria-label", TEXTS.tick);
  tick.addEventListener("click", (event) => {
    event.stopPropagation();
    focusOn(index);
    pick(index, { ctrlKey: true });
  });
  node.append(picture, meta, tick);
  if (file.chosen) node.append(element("span", "badge", TEXTS.aside));
  node.addEventListener("click", (event) => {
    if (bandDrawn) return; // the end of a rectangle, not a pick
    focusOn(index);
    pick(index, event);
  });
  node.addEventListener("dblclick", () => { focusOn(index); open(); });
  node.addEventListener("focus", () => focusOn(index));
  return node;
}

async function openFolder(path) {
  folder = path;
  for (const button of document.querySelectorAll(".folder")) {
    button.classList.toggle("open", button.dataset.path === path);
  }
  const answer = await ask(FOLDER_PATH, { folder: path, order: $("order").value });
  if (!answer || !answer.ok) { failed(answer); return; }
  files = (await answer.json()).files;
  cards = files.map(card);
  current = -1;
  anchor = -1;
  picked.clear();
  $("grid").replaceChildren(...cards);
  $("status").className = "";
  $("status").textContent = files.length ? path + " — " + counted(TEXTS.files, files.length) : TEXTS.empty;
  showPicked();
}

function focusOn(index) {
  if (index < 0 || index >= cards.length) return;
  if (current >= 0 && cards[current]) cards[current].classList.remove("current");
  current = index;
  cards[current].classList.add("current");
  if (document.activeElement !== cards[current]) cards[current].focus();
}

// As in Explorer: a click picks one file, Ctrl adds or removes, Shift a range.
function pick(index, event) {
  const key = files[index].key;
  if (event && event.shiftKey && anchor >= 0) {
    if (!event.ctrlKey) picked.clear();
    const [from, to] = [Math.min(anchor, index), Math.max(anchor, index)];
    for (let rank = from; rank <= to; rank += 1) picked.add(files[rank].key);
  } else if (event && (event.ctrlKey || event.metaKey || event.type === "keydown")) {
    if (picked.has(key)) picked.delete(key); else picked.add(key);
    anchor = index;
  } else {
    const only = picked.size === 1 && picked.has(key);
    picked.clear();
    if (!only) picked.add(key);
    anchor = index;
  }
  showPicked();
}

// The files not picked instead: quicker when a folder holds more to set aside than to keep.
function invert() {
  for (const file of files) {
    if (picked.has(file.key)) picked.delete(file.key); else picked.add(file.key);
  }
  showPicked();
}

function showPicked() {
  cards.forEach((node, index) => {
    const on = picked.has(files[index].key);
    node.classList.toggle("picked", on);
    node.querySelector(".tick").checked = on;
  });
  // The bar shows where you are, or, once a file is picked, what to do with the picking.
  const some = picked.size > 0;
  $("bar").classList.toggle("acting", some);
  $("lead").hidden = some;
  $("acting").hidden = !some;
  $("picked").textContent = some ? counted(TEXTS.picked, picked.size) : "";
  $("takeBack").hidden = !files.some((file) => file.chosen && picked.has(file.key));
  if (window.mhAlbumPicked) window.mhAlbumPicked(picked.size); // album_bar.html.j2
}

// What *Add to the album* adds: the files picked in the folder shown.
window.mhAlbumPick = () => ({ keys: [...picked], search: { folder: folder } });

function said(answer, state) {
  const line = $("chosen");
  line.className = answer.ok ? "" : "error";
  line.textContent = answer.ok ? state.message : fill(TEXTS.notSaved, { error: state.error || answer.status });
  if (window.mhApplyNow) window.mhApplyNow(answer.ok && state.count > 0); // apply_now.html.j2
}

async function choose(action) {
  if (!picked.size) return;
  $("chosen").className = "";
  $("chosen").textContent = TEXTS.saving;
  const body = { action: action, keys: [...picked], search: { folder: folder } };
  const answer = await ask(CHOSEN_PATH, body);
  if (!answer) { failed(null); return; }
  said(answer, await answer.json().catch(() => ({})));
  if (answer.ok) await openFolder(folder);
}

function open() {
  const file = files[current];
  if (!file) return;
  const movie = $("movie");
  const large = $("large");
  movie.hidden = !file.video;
  large.hidden = Boolean(file.video);
  if (file.video) { movie.src = file.video; } else { movie.removeAttribute("src"); large.src = file.preview; }
  large.alt = file.name;
  $("viewerName").textContent = file.name;
  $("originalLink").href = file.original;
  $("viewer").classList.add("open");
}

function close() {
  $("movie").pause();
  $("viewer").classList.remove("open");
}

function columns() {
  if (cards.length < 2) return 1;
  const top = cards[0].offsetTop;
  const count = cards.findIndex((node) => node.offsetTop !== top);
  return count < 0 ? cards.length : count;
}

document.addEventListener("keydown", (event) => {
  if ($("viewer").classList.contains("open")) {
    if (event.key === "Escape") close();
    else if (event.key === "ArrowRight") { focusOn(current + 1); open(); }
    else if (event.key === "ArrowLeft") { focusOn(current - 1); open(); }
    else return;
    event.preventDefault();
    return;
  }
  if (["SELECT", "INPUT"].includes(document.activeElement.tagName)) return; // an album's name
  if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "a") {
    event.preventDefault();
    for (const file of files) picked.add(file.key);
    showPicked();
    return;
  }
  if (event.key.toLowerCase() === "i" && !event.ctrlKey && !event.metaKey && !event.altKey) {
    event.preventDefault();
    invert();
    return;
  }
  const moves = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: columns(), ArrowUp: -columns() };
  if (event.key in moves && cards.length) {
    event.preventDefault();
    focusOn(current < 0 ? 0 : current + moves[event.key]);
  } else if (event.key === "Enter" && current >= 0 && document.activeElement.classList.contains("file")) {
    event.preventDefault();
    open();
  } else if (event.key === " " && current >= 0 && document.activeElement.classList.contains("file")) {
    event.preventDefault();
    pick(current, event);
  } else if (event.key === "Delete") {
    event.preventDefault();
    choose("add");
  }
});
$("viewer").addEventListener("click", (event) => {
  if (!["A", "VIDEO"].includes(event.target.tagName)) close();
});
$("order").addEventListener("change", () => { if (folder) openFolder(folder); });
$("setAside").addEventListener("click", () => choose("add"));
$("takeBack").addEventListener("click", () => choose("remove"));
$("unpick").addEventListener("click", () => { picked.clear(); showPicked(); });
$("invert").addEventListener("click", invert);

async function loadChosen() {
  const answer = await ask(CHOSEN_PATH);
  if (answer) said(answer, await answer.json().catch(() => ({})));
}

loadTree();
loadChosen();

{# The script of the folder view (`browse.html.j2`): the tree, the files of a folder or
   the heaviest ones. The picking, the bar and the saving are `pick_grid.js.j2`'s, the
   large view `pick_viewer.js.j2`'s, the albums `album_bar.html.j2`'s. #}
const TEXTS = {{ texts | tojson }};
const FOLDERS_PATH = {{ folders_path | tojson }};
const FOLDER_PATH = {{ folder_path | tojson }};
const HEAVIEST_PATH = {{ heaviest_path | tojson }};
const HEAVIEST_FIRST = {{ heaviest_first | tojson }};
const CHOSEN_PATH = {{ chosen_path | tojson }};
let folder = "";       // the folder shown (host path)
let heavy = false;     // the heaviest files of the library are shown instead
let limit = HEAVIEST_FIRST; // how many of them; *Show more* adds as many

async function loadTree() {
  const answer = await ask(FOLDERS_PATH);
  if (!answer || !answer.ok) { failed(answer); return; }
  const { folders } = await answer.json();
  const list = folderTree(folders, (node) => openFolder(node.path));  // folder_tree.js.j2
  // Above the folders: where the space goes, the videos first unless another kind is chosen.
  const heaviest = element("button", "folder heaviest", "⚖ " + TEXTS.heaviest);
  heaviest.type = "button";
  heaviest.append(element("small", "", TEXTS.heaviestHint));
  heaviest.addEventListener("click", () => {
    if ($("kind").value === "all") $("kind").value = "videos";
    limit = HEAVIEST_FIRST;
    openHeaviest();
  });
  $("tree").replaceChildren(heaviest, list);
  $("status").textContent = TEXTS.choose;
}

function card(file, index) {
  const node = element("article");
  let picture;
  if (file.video) {
    picture = element("video");
    picture.preload = "metadata";
    picture.muted = true;
    picture.src = file.video + "#t=0.5";
  } else if (file.thumb) {
    picture = element("img");
    picture.loading = "lazy";
    picture.draggable = false; // a drag draws a rectangle (`pick_band.js.j2`)
    picture.alt = file.name;
    picture.src = file.thumb;
    picture.addEventListener("error", () => picture.replaceWith(element("div", "empty", TEXTS.noPreview)));
  } else picture = element("div", "empty", TEXTS.noPreview);
  const meta = element("div", "meta");
  meta.append(element("div", "name", file.name),
              element("div", "muted", [file.date, file.size].filter(Boolean).join(" · ")));
  if (file.facts) meta.append(element("div", "muted", file.facts));
  if (file.where) meta.append(element("div", "muted where", file.where));
  node.append(picture, meta);
  return wireCard(node, index);
}

// The files listed take the grid; the tree marks where they come from.
function show(listed, again) {
  for (const button of document.querySelectorAll(".folder")) {
    button.classList.toggle("open", heavy ? button.classList.contains("heaviest") : button.dataset.path === folder);
  }
  showFiles(listed, again);
  $("more").hidden = true;
  $("status").className = "";
}

async function openFolder(path, again) {
  heavy = false;
  folder = path;
  const order = $("order").value === "rate" ? "size" : $("order").value; // a rate: the heaviest only
  const answer = await ask(FOLDER_PATH, { folder: path, order: order, kind: $("kind").value });
  if (!answer || !answer.ok) { failed(answer); return; }
  const { files: listed, holds } = await answer.json();
  show(listed, again);
  $("status").textContent = files.length ? path + " — " + counted(TEXTS.files, files.length) : hidden(holds);
}

// The heaviest files of every folder (0302): by size, or by bit rate for the videos.
async function openHeaviest(again) {
  heavy = true;
  folder = "";
  const order = $("order").value === "rate" ? "rate" : "size";
  const answer = await ask(HEAVIEST_PATH, { kind: $("kind").value, order: order, limit: limit });
  if (!answer || !answer.ok) { failed(answer); return; }
  const { files: listed, total } = await answer.json();
  show(listed, again);
  $("status").textContent = TEXTS.heaviest + " — " + total;
  $("more").hidden = listed.length < limit;
}

function reopen(again) {
  return heavy ? openHeaviest(again) : openFolder(folder, again);
}

// What the files shown are, sent with each choice and each album change.
function scope() {
  return { folder: folder };
}

// An empty grid: the folder holds nothing, or only what the **Show** filter hides.
function hidden(holds) {
  if ($("kind").value === "videos" && holds.photos) return counted(TEXTS.noVideo, holds.photos);
  if ($("kind").value === "photos" && holds.videos) return counted(TEXTS.noPhoto, holds.videos);
  return TEXTS.empty;
}

// **Sort by** and **Show** are kept for this viewer only: another folder opens the same way.
for (const id of ["order", "kind"]) {
  const select = $(id);
  try {
    const kept = localStorage.getItem("mh-browse-" + id);
    if ([...select.options].some((option) => option.value === kept)) select.value = kept;
  } catch (error) { /* no storage (private window): the defaults */ }
  select.addEventListener("change", () => {
    try { localStorage.setItem("mh-browse-" + id, select.value); } catch (error) { /* not kept */ }
    if (folder || heavy) reopen();
  });
}
$("more").addEventListener("click", () => { limit += HEAVIEST_FIRST; openHeaviest(); });

loadTree();
loadChosen();

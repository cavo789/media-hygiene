{# The texts of the *🗂 Events* view (0438), review-sort's msgids (kept, so its
   translations serve), as `ET` for `search_events.js.j2`. #}
{% set event_texts = {
  "position": _("Event {number} of {total}"),
  "saving": _("Saving…"),
  "failed": _("Not saved (error {status})."),
  "offline": _("The search is not running any more: start it again."),
  "first": _("This is the first event."),
  "last": _("This is the last event."),
} %}
const ET = {{ event_texts | tojson }};

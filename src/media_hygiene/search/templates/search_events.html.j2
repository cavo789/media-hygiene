{# *🗂 Events* (0437, 0438; a tab since 0457): the events of the latest classify plan in the left column, as
   review-sort showed them — its progress and runs, its three filters, the event's card —
   and its photos in the grid, the search's own tiles. The choices are review-sort's: the
   folder (F, Enter), the name (E), the picked photos to another folder (O) or left (S),
   the whole event left (Shift+S), a choice taken back (T), the sure proposals (V,
   Shift+Z), *Remember as a rule* (R), *Sort this event now* (M); each is saved at once
   in sort-decisions.json, read back. Delete sets aside, as on every tile page.
   Since 0572 the tab lists the events made from the index; their card (0574,
   `#spanChoice`, `search_events_span_card.js.j2`) says in one sentence where the files
   go, then three buttons: *Sort here now*, *Another folder…* (the bar's *Move to an
   event…*), *Do not sort this event*; *Undo my choice* once one is saved; *Remember as a
   rule* a plain link under them. The plan-based form and buttons stay hidden. #}
<section id="events" role="tabpanel" aria-labelledby="tabEvents" hidden>
  <h2 class="tabTitle">🗂 {{ _("Events not sorted yet") }}</h2>
  <p id="eventsSaid" class="muted" role="status"></p>
  {% include "search_events_trial.html.j2" %}
  <p id="eventsProgress" class="muted"></p>
  <details id="runs" hidden><summary>{{ _("The sort runs of this plan") }}</summary><ol id="runList"></ol></details>
  {% include "search_events_grouping.html.j2" %}
  <p id="eventsTotals" class="muted"></p>
  <label class="filter" title="{{ _('N, P and U skip the events already chosen and those whose proposal is sure') }}"><input type="checkbox" id="onlyDecide"> {{ _("Only the events to decide") }}</label>
  <label class="filter" title="{{ _('N and P walk only the events to decide whose proposal is sure, one by one, before accepting them') }}"><input type="checkbox" id="onlySure"> {{ _("Only the sure proposals") }}</label>
  <label class="filter" title="{{ _('N, P and U walk only the events with files still to move: neither sorted nor in place') }}"><input type="checkbox" id="onlyUnsorted"> {{ _("Only the events not sorted yet") }}</label>
  <p class="eventButtons">
    <button type="button" id="sure" hidden title="{{ _('Accept at once every event still to decide whose proposal is sure (V)') }}"></button>
    <button type="button" id="sureUndo" class="plain" title="{{ _('Take back the last batch of sure proposals (Shift+Z)') }}" hidden></button>
    <button type="button" id="rulesOpen" class="plain">📌 {{ _("Your rules") }}</button>
    <button type="button" id="setupOpen" class="plain writes" title="{{ _('The folder receiving the sorted tree and its shape, with a preview on your photos') }}">📐 {{ _("Where and how to sort") }}</button>
  </p>
  <section id="eventCard" hidden aria-label="{{ _('The event shown') }}">
    <p id="eventNav">
      <button type="button" id="prevEvent" class="plain" title="{{ _('Previous event (P)') }}" aria-label="{{ _('Previous event (P)') }}">←</button>
      <strong id="position"></strong>
      <button type="button" id="nextEvent" class="plain" title="{{ _('Next event (N)') }}" aria-label="{{ _('Next event (N)') }}">→</button>
    </p>
    <h3 id="eventTitle"></h3>
    <div id="eventSummary" class="muted"></div>
    <div id="spanChoice" hidden>
      <p id="spanGoes" role="status" aria-live="polite"></p>
      <p class="spanButtons">
        <button type="button" id="spanSort" class="primary writes" title="{{ _('Move the files of this event to the folder said above, journaled: undo puts them back. Then the next event to decide.') }}">{{ _("Sort here now") }}</button>
        <button type="button" id="spanOther" class="plain writes" title="{{ _('Choose another folder for the photos picked, or for the whole event when none is picked') }}">{{ _("Another folder…") }}</button>
        <button type="button" id="spanLeave" class="plain" title="{{ _('Its files stay where they are, the event counted as decided. Skipping it with → is not this: a skipped event stays to decide.') }}">{{ _("Do not sort this event") }}</button>
        <button type="button" id="spanUndo" class="plain" hidden title="{{ _('The event is to decide again') }}">{{ _("Undo my choice") }}</button>
        <button type="button" id="spanAlbum" class="plain writes" title="{{ _('An album named after this event, with its files shown, then opened. No photo is copied or moved.') }}">📚 {{ _("Make an album") }}</button>
        {% if tv_here | default(false) %}<button type="button" id="spanTv" class="plain" hidden data-path="{{ albums_path }}" data-sent="{{ _('Sent to the TV: its remote opens.') }}" data-sending="{{ _('Starting the show on the TV…') }}" title="{{ _('Show the files picked on the TV; nothing picked: every file of this event') }}">📺 {{ _("On the TV") }}</button>{% endif %}
      </p>
      <p><a href="#" id="spanRule" title="{{ _('Write this event down as a rule: its days, its folder; the next classify runs apply it') }}">📌 {{ _("Remember as a rule") }}</a></p>
    </div>
    <dl id="eventFacts"></dl>
    <p id="eventConflict" class="conflict" hidden></p>
    <form id="eventChoice" autocomplete="off">
      <label>{{ _("Folder") }} <kbd>F</kbd><span class="path"><span id="eventPrefix" class="muted"></span><input id="eventFolderIn"></span></label>
      <details id="eventNaming"><summary>{{ _("Name of the event") }} <kbd>E</kbd></summary><input id="eventNameIn"></details>
      <p id="eventSuggest" hidden>💡 {{ _("Proposed name:") }} <strong id="eventSuggestName"></strong> <button type="button" id="eventSuggestUse" class="plain" title="{{ _('Name the event so and save it; change it in the field above at any time') }}">{{ _("Use this name") }}</button></p>
    </form>
    <p id="destination" class="muted" role="status" aria-live="polite"></p>
    <p class="eventButtons">
      <button type="button" id="sortNow" title="{{ _('Save the folder, then move the files of this event only, journaled: undo puts them back (M)') }}">{{ _("Sort this event now") }}</button>
      <button type="button" id="eventRuleOpen" class="plain" title="{{ _('Write this event down as a rule of config.toml: its days, its folder; the next classify runs apply it (R)') }}">📌 {{ _("Remember as a rule") }}</button>
      <button type="button" id="sendPicked" class="plain">{{ _("Send to another folder (O)") }}</button>
      <button type="button" id="leavePicked" class="plain">{{ _("Leave where they are (S)") }}</button>
      <button type="button" id="stayEvent" class="plain">{{ _("Leave the whole event where it is (Shift+S)") }}</button>
      <button type="button" id="forgetChoice" class="plain">{{ _("Take back the choice made here (T)") }}</button>
    </p>
  </section>
  {% include "search_events_late.html.j2" %}
  {% include "search_events_found.html.j2" %}
  <ol id="eventList"></ol>
</section>

{# *🗂 Events* (0437, 0572): the events made from the index, read when the tab opens; one
   clicked shows its card (`search_events_span_card.js.j2`) and its photos in the grid,
   the search's own tiles. Delete sets aside as on every tile page, Backspace takes the
   picked files back out. The plan-based choices of review-sort left this page (0822). #}
{% include "search_events_texts.js.j2" %}
const SPAN_PATHS = {{ span_paths | tojson }};  // the events made from the index (0572)
let eventShown = null; // the event whose photos the grid shows
let showEvent = null;  // (id, again): an event shown, its tiles asked again

(() => {
  const T = ET;
  const P = {{ sort_paths | tojson }};
  const byId = $;
  let events = [];
  let current = -1;  // the event shown, in `events` (the frame of the grid is .current on a card)
  const setStatus = (text, kind) => {
    byId("chosen").textContent = text;
    byId("chosen").title = text;
    byId("chosen").className = kind || "";
  };
{% include "search_events_ahead.js.j2" %}
{% include "search_events_span.js.j2" %}
{% include "search_events_span_card.js.j2" %}
{% include "search_events_trial.js.j2" %}
  const load = (index) => loadSpan(index);
  const listEvents = () => {
    byId("eventList").replaceChildren(...events.map((card) => {
      const marks = (card.sorted ? "✓ " : "") + (card.left ? "⏸ " : "");
      const button = element("button", "plain", marks + card.title + " · " + counted(TEXTS.eventFiles, card.files));
      button.type = "button";
      button.title = card.span_text;
      button.classList.toggle("open", eventShown === card.id);
      button.addEventListener("click", () => load(events.indexOf(card)));
      const item = element("li");
      item.append(button);
      return item;
    }));
    if (!events.length) byId("eventList").append(element("li", "muted", TEXTS.spanNone));
  };
  const go = (step) => {
    const next = current + step;
    if (next < 0 || next >= events.length) { setStatus(next < 0 ? T.first : T.last); return; }
    setStatus("");
    load(next);
  };

  // After the keys of the shared grid: what it took (arrows, Space, Enter on a framed photo,
  // Ctrl+A, I, Delete, the keys of the large view) is not for the Events view.
  const EVENT_KEYS = { ...SPAN_KEYS, Backspace: () => choose("remove") };  // 0574
  document.addEventListener("keydown", (event) => {
    if (eventShown === null || current < 0 || byId("events").hidden) return;
    if (["ruleDlg", "trialDlg"].some((dialog) => byId(dialog).open)) return;
    if (event.defaultPrevented || byId("viewer").classList.contains("open")) return;
    if (event.key === "Escape") { document.activeElement.blur(); return; }
    const typing = ["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement.tagName);
    if (typing || event.ctrlKey || event.metaKey || event.altKey) return;
    const key = event.key.length === 1 && !event.shiftKey ? event.key.toLowerCase() : event.key;
    if (!(key in EVENT_KEYS) || (key === "Backspace" && !picked.size)) return;
    event.preventDefault();
    EVENT_KEYS[key]();
  });
  for (const [button, action] of Object.entries({ prevEvent: () => go(-1), nextEvent: () => go(1) })) byId(button).addEventListener("click", action);

  const loadEvents = () => loadSpans();
  showEvent = (wanted) => {
    const index = events.findIndex((card) => card.id === wanted);
    return index >= 0 ? load(index) : loadEvents();
  };
  // The two tabs (0457): Photos (the search) or Events; the choice kept per viewer.
  const showTab = (wanted) => {
    const onEvents = wanted === "events";
    byId("toc").hidden = onEvents;
    byId("events").hidden = !onEvents;
    for (const [id, on] of [["tabPhotos", !onEvents], ["tabEvents", onEvents]]) {
      byId(id).setAttribute("aria-selected", String(on));
      byId(id).tabIndex = on ? 0 : -1;
    }
    try { localStorage.setItem("mh-search-tab", wanted); } catch (error) { /* not kept */ }
    if (onEvents) { loadEvents(); trialOffer(); }
  };
  byId("tabPhotos").addEventListener("click", () => showTab("photos"));
  byId("tabEvents").addEventListener("click", () => showTab("events"));
  byId("tabs").addEventListener("keydown", (event) => {
    if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
    event.preventDefault();
    const wanted = byId("events").hidden ? "events" : "photos";
    showTab(wanted);
    byId(wanted === "events" ? "tabEvents" : "tabPhotos").focus();
  });
  // A search typed leaves the event: the grid shows what was searched.
  $("form").addEventListener("submit", () => { eventShown = null; current = -1; byId("eventCard").hidden = true; if (!byId("events").hidden) loadEvents(); else listEvents(); });
  // `/events`: the search, its Events tab shown.
  let kept = "photos";
  try { kept = localStorage.getItem("mh-search-tab") || "photos"; } catch (error) { /* not kept */ }
  showTab(window.location.pathname === {{ events_page | tojson }} ? "events" : kept);
})();

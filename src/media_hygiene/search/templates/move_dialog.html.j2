{# *Move to an event…* (0403): the photos picked go to `YYYY\YYYY-MM\<name>`, no rule
   written. The name proposed is that of your folder holding most of them; the files are
   shown by source folder, one tick box each (a folder you named after another event is
   unticked). The names offered are the event folders already in the month they go to,
   sub-folders written `France\Morzine`, in the list *Path contains* uses
   (`combo_list.js.j2`, 0487); a new name is typed as before. Its script is
   `move_dialog.js.j2`; the dialog's look is the rule dialog's. #}
<style>
  #moveDlg { max-width: min(32rem, 94vw); color: var(--text); background: var(--card);
             border: 1px solid var(--line); border-radius: 10px; }
  #moveDlg::backdrop { background: rgb(0 0 0 / 50%); }
  #moveDlg > form > label { display: flex; flex-direction: column; gap: 6px; margin: 6px 0; }
  #moveDlg { overflow: visible; }
  #moveDlg h2 { margin: 0 0 6px; } #moveDlg menu { display: flex; gap: 8px; justify-content: end; padding: 0; }
  .sources { list-style: none; padding: 0; margin: 6px 0; max-height: 40vh; overflow: hidden auto;
             scrollbar-width: thin; border: 1px solid var(--line); border-radius: 6px; }
  /* one row per folder: box at the left, text beside it (a long folder wraps under the text);
     the box's `width: auto` beats the shared `input { width: 100% }` of the form fields (0562) */
  .sources label { display: flex !important; flex-direction: row !important; gap: 8px; align-items: baseline;
                   margin: 0; padding: 4px 8px; cursor: pointer; overflow-wrap: anywhere; min-width: 0; }
  .sources li:nth-child(even) label { background: color-mix(in srgb, var(--line) 35%, transparent); }
  .sources label:hover { background: color-mix(in srgb, var(--line) 70%, transparent); }
  .sources input[type=checkbox] { width: auto; flex: none; margin: 0; }
  .sources .count { color: var(--muted); font-weight: 600; }
  .sources .why { color: var(--muted); font-size: .85rem; }
  #moveSaid.error { color: var(--bad); } #moveSaid.saved { color: var(--ok); }
  #moveBar { margin: 6px 0 0; }
</style>
<dialog id="moveDlg" aria-labelledby="moveTitle">
  <form id="moveForm" method="dialog" autocomplete="off">
    <h2 id="moveTitle">📂 {{ _("Move to an event") }}</h2>
    <p class="muted">{{ _("The photos picked go to the event's folder, under their year and month, journaled: 'undo' puts them back. No rule is written.") }}</p>
    <label class="comboBox">{{ _("Name of the event's folder") }} <input id="moveName" type="text" autocomplete="off" required
           role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="moveNames"
           title="{{ _('A folder of yours, or a new name; \\ between sub-folders') }}">
      <button type="button" id="moveClear" class="plain comboClear" disabled title="{{ _('Empty the name, then the list of your folders again') }}" aria-label="{{ _('Empty the name') }}">✕</button>
      <ul id="moveNames" class="comboList" role="listbox" aria-label="{{ _('Your event folders of that month') }}" hidden></ul></label>
    <p id="moveWhere" class="muted"></p>
    <ul id="moveSources" class="sources"></ul>
    <p id="moveSaid" class="muted" role="status"></p>
    <menu><button type="button" id="moveNo" class="plain" data-cancel="{{ _('Cancel') }}" data-close="{{ _('Close') }}">{{ _("Cancel") }}</button><button type="submit" id="moveGo" disabled>{{ _("Move them now") }}</button></menu>
  </form>
</dialog>

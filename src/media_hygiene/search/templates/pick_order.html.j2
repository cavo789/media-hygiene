{# **Sort by** and **Show**, the same on the folder view and the search (0347), in the bar
   after the picking. `order_best` (the search): *best match* first, the default; `order_rate`
   (the folders): the videos worst compressed first. The page's script reads `#order` and
   `#kind`, and lists the files again when they change. #}
    <label>{{ _("Sort by") }}
      <select id="order">
        {% if order_best | default(false) %}<option value="best">{{ _("best match") }}</option>{% endif %}
        <option value="name">{{ _("name") }}</option>
        <option value="date">{{ _("date") }}</option>
        <option value="size">{{ _("size, largest first") }}</option>
        {% if order_rate | default(false) %}<option value="rate" title="{{ _('The videos worst compressed for their length first: the best to lighten') }}">{{ _("bit rate (heaviest files)") }}</option>{% endif %}
      </select></label>
    <label>{{ _("Show") }}
      <select id="kind">
        <option value="all">{{ _("All") }}</option>
        <option value="photos">{{ _("Photos") }}</option>
        <option value="videos">{{ _("Videos") }}</option>
      </select></label>

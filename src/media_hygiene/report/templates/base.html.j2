<!DOCTYPE html>
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}media-hygiene{% endblock %}</title>
<style>
  {{ theme_tokens() }}
  * { box-sizing: border-box; }
  /* The system fonts (Segoe UI, Cascadia Mono on Windows): a file opened from disk loads none. */
  body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 var(--mk-font-text); }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
  h1, h2 { font-family: var(--mk-font-display); }
  code { font-family: var(--mk-font-mono); }
  h1 { font-size: 1.6rem; margin: 0 0 4px; }
  h2 { font-size: 1.2rem; margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .muted { color: var(--muted); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-top: 20px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .card .value { font-size: 1.6rem; font-weight: 650; }
  .card .label { color: var(--muted); font-size: .9rem; }
  table { width: 100%; border-collapse: collapse; background: var(--card); border: 1px solid var(--line);
          border-radius: 10px; overflow: hidden; }
  th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line); vertical-align: top;
           overflow-wrap: anywhere; }
  th { font-size: .85rem; color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  .group { display: flex; gap: 14px; background: var(--card); border: 1px solid var(--line);
           border-radius: 10px; padding: 12px; margin-bottom: 10px; }
  .thumb { flex: 0 0 96px; height: 96px; border-radius: 6px; background: var(--bg); display: flex;
           align-items: center; justify-content: center; font-size: 2rem; overflow: hidden; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb > a { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; }
  .thumb video { width: 100%; height: 100%; object-fit: contain; background: #000; }
  .files { list-style: none; margin: 0; padding: 0; min-width: 0; }
  .files li { overflow-wrap: anywhere; }
  .keep { color: var(--ok); } .remove { color: var(--bad); } .lock { color: var(--warn); }
  .samples { display: flex; gap: 4px; }
  .samples img { width: 48px; height: 48px; object-fit: cover; border-radius: 4px; }
  .badge { display: inline-block; margin-top: 4px; padding: 1px 8px; border-radius: 999px; font-size: .8rem;
           color: var(--ok); border: 1px solid var(--ok); }
  details { display: inline; } summary { display: inline; cursor: pointer; color: var(--accent); }
  details[open] { display: block; }
  code.command { display: block; margin-top: 4px; padding: 6px 8px; background: var(--bg); border-radius: 6px;
                 overflow-wrap: anywhere; user-select: all; }
  .note ul { margin: 6px 0 0; padding-left: 20px; }
  /* One frame per group or series: tired eyes still tell where one ends. */
  .shots { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; padding: 12px;
           border: 2px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--accent) 5%, var(--bg)); }
  .shots .caption { flex-basis: 100%; margin: 0; font-weight: 600; }
  .shot { margin: 0; flex: 0 1 220px; background: var(--card); border: 1px solid var(--line); border-radius: 10px;
          padding: 8px; font-size: .85rem; }
  .shot .thumb { width: 100%; height: 150px; flex: none; }
  .shot.keep { border-color: var(--ok); } .shot.remove { border-color: var(--bad); } .shot.lock { border-color: var(--warn); }
  .shot .path { overflow-wrap: anywhere; }
  .note { background: var(--card); border-left: 4px solid var(--accent); padding: 10px 14px; border-radius: 6px; }
  a { color: var(--accent); }
  .toc { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; margin: 20px 0; }
  .toc ul { margin: 6px 0 0; padding-left: 20px; columns: 2 220px; }
  h2[id] { scroll-margin-top: 12px; }
  select, button { font: inherit; color: var(--text); background: var(--card); border: 1px solid var(--line);
                   border-radius: 6px; padding: 2px 6px; }
  button { cursor: pointer; border-color: var(--accent); color: var(--accent); padding: 4px 12px; }
  button:disabled { cursor: default; opacity: .5; }
</style>
</head>
<body>
{% set header = report_header(report_kind) %}
<nav class="mh-bar" aria-label="Media Hygiene">
  <span class="mh-brand"><img src="{{ avatar_data_uri() }}" alt="" width="24" height="32">Media Hygiene</span>
  <span class="mh-page" aria-hidden="true">›</span>
  <span class="mh-page">{{ report_name }}</span>
{% if report_when is defined %}
  <span class="mh-page">· {{ report_when | when }}</span>
{% endif %}
  <span class="mh-links">
    <a class="mh-doc" href="{{ header.doc }}" target="_blank" rel="noopener">{{ _("Documentation") }}</a>
    <a class="mh-doc" href="{{ header.twin }}" target="_blank" rel="noopener" hreflang="{{ header.twin_lang }}" lang="{{ header.twin_lang }}">{{ header.twin_label }}</a>
  </span>
</nav>
<main>
{% block content %}{% endblock %}
</main>
<script>
  // The report is written in UTC: show its dates in the reader's time zone.
  for (const time of document.querySelectorAll("time[datetime]")) {
    const moment = new Date(time.dateTime);
    if (Number.isNaN(moment.getTime())) continue;
    const two = (number) => String(number).padStart(2, "0");
    time.textContent = `${moment.getFullYear()}-${two(moment.getMonth() + 1)}-${two(moment.getDate())}`
      + ` ${two(moment.getHours())}:${two(moment.getMinutes())}`;
  }
</script>
</body>
</html>

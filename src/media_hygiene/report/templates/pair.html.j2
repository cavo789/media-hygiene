{% extends "base.html.j2" %}
{% from "_disposal.html.j2" import removed_from_label, removed_label, disposal_icon, copies_legend %}
{% set pair = page.pair %}
{% block title %}{{ _("Folder pair") }} — {{ pair.removed_from }}{% endblock %}
{% block content %}
<p class="muted"><a href="../report.html">← {{ _("Back to the report") }}</a></p>
<h1>📁 {{ _("Folder pair") }}</h1>
<ul class="files">
  <li class="keep">✅ <span class="muted">{{ _("Kept in") }}</span> {{ pair.kept_in }}{% if pair.evidence.reasons %} <span class="muted">· {{ _("why:") }} {{ pair.evidence.reasons | join("; ") }}</span>{% endif %}</li>
  <li class="remove">{{ disposal_icon(pair.evidence.disposal) }} <span class="muted">{{ removed_from_label(pair.evidence.disposal, page.is_clean) }}</span> {{ pair.removed_from }}</li>
</ul>
<p>{{ ngettext("%(num)s copy", "%(num)s copies", pair.files, num=pair.files | number) }} · {{ pair.size | size }}{% if pair.evidence.complete %} · <span class="badge">{{ _("entirely a copy: holds nothing else") }}</span>{% endif %}</p>
{% if pair.evidence.samples %}<div class="samples">{% for sample in pair.evidence.samples %}<img src="../{{ sample }}" alt="" loading="lazy">{% endfor %}</div>{% endif %}
<h2>{{ _("Every copy") }}</h2>
<p class="muted">{{ copies_legend(pair.evidence.disposal) }}</p>
<table>
  <tr><th>{{ _("Kept") }}</th><th>{{ removed_label(pair.evidence.disposal, page.is_clean) }}</th><th class="num">{{ _("Size") }}</th><th>SHA-256</th></tr>
  {% for copy in page.copies %}
  <tr><td class="keep">{{ copy.kept }}</td><td class="remove">{% if copy.moved and pair.evidence.disposal == "mixed" %}📦 {% endif %}{{ copy.removed }}</td><td class="num">{{ copy.size | size }}</td><td class="muted"><code>{{ copy.digest[:16] }}…</code></td></tr>
  {% endfor %}
</table>
<p class="muted"><a href="../report.html">← {{ _("Back to the report") }}</a></p>
{% endblock %}

{# The table of contents of report.html and near.html: one entry per section shown. #}
{% set sections = [
  ("done", "✅ " ~ _("What this clean did"), report.done),
  ("untouched-later", "⏸️ " ~ _("Not touched by this clean"), report.done and (report.done.near_left or report.done.bursts_left)),
  ("untouched", "⚠️ " ~ _("Files left untouched"), report.incidents.failed or report.incidents.skipped),
  ("pairs", "📁 " ~ _("Folder pairs"), report.pairs),
  ("backups", "🗄️ " ~ _("Backup folders"), backups),
  ("intruders", "🧹 " ~ _("Intruder files"), intruders),
  ("sample", "🎲 " ~ _("Random sample"), report.groups.sample),
  ("groups", "🧬 " ~ _("Duplicate groups"), report.groups.largest),
  ("returned", "↩️ " ~ _("Back after being set aside"), report.returned.items),
  ("near", "🪞 " ~ _("Near duplicates"), report.similar.near),
  ("videos", "🎞️ " ~ _("Re-encoded videos"), report.similar.videos.groups),
  ("broken", "💔 " ~ _("Broken files"), report.broken.handled or report.broken.protected),
  ("orphans", "🏷️ " ~ _("Orphan sidecar files"), report.orphans.paths),
  ("bursts", "📸 " ~ _("Burst series"), report.similar.bursts),
] %}
{# The status of each chapter in an audit (0310): 🧹 clean, 👀 yours to decide, ℹ️ to know. #}
{% set status = {} if report.done else {"groups": "🧹", "broken": "🧹", "orphans": "🧹", "near": "👀", "videos": "👀", "bursts": "ℹ️"} %}
{% set on_page = ["near", "videos"] if near_page else sections | map(attribute=0) | list %}
{% set shown = sections | selectattr(2) | selectattr(0, "in", on_page) | list %}
{% if shown | length > 1 %}
<nav class="toc" aria-label="{{ _('Contents') }}">
  <strong>{{ _("Contents") }}</strong>
  <ul>{% for anchor, title, _items in shown %}<li><a href="#{{ anchor }}">{{ title }}</a>{% if anchor in status %} {{ status[anchor] }}{% endif %}</li>{% endfor %}</ul>
</nav>
{% endif %}

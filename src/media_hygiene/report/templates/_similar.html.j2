{# Near duplicates and re-encoded videos: included by report.html.j2 and near.html.j2. #}
{% from "_shots.html.j2" import shot, clip %}
{% set sim = report.similar %}
{% if sim.near %}
<h2 id="near">🪞 {{ _("Near duplicates") }}</h2>
{% if not near_page %}<p class="muted">📄 <a href="near.html">{{ _("The near duplicates and re-encoded videos alone, on one page") }}</a></p>{% endif %}
<p class="note">{{ _("The same picture saved again: resized, recompressed or without its date. They are not identical files, so a plain 'clean' leaves them alone; 'clean --tier near' moves the copies to the quarantine, where 'undo' finds them again. The highest resolution is kept. Compare each copy with the kept picture first.") }}</p>
{% for group in sim.near %}
<div class="shots">
  {% if group.why %}<p class="muted caption">💬 {{ group.why }}</p>{% endif %}
  {{ shot(group.kept, "✅ " ~ _("kept"), "keep") }}
  {% for item in group.copies %}{{ shot(item, "📦 " ~ _("to the quarantine with --tier near"), "remove") }}{% endfor %}
  {% for item in group.protected %}{{ shot(item, "🔒 " ~ _("protected folder, kept"), "lock") }}{% endfor %}
</div>
{% endfor %}
{% endif %}

{% if sim.videos.groups %}
<h2 id="videos">🎞️ {{ _("Re-encoded videos") }}</h2>
<p class="note">{{ _("The same video saved again: shared by a messaging app, converted or recompressed. Same length, same frames at the same moments, same date or none. They are not identical files, so a plain 'clean' leaves them alone; 'clean --tier near' moves the copies to the quarantine, where 'undo' finds them again. The highest resolution, then the largest file, is kept; between copies of the very same picture and sound, whose metadata alone differ, the usual rules choose (folder, name). Play each copy before choosing.") }}</p>
{% for group in sim.videos.groups %}
<div class="shots">
  {% if group.why %}<p class="muted caption">💬 {{ group.why }}</p>{% endif %}
  {{ clip(group.kept, "✅ " ~ _("kept"), "keep") }}
  {% for item in group.copies %}{{ clip(item, "📦 " ~ _("to the quarantine with --tier near"), "remove") }}{% endfor %}
  {% for item in group.protected %}{{ clip(item, "🔒 " ~ _("protected folder, kept"), "lock") }}{% endfor %}
</div>
{% endfor %}
{% endif %}

<!DOCTYPE html>
{# The TV's welcome page (0614): the plain door's bare address. Two tiles a TV remote
   drives (arrows, OK); the first one has the focus on load. No clock, no animation. #}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --bg: #f4f1ea; --fg: #222; --tile: #fff; --edge: #c9c2b4; --focus: #e07a1f; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #111; --fg: #ddd; --tile: #222; --edge: #444; --focus: #ffb35c; }
  }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 28px/1.4 sans-serif; text-align: center; }
  h1 { margin: 10vh 5vw 6vh; font-size: 2.2em; }
  h1 img { vertical-align: middle; margin-right: 0.4em; border-radius: 50%; }
  nav { display: flex; gap: 5vw; justify-content: center; flex-wrap: wrap; margin: 0 5vw; }
  a { display: block; width: 32vw; min-width: 260px; padding: 8vh 2vw; border: 4px solid var(--edge);
      border-radius: 24px; background: var(--tile); color: inherit; text-decoration: none; font-size: 1.3em; }
  a span { display: block; font-size: 2.6em; }
  a:focus { outline: 8px solid var(--focus); outline-offset: 6px; border-color: var(--focus); }
</style>
</head>
<body>
<h1><img src="{{ meerkat }}" alt="" width="96" height="96">{{ title }}</h1>
<nav>
  <a href="{{ screen }}" autofocus><span>📺</span>{{ _("This is the TV") }}</a>
  <a href="{{ phone }}"><span>📱</span>{{ _("Install on my phone") }}</a>
</nav>
<script>
  const tiles = Array.from(document.querySelectorAll("nav a"));
  tiles[0].focus();
  document.addEventListener("keydown", (event) => {
    const step = {ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1}[event.key];
    if (step === undefined) { return; }
    const at = Math.max(0, tiles.indexOf(document.activeElement));
    tiles[(at + step + tiles.length) % tiles.length].focus();
    event.preventDefault();
  });
</script>
</body>
</html>

<!DOCTYPE html>
{# The TV's welcome page (0614): the plain door's bare address. The home page's look
   (assets/theme/tokens.css: warm paper, the meerkat's indigo, apricot for "here"), its
   fonts and its lookout meerkat, all served by the plain door. Always light, `only
   light` so a TV's automatic dark mode leaves it alone (it darkened it, 2026-11-06).
   Two tiles of one size a TV remote drives (arrows, OK); the first one has the focus
   on load. ES5 script: TV browsers are old. No clock, no
   animation. #}
<html lang="{{ _('en') }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="only light">
<title>{{ title }}</title>
<style>
  @font-face { font-family: "Bricolage Grotesque"; font-weight: 200 800; font-display: swap;
               src: url("{{ display_font }}") format("woff2"); }
  @font-face { font-family: "Source Sans 3"; font-weight: 200 900; font-display: swap;
               src: url("{{ text_font }}") format("woff2"); }
  :root { color-scheme: only light; }  /* a TV's automatic dark mode darkened it all */
  html, body { height: 100%; }
  body { margin: 0; background: #f7f0e2; color: #2b2118;
         font: 30px/1.4 "Source Sans 3", "Segoe UI", sans-serif; font-size: 3.6vh;
         display: flex; flex-direction: column; }
  header { display: flex; align-items: center; justify-content: center; gap: 4vw;
           padding: 5vh 6vw 3vh; background: #1a0737; color: #faf0cb;
           border-bottom: 1.2vh solid #fdb057; }
  header img { height: 26vh; width: auto; filter: drop-shadow(0 1vh 1.5vh #00000066); }
  h1 { margin: 0; font: 800 11vh/1.05 "Bricolage Grotesque", "Segoe UI", sans-serif; }
  header p { margin: 1.5vh 0 0; color: #cbbfe0; font-size: 1.1em; }
  header p.facts { color: #faf0cb; }
  nav { flex: 1; display: flex; gap: 5vw; justify-content: center; align-items: center;
        padding: 4vh 6vw; }
  a { display: flex; flex-direction: column; justify-content: center; align-items: center;
      box-sizing: border-box; width: 34vw; height: 42vh; padding: 2vh 2vw; border: 0.6vh solid #d5c7a9;
      border-radius: 3vh; background: #ffffff; color: #2b2118; text-decoration: none; text-align: center;
      font: 700 5vh/1.2 "Bricolage Grotesque", "Segoe UI", sans-serif;
      box-shadow: 0 1vh 2.5vh #3b2c1e40; }
  a span { display: block; margin-bottom: 2vh; font-size: 2.4em; }
  a:focus { outline: none; background: #fdebcf; border-color: #fdb057;
            box-shadow: 0 0 0 1.2vh #1a0737, 0 2vh 4vh #3b2c1e66; }
</style>
</head>
<body>
<header>
  <img src="{{ meerkat }}" alt="">
  <div>
    <h1>{{ title }}</h1>
    {% if facts %}<p class="facts">{{ facts }}</p>{% endif %}
    <p>{{ _("Choose with the remote's arrows, then OK.") }}</p>
  </div>
</header>
<nav>
  <a href="{{ screen }}" autofocus><span>📺</span>{{ _("Slideshow") }}</a>
  <a href="{{ phone }}"><span>📱</span>{{ _("Install on my phone") }}</a>
</nav>
<script nonce="{{ page_nonce }}">
  (function () {
    var tiles = document.querySelectorAll("nav a");
    var steps = {37: -1, 38: -1, 39: 1, 40: 1};
    tiles[0].focus();
    document.addEventListener("keydown", function (event) {
      var step = steps[event.keyCode];
      var at = 0;
      var i;
      if (step === undefined) {
        return;
      }
      for (i = 0; i < tiles.length; i += 1) {
        if (tiles[i] === document.activeElement) {
          at = i;
        }
      }
      tiles[(at + step + tiles.length) % tiles.length].focus();
      event.preventDefault();
    });
  }());
</script>
</body>
</html>

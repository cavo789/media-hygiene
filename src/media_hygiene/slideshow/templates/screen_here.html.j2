{# The screen on this PC (0659, `/screen?here=1`): a bar of the same buttons as the phone's
   remote, shown when the mouse moves, hidden after a few seconds still. Hidden for good on a
   TV (no `here=1`): the TV's page is unchanged. Its script: screen_here.js.j2. #}
<style>
#here { position: absolute; z-index: 6; left: 0; right: 0; bottom: 0; padding: 12px 16px; background: rgba(0, 0, 0, 0.7); color: #eee; font: 16px/1.4 sans-serif; text-align: center; }
#here button { margin: 0 6px; padding: 8px 14px; border: 1px solid #666; border-radius: 6px; background: #222; color: #fff; font: 18px/1 sans-serif; cursor: pointer; }
#here button:hover, #here button:focus { background: #444; }
#here p { margin: 8px 0 0 0; color: #bbb; font-size: 14px; }
body.pointing { cursor: default; }
</style>
<div id="here" class="hidden" data-paused="{{ _('Play (Space)') }}" data-playing="{{ _('Pause (Space)') }}">
  <button type="button" id="herePrevious" title="{{ _('Previous (←)') }}" aria-label="{{ _('Previous (←)') }}">&#9664;</button>
  <button type="button" id="herePlay" title="{{ _('Play (Space)') }}" aria-label="{{ _('Play (Space)') }}">&#9199;</button>
  <button type="button" id="hereNext" title="{{ _('Next (→)') }}" aria-label="{{ _('Next (→)') }}">&#9654;</button>
  <button type="button" id="hereFull" title="{{ _('Full screen (Esc leaves it)') }}" aria-label="{{ _('Full screen (Esc leaves it)') }}">&#9974;</button>
  <button type="button" id="hereStop" title="{{ _('Stop the show (S)') }}" aria-label="{{ _('Stop the show (S)') }}">&#10005;</button>
  <p>{{ _("Click the photo for full screen. Keys: ← → previous and next, Space pause and play, Esc leaves full screen, S stops the show.") }}</p>
</div>

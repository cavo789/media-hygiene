{# Avoid some people (0825): one checkbox per person seen on the show's photos, with their
   count; each change sends every name ticked, the server sets their photos out of the show ("Do not show"), and the long poll
   greys them in the grid. Nobody seen nor remembered: the block stays hidden.
   Remembered (0834): the PC's ticks are written to [slideshow] avoid and read back; the
   names remembered start ticked, listed even on none of the photos; a phone's are for its
   show only.
   One component for the remote and the PC's own screen tab (0829, included in
   screen_here.js.j2 behind `here=1`): ES5 and XMLHttpRequest, as the screen page's script
   (tests/support/es5.py). A page that wants to know the block opened defines
   `avoidOpened` in the scope it includes this from. A name changed in a large view
   (`mh-named`, 0830) asks again with `fresh`: the counts follow the people files. #}
(function () {
  var block = document.getElementById("avoid");
  var names = document.getElementById("avoidNames");
  var said = document.getElementById("avoidSaid");
  var PATH = {{ avoid_path | tojson }};
  var FORMS = [{{ _("{n} photo set out for them.") | tojson }}, {{ _("{n} photos set out for them.") | tojson }}];
  var failed = {{ _("The people could not be avoided: try again.") | tojson }};
  var KEPT = {{ _("Remembered for every show: {names}.") | tojson }};
  var NONE_KEPT = {{ _("Nobody is remembered for every show.") | tojson }};
  var PHONE = {{ _("On the phone, for this show only: the people remembered are changed on the PC.") | tojson }};
  var ABSENT = {{ _("remembered, on none of these photos") | tojson }};
  function tell(view) {
    var lines = [];
    if (view.ticked.length) {
      lines.push(FORMS[view.out === 1 ? 0 : 1].replace("{n}", view.out));
    }
    lines.push(view.remembered.length ? KEPT.replace("{names}", view.remembered.join(", ")) : NONE_KEPT);
    if (view.phone) {
      lines.push(PHONE);
    }
    said.textContent = lines.join(" ");
  }
  function call(method, body, done) {
    var request = new XMLHttpRequest();
    request.open(method, PATH, true);
    request.onreadystatechange = function () {
      if (request.readyState === 4) {
        done(request.status === 200 ? JSON.parse(request.responseText) : null);
      }
    };
    if (body === null) {
      request.setRequestHeader("Cache-Control", "no-store");
      request.send();
    } else {
      request.setRequestHeader("Content-Type", "application/json");
      request.send(JSON.stringify(body));
    }
  }
  function ticked() {
    var boxes = names.getElementsByTagName("input");
    var chosen = [];
    var index;
    for (index = 0; index < boxes.length; index += 1) {
      if (boxes[index].checked) {
        chosen.push(boxes[index].value);
      }
    }
    return chosen;
  }
  function send() {
    call("POST", { names: ticked() }, function (view) {
      if (view && view.people) {
        tell(view);
      } else {
        said.textContent = failed;
      }
    });
  }
  function add(person, chosen) {
    var label = document.createElement("label");
    var box = document.createElement("input");
    // ✓ a face named as theirs, ≈ only guessed (close to their mean): the signs of /person.
    var counts = [];
    if (person.sure) {
      counts.push("✓ " + person.sure);
    }
    if (person.guessed) {
      counts.push("≈ " + person.guessed);
    }
    box.type = "checkbox";
    box.value = person.name;
    box.checked = chosen.indexOf(person.name) !== -1;
    box.addEventListener("change", send, false);
    label.appendChild(box);
    if (counts.length) {
      label.appendChild(document.createTextNode((person.sure ? "✓ " : "≈ ") + person.name + " (" + counts.join(" · ") + ")"));
    } else {
      label.appendChild(document.createTextNode(person.name + " — " + ABSENT));
    }
    names.appendChild(label);
  }
  function draw(view) {
    var index;
    if (!view || !view.people || view.people.length === 0) {
      return false;
    }
    while (names.firstChild) {
      names.removeChild(names.firstChild);
    }
    for (index = 0; index < view.people.length; index += 1) {
      add(view.people[index], view.ticked);
    }
    block.hidden = false;
    tell(view);
    return true;
  }
  call("GET", null, function (view) {
    if (draw(view) && typeof avoidOpened === "function") {
      avoidOpened();
    }
  });
  // A name changed in the large view (0830): the people found again, their counts redrawn.
  document.addEventListener("mh-named", function () {
    call("POST", { names: ticked(), fresh: true }, draw);
  }, false);
}());

{# The script of the TV's page (screen.html.j2). ES5 only, for a 2012 TV browser: var, function,
   XMLHttpRequest; no arrow, no let/const, no template string, no fetch, no Promise written here
   (img.decode is used only where it exists). tests/unit/test_slideshow_screen.py parses it.
   A video (0292): played in the third layer; its end (or an error) is told to the server, which
   moves on. A browser older than img.decode (a 2012 TV's own) or that says it plays no H.264
   shows the photos only, and says so on each question it asks. #}
(function () {
  var WAIT = {{ wait_prefix | tojson }};
  var CODE_SHOWN = {{ code_shown | tojson }};
  var ENDED = {{ ended_prefix | tojson }};
  var PHOTOS_ONLY = {{ photos_only | tojson }};
  var H264 = "video/mp4; codecs=\"avc1.42E01E\"";
  var RETRY_MS = 3000;
  var DECODE_MS = 150;
  var version = 0;
  var shown = "";
  var loading = "";
  var ahead = new Image();
  var front = { layer: document.getElementById("layerA"), photo: document.getElementById("photoA") };
  var back = { layer: document.getElementById("layerB"), photo: document.getElementById("photoB") };
  var pairing = document.getElementById("pairing");
  var codeText = document.getElementById("code");
  var film = document.getElementById("film");
  var filmLayer = document.getElementById("layerF");
  var films = typeof ahead.decode === "function" && Boolean(film.canPlayType && film.canPlayType(H264));
  var filmShown = "";
  var filmKey = null;
  var BEHIND = typeof ahead.decode === "function" ? "layer back quiet" : "layer back";
  var SHRINK = 0.85;
  var FITS_TRIES = 20;
  var TITLE_MS = {{ title_seconds }} * 1000;
  var BANNER_MS = {{ banner_seconds }} * 1000;
  var card = document.getElementById("card");
  var banner = document.getElementById("banner");
  var told = 0;
  var tellTimer = null;

  front.photo.className = "hidden";
  back.photo.className = "hidden";
  back.layer.className = BEHIND;

  function swap() {
    var former = front;
    front = back;
    back = former;
    front.layer.className = "layer front";
    back.layer.className = BEHIND;
  }

  function shownNow(url) {
    if (loading !== url) {
      return;
    }
    loading = "";
    shown = url;
    swap();
  }

  function show(url) {
    if (url === shown || url === loading) {
      return;
    }
    if (url === "") {
      loading = "";
      shown = "";
      front.photo.className = "hidden";
      return;
    }
    loading = url;
    back.photo.onload = function () {
      var decoded = function () { shownNow(url); };
      if (back.photo.decode) {
        back.photo.decode().then(decoded, decoded);
      } else {
        window.setTimeout(decoded, DECODE_MS);
      }
    };
    back.photo.onerror = function () {
      if (loading === url) {
        loading = "";
      }
    };
    back.photo.className = "";
    if (back.photo.getAttribute("src") === url && back.photo.complete) {
      back.photo.onload();
      return;
    }
    back.photo.src = url;
  }

  function preload(url) {
    if (url !== "" && url !== shown) {
      ahead.src = url;
    }
  }

  function ended() {
    var request;
    if (filmShown === "") {
      return;
    }
    request = new XMLHttpRequest();
    request.open("GET", ENDED + filmKey, true);
    request.send(null);
  }

  function started(attempt, failed) {
    if (attempt && attempt["catch"]) {
      attempt["catch"](failed);
    }
  }

  function startFilm() {
    started(film.play(), function () {
      film.muted = true;  // a browser may refuse sound before a click: muted, it plays
      started(film.play(), ended);
    });
  }

  function stopFilm() {
    if (filmShown === "") {
      return;
    }
    filmShown = "";
    film.pause();
    film.removeAttribute("src");
    film.load();
    filmLayer.className = "layer hidden";
  }

  function showFilm(url, key, playing) {
    filmKey = key;
    if (url !== filmShown) {
      filmShown = url;
      film.src = url;
      filmLayer.className = "layer film";
    }
    if (playing) {
      startFilm();
    } else {
      film.pause();
    }
  }

  function setText(id, text) {
    var element = document.getElementById(id);
    element.innerHTML = "";
    element.appendChild(document.createTextNode(text || ""));
  }

  function hideTelling() {
    if (tellTimer !== null) {
      window.clearTimeout(tellTimer);
      tellTimer = null;
    }
    card.className = "hidden";
    banner.className = "hidden";
  }

  // A new event: its title card, then a banner on its first photo, never permanently.
  function tell(chapter, photo) {
    var line = [chapter.name, chapter.period, chapter.place];
    var parts = [];
    var each;
    if (!chapter.name && !chapter.period && !chapter.place) {
      return;
    }
    for (each = 0; each < line.length; each += 1) {
      if (line[each]) {
        parts.push(line[each]);
      }
    }
    setText("cardName", chapter.name);
    setText("cardPeriod", chapter.period);
    setText("cardPlace", chapter.place);
    setText("banner", parts.join(" \u00b7 "));
    document.getElementById("cardPhoto").src = photo || "";
    document.getElementById("cardPhoto").className = photo ? "" : "hidden";
    card.className = "";
    tellTimer = window.setTimeout(function () {
      card.className = "hidden";
      banner.className = "";
      tellTimer = window.setTimeout(hideTelling, BANNER_MS);
    }, TITLE_MS);
  }

  function telling(answer) {
    var chapter = answer.chapter;
    if (!chapter) {
      told = 0;
      hideTelling();
      return;
    }
    if (chapter.number === told) {
      return;
    }
    told = chapter.number;
    hideTelling();
    tell(chapter, answer.photo || answer.next);
  }

  function showAnswer(answer) {
    telling(answer);
    if (answer.film && films) {
      showFilm(answer.film, answer.key, answer.playing);
    } else {
      stopFilm();
      if (!answer.film) {
        show(answer.photo);
      }
    }
    preload(answer.next);
  }

  function fontSize(element) {
    return parseFloat(window.getComputedStyle(element, null).fontSize);
  }

  // Shrinks the code and its lines until they fit the screen, whatever text zoom the TV's
  // browser applies (a Chromecast's showed the lines but not the code, 2026-10-22).
  function fitCode() {
    var tries = 0;
    var text = fontSize(pairing);
    var digits = fontSize(codeText);
    while (tries < FITS_TRIES && (codeText.scrollWidth > pairing.clientWidth || pairing.offsetTop + pairing.offsetHeight > window.innerHeight)) {
      text = text * SHRINK;
      digits = digits * SHRINK;
      pairing.style.fontSize = text + "px";
      codeText.style.fontSize = digits + "px";
      tries = tries + 1;
    }
  }

  function showCode(code) {
    codeText.innerHTML = "";
    codeText.appendChild(document.createTextNode(code));
    pairing.className = "";
    fitCode();
  }

  function ask(since) {
    var request = new XMLHttpRequest();
    request.open("GET", WAIT + since + (films ? "" : PHOTOS_ONLY), true);
    request.onreadystatechange = function () {
      var answer;
      if (request.readyState !== 4) {
        return;
      }
      if (request.status === 401) {
        window.setTimeout(function () { window.location.reload(); }, RETRY_MS);
        return;
      }
      if (request.status !== 200) {
        window.setTimeout(function () { ask(version); }, RETRY_MS);
        return;
      }
      try {
        answer = JSON.parse(request.responseText);
      } catch (error) {
        window.setTimeout(function () { ask(version); }, RETRY_MS);
        return;
      }
      if (answer.code) {
        showCode(answer.code);
        ask(CODE_SHOWN);
        return;
      }
      pairing.className = "hidden";
      version = answer.version;
      showAnswer(answer);
      ask(version);
    };
    request.send(null);
  }

  function fullScreen() {
    var page = document.documentElement;
    var asks = page.requestFullscreen || page.webkitRequestFullScreen || page.webkitRequestFullscreen || page.mozRequestFullScreen || page.msRequestFullscreen;
    if (asks) {
      try {
        asks.call(page);
      } catch (error) {
        return;
      }
    }
  }

  document.addEventListener("keydown", function (event) {
    if (event.keyCode === 13) {
      fullScreen();
    }
  }, false);
  document.addEventListener("click", fullScreen, false);
  film.addEventListener("ended", ended, false);
  film.addEventListener("error", ended, false);
  ask(0);

  // The server gone (0416): two asks in a row without any answer, the overlay says so.
  var lostAsks = 0;
  function probe() {
    var check = new XMLHttpRequest();
    check.open("HEAD", window.location.pathname, true);
    check.onload = function () { lostAsks = 0; };
    check.onerror = function () {
      var overlay = document.getElementById("mhStopped");
      lostAsks += 1;
      if (overlay && lostAsks >= 2) {
        overlay.hidden = false;
        overlay.style.display = "flex";
      }
    };
    check.send();
  }
  window.setInterval(probe, 10000);
}());

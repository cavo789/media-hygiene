{# The script of the remote (slideshow.html.j2): the photos once, then the show as the server holds
   it, asked again and again (a long poll: the answer comes once the show changed). Each button
   sends one action; the answer is the show as it now is. A video (0292) is marked ▶, its first
   frame as thumbnail; one the TV cannot play is labelled and cannot be chosen. #}
(() => {
  const TEXTS = {{ texts | tojson }};
  const SLIDES_PATH = {{ slides_path | tojson }};
  const SHOW_PATH = {{ show_path | tojson }};
  const SCREENS_PATH = {{ screens_path | tojson }};
  const SCREEN_PATH = {{ screen_path | tojson }};
  const LAN_PATH = {{ lan_path | tojson }};
  const RETRY_MS = 3000;
  const LOOPBACK = new Set(["127.0.0.1", "localhost", "[::1]"]);
  const status = document.getElementById("status");
  const grid = document.getElementById("grid");
  const play = document.getElementById("play");
  const out = document.getElementById("out");
  const seconds = document.getElementById("seconds");
  const tiles = new Map();
  const filmKeys = new Set();
  let version = 0;
  let current = null;
  let playing = false;

  const plural = (forms, n) => forms[n === 1 ? 0 : 1].replace("{n}", n);
  const say = (text, error) => {
    status.textContent = text;
    status.classList.toggle("error", Boolean(error));
  };
  const post = (path, value) =>
    fetch(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(value) });
  const ask = (value) =>
    post(SHOW_PATH, value)
      .then((response) => (response.ok ? response.json().then(draw) : say(TEXTS.failed.replace("{status}", response.status), true)))
      .catch(() => say(TEXTS.offline, true));

  function draw(show) {
    version = show.version;
    current = show.current;
    playing = show.playing;
    const outKeys = new Set(show.out);
    for (const [key, tile] of tiles) {
      tile.classList.toggle("current", key === current);
      tile.classList.toggle("out", outKeys.has(key));
      const toggle = tile.querySelector("button");
      if (toggle) toggle.textContent = outKeys.has(key) ? TEXTS.in : TEXTS.out;
    }
    const where = show.place === null ? TEXTS.nothing : TEXTS.place.replace("{place}", show.place).replace("{total}", show.total);
    const stays = filmKeys.has(current) ? TEXTS.filmPlays : TEXTS.playing.replace("{seconds}", show.seconds);
    const pace = show.playing ? stays : TEXTS.paused;
    const screens = show.screens === 0 ? TEXTS.noScreen : plural(TEXTS.screens, show.screens);
    const films = show.films || filmKeys.size === 0 ? "" : ` · ${TEXTS.photosOnly}`;
    say(`${where} · ${pace} · ${screens}${films}`, false);
    play.textContent = show.playing ? TEXTS.pause : TEXTS.play;
    out.disabled = current === null;
    const paceValue = String(show.seconds);
    if (![...seconds.options].some((option) => option.value === paceValue)) {
      seconds.add(new Option(TEXTS.seconds.replace("{n}", paceValue), paceValue));
    }
    seconds.value = paceValue;
    tellEvent(show);
    window.dispatchEvent(new CustomEvent("mh-show", { detail: show }));
    const tile = tiles.get(current);
    if (tile) tile.scrollIntoView({ block: "nearest" });
  }

  // The event of the photo shown (0448), unless told nowhere; the button of the choice pressed.
  let told = null;
  function tellEvent(show) {
    for (const button of document.querySelectorAll("[data-where]")) {
      button.setAttribute("aria-pressed", String(button.dataset.where === show.telling));
    }
    const chapter = show.chapter;
    const parts = chapter ? [chapter.name, chapter.period, chapter.place].filter(Boolean) : [];
    const event = document.getElementById("event");
    event.textContent = parts.join(" · ");
    event.hidden = show.telling === "none" || parts.length === 0;
    // "Phone only" (0449): the storyteller's notes open by themselves, once per choice made.
    if (show.telling === "phone" && told !== "phone") document.getElementById("story").open = true;
    told = show.telling;
  }

  function poll() {
    fetch(`${SHOW_PATH}/${version}`, { cache: "no-store" })
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((show) => {
        draw(show);
        poll();
      })
      .catch(() => {
        say(TEXTS.offline, true);
        window.setTimeout(poll, RETRY_MS);
      });
  }

  function pictureOf(slide) {
    if (slide.thumb) {
      const image = document.createElement("img");
      image.src = slide.thumb;
      image.alt = slide.day || "";
      image.loading = "lazy";
      return image;
    }
    if (!slide.film) {
      const blank = document.createElement("div");
      blank.className = "blank";
      blank.textContent = "▶";
      return blank;
    }
    const movie = document.createElement("video");
    movie.muted = true;
    movie.playsInline = true;
    movie.preload = "metadata";
    movie.src = `${slide.film}#t=0.5`;  // its first frames: the thumbnail
    return movie;
  }

  function tileOf(slide) {
    const figure = document.createElement("figure");
    figure.className = "tile";
    const picture = pictureOf(slide);
    const caption = document.createElement("figcaption");
    caption.textContent = slide.day || "";
    if (slide.format && !slide.film) {  // a video the TV cannot play
      figure.classList.add("unplayable");
      caption.textContent = TEXTS.unplayable.replace("{format}", slide.format);
      figure.append(picture, caption);
      return figure;
    }
    if (slide.film) {
      filmKeys.add(slide.key);
      const mark = document.createElement("span");
      mark.className = "mark";
      mark.textContent = "▶";
      figure.append(mark);
    }
    picture.addEventListener("click", () => ask({ action: "jump", key: slide.key }));
    const toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "plain";
    toggle.addEventListener("click", () => ask({ action: figure.classList.contains("out") ? "in" : "out", key: slide.key }));
    figure.append(picture, caption, toggle);
    return figure;
  }

  function showLan() {
    const local = LOOPBACK.has(window.location.hostname);
    if (!local) {
      const homeLink = document.getElementById("homeLink");
      if (homeLink) homeLink.hidden = true;  // only the PC goes back to the home page
      return;
    }
    fetch(LAN_PATH, { cache: "no-store" })
      .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
      .then((lan) => {
        document.getElementById("screenUrl").textContent = new URL(SCREEN_PATH, lan.url).href;
        document.getElementById("phoneUrl").textContent = lan.url;
        document.getElementById("phoneCode").textContent = lan.code;
        document.getElementById("qr").innerHTML = lan.qr;
        document.getElementById("lan").hidden = false;
      })
      .catch(() => {
        const off = document.getElementById("lanOff");
        off.textContent = TEXTS.lanOff.replace("{command}", TEXTS.lanCommand);
        off.hidden = false;
      });
  }

  document.getElementById("previous").addEventListener("click", () => ask({ action: "previous" }));
  document.getElementById("next").addEventListener("click", () => ask({ action: "next" }));
  play.addEventListener("click", () => ask({ action: playing ? "pause" : "play" }));
  out.addEventListener("click", () => current !== null && ask({ action: "out", key: current }));
  for (const button of document.querySelectorAll("[data-where]")) {
    button.addEventListener("click", () => ask({ action: "tell", where: button.dataset.where }));
  }
  seconds.addEventListener("change", () => ask({ action: "pace", seconds: Number(seconds.value) }));
  document.getElementById("pair").addEventListener("submit", (event) => {
    event.preventDefault();
    const field = document.getElementById("tvCode");
    const said = document.getElementById("pairStatus");
    post(SCREENS_PATH, { code: field.value })
      .then((response) => response.json().then((value) => {
        said.textContent = response.ok ? TEXTS.paired : value.error;
        if (response.ok) {
          field.value = "";
          draw(value);
        }
      }))
      .catch(() => { said.textContent = TEXTS.offline; });
  });

  showLan();
  fetch(SLIDES_PATH, { cache: "no-store" })
    .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
    .then((value) => {
      for (const slide of value.slides) {
        const tile = tileOf(slide);
        tiles.set(slide.key, tile);
        grid.append(tile);
      }
      poll();
    })
    .catch(() => say(TEXTS.offline, true));
})();

{# Rendered once, in the active language, when config.toml does not exist yet. #}
{% macro comment(text, cli="") -%}
# {{ text | wordwrap(86, break_long_words=False, wrapstring="\n# ") }}
{%- if cli %}

# CLI: {{ cli }}
{%- endif %}
{%- endmacro %}
{{ comment(_("media-hygiene configuration — created on first run, edit it freely.")) }}
#
{{ comment(_("Precedence, from the strongest: command-line options > MEDIA_HYGIENE_* environment variables (e.g. MEDIA_HYGIENE_GENERAL__LOCALE=fr) > this file > built-in defaults.")) }}
{{ comment(_("Run 'media-hygiene config' to see every effective value and where it comes from.")) }}


[general]
{{ comment(_('Interface language: "en" or "fr".'), "--locale") }}
locale = "{{ locale }}"

{{ comment(_('How much to log: "error", "warning", "info" or "debug".'), "--verbosity") }}
verbosity = "info"

{{ comment(_('ANSI colours: "auto", "always" or "never".'), "--color") }}
color = "auto"


[folders]
{{ comment(_("Host paths, written between 'single quotes' so backslashes need no escaping. These are lists of paths: your real folders are never renamed.")) }}

{{ comment(_("Copies found in these folders are kept first, in this order."), "--prefer") }}
preferred = []

{{ comment(_('Never modified. Their files are always the copies kept, so identical files elsewhere ARE deleted (a "master library").'), "--protect") }}
protected = []

{{ comment(_("Never analysed: e.g. a real backup that must remain a second copy."), "--exclude") }}
excluded = []

{{ comment(_("Example:")) }}
# preferred = ['C:\Family Photos', 'C:\Users\Public\Pictures']
# protected = ['C:\Family Photos\Albums']
# excluded = ['D:\backup']


[scan]
{{ comment(_('Only analyse these categories or extensions, e.g. ["photo", "video"] or ["png", "webp"]. Built-in categories: photo, raw, video and media (the three); yours are defined below. Empty: media, every photo, RAW and video extension. Other types are allowed, such as ["pdf", "docx"]: their copies are moved to the quarantine, never deleted. A name without a dot is a category when one has that name, otherwise an extension: write ".raw" for the extension.'), "--ext") }}
extensions = []

{{ comment(_("Folder names never analysed, wherever they are, on every disk: they add to the system and trash folders always skipped ('media-hygiene config' lists them). Globs matching the whole name, case ignored: * stands for any characters, ? for one, e.g. [\"Thumbnails\", \".Trash-*\", \"*.lrdata\"]. Globs, not regular expressions as in [keep]: folder names hold dots and dollars ($RECYCLE.BIN), which a regular expression reads as operators. A comma separates names: write ? in its place. For one precise folder, use excluded in [folders]."), "--exclude-name") }}
excluded_names = []

{{ comment(_("Your own categories: a name, then its extensions (not other categories). The built-in ones cannot be redefined. Variable: MEDIA_HYGIENE_SCAN__CATEGORIES holds a JSON object that replaces this whole table.")) }}
[scan.categories]
# documents = ["pdf", "docx", "txt"]


[keep]
{{ comment(_("Between identical copies, a name someone chose (Mariage 2015\\Marie et Paul.jpg) is kept rather than a name generated by a camera or an app (DCIM\\IMG_1234.jpg), and a folder someone named rather than a generic one (DCIM, Camera, New folder).")) }}
{{ comment(_("Regular expressions matching the whole name, case ignored: file names without extension, then folder names. Leave these lines commented to use the built-in lists ('media-hygiene config' shows them); an empty list [] disables the rule.")) }}
# generated_names = ['IMG_\d+', 'DSC\d+', 'PXL_\d{8}_\d+.*']
# generic_folders = ['DCIM', 'Camera', 'New folder']


[clean]
{{ comment(_("Ask for confirmation before cleaning."), "--yes") }}
confirm = true


[sort]
{{ comment(_("Ask for confirmation before sorting."), "--yes") }}
confirm = true

{{ comment(_("Files the system leaves behind: a source folder holding nothing else is removed once sorted, these files going to the quarantine first. 'sort --keep-empty-folders' keeps every folder.")) }}
junk_files = ["Thumbs.db", "desktop.ini", ".DS_Store"]


[inventory]
{{ comment(_("Labels of the 'inventory' export, computed when it is written: change a value and export again, nothing is scanned. A photo is blurry below blurry_below (sharpness), small below small_below pixels on its shorter side.")) }}
blurry_below = 100.0
small_below = 1000

{{ comment(_("Exposure: dark below dark_below or bright above bright_above (mean brightness, 0 to 255), or when more than clipped_above of the pixels (0 to 1) are pure black or pure white.")) }}
dark_below = 50.0
bright_above = 205.0
clipped_above = 0.25


[places]
{{ comment(_("The map of 'places', where you name your places: only its tiles are fetched, by your browser, from this https address (they show the areas you look at, never a photo). Another tile server asks for its own credit in attribution (plain text).")) }}
tiles = "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
attribution = "© OpenStreetMap contributors"


[classify]
{{ comment(_("How 'classify' proposes a tree for your photos and videos. Every value below is an example: replace it with your own structure. Nothing moves before 'sort'.")) }}

{{ comment(_("Host folder receiving the tree. Empty: each mounted folder is reorganised in place."), "--target") }}
target = ''

{{ comment(_("Host folders never sorted: analysed and cleaned as usual, left where they are."), "--leave") }}
leave = []

{{ comment(_("Where files go, by how sure the proposal is. Placeholders: {year}, {quarter}, {month}, {month_name}, {day}, {category}, {event}, {event_start}, {place}, {country}, {region}, {city}. An empty layout leaves the files where they are; '{year}/{month}' needs no category at all."), "--layout") }}
layout = "{year}/{category}"
unsure_layout = "{year}/{{ _("To check") }}/{category}"
manual_layout = "{year}/{{ _("To sort") }}/{event}"
undated_layout = "{{ _("To sort") }}/{{ _("Undated") }}"
received_layout = "{{ _("To sort") }}/{{ _("Received and downloaded") }}"

{{ comment(_("Events: photos taken less than merge_gap_hours apart belong together; fewer than min_event_size photos are not an event, and fall back to their month.")) }}
merge_gap_hours = 18
min_event_size = 5

{{ comment(_('Zone of the videos\' UTC times, e.g. "Europe/Brussels". Empty: the zone of the container.')) }}
timezone = ""

{{ comment(_("Scores from 0 to 100: 'sure' and above goes to the layout, 'unsure' and above to the 'to check' layout, the rest to the 'to sort' one.")) }}
sure = 80
unsure = 50

{{ comment(_("Trips, for a 'trip' rule: an event whose photos lie farther than trip_min_km from home is away; away events less than trip_merge_gap_hours apart, and less than trip_merge_max_km from each other, make one trip.")) }}
trip_min_km = 100
trip_merge_gap_hours = 48
trip_merge_max_km = 120

[classify.ai]
{{ comment(_("A local vision model (Ollama) names the subject of the photos no other rule decides. Off until a 'subject' rule is written below and a model is set here. The photos are sent to url, and only there: keep that server on your own computer.")) }}
{{ comment(_("Docker Desktop resolves host.docker.internal by itself. Docker Engine (Linux, WSL) needs --add-host=host.docker.internal:host-gateway in docker run, and Ollama started with OLLAMA_HOST=0.0.0.0 to listen beyond 127.0.0.1.")) }}
url = "http://host.docker.internal:11434"
{{ comment(_('A model that sees images, e.g. "qwen2.5vl:7b". Empty: no photo is ever sent. map_model: a text model that chooses the categories; empty: the same model.')) }}
model = ""
map_model = ""
{{ comment(_("Photos that answer for each event (the sharpest, spread over its span); the other files of the event follow them. Smaller photos (shorter side, in pixels) are never sent: the model invents details on thumbnails.")) }}
samples_per_event = 3
min_edge = 512
{{ comment(_("Above this many photos to describe, classify asks first and prints the estimated time. One photo at a time suits one graphics card."), "--yes") }}
confirm_above = 200
concurrency = 1

{{ comment(_("Rules: what you know, written once, applied at every run. They are read in order, and the first one whose score reaches 'sure' decides; its name shows as the reason in the summary and in the workbook. These lists of tables are read from this file only: no environment variable overrides them.")) }}
{{ comment(_('Each rule has a name and a "match": existing_folder (a folder name you chose), event_neighbour (the loose files of an event join its one named folder), calendar (days of every year, dates = "12-24..12-26"; "12-31..01-01" crosses New Year), date_range (days that happen once, dates = "2023-07-01..2023-07-15"), kind (kind = "screenshot", "received" or "download"), path (a regular expression searched in the host path, pattern = "(?i)kermesse"), camera (a regular expression searched in the make and model, pattern = "(?i)dji"), subject (what a local vision model sees, categories = [...], see [classify.ai]), place (the GPS position lies in one of your places, see [[classify.places]]), trip (an event far from home, named after its country and town without going online), other_category (the files no rule above matched).')) }}
{{ comment(_("A date rule takes a whole event when at least half of its photos fall on its days: a trip over Christmas stays a trip if its date range is listed above Christmas.")) }}
{{ comment(_("A category may use {year}, {month}, {month_name}, {day}, {event} and {event_start}: those of the event's start. Without a category, the files a rule matches stay where they are. 'score = 0' turns a rule off; without a score, the rule takes the one of its match (a date range is sure).")) }}
{{ comment(_('The categories below are an example to replace with your own, e.g. Parties, Holidays and outings, School, Sport and leisure, Home and works, Animals, Nature and landscapes, Documents and screenshots, Other. Avoid a "Family" or "Portraits" category: in a family collection, it swallows most photos.')) }}

[[classify.rules]]
name = "{{ _("Films and series") }}"
match = "kind"
kind = "download"
{{ comment(_("No category: downloaded films and series are not memories, they stay where they are.")) }}

{{ comment(_("Your own rules go here, above the folders, for instance:")) }}
# [[classify.rules]]
# name = "{{ _("My places") }}"
# match = "place"
#
# [[classify.rules]]
# name = "{{ _("Trips") }}"
# match = "trip"
#
# [[classify.rules]]
# name = "{{ _("Italy 2023") }}"
# match = "date_range"
# dates = "2023-07-01..2023-07-15"
# category = "{{ _("Holidays and outings") }}/{{ _("Italy 2023") }}"
#
# [[classify.rules]]
# name = "{{ _("Grandma's birthday") }}"
# match = "calendar"
# dates = "03-12"
# category = "{{ _("Parties") }}/{{ _("Birthdays") }}"
#
# [[classify.rules]]
# name = "{{ _("School fair") }}"
# match = "path"
# pattern = '(?i)kermesse'
# category = "{{ _("School") }}/{{ _("School fair") }}"
#
# [[classify.rules]]
# name = "{{ _("Drone") }}"
# match = "camera"
# pattern = '(?i)dji|fc\d{4}'
# category = "{{ _("Nature and landscapes") }}/{{ _("Drone") }}"

[[classify.rules]]
name = "{{ _("Existing folders") }}"
match = "existing_folder"

[[classify.rules]]
name = "{{ _("Screenshots and documents") }}"
match = "kind"
kind = "screenshot"
category = "{{ _("Documents and screenshots") }}"

[[classify.rules]]
name = "{{ _("Event neighbours") }}"
match = "event_neighbour"

[[classify.rules]]
name = "{{ _("Christmas") }}"
match = "calendar"
dates = "12-24..12-26"
category = "{{ _("Parties") }}/{{ _("Christmas") }}"

[[classify.rules]]
name = "{{ _("New Year") }}"
match = "calendar"
dates = "12-31..01-01"
category = "{{ _("Parties") }}/{{ _("New Year") }}"
{% if locale == "fr" %}

[[classify.rules]]
name = "Saint-Nicolas"
match = "calendar"
dates = "12-05..12-06"
category = "{{ _("Parties") }}/Saint-Nicolas"
{% endif %}

{{ comment(_("Pictures received through a messaging app, if you want them apart:")) }}
# [[classify.rules]]
# name = "{{ _("Received") }}"
# match = "kind"
# kind = "received"
# category = "{{ _("Received") }}"

{{ comment(_("The subject a local vision model sees, for the photos no rule above decided ([classify.ai] model must be set). It picks one of these categories, or none; it is sure only when the photos of an event agree. per_photo = true describes every photo instead of a few per event: much longer.")) }}

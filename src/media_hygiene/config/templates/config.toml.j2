{# Rendered once, in the active language, when config.toml does not exist yet. #}
{% macro comment(text, cli="") -%}
# {{ text | wordwrap(86, break_long_words=False, wrapstring="\n# ") }}
{%- if cli %}

# CLI: {{ cli }}
{%- endif %}
{%- endmacro %}
{{ comment(_("media-hygiene configuration — created on first run, edit it freely.")) }}
# media-hygiene-config: {{ version }}
#
{{ comment(_("Precedence, from the strongest: command-line options > MEDIA_HYGIENE_* environment variables (e.g. MEDIA_HYGIENE_GENERAL__LOCALE=fr) > this file > built-in defaults.")) }}
{{ comment(_("Run 'media-hygiene config' to see every effective value and where it comes from.")) }}


[general]
{{ comment(_('Interface language: "en" or "fr".'), "--locale") }}
locale = "{{ locale }}"

{{ comment(_('Your time zone, for the dates and the names of reports and runs, e.g. "Europe/Brussels" or "America/Montreal" (list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones). Empty: UTC, as Docker does not know yours.')) }}
timezone = ""

{{ comment(_('How much to log: "error", "warning", "info", "verbose" (info and every tip, not only the best two) or "debug".'), "--verbosity") }}
verbosity = "info"

{{ comment(_('ANSI colours: "auto", "always" or "never".'), "--color") }}
color = "auto"


[folders]
{{ comment(_("Host paths, written between 'single quotes' so backslashes need no escaping. These are lists of paths: your real folders are never renamed.")) }}

{{ comment(_("Copies found in these folders are kept first, in this order."), "--prefer") }}
preferred = []

{{ comment(_('Never modified. Their files are always the copies kept, so identical files elsewhere ARE deleted (a "master library").'), "--protect") }}
protected = []

{{ comment(_("Never analysed: e.g. a real backup that must remain a second copy."), "--exclude") }}
excluded = []

{{ comment(_("Example:")) }}
# preferred = ['C:\Family Photos', 'C:\Users\Public\Pictures']
# protected = ['C:\Family Photos\Albums']
# excluded = ['D:\backup']


[scan]
{{ comment(_('Only analyse these categories or extensions, e.g. ["photo", "video"] or ["png", "webp"]. Built-in categories: photo, raw, video and media (the three); yours are defined below. Empty: media, every photo, RAW and video extension. Other types are allowed, such as ["pdf", "docx"]: their copies are moved to the quarantine, never deleted. A name without a dot is a category when one has that name, otherwise an extension: write ".raw" for the extension.'), "--ext") }}
extensions = []

{{ comment(_("Folder names never analysed, wherever they are, on every disk: they add to the system and trash folders always skipped ('media-hygiene config' lists them). Globs matching the whole name, case ignored: * stands for any characters, ? for one, e.g. [\"Thumbnails\", \".Trash-*\", \"*.lrdata\"]. Globs, not regular expressions as in [keep]: folder names hold dots and dollars ($RECYCLE.BIN), which a regular expression reads as operators. A comma separates names: write ? in its place. For one precise folder, use excluded in [folders]."), "--exclude-name") }}
excluded_names = []

{{ comment(_("A folder that did not change since the last audit is taken from the index (/cache) instead of read again: one look at the folder instead of one per file. A file changed in place does not change its folder: a folder listed more than this many days ago is read again anyway. 0 reads every folder every time."), "--full") }}
full_check_days = 7

{{ comment(_("A photo or RAW file up to this size, in MB, is read once into memory: it is checked and its fingerprint computed from that one reading. Each worker holds one such file at a time: with 16 workers, up to 16 x this size at worst. Lower it when Docker has little memory (Docker Desktop: Settings > Resources); 0 reads every file twice.")) }}
read_whole_mb = 128

{{ comment(_("Your own categories: a name, then its extensions (not other categories). The built-in ones cannot be redefined. Variable: MEDIA_HYGIENE_SCAN__CATEGORIES holds a JSON object that replaces this whole table.")) }}
[scan.categories]
# documents = ["pdf", "docx", "txt"]


[keep]
{{ comment(_("Between identical copies, a name someone chose (Mariage 2015\\Marie et Paul.jpg) is kept rather than a name generated by a camera or an app (DCIM\\IMG_1234.jpg), and a folder someone named rather than a generic one (DCIM, Camera, New folder).")) }}
{{ comment(_("Regular expressions matching the whole name, case ignored: file names without extension, then folder names. Leave these lines commented to use the built-in lists ('media-hygiene config' shows them); an empty list [] disables the rule.")) }}
# generated_names = ['IMG_\d+', 'DSC\d+', 'PXL_\d{8}_\d+.*']
# generic_folders = ['DCIM', 'Camera', 'New folder']


[clean]
{{ comment(_("Ask for confirmation before cleaning."), "--yes") }}
confirm = true

{{ comment(_("After how many days 'status' suggests emptying the quarantine with 'purge' (the files set aside still take their space until then).")) }}
purge_hint_days = 30

{{ comment(_("How many files 'clean', 'undo' and 'sort' handle at once (1 or more): four readers read a Windows folder about 4 times faster than one. Lower it to 1 for a slow USB hard disk, whose head seeks back and forth between the readers.")) }}
workers = 4

{{ comment(_("Space 'clean' leaves free on the quarantine's drive when it copies files there from another drive, in GB (0 or more): a full system drive breaks Windows. 0 keeps no margin.")) }}
quarantine_headroom_gb = 1.0

{{ comment(_("Photos and videos you set aside by a choice (burst shots, near duplicates, files set aside in 'search' or 'review --junk') and that come back, whatever their name (a phone backup): the audit recognises them from the journal and 'clean' sets them aside again. false never looks for them.")) }}
returned = true


[review]
{{ comment(_("A series whose proposal leaves only the sharpest shot (and those of protected folders) is obvious: the review page validates every obvious series at once, with one confirmation.")) }}

{{ comment(_("The burst review proposes to set aside a shot whose sharpness is below this share of the sharpest shot of its series (0 to 1): 0.35 proposes a shot at 162 next to one at 1017, not one at 616. Moving on accepts the proposal, a key takes it back. 0 never proposes anything.")) }}
propose_aside_below = 0.35

{{ comment(_("A shot nearly identical to a sharper shot kept of its series is proposed aside too: its perceptual hash differs by fewer bits than this (0 to 64). Low values only catch repeats of the same frame. 0 disables the rule.")) }}
identical_below = 6

{{ comment(_("A shot clearly over- or under-exposed next to the others of its series is proposed aside: its mean brightness lies farther than this from theirs (gray levels, 0 to 255), or its share of pixels clipped to white or black exceeds theirs by more than clipped_gap (0 to 1). 0 disables either rule.")) }}
brightness_gap = 60
clipped_gap = 0.25

[review.unwanted]
{{ comment(_("'review --junk' shows the photos most likely unwanted, one group per reason; nothing is set aside until you say so, and 'clean --decisions' moves only what you set aside to the quarantine. A photo of a protected folder, a burst shot, a near or exact duplicate is never listed.")) }}

{{ comment(_("Tiny: below this many megapixels (width times height divided by a million): 0.16 is 400 x 400 pixels, icons and thumbnails. 0 disables the reason.")) }}
tiny_megapixels = 0.16

{{ comment(_("A screenshot or a document, as 'classify' tells them: a screenshot name, or a PNG or tiny image without any camera trace.")) }}
screenshots = true

{{ comment(_("Nearly black: mean brightness under dark_mean (gray levels, 0 to 255) with at least dark_share (0 to 1) of the pixels black; the same for nearly white, over white_mean. 0 disables either reason.")) }}
dark_mean = 25
dark_share = 0.7
white_mean = 230
white_share = 0.7

{{ comment(_("The blurriest: sharpness under this percentile (0 to 100) of your own photos, so the threshold follows your cameras. 0 disables the reason.")) }}
blur_percentile = 2


[sort]
{{ comment(_("Ask for confirmation before sorting."), "--yes") }}
confirm = true

{{ comment(_("Files the system leaves behind: a source folder holding nothing else is removed once sorted, these files going to the quarantine first. 'sort --keep-empty-folders' keeps every folder.")) }}
junk_files = ["Thumbs.db", "desktop.ini", ".DS_Store"]


[album]
{{ comment(_("Host folder holding the albums of 'album': folders of hard links, a second name for each photo, which take no space. Empty: 'Albums' in the [classify] target folder. It must be on the disk of the photos, in the same mounted folder.")) }}
root = ''


[inventory]
{{ comment(_("Labels of the 'inventory' export, computed when it is written: change a value and export again, nothing is scanned. A photo is blurry below blurry_below (sharpness), small below small_below pixels on its shorter side.")) }}
blurry_below = 100.0
small_below = 1000

{{ comment(_("Exposure: dark below dark_below or bright above bright_above (mean brightness, 0 to 255), or when more than clipped_above of the pixels (0 to 1) are pure black or pure white.")) }}
dark_below = 50.0
bright_above = 205.0
clipped_above = 0.25


[cache]
{{ comment(_("The cache folder (/cache) keeps the previews of your photos, one per size, so that reports and review pages never decode a photo twice. At most this many gigabytes: beyond, the previews shown least recently are removed, and made again when needed.")) }}
previews_max_gb = 2.0


[places]
{{ comment(_("The map of 'places', where you name your places: only its tiles are fetched, by your browser, from this https address (they show the areas you look at, never a photo). Another tile server asks for its own credit in attribution (plain text).")) }}
tiles = "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
attribution = "© OpenStreetMap contributors"
{{ comment(_("Search an area by its name on OpenStreetMap (a village, a park), from the map, on a click only: only the text you type is sent to this Nominatim service, never a photo nor a position. Its usage policy: https://operations.osmfoundation.org/policies/nominatim/ (one search per second at most). Another instance, or empty to search offline only.")) }}
nominatim_url = "https://nominatim.openstreetmap.org"


[tags]
{{ comment(_("The words of 'tags', to find photos by what they show: the meaningful words of the folder and file names (none for IMG_1234), the date (year, month, season, holidays), the place (your [[classify.places]], the nearest town) and, when [classify.ai] model is set, what the vision model sees. They are kept in the cache (/cache), never written into the photos.")) }}
{{ comment(_('Language of the words: "en", "fr", or empty for the language of the interface.')) }}
language = ""
{{ comment(_("Words left out because they describe nearly every photo. Written here, the list replaces the built-in one (French and English).")) }}
# stop_words = ["sol", "mur", "intérieur", "floor", "wall", "indoor"]
{{ comment(_("A GPS position is named after its town only within this distance, in km.")) }}
town_km = 20
{{ comment(_("The words 'xmp' writes into the .xmp sidecars next to the photos (dc:subject), by source: vision, place, folder, name, former (the folders and names of the copies 'clean' removed), date. The model's sentence goes into dc:description.")) }}
{{ comment(_("person writes the names of the people on each photo (PersonInImage): never by default, as the names then travel with every copy of the photos.")) }}
xmp_sources = ["vision", "place"]


[people]
{{ comment(_("The faces 'people' finds and groups. They are personal data: kept in the cache (/cache) only, never sent anywhere; 'people --forget' deletes them all. These settings choose which faces are grouped: changing them analyses nothing again.")) }}
{{ comment(_("Two faces this similar (cosine, 0 to 1) may be the same person: higher splits more groups, lower mixes people.")) }}
similarity = 0.363
{{ comment(_("Faces smaller than this many pixels (shorter side of their box) are left out.")) }}
min_face = 40
{{ comment(_("Faces blurrier than this sharpness (variance of the Laplacian of the face) are left out.")) }}
min_sharpness = 30.0
{{ comment(_("true: every 'audit' then looks for faces in the photos not looked at yet, after saying how long it takes and asking, as 'audit --people' does."), "--people") }}
with_audit = false
{{ comment(_("The names you give on the 'people' page are saved here as [[people.person]] tables (a name, the faces confirmed as theirs, the faces taken out of them), and the faces of strangers as 'ignored'. 'search person:name' finds their photos.")) }}

[classify]
{{ comment(_("How 'classify' proposes a tree for your photos and videos. Every value below is an example: replace it with your own structure. Nothing moves before 'sort'.")) }}

{{ comment(_("Host folder receiving the tree. Empty: each mounted folder is reorganised in place."), "--target") }}
target = ''

{{ comment(_("Host folders never sorted: analysed and cleaned as usual, left where they are."), "--leave") }}
leave = []

{{ comment(_("Where files go, by how sure the proposal is. Placeholders: {year}, {quarter}, {month}, {month_name}, {day}, {category}, {event}, {event_start}, {place}, {country}, {region}, {city}. An empty layout leaves the files where they are; '{year}/{month}' needs no category at all."), "--layout") }}
layout = "{year}/{category}"
unsure_layout = "{year}/{{ _("To check") }}/{category}"
manual_layout = "{year}/{{ _("To sort") }}/{event}"
undated_layout = "{{ _("To sort") }}/{{ _("Undated") }}"
received_layout = "{{ _("To sort") }}/{{ _("Received and downloaded") }}"

{{ comment(_("Events: photos taken less than merge_gap_hours apart belong together; fewer than min_event_size photos are not an event, and fall back to their month.")) }}
merge_gap_hours = 18
min_event_size = 5

{{ comment(_('Zone of the videos\' UTC times, e.g. "Europe/Brussels". Empty: [general] timezone.')) }}
timezone = ""

{{ comment(_("Scores from 0 to 100: 'sure' and above goes to the layout, 'unsure' and above to the 'to check' layout, the rest to the 'to sort' one.")) }}
sure = 80
unsure = 50

{{ comment(_("Trips, for a 'trip' rule: an event whose photos lie farther than trip_min_km from home is away; away events less than trip_merge_gap_hours apart, and less than trip_merge_max_km from each other, make one trip.")) }}
trip_min_km = 100
trip_merge_gap_hours = 48
trip_merge_max_km = 120
{{ comment(_("Towns, for a 'folder_town' rule: a folder named exactly after a town of at least this many inhabitants (GeoNames) names the place of its photos.")) }}
folder_town_min_population = 5000
{{ comment(_('Folder names that are never towns, e.g. a first name that is also a town somewhere: ["Martin", "Victoria"]. Case and accents do not matter.')) }}
folder_town_ignore = []

[classify.ai]
{{ comment(_("A local vision model (Ollama) names the subject of the photos no other rule decides. Off until a 'subject' rule is written below and a model is set here. The photos are sent to url, and only there: keep that server on your own computer.")) }}
{{ comment(_("Docker Desktop resolves host.docker.internal by itself. Docker Engine (Linux, WSL) needs --add-host=host.docker.internal:host-gateway in docker run, and Ollama started with OLLAMA_HOST=0.0.0.0 to listen beyond 127.0.0.1.")) }}
url = "http://host.docker.internal:11434"
{{ comment(_('A model that sees images, e.g. "qwen2.5vl:7b". Empty: no photo is ever sent. map_model: a text model that chooses the categories; empty: the same model.')) }}
model = ""
map_model = ""
{{ comment(_("Photos that answer for each event (the sharpest, spread over its span); the other files of the event follow them. Smaller photos (shorter side, in pixels) are never sent: the model invents details on thumbnails.")) }}
samples_per_event = 3
min_edge = 512
{{ comment(_("Above this many photos to describe, classify asks first and prints the estimated time. One photo at a time suits one graphics card."), "--yes") }}
confirm_above = 200
concurrency = 1

{{ comment(_("Rules: what you know, written once, applied at every run. They are read in order, and the first one whose score reaches 'sure' decides; its name shows as the reason in the summary and in the workbook. These lists of tables are read from this file only: no environment variable overrides them.")) }}
{{ comment(_('Each rule has a name and a "match": existing_folder (a folder name you chose), event_neighbour (the loose files of an event join its one named folder), calendar (days of every year, dates = "12-24..12-26"; "12-31..01-01" crosses New Year), date_range (days that happen once, dates = "2023-07-01..2023-07-15"), kind (kind = "screenshot", "received" or "download"), path (a regular expression searched in the host path, pattern = "(?i)kermesse"), camera (a regular expression searched in the make and model, pattern = "(?i)dji"), subject (what a local vision model sees, categories = [...], see [classify.ai]), place (the GPS position lies in one of your places, see [[classify.places]]), trip (an event far from home, named after its country and town without going online), folder_town (a folder named after a town, 2017/Durbuy: its photos go to country/town, to check), other_category (the files no rule above matched).')) }}
{{ comment(_("A date rule takes a whole event when at least half of its photos fall on its days: a trip over Christmas stays a trip if its date range is listed above Christmas.")) }}
{{ comment(_("A category may use {year}, {month}, {month_name}, {day}, {event} and {event_start}: those of the event's start. Without a category, the files a rule matches stay where they are. 'score = 0' turns a rule off; without a score, the rule takes the one of its match (a date range is sure).")) }}
{{ comment(_('The categories below are an example to replace with your own, e.g. Parties, Holidays and outings, School, Sport and leisure, At home, Animals, Nature and landscapes, Documents and screenshots, Other. Avoid a "Family" or "Portraits" category: in a family collection, it swallows most photos.')) }}

[[classify.rules]]
name = "{{ _("Films and series") }}"
match = "kind"
kind = "download"
{{ comment(_("No category: downloaded films and series are not memories, they stay where they are.")) }}

{{ comment(_("Your own rules go here, above the folders, for instance:")) }}
# [[classify.rules]]
# name = "{{ _("My places") }}"
# match = "place"
#
# [[classify.rules]]
# name = "{{ _("Trips") }}"
# match = "trip"
#
# [[classify.rules]]
# name = "{{ _("Towns of the folders") }}"
# match = "folder_town"
#
# [[classify.rules]]
# name = "{{ _("Italy 2023") }}"
# match = "date_range"
# dates = "2023-07-01..2023-07-15"
# category = "{{ _("Holidays and outings") }}/{{ _("Italy 2023") }}"
#
# [[classify.rules]]
# name = "{{ _("Grandma's birthday") }}"
# match = "calendar"
# dates = "03-12"
# category = "{{ _("Parties") }}/{{ _("Birthdays") }}"
#
# [[classify.rules]]
# name = "{{ _("School fair") }}"
# match = "path"
# pattern = '(?i)kermesse'
# category = "{{ _("School") }}/{{ _("School fair") }}"
#
# [[classify.rules]]
# name = "{{ _("Drone") }}"
# match = "camera"
# pattern = '(?i)dji|fc\d{4}'
# category = "{{ _("Nature and landscapes") }}/{{ _("Drone") }}"

{{ comment(_("person: the events where someone named on the 'people' page shows on at least min_share percent of the photos (10 by default), and the lone photos showing them. names = [...] matches any of them; all = true needs every one. A name nobody has in [[people.person]] stops classify.")) }}
# [[classify.rules]]
# name = "{{ _("With Léa") }}"
# match = "person"
# names = ["Léa"]
# category = "{{ _("People") }}/Léa"

[[classify.rules]]
name = "{{ _("Existing folders") }}"
match = "existing_folder"

[[classify.rules]]
name = "{{ _("Screenshots and documents") }}"
match = "kind"
kind = "screenshot"
category = "{{ _("Documents and screenshots") }}"

[[classify.rules]]
name = "{{ _("Event neighbours") }}"
match = "event_neighbour"

[[classify.rules]]
name = "{{ _("Christmas") }}"
match = "calendar"
dates = "12-24..12-26"
category = "{{ _("Parties") }}/{{ _("Christmas") }}"

[[classify.rules]]
name = "{{ _("New Year") }}"
match = "calendar"
dates = "12-31..01-01"
category = "{{ _("Parties") }}/{{ _("New Year") }}"
{% if locale == "fr" %}

[[classify.rules]]
name = "Saint-Nicolas"
match = "calendar"
dates = "12-05..12-06"
category = "{{ _("Parties") }}/Saint-Nicolas"
{% endif %}

{{ comment(_("Pictures received through a messaging app, if you want them apart:")) }}
# [[classify.rules]]
# name = "{{ _("Received") }}"
# match = "kind"
# kind = "received"
# category = "{{ _("Received") }}"

{{ comment(_("The subject a local vision model sees, for the photos no rule above decided ([classify.ai] model must be set). It picks one of these categories, or none; it is sure only when the photos of an event agree. per_photo = true describes every photo instead of a few per event: much longer.")) }}
{{ comment(_('Write each category as "Name = definition": the name is the folder, the definition tells the model what you mean by it. A name alone is judged by its words: "Home and works" drew every indoor scene.')) }}
# [[classify.rules]]
# name = "{{ _("Subject") }}"
# match = "subject"
# categories = [
#     "{{ _("Holidays and outings") }} = {{ _("away from home: trips, visits, restaurants, playgrounds") }}",
#     "{{ _("Parties") }} = {{ _("birthdays, Christmas, communions, weddings; not a costume alone") }}",
#     "{{ _("School") }} = {{ _("classrooms, school trips, school shows and parties") }}",
#     "{{ _("Sport and leisure") }} = {{ _("sports and hobbies, played or watched: matches, swimming") }}",
#     "{{ _("At home") }} = {{ _("in your own home only: meals, games, children, sofa, garden") }}",
#     "{{ _("Animals") }} = {{ _("a pet or an animal as the main subject") }}",
#     "{{ _("Nature and landscapes") }} = {{ _("landscapes, plants and sky, no one as the main subject") }}",
# ]

{{ comment(_('"Other" means: sure that nothing above matches. Without it, such files go to "to sort", which means: we do not know.')) }}
# [[classify.rules]]
# name = "{{ _("Other") }}"
# match = "other_category"
# category = "{{ _("Other") }}"

{{ comment(_("Your own places: a photo whose GPS position lies within radius_m metres of one goes to its name, with a 'place' rule above; a photo without GPS follows the other photos of its event. One place can be home = true: trips are measured from it. Name them on a map with 'media-hygiene places', or copy the latitude and longitude from a map. Nothing leaves your computer: towns and countries are named from GeoNames data shipped with the image. A place found on OpenStreetMap from that map keeps its outline instead of a radius (area, a list of [latitude, longitude] rings, and osm, its id): 'classify' never goes online.")) }}
# [[classify.places]]
# name = "{{ _("Home") }}"
# latitude = 50.0
# longitude = 5.0
# radius_m = 200
# home = true

{{ comment(_("Your names for the towns: the towns are named after GeoNames, in English or in their own language (Brussels, Brugge, Gent). Write the exact GeoNames name, then yours: trips, {city}, the places page and the folder_town rule use yours; a folder named either way matches.")) }}
# [classify.town_names]
# "Brugge" = "Bruges"
# "Gent" = "{{ _("Ghent") }}"

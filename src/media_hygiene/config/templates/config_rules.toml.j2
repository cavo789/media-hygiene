[[classify.rules]]
name = "{{ _("Existing folders") }}"
match = "existing_folder"

[[classify.rules]]
name = "{{ _("Screenshots and documents") }}"
match = "kind"
kind = "screenshot"
{{ comment(_("No category: screenshots, tickets and receipts stay where they are, out of the years. To gather them in a folder of yours, give a category and a layout of their own, e.g.:")) }}
# category = "{{ _("Documents and screenshots") }}"
# layout = "{category}/{year}"

[[classify.rules]]
name = "{{ _("Event neighbours") }}"
match = "event_neighbour"

[[classify.rules]]
name = "{{ _("Same moment") }}"
match = "same_moment"

[[classify.rules]]
name = "{{ _("Christmas") }}"
match = "calendar"
dates = "12-24..12-26"
category = "{{ _("Christmas") }}"

[[classify.rules]]
name = "{{ _("New Year") }}"
match = "calendar"
dates = "12-31..01-01"
category = "{{ _("New Year") }}"
{% if locale == "fr" %}

[[classify.rules]]
name = "Saint-Nicolas"
match = "calendar"
dates = "12-05..12-06"
category = "Saint-Nicolas"
{% endif %}

{{ comment(_("Pictures received through a messaging app, if you want them apart:")) }}
